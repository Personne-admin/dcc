module std::mem;

public import std::result;

import core::slice;
import std::debug;

using result::{ Optional };

//!
//! Transitional re-export
//!
//! The callback allocator record, its fixed-buffer adapter and its arena used to
//! live in this module. They keep their `std::mem` spelling only until the last
//! consumer moves to the static policies in `std::alloc` and
//! `std::alloc::fixed`; this import is removed with them.
//!
public import std::alloc::callback;

//!
//! Raw memory primitives
//!

/// copies `min(dst.len, src.len)` elements forward. regions must not overlap.
public void copy(T)([] T dst, [] const T src) {
    usize n = if dst.len < src.len {
        dst.len
    } else {
        src.len
    };

    for usize i = 0; i < n; i++ {
        dst[i] = src[i];
    }
}

/// copies elements even when the regions overlap.
public void move(T)([] T dst, [] const T src) {
    usize n = if dst.len < src.len {
        dst.len
    } else {
        src.len
    };

    if dst.ptr as usize < src.ptr as usize {
        for usize i = 0; i < n; i++ {
            dst[i] = src[i];
        }
    } else {
        usize i = n;
        while i > 0 {
            i--;
            dst[i] = src[i];
        }
    }
}

public void set(T)([] T dst, T value) {
    for usize i = 0; i < dst.len; i++ {
        dst[i] = value;
    }
}

public void zero(T)([] T dst) {
    [] u8 raw = core::slice::from_raw!u8(dst.ptr as u8*, mem_byte_len!T(dst.len));
    for usize i = 0; i < raw.len; i++ {
        raw[i] = 0;
    }
}

/// lexicographic byte comparison. returns -1, 0 or 1.
public i32 compare([] const u8 a, [] const u8 b) {
    usize n = if a.len < b.len {
        a.len
    } else {
        b.len
    };

    for usize i = 0; i < n; i++ {
        if a[i] != b[i] {
            return if a[i] < b[i] {
                -1
            } else {
                1
            };
        }
    }

    if a.len == b.len {
        return 0;
    }

    return if a.len < b.len {
        -1
    } else {
        1
    };
}

public bool equal([] const u8 a, [] const u8 b) {
    return compare(a, b) == 0;
}

public i32 compare([] const char a, [] const char b) {
    return compare(a as [] const u8, b as [] const u8);
}

public bool equal([] const char a, [] const char b) {
    return equal(a as [] const u8, b as [] const u8);
}

public void swap(T)(T* a, T* b) {
    T tmp = *a;
    *a = *b;
    *b = tmp;
}

//!
//! Reinterpretation
//!

/// views a value as its raw bytes. the result borrows from `value`.
public [] const u8 as_bytes(T)(const T* value) {
    return core::slice::from_raw_const!u8(value as const u8*, sizeof (T));
}

public [] u8 as_bytes_mut(T)(T* value) {
    return core::slice::from_raw!u8(value as u8*, sizeof (T));
}

/// views a typed slice as raw bytes.
public [] const u8 slice_as_bytes(T)([] const T items) {
    return core::slice::from_raw_const!u8(
        items.ptr as const u8*,
        mem_byte_len!T(items.len)
    );
}

//!
//! Alignment
//!

public bool is_power_of_two(usize v) {
    return v != 0 && (v & (v - 1)) == 0;
}

using usize MAX_SIZE = ~(0 as usize);

Optional(usize) mem_checked_add(usize a, usize b) {
    if b > MAX_SIZE - a { return Optional::None; }
    return Optional::Some(a + b);
}

Optional(usize) mem_checked_mul(usize a, usize b) {
    if a != 0 && b > MAX_SIZE / a { return Optional::None; }
    return Optional::Some(a * b);
}

usize mem_byte_len(T)(usize count) {
    Optional(usize) size = mem_checked_mul(count, sizeof(T));
    if size.is_none() { debug::panic("mem::byte_len: size overflow"); }
    return size.unwrap_some();
}

Optional(usize) mem_checked_align_up(usize value, usize align) {
    if !is_power_of_two(align) {
        debug::panic("mem::checked_align_up: alignment must be a nonzero power of two");
    }
    usize padding = (0 as usize - value) & (align - 1);
    return mem_checked_add(value, padding);
}

public usize align_up(usize value, usize align) {
    Optional(usize) rounded = mem_checked_align_up(value, align);
    if rounded.is_none() { debug::panic("mem::align_up: size overflow"); }
    return rounded.unwrap_some();
}

public usize align_down(usize value, usize align) {
    if !is_power_of_two(align) {
        debug::panic("mem::align_down: alignment must be a nonzero power of two");
    }
    return value & ~(align - 1);
}

public bool is_aligned(usize value, usize align) {
    if !is_power_of_two(align) {
        debug::panic("mem::is_aligned: alignment must be a nonzero power of two");
    }
    return (value & (align - 1)) == 0;
}

public bool is_ptr_aligned(T)(const T* p, usize align) {
    return is_aligned(p as usize, align);
}
