module std::mem;

public import std::result;
import std::slice;
import std::debug;

using result::{ Result, Status, Optional };

//!
//! Errors and allocator interface
//!

public enum AllocError : u8 {
    OutOfMemory,
    InvalidAlignment,
}

public using AllocFn = Result([] u8, AllocError)(*)(void* ctx, usize len, usize align);
public using ResizeFn = bool(*)(void* ctx, [] u8 buf, usize new_len, usize align);
public using FreeFn = void(*)(void* ctx, [] u8 buf, usize align);

public struct Allocator {
    void* ctx;
    AllocFn alloc_fn;
    ResizeFn resize_fn;
    FreeFn free_fn;
}

//!
//! Allocator operations
//!

/// allocates `len` bytes with the given alignment.
public Result([] u8, AllocError) raw_alloc(
    const Allocator* self,
    usize len,
    usize align
) {
    if !is_power_of_two(align) {
        return AllocError::InvalidAlignment;
    }

    return self.alloc_fn(self.ctx, len, align);
}

/// attempts to grow or shrink `buf` in place. returns false when the
/// allocator cannot honour the request without moving the block.
public bool raw_resize(
    const Allocator* self,
    [] u8 buf,
    usize new_len,
    usize align
) {
    return self.resize_fn(self.ctx, buf, new_len, align);
}

public void raw_free(const Allocator* self, [] u8 buf, usize align) {
    self.free_fn(self.ctx, buf, align);
}

public [] T raw_as_typed(T)([] u8 raw, usize n) {
    static if sizeof(T) == 0 {
        return slice::from_raw(raw.ptr as T*, n);
    } else {
        return (raw as []T)[0..n];
    }
}

/// allocates storage for `n` values of `T`, uninitialized.
public Result([] T, AllocError) alloc(T)(const Allocator* self, usize n) {
    Optional(usize) size = mem_checked_mul(sizeof(T), n);
    if size.is_none() { return AllocError::OutOfMemory; }
    static if sizeof(T) == 0 {
        return Result::Ok(slice::from_raw(null as T*, n));
    } else {
        usize bytes = size.unwrap_some();
        Result([] u8, AllocError) raw_r = self.raw_alloc(bytes, alignof (T));
        if raw_r.is_err() {
            return raw_r.unwrap_err();
        }
        [] u8 raw = raw_r.unwrap();
        [] T out = raw_as_typed(raw, n);
        return result::Result::Ok(out);
    }
}

/// allocates storage for `n` values of `T` and zeroes it.
public Result([] T, AllocError) alloc_zeroed(T)(const Allocator* self, usize n) {
    Result([] T, AllocError) out_r = self.alloc(n);
    if out_r.is_err() {
        return out_r;
    }
    [] T out = out_r.unwrap();
    zero(out);
    return Result::Ok(out);
}

public void free(T)(const Allocator* self, [] T items) {
    static if sizeof(T) != 0 {
        []u8 raw = slice::from_raw!u8(items.ptr as u8*, mem_byte_len!T(items.len));
        self.raw_free(raw, alignof(T));
    }
}

/// allocates a single `T`.
public Result(T*, AllocError) create(T)(const Allocator* self) {
    Result([] T, AllocError) one_r = self.alloc(1);
    if one_r.is_err() {
        return one_r.unwrap_err();
    }
    [] T one = one_r.unwrap();
    return Result::Ok(one.ptr);
}

public void destroy(T)(const Allocator* self, T* value) {
    self.free(slice::from_raw(value, 1));
}

/// copies `source` into freshly allocated storage owned by the caller.
public Result([] T, AllocError) dupe(T)(
    const Allocator* self,
    [] const T source
) {
    Result([] T, AllocError) out_r = self.alloc(source.len);
    if out_r.is_err() {
        return out_r;
    }
    [] T out = out_r.unwrap();
    copy(out, source);
    return Result::Ok(out);
}

//!
//! Raw memory primitives
//!

/// copies `min(dst.len, src.len)` elements forward. regions must not overlap.
public void copy(T)([] T dst, [] const T src) {
    usize n = if dst.len < src.len {
        dst.len
    } else {
        src.len
    };

    for usize i = 0; i < n; i++ {
        dst[i] = src[i];
    }
}

/// copies elements even when the regions overlap.
public void move(T)([] T dst, [] const T src) {
    usize n = if dst.len < src.len {
        dst.len
    } else {
        src.len
    };

    if dst.ptr as usize < src.ptr as usize {
        for usize i = 0; i < n; i++ {
            dst[i] = src[i];
        }
    } else {
        usize i = n;
        while i > 0 {
            i--;
            dst[i] = src[i];
        }
    }
}

public void set(T)([] T dst, T value) {
    for usize i = 0; i < dst.len; i++ {
        dst[i] = value;
    }
}

public void zero(T)([] T dst) {
    [] u8 raw = slice::from_raw!u8(dst.ptr as u8*, mem_byte_len!T(dst.len));
    for usize i = 0; i < raw.len; i++ {
        raw[i] = 0;
    }
}

/// lexicographic byte comparison. returns -1, 0 or 1.
public i32 compare([] const u8 a, [] const u8 b) {
    usize n = if a.len < b.len {
        a.len
    } else {
        b.len
    };

    for usize i = 0; i < n; i++ {
        if a[i] != b[i] {
            return if a[i] < b[i] {
                -1
            } else {
                1
            };
        }
    }

    if a.len == b.len {
        return 0;
    }

    return if a.len < b.len {
        -1
    } else {
        1
    };
}

public bool equal([] const u8 a, [] const u8 b) {
    return compare(a, b) == 0;
}

public i32 compare([] const char a, [] const char b) {
    return compare(a as [] const u8, b as [] const u8);
}

public bool equal([] const char a, [] const char b) {
    return equal(a as [] const u8, b as [] const u8);
}

public void swap(T)(T* a, T* b) {
    T tmp = *a;
    *a = *b;
    *b = tmp;
}

//!
//! Reinterpretation
//!

/// views a value as its raw bytes. the result borrows from `value`.
public [] const u8 as_bytes(T)(const T* value) {
    return slice::from_raw_const!u8(value as const u8*, sizeof (T));
}

public [] u8 as_bytes_mut(T)(T* value) {
    return slice::from_raw!u8(value as u8*, sizeof (T));
}

/// views a typed slice as raw bytes.
public [] const u8 slice_as_bytes(T)([] const T items) {
    return slice::from_raw_const!u8(
        items.ptr as const u8*,
        mem_byte_len!T(items.len)
    );
}

//!
//! Alignment
//!

public bool is_power_of_two(usize v) {
    return v != 0 && (v & (v - 1)) == 0;
}

using usize MAX_SIZE = ~(0 as usize);

Optional(usize) mem_checked_add(usize a, usize b) {
    if b > MAX_SIZE - a { return Optional::None; }
    return Optional::Some(a + b);
}

Optional(usize) mem_checked_mul(usize a, usize b) {
    if a != 0 && b > MAX_SIZE / a { return Optional::None; }
    return Optional::Some(a * b);
}

usize mem_byte_len(T)(usize count) {
    Optional(usize) size = mem_checked_mul(count, sizeof(T));
    if size.is_none() { debug::panic("mem::byte_len: size overflow"); }
    return size.unwrap_some();
}

Optional(usize) mem_checked_align_up(usize value, usize align) {
    if !is_power_of_two(align) {
        debug::panic("mem::checked_align_up: alignment must be a nonzero power of two");
    }
    usize padding = (0 as usize - value) & (align - 1);
    return mem_checked_add(value, padding);
}

public usize align_up(usize value, usize align) {
    Optional(usize) rounded = mem_checked_align_up(value, align);
    if rounded.is_none() { debug::panic("mem::align_up: size overflow"); }
    return rounded.unwrap_some();
}

public usize align_down(usize value, usize align) {
    if !is_power_of_two(align) {
        debug::panic("mem::align_down: alignment must be a nonzero power of two");
    }
    return value & ~(align - 1);
}

public bool is_aligned(usize value, usize align) {
    if !is_power_of_two(align) {
        debug::panic("mem::is_aligned: alignment must be a nonzero power of two");
    }
    return (value & (align - 1)) == 0;
}

Result(usize, AllocError) allocation_start([]u8 buffer, usize offset, usize len, usize align) {
    Optional(usize) address = mem_checked_add(buffer.ptr as usize, offset);
    if address.is_none() { return AllocError::OutOfMemory; }
    Optional(usize) rounded = mem_checked_align_up(address.unwrap_some(), align);
    if rounded.is_none() { return AllocError::OutOfMemory; }
    usize start = rounded.unwrap_some() - (buffer.ptr as usize);
    Optional(usize) end = mem_checked_add(start, len);
    if end.is_none() { return AllocError::OutOfMemory; }
    if end.unwrap_some() > buffer.len { return AllocError::OutOfMemory; }
    return Result::Ok(start);
}

public bool is_ptr_aligned(T)(const T* p, usize align) {
    return is_aligned(p as usize, align);
}

//!
//! Fixed buffer allocator
//!

public struct FixedBuffer {
    [] u8 buffer;
    usize offset;
    usize last_offset;
}

public FixedBuffer new_fixed_buffer([] u8 backing) {
    return FixedBuffer {buffer = backing, offset = 0, last_offset = 0};
}

public using FixedBuffer::new = new_fixed_buffer;

Result([] u8, AllocError) fixed_alloc(void* ctx, usize len, usize align) {
    FixedBuffer* self = ctx as FixedBuffer*;

    Result(usize, AllocError) got = allocation_start(self.buffer, self.offset, len, align);
    if got.is_err() { return got.unwrap_err(); }
    usize start = got.unwrap();

    self.last_offset = start;
    self.offset = start + len;
    return Result::Ok(slice::from_raw(self.buffer.ptr + start, len));
}

bool fixed_resize(void* ctx, [] u8 buf, usize new_len, usize align) {
    FixedBuffer* self = ctx as FixedBuffer*;
    usize start = buf.ptr as usize - self.buffer.ptr as usize;

    if start != self.last_offset {
        return new_len <= buf.len;
    }

    Optional(usize) end = mem_checked_add(start, new_len);
    if end.is_none() || end.unwrap_some() > self.buffer.len { return false; }

    self.offset = end.unwrap_some();
    return true;
}

void fixed_free(void* ctx, [] u8 buf, usize align) {
    FixedBuffer* self = ctx as FixedBuffer*;
    usize start = buf.ptr as usize - self.buffer.ptr as usize;

    if start == self.last_offset {
        self.offset = start;
    }
}

public Allocator allocator(FixedBuffer* self) {
    return Allocator {
        ctx = self as void*,
        alloc_fn = fixed_alloc,
        resize_fn = fixed_resize,
        free_fn = fixed_free,
    };
}

/// discards every allocation made from this buffer.
public void reset(FixedBuffer* self) {
    self.offset = 0;
    self.last_offset = 0;
}

//!
//! Arena allocator
//!

public struct ArenaChunk {
    ArenaChunk* next;
    [] u8 memory;
    usize offset;
}

public struct Arena {
    Allocator parent;
    ArenaChunk* head;
    usize next_chunk_size;
}

public using usize ARENA_MIN_CHUNK = 4096;

public Arena new_arena(Allocator parent) {
    return Arena {parent = parent, head = null, next_chunk_size = ARENA_MIN_CHUNK};
}

Result([]u8, AllocError) arena_new_chunk(Arena* self, usize len, usize align) {
    Optional(usize) minimum = mem_checked_add(len, align - 1);
    if minimum.is_none() { return AllocError::OutOfMemory; }
    usize size = self.next_chunk_size;
    if size <= minimum.unwrap_some() {
        Optional(usize) rounded = mem_checked_align_up(minimum.unwrap_some(), ARENA_MIN_CHUNK);
        if rounded.is_none() { return AllocError::OutOfMemory; }
        size = rounded.unwrap_some();
    }
    Optional(usize) total = mem_checked_add(size, sizeof(ArenaChunk));
    Optional(usize) next = mem_checked_mul(size, 2);
    if total.is_none() || next.is_none() { return AllocError::OutOfMemory; }
    Result([]u8, AllocError) got = self.parent.raw_alloc(total.unwrap_some(), alignof(ArenaChunk));
    if got.is_err() { return got.unwrap_err(); }
    []u8 block = got.unwrap();
    []u8 memory = slice::from_raw(block.ptr + sizeof(ArenaChunk), size);
    Result(usize, AllocError) offset = allocation_start(memory, 0, len, align);
    if offset.is_err() {
        self.parent.raw_free(block, alignof(ArenaChunk));
        return offset.unwrap_err();
    }
    usize start = offset.unwrap();
    ArenaChunk* chunk = block.ptr as ArenaChunk*;
    chunk.next = self.head;
    chunk.memory = memory;
    chunk.offset = start + len;
    self.head = chunk;
    self.next_chunk_size = next.unwrap_some();
    return Result::Ok(slice::from_raw(memory.ptr + start, len));
}

Result([] u8, AllocError) arena_alloc(void* ctx, usize len, usize align) {
    Arena* self = ctx as Arena*;
    if self.head != null {
        Result(usize, AllocError) offset = allocation_start(self.head.memory, self.head.offset, len, align);
        if offset.is_ok() {
            usize start = offset.unwrap();
            self.head.offset = start + len;
            return Result::Ok(slice::from_raw(self.head.memory.ptr + start, len));
        }
    }
    return arena_new_chunk(self, len, align);
}

bool arena_resize(void* ctx, [] u8 buf, usize new_len, usize align) {
    return new_len <= buf.len;
}

void arena_free(void* ctx, [] u8 buf, usize align) {}

public Allocator allocator(Arena* self) {
    return Allocator {
        ctx = self as void*,
        alloc_fn = arena_alloc,
        resize_fn = arena_resize,
        free_fn = arena_free,
    };
}

/// releases every chunk back to the parent allocator.
public void deinit(Arena* self) {
    ArenaChunk* chunk = self.head;

    while chunk != null {
        ArenaChunk* next = chunk.next;
        Optional(usize) size = mem_checked_add(chunk.memory.len, sizeof(ArenaChunk));
        if size.is_none() { debug::panic("mem::Arena: invalid chunk size"); }
        usize total = size.unwrap_some();
        self.parent.raw_free(
            slice::from_raw(chunk as u8*, total),
            alignof (ArenaChunk)
        );
        chunk = next;
    }

    self.head = null;
    self.next_chunk_size = ARENA_MIN_CHUNK;
}
