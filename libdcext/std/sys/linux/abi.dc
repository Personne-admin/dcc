//!!
//!! Linux kernel ABI
//!!
//!! Types, flag values and structure layouts.
//!!
//!! Layouts and numeric values are those of the x86-64 kernel headers.
//!! `Stat` in particular is arch-dependent.
//!!

module std::sys::linux::abi;

//!
//! Scalar types
//!

public using Fd = i32;
public using Pid = i32;
public using Uid = u32;
public using Gid = u32;
public using Mode = u32;
public using Off = i64;
public using Dev = u64;
public using Ino = u64;
public using Time = i64;

public using Fd AT_FDCWD = -100;

//!
//! Error numbers
//!
//! Syscalls report failure by returning `-errno` in the range
//! [-4095, -1]. See `is_error` and `errno_of`.
//!

public using i32 EPERM = 1;
public using i32 ENOENT = 2;
public using i32 ESRCH = 3;
public using i32 EINTR = 4;
public using i32 EIO = 5;
public using i32 ENXIO = 6;
public using i32 E2BIG = 7;
public using i32 ENOEXEC = 8;
public using i32 EBADF = 9;
public using i32 ECHILD = 10;
public using i32 EAGAIN = 11;
public using i32 ENOMEM = 12;
public using i32 EACCES = 13;
public using i32 EFAULT = 14;
public using i32 EBUSY = 16;
public using i32 EEXIST = 17;
public using i32 EXDEV = 18;
public using i32 ENODEV = 19;
public using i32 ENOTDIR = 20;
public using i32 EISDIR = 21;
public using i32 EINVAL = 22;
public using i32 ENFILE = 23;
public using i32 EMFILE = 24;
public using i32 ENOTTY = 25;
public using i32 EFBIG = 27;
public using i32 ENOSPC = 28;
public using i32 ESPIPE = 29;
public using i32 EROFS = 30;
public using i32 EMLINK = 31;
public using i32 EPIPE = 32;
public using i32 ERANGE = 34;
public using i32 EDEADLK = 35;
public using i32 ENAMETOOLONG = 36;
public using i32 ENOSYS = 38;
public using i32 ENOTEMPTY = 39;
public using i32 ELOOP = 40;
public using i32 EOVERFLOW = 75;
public using i32 ENOTSOCK = 88;
public using i32 EOPNOTSUPP = 95;
public using i32 EADDRINUSE = 98;
public using i32 ECONNRESET = 104;
public using i32 ETIMEDOUT = 110;
public using i32 ECONNREFUSED = 111;
public using i32 ECANCELED = 125;

public using isize MAX_ERRNO = 4095;

/// true when a raw syscall return encodes a failure.
public bool is_error(isize ret) {
    return ret < 0 && ret >= 0 - MAX_ERRNO;
}

/// error number carried by a failing return. undefined for successes.
public i32 errno_of(isize ret) {
    return (0 - ret) as i32;
}

//!
//! open / openat
//!

public using i32 O_RDONLY = 0x00000;
public using i32 O_WRONLY = 0x00001;
public using i32 O_RDWR = 0x00002;
public using i32 O_CREAT = 0x00040;
public using i32 O_EXCL = 0x00080;
public using i32 O_NOCTTY = 0x00100;
public using i32 O_TRUNC = 0x00200;
public using i32 O_APPEND = 0x00400;
public using i32 O_NONBLOCK = 0x00800;
public using i32 O_DSYNC = 0x01000;
public using i32 O_DIRECTORY = 0x10000;
public using i32 O_NOFOLLOW = 0x20000;
public using i32 O_CLOEXEC = 0x80000;

public using i32 SEEK_SET = 0;
public using i32 SEEK_CUR = 1;
public using i32 SEEK_END = 2;

public using i32 AT_SYMLINK_NOFOLLOW = 0x100;
public using i32 AT_REMOVEDIR = 0x200;
public using i32 AT_EMPTY_PATH = 0x1000;

//!
//! File modes
//!

public using Mode S_IFMT = 0xF000;
public using Mode S_IFSOCK = 0xC000;
public using Mode S_IFLNK = 0xA000;
public using Mode S_IFREG = 0x8000;
public using Mode S_IFBLK = 0x6000;
public using Mode S_IFDIR = 0x4000;
public using Mode S_IFCHR = 0x2000;
public using Mode S_IFIFO = 0x1000;

public using Mode S_IRWXU = 0x1C0;
public using Mode S_IRWXG = 0x038;
public using Mode S_IRWXO = 0x007;

/// 0o666
public using Mode DEFAULT_FILE_MODE = 0x1B6;
/// 0o777
public using Mode DEFAULT_DIR_MODE = 0x1FF;

public bool is_reg(Mode m) {
    return (m & S_IFMT) == S_IFREG;
}

public bool is_dir(Mode m) {
    return (m & S_IFMT) == S_IFDIR;
}

public bool is_lnk(Mode m) {
    return (m & S_IFMT) == S_IFLNK;
}

//!
//! Memory mapping
//!

public using i32 PROT_NONE = 0x0;
public using i32 PROT_READ = 0x1;
public using i32 PROT_WRITE = 0x2;
public using i32 PROT_EXEC = 0x4;

public using i32 MAP_SHARED = 0x0001;
public using i32 MAP_PRIVATE = 0x0002;
public using i32 MAP_FIXED = 0x0010;
public using i32 MAP_ANONYMOUS = 0x0020;
public using i32 MAP_NORESERVE = 0x4000;

public using i32 MREMAP_MAYMOVE = 0x1;
public using i32 MREMAP_FIXED = 0x2;

public using i32 MADV_NORMAL = 0;
public using i32 MADV_WILLNEED = 3;
public using i32 MADV_DONTNEED = 4;
public using i32 MADV_FREE = 8;

/// mmap reports failure the same way every other syscall does; this is
/// the address a caller should never treat as a mapping.
public using usize MAP_FAILED = 0xFFFFFFFFFFFFFFFF;

//!
//! Clocks and time
//!

public using i32 CLOCK_REALTIME = 0;
public using i32 CLOCK_MONOTONIC = 1;
public using i32 CLOCK_PROCESS_CPUTIME = 2;
public using i32 CLOCK_THREAD_CPUTIME = 3;
public using i32 CLOCK_MONOTONIC_RAW = 4;
public using i32 CLOCK_BOOTTIME = 7;

public struct Timespec {
    Time seconds;
    i64 nanoseconds;
}

public struct Timeval {
    Time seconds;
    i64 microseconds;
}

//!
//! Vectored io
//!

public struct Iovec {
    u8* base;
    usize len;
}

//!
//! stat
//!
//! x86-64 layout.
//!

public struct Stat {
    Dev dev;
    Ino ino;
    u64 nlink;
    Mode mode;
    Uid uid;
    Gid gid;
    u32 pad0;
    Dev rdev;
    Off size;
    i64 blksize;
    i64 blocks;
    Timespec atime;
    Timespec mtime;
    Timespec ctime;
    i64[3] reserved;
}

//!
//! Signals
//!

public using i32 SIGHUP = 1;
public using i32 SIGINT = 2;
public using i32 SIGQUIT = 3;
public using i32 SIGILL = 4;
public using i32 SIGABRT = 6;
public using i32 SIGFPE = 8;
public using i32 SIGKILL = 9;
public using i32 SIGSEGV = 11;
public using i32 SIGPIPE = 13;
public using i32 SIGALRM = 14;
public using i32 SIGTERM = 15;

//!
//! Standard descriptors and misc
//!

public using Fd STDIN = 0;
public using Fd STDOUT = 1;
public using Fd STDERR = 2;

public using u32 GRND_NONBLOCK = 0x0001;
public using u32 GRND_RANDOM = 0x0002;

public using usize PAGE_SIZE = 4096;
