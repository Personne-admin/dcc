module std::map;

import core::allocator_config;
import std::hash;
import std::slice;
import std::alloc;
public import std::mem;
public import std::math;
public import std::result;

using result::{ Result, Status, Optional };
using alloc::{ AllocError, AllocatorPolicy };
using hash::{ Hashable, KeyEq };

//!
//! Open-addressed hash map
//!

public using MapKey(K) = Hashable(K) & KeyEq(K);

using u8 CTRL_EMPTY = 0x00;
using u8 CTRL_TOMB = 0x01;

using usize MIN_CAPACITY = 16;
using usize LOAD_NUM = 3;
using usize LOAD_DEN = 4;

public struct Map(K, V, A = DefaultAllocator) if MapKey(K) & AllocatorPolicy(A) {
    A alloc;
    [] u8 control;
    [] K keys;
    [] V values;
    usize count;
    usize tombstones;
}

public struct Entry(K, V) {
    K* key;
    V* value;
}

//!
//! Construction
//!

public Map(K, V) new_map(K, V)() {
    return {
        alloc = DefaultAllocator{},
        control = slice::from_raw(null as u8*, 0),
        keys = slice::from_raw(
            null as K*,
            0
        ),
        values = slice::from_raw(
            null as V*,
            0
        ),
        count = 0,
        tombstones = 0,
    };
}

public Map(K, V, A) new_map(K, V, A)(A alloc) if AllocatorPolicy(A) {
    return {
        alloc = alloc,
        control = slice::from_raw(null as u8*, 0),
        keys = slice::from_raw(
            null as K*,
            0
        ),
        values = slice::from_raw(
            null as V*,
            0
        ),
        count = 0,
        tombstones = 0,
    };
}

public Result(Map(K, V), AllocError) with_capacity(K, V)(
    usize capacity
) {
    Map(K, V) self = new_map();
    self.ensure_capacity(capacity) ?;
    return Result::Ok(self);
}

public Result(Map(K, V, A), AllocError) with_capacity(K, V, A)(
    A alloc,
    usize capacity
) if AllocatorPolicy(A) {
    Map(K, V, A) self = new_map(alloc);
    self.ensure_capacity(capacity) ?;
    return Result::Ok(self);
}

/// releases the table. keys and values holding resources must be drained
/// through `iterate` first.
public void deinit(K, V, A)(Map(K, V, A)* self) if MapKey(K) {
    Map(K, V, A) b = *self;
    if b.control.len > 0 {
        b.alloc.free_slice(b.control);
        b.alloc.free_slice(b.keys);
        b.alloc.free_slice(b.values);
    }

    b.control = slice::from_raw(null as u8*, 0);
    b.keys = slice::from_raw(null as K*, 0);
    b.values = slice::from_raw(null as V*, 0);
    b.count = 0;
    b.tombstones = 0;
    *self = b;
}

//!
//! Queries
//!

public usize len(K, V, A)(const Map(K, V, A)* self) {
    Map(K, V, A) b = *self;
    return b.count;
}

public bool is_empty(K, V, A)(const Map(K, V, A)* self) {
    Map(K, V, A) b = *self;
    return b.count == 0;
}

public usize capacity(K, V, A)(const Map(K, V, A)* self) {
    Map(K, V, A) b = *self;
    return b.control.len;
}

//!
//! Probing
//!

u8 control_byte(u64 hash) {
    return 0x80 | ((hash >> 57) as u8);
}

/// index of `key` in the table, or None.
Optional(usize) find_slot(K, V, A)(const Map(K, V, A)* self, const K* key, u64 hash) {
    Map(K, V, A) b = *self;
    usize mask = b.control.len - 1;
    usize index = (hash as usize) & mask;
    u8 tag = control_byte(hash);

    usize probe = 0;
    while probe < b.control.len {
        u8 ctrl = b.control[index];

        if ctrl == CTRL_EMPTY {
            return Optional::None;
        }

        if ctrl == tag && hash::key_eq(&b.keys[index], key) {
            return Optional::Some(index);
        }

        index = (index + 1) & mask;
        probe++;
    }

    return Optional::None;
}

/// slot an insertion should occupy: the existing entry when present, else
/// the first empty or tombstoned slot on the probe chain.
usize find_insert_slot(K, V, A)(
    const Map(K, V, A)* self,
    const K* key,
    u64 hash,
    bool* replacing
) {
    Map(K, V, A) b = *self;
    usize mask = b.control.len - 1;
    usize index = (hash as usize) & mask;
    u8 tag = control_byte(hash);

    Optional(usize) first_free = Optional::None;

    usize probe = 0;
    while probe < b.control.len {
        u8 ctrl = b.control[index];

        if ctrl == CTRL_EMPTY {
            *replacing = false;
            return first_free.some_or(index);
        }

        if ctrl == CTRL_TOMB {
            if first_free.is_none() {
                first_free = Optional::Some(index);
            }
        } else if ctrl == tag && hash::key_eq(&b.keys[index], key) {
            *replacing = true;
            return index;
        }

        index = (index + 1) & mask;
        probe++;
    }

    *replacing = false;
    return first_free.some_or(0 as usize);
}

//!
//! Capacity
//!

public Status(AllocError) ensure_capacity(K, V, A)(Map(K, V, A)* self, usize wanted) {
    Map(K, V, A) b = *self;
    usize needed = math::max(wanted, MIN_CAPACITY);
    Optional(usize) extra = map_checked_add(needed / LOAD_NUM, 1);
    if extra.is_none() { return AllocError::OutOfMemory; }
    Optional(usize) required = map_checked_add(needed, extra.unwrap_some());
    if required.is_none() { return AllocError::OutOfMemory; }
    Optional(u64) rounded = map_checked_next_power_of_two(required.unwrap_some() as u64);
    if rounded.is_none() || rounded.unwrap_some() > (~(0 as usize)) as u64 { return AllocError::OutOfMemory; }
    usize target = rounded.unwrap_some() as usize;

    if b.control.len >= target && b.control.len > 0 {
        return Status::Ok;
    }

    *self = b;
    Status(AllocError) rh_st = rehash_into(self, target);
    if !rh_st.is_ok() {
        return rh_st.unwrap_err();
    }
    return Status::Ok;
}

Status(AllocError) rehash_into(K, V, A)(Map(K, V, A)* self, usize new_capacity) {
    Map(K, V, A) b = *self;
    if map_checked_mul(new_capacity, sizeof(K)).is_none()
        || map_checked_mul(new_capacity, sizeof(V)).is_none() { return AllocError::OutOfMemory; }
    [] u8 old_control = b.control;
    [] K old_keys = b.keys;
    [] V old_values = b.values;
    A alloc = b.alloc;

    Result([] u8, AllocError) control_r = alloc.allocate_zeroed_slice(new_capacity);
    if control_r.is_err() {
        return control_r.unwrap_err();
    }
    Result([] K, AllocError) keys_r = alloc.allocate_slice(new_capacity);
    if keys_r.is_err() {
        alloc.free_slice(control_r.unwrap());
        return keys_r.unwrap_err();
    }
    Result([] V, AllocError) values_r = alloc.allocate_slice(new_capacity);
    if values_r.is_err() {
        alloc.free_slice(keys_r.unwrap());
        alloc.free_slice(control_r.unwrap());
        return values_r.unwrap_err();
    }

    b.control = control_r.unwrap();
    b.keys = keys_r.unwrap();
    b.values = values_r.unwrap();
    b.count = 0;
    b.tombstones = 0;
    *self = b;

    usize i = 0;
    while i < old_control.len {
        if old_control[i] >= 0x80 {
            insert_unchecked(self, old_keys[i], old_values[i]);
        }
        i++;
    }

    if old_control.len > 0 {
        alloc.free_slice(old_control);
        alloc.free_slice(old_keys);
        alloc.free_slice(old_values);
    }

    return Status::Ok;
}

/// Places an entry known to be absent into a table known to have room.
void insert_unchecked(K, V, A)(Map(K, V, A)* self, K key, V value) {
    Map(K, V, A) b = *self;
    u64 hash = key.hash_of();
    usize mask = b.control.len - 1;
    usize index = (hash as usize) & mask;

    while b.control[index] >= 0x80 {
        index = (index + 1) & mask;
    }

    b.control[index] = control_byte(hash);
    b.keys[index] = key;
    b.values[index] = value;
    b.count++;
    *self = b;
}

bool needs_growth(K, V, A)(const Map(K, V, A)* self) {
    Map(K, V, A) b = *self;
    if b.control.len == 0 {
        return true;
    }

    usize threshold = b.control.len / LOAD_DEN * LOAD_NUM;
    return b.count >= threshold || b.tombstones >= threshold - b.count;
}

//!
//! Access
//!

/// inserts or replaces.
public Result(Optional(V), AllocError) put(K, V, A)(
    Map(K, V, A)* self,
    K key,
    V value
) {
    Map(K, V, A) b = *self;
    if needs_growth(&b) {
        Optional(usize) grown_capacity = map_checked_mul(b.control.len, 2);
        if grown_capacity.is_none() { return AllocError::OutOfMemory; }
        usize target = if b.control.len == 0 { MIN_CAPACITY } else { grown_capacity.unwrap_some() };
        *self = b;
        Status(AllocError) rh_st = rehash_into(self, target);
        if !rh_st.is_ok() {
            return rh_st.unwrap_err();
        }
        Map(K, V, A) grown = *self;
        Result(Optional(V), AllocError) again = put(&grown, key, value);
        *self = grown;
        return again;
    }

    u64 hash = key.hash_of();
    bool replacing = false;
    usize slot = find_insert_slot(&b, &key, hash, &replacing);

    if replacing {
        V previous = b.values[slot];
        b.values[slot] = value;
        *self = b;
        return Result::Ok(Optional::Some(previous));
    }

    if b.control[slot] == CTRL_TOMB {
        b.tombstones--;
    }

    b.control[slot] = control_byte(hash);
    b.keys[slot] = key;
    b.values[slot] = value;
    b.count++;
    *self = b;

    return Result::Ok(Optional::None);
}

public Optional(V) get(K, V, A)(const Map(K, V, A)* self, K key) {
    Map(K, V, A) b = *self;
    if b.control.len == 0 {
        return Optional::None;
    }

    Optional(usize) slot = find_slot(&b, &key, key.hash_of());
    return match slot {
        Optional::Some(i) => Optional::Some(b.values[i]),
        _ => Optional::None,
    };
}

/// pointer to the stored value. invalidated by any insertion that grows
/// the table.
public Optional(V*) get_ptr(K, V, A)(Map(K, V, A)* self, K key) {
    Map(K, V, A) b = *self;
    if b.control.len == 0 {
        return Optional::None;
    }

    Optional(usize) slot = find_slot(&b, &key, key.hash_of());
    return match slot {
        Optional::Some(i) => Optional::Some(&b.values[i]),
        _ => Optional::None,
    };
}

public bool contains(K, V, A)(const Map(K, V, A)* self, K key) {
    return self.get(key).is_some();
}

/// returns a pointer to the value for `key`, inserting `fallback` when
/// absent.
public Result(V*, AllocError) get_or_put(K, V, A)(
    Map(K, V, A)* self,
    K key,
    V fallback
) {
    Optional(V*) p = self.get_ptr(key);
    if p.is_some() {
        return Result::Ok(p.unwrap_some());
    }

    Result(Optional(V), AllocError) put_r = self.put(key, fallback);
    if put_r.is_err() {
        return put_r.unwrap_err();
    }
    Optional(V*) q = self.get_ptr(key);
    return Result::Ok(q.unwrap_some());
}

public Optional(V) remove(K, V, A)(Map(K, V, A)* self, K key) {
    Map(K, V, A) b = *self;
    if b.control.len == 0 {
        return Optional::None;
    }

    Optional(usize) slot = find_slot(&b, &key, key.hash_of());
    return match slot {
        Optional::Some(i) => {
            V value = b.values[i];
            b.control[i] = CTRL_TOMB;
            b.count--;
            b.tombstones++;
            *self = b;
            Optional::Some(value)
        },
        _ => Optional::None,
    };
}

/// empties the map without releasing its storage.
public void clear(K, V, A)(Map(K, V, A)* self) {
    Map(K, V, A) b = *self;
    mem::set(b.control, CTRL_EMPTY);
    b.count = 0;
    b.tombstones = 0;
    *self = b;
}

//!
//! Iteration
//!

public struct Iterator(K, V, A) {
    Map(K, V, A)* map;
    usize index;
}

public Iterator(K, V, A) iterate(K, V, A)(Map(K, V, A)* self) {
    return {map = self, index = 0};
}

public Optional(Entry(K, V)) next(K, V, A)(Iterator(K, V, A)* self) {
    Iterator(K, V, A) it = *self;
    Map(K, V, A) m = *it.map;
    while it.index < m.control.len {
        usize i = it.index;
        it.index++;

        if m.control[i] >= 0x80 {
            *self = it;
            return Optional::Some(
                {
                    key = &m.keys[i],
                    value = &m.values[i],
                }
            );
        }
    }

    *self = it;
    return Optional::None;
}

Optional(usize) map_checked_add(usize a, usize b) {
    if b > (~(0 as usize)) - a { return Optional::None; }
    return Optional::Some(a + b);
}

Optional(usize) map_checked_mul(usize a, usize b) {
    if a != 0 && b > (~(0 as usize)) / a { return Optional::None; }
    return Optional::Some(a * b);
}

result::Optional(u64) map_checked_next_power_of_two(u64 v) {
    if v > (1 as u64 << 63) { return result::Optional::None; }
    if v <= 1 { return result::Optional::Some(1 as u64); }
    return result::Optional::Some(1 as u64 << (64 - math::leading_zeros(v - 1)) as u64);
}
