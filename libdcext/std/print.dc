module std::print;

public using WritableInto(T) = compiles(T x, []const u8 bytes) {
    x.write(bytes);
};

public enum FormatArg {
    @implicit_construction Str([]const u8),
    @implicit_construction Int(i64),
    @implicit_construction Uint(u64),
    @implicit_construction Usize(usize),
}

void put(T)(T out, u8 c) if WritableInto(T) {
    u8[1] one;
    one[0] = c;
    out.write(one[0..1]);
}

public void newline(T)(T out) if WritableInto(T) {
    out.put(10 as u8);
}

usize decimal(u64 value, []u8 buf) {
    if value == 0 {
        buf[buf.len - 1] = '0' as u8;
        return 1;
    }

    usize n = 0;
    u64 v = value;
    while v > 0 {
        n += 1;
        buf[buf.len - n] = ('0' as u8) + (v % 10) as u8;
        v /= 10;
    }

    return n;
}

usize hexadecimal(u64 value, []u8 buf) {
    if value == 0 {
        buf[buf.len - 1] = '0' as u8;
        return 1;
    }

    usize n = 0;
    u64 v = value;
    while v > 0 {
        u64 digit = v % 16;
        n += 1;
        buf[buf.len - n] = if digit < 10 { ('0' as u8) + digit as u8 } else { ('a' as u8) + (digit - 10) as u8 };
        v /= 16;
    }

    return n;
}

public void print(T)(T out, u64 value) if WritableInto(T) {
    u8[20] buf;
    usize n = decimal(value, buf[0..20]);
    out.write(buf[20 - n..20]);
}

public void print_hex(T)(T out, u64 value) if WritableInto(T) {
    u8[16] buf;
    usize n = hexadecimal(value, buf[0..16]);
    out.write(buf[16 - n..16]);
}

public void print(T)(T out, i64 value) if WritableInto(T) {
    u64 magnitude = if value < 0 { 0 - value as u64 } else { value as u64 };

    u8[21] buf;
    usize n = decimal(magnitude, buf[0..21]);
    if value < 0 {
        n += 1;
        buf[21 - n] = '-' as u8;
    }

    out.write(buf[21 - n..21]);
}

void format_one(T)(T out, FormatArg arg, u8 spec_kind) if WritableInto(T) {
    match arg {
        FormatArg::Str(s) => {
            out.write(s);
        },
        FormatArg::Int(value) => {
            if spec_kind == ('x' as u8) {
                if value < 0 {
                    out.put('-' as u8);
                }

                out.print_hex(if value < 0 { 0 - value as u64 } else { value as u64 });
            } else if spec_kind == ('u' as u8) {
                out.print(value as u64);
            } else {
                out.print(value);
            }
        },
        FormatArg::Uint(value) => {
            if spec_kind == ('x' as u8) {
                out.print_hex(value);
            } else if spec_kind == ('d' as u8) {
                out.print(value as i64);
            } else {
                out.print(value);
            }
        },
        FormatArg::Usize(value) => {
            if spec_kind == ('x' as u8) {
                out.print_hex(value as u64);
            } else if spec_kind == ('d' as u8) {
                out.print(value as i64);
            } else {
                out.print(value as u64);
            }
        },
    }
}

u8 read_spec([]const u8 fmt, usize spec_start, usize spec_len) {
    if spec_len == 0 {
        return 0;
    }

    u8 sc = fmt[spec_start];
    if sc == ('d' as u8) {
        return 'd' as u8;
    }

    if sc == ('u' as u8) {
        return 'u' as u8;
    }

    if sc == ('x' as u8) {
        return 'x' as u8;
    }

    return 0;
}

void emit_arg(T)(T out, []const FormatArg args, usize arg_idx, u8 kind) if WritableInto(T) {
    if arg_idx < args.len {
        out.format_one(args[arg_idx], kind);
    } else {
        out.write("<missing>");
    }
}

void format_impl(T)(T out, []const u8 fmt, []const FormatArg args) if WritableInto(T) {
    usize arg_idx = 0;
    usize i = 0;

    while i < fmt.len {
        u8 c = fmt[i];

        if c == ('{' as u8) {
            if i + 1 < fmt.len {
                if fmt[i + 1] == ('{' as u8) {
                    out.put(c);
                    i = i + 2;
                    continue;
                }
            }

            usize spec_start = i + 1;
            i = i + 1;
            while i < fmt.len {
                if fmt[i] == ('}' as u8) {
                    break;
                }

                i = i + 1;
            }

            if i >= fmt.len {
                out.put('{' as u8);
                out.write(fmt[spec_start..fmt.len]);
                return;
            }

            usize spec_len = i - spec_start;
            u8 kind = read_spec(fmt, spec_start, spec_len);

            i = i + 1;

            out.emit_arg(args, arg_idx, kind);
            arg_idx = arg_idx + 1;

        } else if c == ('}' as u8) {
            if i + 1 < fmt.len {
                if fmt[i + 1] == ('}' as u8) {
                    out.put(c);
                    i = i + 2;
                    continue;
                }
            }

            out.put(c);
            i = i + 1;
        } else {
            out.put(c);
            i = i + 1;
        }
    }
}

public void print(T)(T out, []const u8 msg) if WritableInto(T) {
    FormatArg[0] empty;
    out.format_impl(msg, empty);
}

public void println(T)(T out, []const u8 msg) if WritableInto(T) {
    FormatArg[0] empty;
    out.format_impl(msg, empty);
    out.newline();
}

public void print_fmt(T)(T out, []const u8 fmt, []const FormatArg args) if WritableInto(T) {
    out.format_impl(fmt, args);
}

public void println_fmt(T)(T out, []const u8 fmt, []const FormatArg args) if WritableInto(T) {
    out.format_impl(fmt, args);
    out.newline();
}
