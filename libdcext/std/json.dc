//!!
//!! JSON
//!!
//!! Three layers. `Scanner` is a pull parser that allocates nothing and
//!! hands back slices of the input. `Document` is an owned tree that
//!! stores its allocator by value, so `deinit` can release it. `parse`
//!! returns a document and copies every string; `parse_borrowed` returns
//!! the bare `Value` and borrows the input wherever it can.
//!!

module std::json;

import core;
import core::allocator_config;
import core::target;
import std::alloc;
import std::fmt;
import std::mem;
import std::slice;
import std::utf8;
public import std::parse;
public import std::result;

using result::{ Result, Status, Optional };
using alloc::AllocatorPolicy;
using parse::{ Position, Located, NumError };

//!
//! Errors
//!

public enum JsonError : u8 {
    UnexpectedByte,
    UnexpectedEnd,
    InvalidNumber,
    NumberOutOfRange,
    InvalidEscape,
    InvalidUtf8,
    ControlCharacter,
    DepthExceeded,
    TrailingBytes,
    OutOfSpace,
    OutOfMemory,
    TypeMismatch,
}

//!
//! Events
//!
//! An object member arrives as a `Key` followed by its value, so a
//! consumer that only cares about one field can skip the rest without
//! building anything.
//!

static if core::target::FLOAT_AVAILABLE {
    public enum Event {
        ObjectBegin,
        ObjectEnd,
        ArrayBegin,
        ArrayEnd,
        /// borrows the input unless `needs_unescape` is set on the scanner
        Key([] const char),
        String([] const char),
        Integer(i64),
        Float(f64),
        Bool(bool),
        Null,
        End,
    }
} else {
    public enum Event {
        ObjectBegin,
        ObjectEnd,
        ArrayBegin,
        ArrayEnd,
        /// borrows the input unless `needs_unescape` is set on the scanner
        Key([] const char),
        String([] const char),
        Integer(i64),
        Bool(bool),
        Null,
        End,
    }
}

//!
//! Scanner
//!
//! Nesting is bounded by the frame buffer rather than by recursion, so a
//! hostile input costs memory it cannot have rather than stack it can.
//!

public using usize MAX_DEPTH = 64;

using u8 FRAME_OBJECT = 1;
using u8 FRAME_SEEN = 2;
using u8 FRAME_AFTER_KEY = 4;

public struct Scanner {
    [] const char input;
    Position at;
    u8[64] frames;
    usize depth;
    /// set for the string or key just yielded. read it before the next
    /// call; it is overwritten by every event.
    bool needs_unescape;
    bool complete;
}

public Scanner scan([] const char input) {
    Scanner self;
    self.input = input;
    self.at = Position::start();
    self.depth = 0;
    self.needs_unescape = false;
    self.complete = false;
    return self;
}

bool at_end(const Scanner* self) {
    return self.at.offset >= self.input.len;
}

char peek(const Scanner* self) {
    return self.input[self.at.offset];
}

char take(Scanner* self) {
    char b = self.input[self.at.offset];
    parse::advance(&self.at, b);
    return b;
}

void skip_space(Scanner* self) {
    while !at_end(self) {
        char c = peek(self);

        if c != (' ' as char) && c != ('\t' as char) && c != ('\n' as char) && c != ('\r' as char) {
            return;
        }

        take(self);
    }
}

Status(JsonError) expect(Scanner* self, char wanted) {
    if at_end(self) {
        return JsonError::UnexpectedEnd;
    }

    if peek(self) != wanted {
        return JsonError::UnexpectedByte;
    }

    take(self);
    return Status::Ok;
}

Status(JsonError) expect_word(Scanner* self, [] const char word) {
    for usize i = 0; i < word.len; i++ {
        if at_end(self) {
            return JsonError::UnexpectedEnd;
        }

        if take(self) != word[i] {
            return JsonError::UnexpectedByte;
        }
    }

    return Status::Ok;
}

//!
//! Strings
//!
//! Validation happens here rather than in `unescape` so that a malformed
//! escape is reported with the position it occupies, and so a consumer
//! that never unescapes still rejects bad input.
//!

Status(JsonError) check_hex4(Scanner* self, u32* out) {
    u32 value = 0;

    for usize i = 0; i < 4; i++ {
        if at_end(self) {
            return JsonError::UnexpectedEnd;
        }

        u32 digit = parse::hex_value(take(self));
        if digit == 16 {
            return JsonError::InvalidEscape;
        }

        value = (value << 4) | digit;
    }

    *out = value;
    return Status::Ok;
}

Status(JsonError) check_escape(Scanner* self) {
    if at_end(self) {
        return JsonError::UnexpectedEnd;
    }

    char c = take(self);

    if c == ('"' as char)
        || c == ('\\' as char)
        || c == ('/' as char)
        || c == ('b' as char)
        || c == ('f' as char)
        || c == ('n' as char)
        || c == ('r' as char)
        || c == ('t' as char)
    {
        return Status::Ok;
    }

    if c != ('u' as char) {
        return JsonError::InvalidEscape;
    }

    u32 high = 0;
    check_hex4(self, &high) ?;

    if high >= 0xDC00 && high <= 0xDFFF {
        // a low surrogate with nothing before it
        return JsonError::InvalidEscape;
    }

    if high < 0xD800 || high > 0xDBFF {
        return Status::Ok;
    }

    expect(self, '\\' as char) ?;
    expect(self, 'u' as char) ?;

    u32 low = 0;
    check_hex4(self, &low) ?;

    if low < 0xDC00 || low > 0xDFFF {
        return JsonError::InvalidEscape;
    }

    return Status::Ok;
}

/// reads to the closing quote, with the opening one already consumed.
Result([] const char, JsonError) read_string_body(Scanner* self) {
    usize start = self.at.offset;
    self.needs_unescape = false;

    while true {
        if at_end(self) {
            return JsonError::UnexpectedEnd;
        }

        char c = peek(self);

        if c == ('"' as char) {
            usize end = self.at.offset;
            take(self);
            return Result::Ok(self.input[start..end]);
        }

        if (c as u8) < 0x20 {
            return JsonError::ControlCharacter;
        }

        if c == ('\\' as char) {
            take(self);
            self.needs_unescape = true;
            check_escape(self) ?;
            continue;
        }

        if (c as u8) < 0x80 {
            take(self);
            continue;
        }

        Result(utf8::Decoded, utf8::Utf8Error) decoded = utf8::decode(
            self.input[self.at.offset..self.input.len]
        );
        if decoded.is_err() {
            return JsonError::InvalidUtf8;
        }

        usize width = decoded.unwrap().width;
        for usize i = 0; i < width; i++ {
            take(self);
        }
    }
}

//!
//! Numbers
//!
//! A token with no fraction and no exponent is an `Integer`; anything
//! else is a `Float`. Collapsing the two would mean handing back 3.0 for
//! 3 and making every caller cast it back, which is the silent
//! conversion this language exists to avoid.
//!

Result(i64, JsonError) to_integer([] const char text) {
    usize i = 0;
    bool negative = false;

    if text[0] == ('-' as char) {
        negative = true;
        i = 1;
    }

    usize count = 0;
    Result(u64, NumError) magnitude = parse::accumulate_digits(
        text,
        &i,
        10,
        false,
        &count
    );
    if magnitude.is_err() {
        if magnitude.unwrap_err() == NumError::OutOfRange {
            return JsonError::NumberOutOfRange;
        }

        return JsonError::InvalidNumber;
    }

    Result(i64, NumError) value = parse::signed_from_magnitude(
        magnitude.unwrap(),
        negative
    );
    if value.is_err() {
        return JsonError::NumberOutOfRange;
    }

    return Result::Ok(value.unwrap());
}

using usize MANTISSA_DIGITS = 19;

static if core::target::FLOAT_AVAILABLE {
    Result(f64, JsonError) to_float([] const char text) {
        usize i = 0;
        bool negative = false;

        if text[0] == ('-' as char) {
            negative = true;
            i = 1;
        }

        u64 mantissa = 0;
        usize taken = 0;
        i32 exponent = 0;

        while i < text.len && parse::is_digit(text[i]) {
            if taken < MANTISSA_DIGITS {
                mantissa = mantissa * 10 + (text[i] as u32 - ('0' as u32)) as u64;
                taken++;
            } else {
                // past the precision f64 can hold; keep the magnitude only
                exponent = exponent + 1;
            }

            i++;
        }

        if i < text.len && text[i] == ('.' as char) {
            i++;

            while i < text.len && parse::is_digit(text[i]) {
                if taken < MANTISSA_DIGITS {
                    mantissa = mantissa * 10 + (text[i] as u32 - ('0' as u32)) as u64;
                    taken++;
                    exponent = exponent - 1;
                }

                i++;
            }
        }

        if i < text.len && (text[i] == ('e' as char) || text[i] == ('E' as char)) {
            i++;

            bool negative_exponent = false;
            if i < text.len && (text[i] == ('+' as char) || text[i] == ('-' as char)) {
                negative_exponent = text[i] == ('-' as char);
                i++;
            }

            i32 written = 0;
            while i < text.len && parse::is_digit(text[i]) {
                // clamp rather than wrap: anything past this overflows or
                // underflows the result regardless of the exact value
                if written < 100000 {
                    written = written * 10 + (text[i] as u32 - ('0' as u32)) as i32;
                }

                i++;
            }

            exponent = exponent + if negative_exponent {
                0 - written
            } else {
                written
            };
        }

        Result(f64, NumError) value = parse::float_from_parts(
            mantissa,
            exponent,
            negative
        );
        if value.is_err() {
            return JsonError::NumberOutOfRange;
        }

        return Result::Ok(value.unwrap());
    }
}

Result(Event, JsonError) read_number(Scanner* self) {
    usize start = self.at.offset;
    bool is_float = false;

    if peek(self) == ('-' as char) {
        take(self);
    }

    if at_end(self) {
        return JsonError::UnexpectedEnd;
    }

    if peek(self) == ('0' as char) {
        take(self);

        if !at_end(self) && parse::is_digit(peek(self)) {
            return JsonError::InvalidNumber;
        }
    } else if parse::is_digit(peek(self)) {
        while !at_end(self) && parse::is_digit(peek(self)) {
            take(self);
        }
    } else {
        return JsonError::InvalidNumber;
    }

    if !at_end(self) && peek(self) == ('.' as char) {
        take(self);
        is_float = true;

        if at_end(self) || !parse::is_digit(peek(self)) {
            return JsonError::InvalidNumber;
        }

        while !at_end(self) && parse::is_digit(peek(self)) {
            take(self);
        }
    }

    if !at_end(self) && (peek(self) == ('e' as char) || peek(self) == ('E' as char)) {
        take(self);
        is_float = true;

        if !at_end(self) && (peek(self) == ('+' as char) || peek(self) == ('-' as char)) {
            take(self);
        }

        if at_end(self) || !parse::is_digit(peek(self)) {
            return JsonError::InvalidNumber;
        }

        while !at_end(self) && parse::is_digit(peek(self)) {
            take(self);
        }
    }

    [] const char text = self.input[start..self.at.offset];

    if is_float {
        static if core::target::FLOAT_AVAILABLE {
            return Result::Ok(Event::Float(to_float(text) ?));
        } else {
            return JsonError::InvalidNumber;
        }
    }

    return Result::Ok(Event::Integer(to_integer(text) ?));
}

//!
//! Dispatch
//!

Status(JsonError) push_frame(Scanner* self, u8 flags) {
    if self.depth >= MAX_DEPTH {
        return JsonError::DepthExceeded;
    }

    self.frames[self.depth] = flags;
    self.depth = self.depth + 1;
    return Status::Ok;
}

void pop_frame(Scanner* self) {
    self.depth = self.depth - 1;

    if self.depth == 0 {
        self.complete = true;
    }
}

Result(Event, JsonError) read_value(Scanner* self) {
    if at_end(self) {
        return JsonError::UnexpectedEnd;
    }

    char c = peek(self);

    if c == ('{' as char) {
        take(self);
        push_frame(self, FRAME_OBJECT) ?;
        return Result::Ok(Event::ObjectBegin);
    }

    if c == ('[' as char) {
        take(self);
        push_frame(self, 0) ?;
        return Result::Ok(Event::ArrayBegin);
    }

    if c == ('"' as char) {
        take(self);
        return Result::Ok(Event::String(read_string_body(self) ?));
    }

    if c == ('t' as char) {
        expect_word(self, "true") ?;
        return Result::Ok(Event::Bool(true));
    }

    if c == ('f' as char) {
        expect_word(self, "false") ?;
        return Result::Ok(Event::Bool(false));
    }

    if c == ('n' as char) {
        expect_word(self, "null") ?;
        return Result::Ok(Event::Null);
    }

    if c == ('-' as char) || parse::is_digit(c) {
        return read_number(self);
    }

    return JsonError::UnexpectedByte;
}

/// yields the next event. `End` is returned once the top-level value is
/// complete and only whitespace remains; anything else after it is
/// `TrailingBytes`.
public Result(Located(Event), JsonError) next(Scanner* self) {
    skip_space(self);
    Position here = self.at;

    if self.depth == 0 {
        if self.complete {
            if !at_end(self) {
                return JsonError::TrailingBytes;
            }

            return Result::Ok({event = Event::End, at = here});
        }

        Event first = read_value(self) ?;
        if self.depth == 0 {
            self.complete = true;
        }

        return Result::Ok({event = first, at = here});
    }

    u8 frame = self.frames[self.depth - 1];

    if (frame & FRAME_OBJECT) != 0 && (frame & FRAME_AFTER_KEY) == 0 {
        if at_end(self) {
            return JsonError::UnexpectedEnd;
        }

        if peek(self) == ('}' as char) {
            take(self);
            pop_frame(self);
            return Result::Ok({event = Event::ObjectEnd, at = here});
        }

        if (frame & FRAME_SEEN) != 0 {
            expect(self, ',' as char) ?;
            skip_space(self);
            here = self.at;
        }

        expect(self, '"' as char) ?;
        [] const char key = read_string_body(self) ?;

        skip_space(self);
        expect(self, ':' as char) ?;

        self.frames[self.depth - 1] = frame | FRAME_AFTER_KEY | FRAME_SEEN;
        return Result::Ok({event = Event::Key(key), at = here});
    }

    if (frame & FRAME_OBJECT) != 0 {
        self.frames[self.depth - 1] = frame & ~FRAME_AFTER_KEY;
        Event value = read_value(self) ?;
        return Result::Ok({event = value, at = here});
    }

    if at_end(self) {
        return JsonError::UnexpectedEnd;
    }

    if peek(self) == (']' as char) {
        take(self);
        pop_frame(self);
        return Result::Ok({event = Event::ArrayEnd, at = here});
    }

    if (frame & FRAME_SEEN) != 0 {
        expect(self, ',' as char) ?;
        skip_space(self);
        here = self.at;
    }

    self.frames[self.depth - 1] = frame | FRAME_SEEN;
    Event element = read_value(self) ?;
    return Result::Ok({event = element, at = here});
}

//!
//! Unescaping
//!
//! Every escape shrinks: `\n` is two bytes for one, `\uFFFF` six for
//! three, a surrogate pair twelve for four. So the raw slice's own length
//! is always a sufficient output bound.
//!

usize read_hex4([] const char raw, usize at, u32* out) {
    u32 value = 0;

    for usize i = 0; i < 4; i++ {
        value = (value << 4) | parse::hex_value(raw[at + i]);
    }

    *out = value;
    return at + 4;
}

/// decodes `raw` into `out`, returning the bytes written. only needed
/// when the scanner set `needs_unescape` for the event.
public Result(usize, JsonError) unescape([] const char raw, [] char out) {
    usize i = 0;
    usize n = 0;

    while i < raw.len {
        char c = raw[i];

        if c != ('\\' as char) {
            if n >= out.len {
                return JsonError::OutOfSpace;
            }

            out[n] = c;
            n++;
            i++;
            continue;
        }

        i++;
        if i >= raw.len {
            return JsonError::InvalidEscape;
        }

        char kind = raw[i];
        i++;

        if kind != ('u' as char) {
            char plain = match kind as char {
                '"' => '"' as char,
                '\\' => '\\' as char,
                '/' => '/' as char,
                'b' => '\x08',
                'f' => '\x0c',
                'n' => '\n' as char,
                'r' => '\r' as char,
                't' => '\t' as char,
                _ => '\0',
            };

            if plain == '\0' {
                return JsonError::InvalidEscape;
            }

            if n >= out.len {
                return JsonError::OutOfSpace;
            }

            out[n] = plain;
            n++;
            continue;
        }

        if i + 4 > raw.len {
            return JsonError::InvalidEscape;
        }

        u32 codepoint = 0;
        i = read_hex4(raw, i, &codepoint);

        if codepoint >= 0xD800 && codepoint <= 0xDBFF {
            if i + 6 > raw.len {
                return JsonError::InvalidEscape;
            }

            if raw[i] != ('\\' as char) || raw[i + 1] != ('u' as char) {
                return JsonError::InvalidEscape;
            }

            u32 low = 0;
            i = read_hex4(raw, i + 2, &low);

            if low < 0xDC00 || low > 0xDFFF {
                return JsonError::InvalidEscape;
            }

            codepoint = 0x10000
            + ((codepoint - 0xD800) << 10)
            + (low - 0xDC00);
        } else if codepoint >= 0xDC00 && codepoint <= 0xDFFF {
            return JsonError::InvalidEscape;
        }

        Result(usize, utf8::Utf8Error) wrote = utf8::encode(
            codepoint,
            out[n..out.len]
        );
        if wrote.is_err() {
            return JsonError::OutOfSpace;
        }

        n = n + wrote.unwrap();
    }

    return Result::Ok(n);
}

//!
//! Value tree
//!

public struct Member {
    [] const char key;
    Value value;
}

static if core::target::FLOAT_AVAILABLE {
    public enum Value {
        Null,
        Bool(bool),
        Integer(i64),
        Float(f64),
        String([] const char),
        Array([] Value),
        Object([] Member),
    }
} else {
    public enum Value {
        Null,
        Bool(bool),
        Integer(i64),
        String([] const char),
        Array([] Value),
        Object([] Member),
    }
}

//!
//! Owned document
//!
//! stores the allocator by value, so a zero-size policy adds nothing.
//! every string in `root` is owned, which is what makes `deinit` and
//! `clone` well defined.
//!

public struct Document(A = DefaultAllocator) if AllocatorPolicy(A) {
    A alloc;
    Value root;
}

//!
//! Growable storage
//!
//! Two concrete vectors rather than one template: the element types are
//! the only difference and the instantiation machinery is not worth the
//! coupling here.
//!

struct ValueVec {
    [] Value items;
    usize len;
}

struct MemberVec {
    [] Member items;
    usize len;
}

using usize VEC_MIN = 8;

Status(JsonError) push_value(A)(
    A* alloc,
    ValueVec* self,
    Value value
) if AllocatorPolicy(A) {
    if self.len == self.items.len {
        Optional(usize) doubled = json_checked_mul(self.items.len, 2);
        if doubled.is_none() { return JsonError::OutOfMemory; }
        usize want = if self.items.len == 0 { VEC_MIN } else { doubled.unwrap_some() };

        Result([] Value, mem::AllocError) grown = alloc.allocate_slice(want);
        if grown.is_err() {
            return if grown.unwrap_err() == mem::AllocError::OutOfMemory { JsonError::OutOfMemory } else { JsonError::OutOfMemory };
        }

        [] Value fresh = grown.unwrap();
        for usize i = 0; i < self.len; i++ {
            fresh[i] = self.items[i];
        }

        if self.items.len != 0 {
            alloc.free_slice(self.items);
        }

        self.items = fresh;
    }

    self.items[self.len] = value;
    self.len = self.len + 1;
    return Status::Ok;
}

Status(JsonError) push_member(A)(
    A* alloc,
    MemberVec* self,
    Member member
) if AllocatorPolicy(A) {
    if self.len == self.items.len {
        Optional(usize) doubled = json_checked_mul(self.items.len, 2);
        if doubled.is_none() { return JsonError::OutOfMemory; }
        usize want = if self.items.len == 0 { VEC_MIN } else { doubled.unwrap_some() };

        Result([] Member, mem::AllocError) grown = alloc.allocate_slice(want);
        if grown.is_err() {
            return if grown.unwrap_err() == mem::AllocError::OutOfMemory { JsonError::OutOfMemory } else { JsonError::OutOfMemory };
        }

        [] Member fresh = grown.unwrap();
        for usize i = 0; i < self.len; i++ {
            fresh[i] = self.items[i];
        }

        if self.items.len != 0 {
            alloc.free_slice(self.items);
        }

        self.items = fresh;
    }

    self.items[self.len] = member;
    self.len = self.len + 1;
    return Status::Ok;
}

//!
//! Building
//!

/// decodes an escaped string into `alloc` and copies an unescaped one
/// when `copy_all` is set. must be called before the next `next`, which
/// overwrites the scanner's `needs_unescape`.
Result([] const char, JsonError) materialize(A)(
    A* alloc,
    const Scanner* self,
    [] const char raw,
    bool copy_all
) if AllocatorPolicy(A) {
    if self.needs_unescape {
        Result([] char, mem::AllocError) slot = alloc.allocate_slice(raw.len);
        if slot.is_err() {
            return JsonError::OutOfMemory;
        }

        [] char buffer = slot.unwrap();
        usize n = unescape(raw, buffer) ?;
        return Result::Ok(buffer[0..n] as [] const char);
    }

    if !copy_all {
        return Result::Ok(raw);
    }

    Result([] char, mem::AllocError) copied = alloc.duplicate_slice(raw);
    if copied.is_err() {
        return JsonError::OutOfMemory;
    }

    return Result::Ok(copied.unwrap() as [] const char);
}

Result(Value, JsonError) build_array(A)(
    A* alloc,
    Scanner* self,
    bool copy_all
) if AllocatorPolicy(A) {
    ValueVec items = {items = slice::from_raw(null as Value*, 0), len = 0};

    while true {
        Located(Event) step = next(self) ?;

        match step.event {
            Event::ArrayEnd => return Result::Ok(
                Value::Array(items.items[0..items.len])
            ),
            _ => {},
        }

        Value element = build(alloc, self, step.event, copy_all) ?;
        push_value(alloc, &items, element) ?;
    }
}

Result(Value, JsonError) build_object(A)(
    A* alloc,
    Scanner* self,
    bool copy_all
) if AllocatorPolicy(A) {
    MemberVec members = {items = slice::from_raw(null as Member*, 0), len = 0};

    while true {
        Located(Event) step = next(self) ?;

        [] const char raw = match step.event {
            Event::ObjectEnd => return Result::Ok(
                Value::Object(members.items[0..members.len])
            ),
            Event::Key(k) => k,
            _ => return JsonError::UnexpectedByte,
        };

        [] const char key = materialize(alloc, self, raw, copy_all) ?;

        Located(Event) value_event = next(self) ?;
        Value value = build(alloc, self, value_event.event, copy_all) ?;

        push_member(alloc, &members, Member {key = key, value = value}) ?;
    }
}

Result(Value, JsonError) build(A)(
    A* alloc,
    Scanner* self,
    Event event,
    bool copy_all
) if AllocatorPolicy(A) {
    static if core::target::FLOAT_AVAILABLE {
        return match event {
            Event::Null => Result::Ok(Value::Null),
            Event::Bool(b) => Result::Ok(Value::Bool(b)),
            Event::Integer(v) => Result::Ok(Value::Integer(v)),
            Event::Float(v) => Result::Ok(Value::Float(v)),
            Event::String(raw) => {
                Result([] const char, JsonError) text = materialize(alloc, self, raw, copy_all);
                if text.is_err() {
                    return text.unwrap_err();
                }
                Result::Ok(Value::String(text.unwrap()))
            },
            Event::ArrayBegin => build_array(alloc, self, copy_all),
            Event::ObjectBegin => build_object(alloc, self, copy_all),
            _ => Result::Err(JsonError::UnexpectedByte),
        };
    } else {
        return match event {
            Event::Null => Result::Ok(Value::Null),
            Event::Bool(b) => Result::Ok(Value::Bool(b)),
            Event::Integer(v) => Result::Ok(Value::Integer(v)),
            Event::String(raw) => {
                Result([] const char, JsonError) text = materialize(alloc, self, raw, copy_all);
                if text.is_err() {
                    return text.unwrap_err();
                }
                Result::Ok(Value::String(text.unwrap()))
            },
            Event::ArrayBegin => build_array(alloc, self, copy_all),
            Event::ObjectBegin => build_object(alloc, self, copy_all),
            _ => Result::Err(JsonError::UnexpectedByte),
        };
    }
}

Result(Value, JsonError) parse_value(A)(
    A* alloc,
    [] const char input,
    bool copy_all
) if AllocatorPolicy(A) {
    Scanner self = scan(input);

    Located(Event) first = next(&self) ?;
    Value root = build(alloc, &self, first.event, copy_all) ?;

    Located(Event) tail = next(&self) ?;
    match tail.event {
        Event::End => {},
        _ => return JsonError::TrailingBytes,
    }

    return Result::Ok(root);
}

/// parses one document and copies every string into `alloc`, so the
/// result depends on the allocator alone. the document stores `alloc` by
/// value and `deinit` releases the whole tree.
public Result(Document(A), JsonError) parse(A)(
    A alloc,
    [] const char input
) if AllocatorPolicy(A) {
    Result(Value, JsonError) root = parse_value(&alloc, input, true);
    if root.is_err() {
        return root.unwrap_err();
    }

    Document(A) document = {alloc = alloc, root = root.unwrap()};
    return Result::Ok(document);
}

/// parses with the selected default allocator.
public Result(Document(A), JsonError) parse(A = DefaultAllocator)(
    [] const char input
) if AllocatorPolicy(A) {
    A alloc = {};
    return parse(alloc, input);
}

/// parses one document into a `Value` whose strings borrow `input` unless
/// they carried an escape. nothing records the allocator, so the caller
/// keeps it alive for the escaped strings and for `own`.
public Result(Value, JsonError) parse_borrowed(A)(
    A alloc,
    [] const char input
) if AllocatorPolicy(A) {
    return parse_value(&alloc, input, false);
}

/// copies every borrowed string into `alloc`, so the result depends on
/// the allocator alone. use it when the input buffer is about to go away.
public Result(Value, JsonError) own(A)(
    A* alloc,
    const Value* self
) if AllocatorPolicy(A) {
    return match *self {
        Value::String(text) => {
            Result([] char, mem::AllocError) slot = alloc.duplicate_slice(text);
            if slot.is_err() {
                return JsonError::OutOfMemory;
            }
            Result::Ok(Value::String(slot.unwrap() as [] const char))
        },
        Value::Array(items) => {
            Result([] Value, mem::AllocError) slot = alloc.allocate_slice(items.len);
            if slot.is_err() {
                return JsonError::OutOfMemory;
            }
            [] Value copied = slot.unwrap();
            for usize i = 0; i < items.len; i++ {
                Result(Value, JsonError) element = own(alloc, &items[i]);
                if element.is_err() {
                    return element.unwrap_err();
                }
                copied[i] = element.unwrap();
            }
            Result::Ok(Value::Array(copied))
        },
        Value::Object(members) => {
            Result([] Member, mem::AllocError) slot = alloc.allocate_slice(members.len);
            if slot.is_err() {
                return JsonError::OutOfMemory;
            }
            [] Member copied = slot.unwrap();
            for usize i = 0; i < members.len; i++ {
                Result([] char, mem::AllocError) key = alloc.duplicate_slice(members[i].key);
                if key.is_err() {
                    return JsonError::OutOfMemory;
                }
                Result(Value, JsonError) value = own(alloc, &members[i].value);
                if value.is_err() {
                    return value.unwrap_err();
                }
                copied[i] = Member {
                    key = key.unwrap() as [] const char,
                    value = value.unwrap(),
                };
            }
            Result::Ok(Value::Object(copied))
        },
        _ => Result::Ok(*self),
    };
}

//!
//! Document ownership
//!

/// releases the tree and empties the document. safe on the empty state and
/// safe to call twice.
public void deinit(A)(Document(A)* self) if AllocatorPolicy(A) {
    A alloc = self.alloc;
    free_value(&alloc, &self.root);
    self.root = Value::Null;
}

/// moves the tree out and leaves the document empty.
public Document(A) take(A)(Document(A)* self) if AllocatorPolicy(A) {
    Document(A) moved = *self;
    self.root = Value::Null;
    return moved;
}

/// copies the tree into freshly allocated storage of the same policy.
public Result(Document(A), JsonError) clone(A)(
    const Document(A)* self
) if AllocatorPolicy(A) {
    A alloc = self.alloc;
    Result(Value, JsonError) copied = own(&alloc, &self.root);
    if copied.is_err() {
        return copied.unwrap_err();
    }

    Document(A) out = {alloc = alloc, root = copied.unwrap()};
    return Result::Ok(out);
}

void free_value(A)(A* alloc, const Value* self) if AllocatorPolicy(A) {
    match *self {
        Value::String(text) => {
            alloc.free_slice(text as [] char);
        },
        Value::Array(items) => {
            for usize i = 0; i < items.len; i++ {
                free_value(alloc, &items[i]);
            }
            alloc.free_slice(items);
        },
        Value::Object(members) => {
            for usize i = 0; i < members.len; i++ {
                alloc.free_slice(members[i].key as [] char);
                free_value(alloc, &members[i].value);
            }
            alloc.free_slice(members);
        },
        _ => {},
    };
}

//!
//! Access
//!
//! Lookup is linear. Documents in this library's usual company have tens
//! of members, and insertion order is worth more than the lookup a map
//! would save.
//!

public Optional(Value) get(const Value* self, [] const char key) {
    return match *self {
        Value::Object(members) => {
            for usize i = 0; i < members.len; i++ {
                if mem::equal(members[i].key, key) {
                    return Optional::Some(members[i].value);
                }
            }
            Optional::None
        },
        _ => Optional::None,
    };
}

public Optional(Value) at(const Value* self, usize index) {
    return match *self {
        Value::Array(items) => if index < items.len {
            Optional::Some(items[index])
        } else {
            Optional::None
        },
        _ => Optional::None,
    };
}

public usize len(const Value* self) {
    return match *self {
        Value::Array(items) => items.len,
        Value::Object(members) => members.len,
        _ => 0,
    };
}

public Optional(i64) as_integer(const Value* self) {
    return match *self {
        Value::Integer(v) => Optional::Some(v),
        _ => Optional::None,
    };
}

/// an `Integer` widens here, since every i64 a document can carry is
/// representable; a `Float` never narrows the other way.
static if core::target::FLOAT_AVAILABLE {
    public Optional(f64) as_float(const Value* self) {
        return match *self {
            Value::Float(v) => Optional::Some(v),
            Value::Integer(v) => Optional::Some(v as f64),
            _ => Optional::None,
        };
    }
}

public Optional(bool) as_bool(const Value* self) {
    return match *self {
        Value::Bool(v) => Optional::Some(v),
        _ => Optional::None,
    };
}

public Optional([] const char) as_string(const Value* self) {
    return match *self {
        Value::String(v) => Optional::Some(v),
        _ => Optional::None,
    };
}

public bool is_null(const Value* self) {
    return match *self {
        Value::Null => true,
        _ => false,
    };
}

//!
//! Emitting
//!
//! Over `fmt::Writer`, so a file, a buffer and a byte counter all work
//! without this module knowing which it has.
//!

public struct Emitter {
    fmt::Writer out;
    /// spaces per level; 0 emits compact output with no newlines
    u32 indent;
    usize depth;
    bool need_comma;
    bool suppress_separator;
}

public Emitter new_emitter(fmt::Writer out, u32 indent) {
    return {
        out = out,
        indent = indent,
        depth = 0,
        need_comma = false,
        suppress_separator = false,
    };
}
public using Emitter::new = new_emitter;

Status(fmt::FmtError) write_newline(Emitter* self) {
    if self.indent == 0 {
        return Status::Ok;
    }

    self.out.write_byte('\n' as char) ?;
    return self.out.write_repeat(
        ' ' as char,
        self.depth * self.indent as usize
    );
}

/// emits the comma and indentation that precede a value, if any.
Status(fmt::FmtError) separate(Emitter* self) {
    if self.suppress_separator {
        self.suppress_separator = false;
        return Status::Ok;
    }

    if self.need_comma {
        self.out.write_byte(',' as char) ?;
    }

    if self.depth != 0 {
        write_newline(self) ?;
    }

    self.need_comma = true;
    return Status::Ok;
}

public Status(fmt::FmtError) write_escaped(
    const fmt::Writer* w,
    [] const char text
) {
    fmt::JsonEscapeCursor cursor = fmt::new_json_escape(text);

    bool finished = false;
    while !finished {
        [] const char chunk = fmt::next(&cursor);
        if chunk.len == 0 {
            finished = true;
        } else {
            w.write_all(chunk) ?;
        }
    }

    return Status::Ok;
}

public Status(fmt::FmtError) begin_object(Emitter* self) {
    separate(self) ?;
    self.out.write_byte('{' as char) ?;
    self.depth = self.depth + 1;
    self.need_comma = false;
    return Status::Ok;
}

public Status(fmt::FmtError) end_object(Emitter* self) {
    bool empty = !self.need_comma;
    self.depth = self.depth - 1;

    if !empty {
        write_newline(self) ?;
    }

    self.out.write_byte('}' as char) ?;
    self.need_comma = true;
    return Status::Ok;
}

public Status(fmt::FmtError) begin_array(Emitter* self) {
    separate(self) ?;
    self.out.write_byte('[' as char) ?;
    self.depth = self.depth + 1;
    self.need_comma = false;
    return Status::Ok;
}

public Status(fmt::FmtError) end_array(Emitter* self) {
    bool empty = !self.need_comma;
    self.depth = self.depth - 1;

    if !empty {
        write_newline(self) ?;
    }

    self.out.write_byte(']' as char) ?;
    self.need_comma = true;
    return Status::Ok;
}

/// writes a member name. the value that follows joins it on the same
/// line rather than starting a new one.
public Status(fmt::FmtError) key(Emitter* self, [] const char name) {
    separate(self) ?;
    write_escaped(&self.out, name) ?;
    self.out.write_byte(':' as char) ?;

    if self.indent != 0 {
        self.out.write_byte(' ' as char) ?;
    }

    self.suppress_separator = true;
    self.need_comma = false;
    return Status::Ok;
}

public Status(fmt::FmtError) string(Emitter* self, [] const char text) {
    separate(self) ?;
    return write_escaped(&self.out, text);
}

public Status(fmt::FmtError) integer(Emitter* self, i64 value) {
    separate(self) ?;
    fmt::Options opts = fmt::Options::default();
    return fmt::format_signed(&self.out, value, &opts);
}

static if core::target::FLOAT_AVAILABLE {
    public Status(fmt::FmtError) float(Emitter* self, f64 value) {
        separate(self) ?;
        fmt::Options opts = fmt::Options::default();
        return fmt::format_float(&self.out, value, &opts);
    }
}

public Status(fmt::FmtError) boolean(Emitter* self, bool value) {
    separate(self) ?;
    return self.out.write_all(
        if value {
            "true"
        } else {
            "false"
        }
    );
}

public Status(fmt::FmtError) null_value(Emitter* self) {
    separate(self) ?;
    return self.out.write_all("null");
}

public Status(fmt::FmtError) value(Emitter* self, const Value* item) {
    static if core::target::FLOAT_AVAILABLE {
        return match *item {
            Value::Null => null_value(self),
            Value::Bool(v) => boolean(self, v),
            Value::Integer(v) => integer(self, v),
            Value::Float(v) => float(self, v),
            Value::String(v) => string(self, v),
            Value::Array(items) => {
                begin_array(self) ?;
                for usize i = 0; i < items.len; i++ {
                    value(self, &items[i]) ?;
                }
                end_array(self)
            },
            Value::Object(members) => {
                begin_object(self) ?;
                for usize i = 0; i < members.len; i++ {
                    key(self, members[i].key) ?;
                    value(self, &members[i].value) ?;
                }
                end_object(self)
            },
        };
    } else {
        return match *item {
            Value::Null => null_value(self),
            Value::Bool(v) => boolean(self, v),
            Value::Integer(v) => integer(self, v),
            Value::String(v) => string(self, v),
            Value::Array(items) => {
                begin_array(self) ?;
                for usize i = 0; i < items.len; i++ {
                    value(self, &items[i]) ?;
                }
                end_array(self)
            },
            Value::Object(members) => {
                begin_object(self) ?;
                for usize i = 0; i < members.len; i++ {
                    key(self, members[i].key) ?;
                    value(self, &members[i].value) ?;
                }
                end_object(self)
            },
        };
    }
}

/// renders `item` to `w`. `indent` of 0 is compact.
public Status(fmt::FmtError) write(
    fmt::Writer w,
    const Value* item,
    u32 indent
) {
    Emitter e = Emitter::new(w, indent);
    return value(&e, item);
}

Optional(usize) json_checked_mul(usize a, usize b) {
    if a != 0 && b > (~(0 as usize)) / a { return Optional::None; }
    return Optional::Some(a * b);
}
