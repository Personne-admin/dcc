//!!
//!! Process control and runtime startup
//!!
//!! Also holds the hosted panic handler. `std::debug` spins on an
//!! unhandled panic because a freestanding target may have nowhere to
//!! report to; this module supplies the handler that writes to stderr and
//!! terminates, and `__dc_rt_init` installs it from the entry stub.
//!!

module std::os::process;

import core;
import core::target;
import core::source_location;
import std::fmt;
import std::slice;
import std::sys::linux::abi;
import std::sys::linux::syscall;
import std::sys::win::abi;
import std::sys::win::imports;
import std::os::file;
import std::os::path;
import std::os::pipe;
public import std::os::error;
public import std::debug;
public import std::result;

using sys::linux;
using sys::win;
using core::source_location::SourceLocation;
using result::{ Result, Status, Optional };
using error::Error;

//!
//! Termination
//!

/// ends the process. does not return and does not run any cleanup.
public void exit(i32 status) {
    static if core::target::OS == core::target::Os::Windows {
        win::imports::ExitProcess(status as u32);
    } else {
        linux::syscall::exit_group(status);
    }

    // unreachable: both calls above diverge.
    while true {}
}

public using i32 ABORT_EXIT_STATUS = 134;

/// ends the process abnormally, without flushing anything.
public void abort() {
    static if core::target::OS == core::target::Os::Windows {
        win::imports::TerminateProcess(
            win::imports::GetCurrentProcess(),
            ABORT_EXIT_STATUS as u32
        );
    } else {
        linux::syscall::kill(
            linux::syscall::getpid() as linux::abi::Pid,
            linux::abi::SIGABRT
        );
    }

    // a blocked or ignored SIGABRT lands here
    exit(ABORT_EXIT_STATUS);
}

//!
//! Identity and scheduling
//!

public u32 process_id() {
    static if core::target::OS == core::target::Os::Windows {
        return win::imports::GetCurrentProcessId();
    } else {
        return linux::syscall::getpid() as u32;
    }
}

/// hands the rest of the current time slice back to the scheduler.
public void yield_now() {
    static if core::target::OS == core::target::Os::Windows {
        win::imports::Sleep(0);
    } else {
        linux::syscall::sched_yield();
    }
}

//!
//! Panic handler
//!
//! The message is written before the location is formatted: if the
//! formatting fails or the buffer overflows, the caller still learns what
//! happened. Write failures are ignored throughout, we are already
//! dying, and there is no second channel to report on.
//!

void report_panic([] const u8 message, SourceLocation sl) {
    u8[512] scratch;
    file::File err = file::stderr();

    file::write_all(&err, "panic: ");
    file::write_all(&err, message);
    file::write_all(&err, "\n  at ");

    match fmt::format_buf(
        scratch,
        "{}:{}:{}\n",
        sl.file,
        sl.line,
        sl.column
    ) {
        Result::Ok(rendered) => file::write_all(&err, rendered),
        Result::Err(_) => file::write_all(&err, "<unknown location>\n"),
    }

    file::sync(&err);
    exit(ABORT_EXIT_STATUS);
}

/// routes panics to stderr and terminates. install once, early.
public void install_panic_handler() {
    debug::set_panic_handler(report_panic);
}

//!
//! Runtime startup
//!
//! Called by the entry stub before it dispatches to main.
//!

@nomangle public void __dc_rt_init(i32 argc, void** argv) {
    install_panic_handler();

    static if core::target::OS == core::target::Os::Linux {
        // envp sits right after the argv NULL: argv[argc + 1].
        saved_envp = (
            argv as usize + (argc as usize + 1) * 8
        ) as const u8**;
    } else {
        saved_envp = &empty_env as const u8**;
    }
}

//!
//! Spawning
//!
//! `Command` borrows everything: the caller owns the `PathZ` buffers for
//! the program and its arguments. At most 16 arguments are accepted.
//!

public using file::Handle STDIO_INHERIT = -2;

public using usize MAX_SPAWN_ARGS = 16;

public struct Stdio {
    file::Handle input;
    file::Handle output;
    file::Handle error;
}

public Stdio inherit_stdio() {
    return {
        input = STDIO_INHERIT,
        output = STDIO_INHERIT,
        error = STDIO_INHERIT,
    };
}

public struct Command {
    path::PathZ* program;
    path::PathZ*[16] argv;
    usize argc;
    Stdio stdio;
}

public void init_command(Command* self, path::PathZ* program) {
    self.program = program;
    self.argc = 0;
    self.stdio = inherit_stdio();
    for usize i = 0; i < 16; i++ {
        self.argv[i] = null as path::PathZ*;
    }
}

/// appends one argument. the caller keeps owning the buffer.
public Status(Error) push_arg(Command* self, path::PathZ* arg) {
    if self.argc >= MAX_SPAWN_ARGS {
        return Status::Err(Error::InvalidArgument);
    }

    self.argv[self.argc] = arg;
    self.argc = self.argc + 1;
    return Status::Ok;
}

public struct ExitStatus {
    i32 code;
}

/// true for exit code 0. signaled children report 128 plus the signal.
public bool success(ExitStatus* self) {
    return self.code == 0;
}

public struct Child {
    usize pid;
    void* process;
    void* thread;
    u32 waited;
    u32 reserved;
}

void* empty_env;
const u8** saved_envp;

void redirect_fd(file::Handle fd, i32 target) {
    static if core::target::OS == core::target::Os::Windows {
        return;
    } else {
        if fd == STDIO_INHERIT {
            return;
        }

        if fd == target as file::Handle {
            return;
        }

        linux::syscall::dup3(fd as linux::abi::Fd, target, 0);
        linux::syscall::close(fd as linux::abi::Fd);
    }
}

/// spawns `cmd`. stdio handles that are not `STDIO_INHERIT` become the
/// child's standard streams; on Windows they must be inheritable (see
/// `pipe::create_inheritable`). the parent keeps its own copies and must
/// close the ends it does not use. the environment is inherited.
public Result(Child, Error) spawn(Command* cmd) {
    if (cmd.program as usize) == 0 {
        return Result::Err(Error::InvalidArgument);
    }

    if cmd.program.len == 0 || cmd.argc > MAX_SPAWN_ARGS {
        return Result::Err(Error::InvalidArgument);
    }

    static if core::target::OS == core::target::Os::Windows {
        u8[2048] narrow;
        usize n = 0;
        bool full = false;

        for usize a = 0; a < cmd.argc + 1; a++ {
            path::PathZ* arg;

            if a == 0 {
                arg = cmd.program;
            } else {
                arg = cmd.argv[a - 1];
            }

            if a != 0 {
                if n < 2048 {
                    narrow[n] = ' ' as u8;
                    n = n + 1;
                } else {
                    full = true;
                }
            }

            [] const u8 text = slice::from_raw_const!u8(
                &arg.bytes[0],
                arg.len
            );
            bool quote = text.len == 0;

            for usize i = 0; i < text.len; i++ {
                u8 b = text[i];

                if b == ' ' as u8 || b == '\t' as u8 || b == '"' as u8 {
                    quote = true;
                }
            }

            if quote {
                if n < 2048 {
                    narrow[n] = '"' as u8;
                    n = n + 1;
                } else {
                    full = true;
                }
            }

            for usize i = 0; i < text.len; i++ {
                if n < 2048 {
                    narrow[n] = text[i];
                    n = n + 1;
                } else {
                    full = true;
                }
            }

            if quote {
                if n < 2048 {
                    narrow[n] = '"' as u8;
                    n = n + 1;
                } else {
                    full = true;
                }
            }
        }

        if full {
            return Result::Err(Error::InvalidArgument);
        }

        path::PathW wide;
        [] const u8 view = slice::from_raw_const!u8(&narrow[0], n);
        path::to_pathw(view, &wide) ?;

        win::abi::StartupInfoW si;
        si.cb = sizeof (win::abi::StartupInfoW) as u32;
        si.reserved = null as win::abi::Wchar*;
        si.desktop = null as win::abi::Wchar*;
        si.title = null as win::abi::Wchar*;
        si.x = 0;
        si.y = 0;
        si.x_size = 0;
        si.y_size = 0;
        si.x_count_chars = 0;
        si.y_count_chars = 0;
        si.fill_attribute = 0;
        si.flags = 0;
        si.show_window = 0;
        si.reserved2_len = 0;
        si.reserved2 = null as win::abi::Byte*;
        si.std_input = win::imports::GetStdHandle(
            win::abi::STD_INPUT_HANDLE
        );
        si.std_output = win::imports::GetStdHandle(
            win::abi::STD_OUTPUT_HANDLE
        );
        si.std_error = win::imports::GetStdHandle(
            win::abi::STD_ERROR_HANDLE
        );

        if cmd.stdio.input != STDIO_INHERIT {
            si.std_input = cmd.stdio.input as win::abi::Handle;
            si.flags = win::abi::STARTF_USESTDHANDLES;
        }

        if cmd.stdio.output != STDIO_INHERIT {
            si.std_output = cmd.stdio.output as win::abi::Handle;
            si.flags = win::abi::STARTF_USESTDHANDLES;
        }

        if cmd.stdio.error != STDIO_INHERIT {
            si.std_error = cmd.stdio.error as win::abi::Handle;
            si.flags = win::abi::STARTF_USESTDHANDLES;
        }

        win::abi::ProcessInformation pi;
        win::abi::Bool ok = win::imports::CreateProcessW(
            null,
            &wide.units[0],
            null,
            null,
            win::abi::TRUE,
            0,
            null,
            null,
            &si,
            &pi
        );

        if !win::abi::succeeded(ok) {
            return Result::Err(
                error::from_win32(win::imports::GetLastError())
            );
        }

        Child c;
        c.pid = pi.process_id as usize;
        c.process = pi.process;
        c.thread = pi.thread;
        c.waited = 0;
        c.reserved = 0;
        return Result::Ok(c);
    } else {
        void*[18] vec;
        vec[0] = &cmd.program.bytes[0] as void*;

        for usize i = 0; i < cmd.argc; i++ {
            vec[i + 1] = &cmd.argv[i].bytes[0] as void*;
        }

        vec[cmd.argc + 1] = null as void*;

        void** envp = saved_envp as void**;
        if (envp as usize) == 0 {
            envp = &empty_env as void**;
        }

        isize r = linux::syscall::clone(linux::abi::SIGCHLD, 0, 0, 0, 0);
        if linux::abi::is_error(r) {
            return Result::Err(error::from_syscall(r));
        }

        if r == 0 {
            redirect_fd(cmd.stdio.input, 0);
            redirect_fd(cmd.stdio.output, 1);
            redirect_fd(cmd.stdio.error, 2);
            linux::syscall::execve(
                &cmd.program.bytes[0],
                &vec[0] as const u8**,
                envp as const u8**
            );
            linux::syscall::exit_group(127);

            while true {}
        }

        Child c;
        c.pid = r as usize;
        c.process = null as void*;
        c.thread = null as void*;
        c.waited = 0;
        c.reserved = 0;
        return Result::Ok(c);
    }
}

ExitStatus decode_status(i32 status) {
    ExitStatus st;

    if (status & 0x7f) == 0 {
        st.code = (status >> 8) & 0xff;
    } else {
        st.code = 128 + (status & 0x7f);
    }

    return st;
}

/// waits for the child, reaps it, and releases its handles. each child
/// must be waited exactly once; waiting again reports `BadHandle`.
/// always wait after `kill`: killing does not reap.
public Result(ExitStatus, Error) wait(Child* self) {
    if self.waited != 0 {
        return Result::Err(Error::BadHandle);
    }

    static if core::target::OS == core::target::Os::Windows {
        win::abi::Dword r = win::imports::WaitForSingleObject(
            self.process as win::abi::Handle,
            win::abi::INFINITE
        );

        if r != win::abi::WAIT_OBJECT_0 {
            return Result::Err(
                error::from_win32(win::imports::GetLastError())
            );
        }

        win::abi::Dword code = 0;
        win::abi::Bool ok = win::imports::GetExitCodeProcess(
            self.process as win::abi::Handle,
            &code
        );

        if !win::abi::succeeded(ok) {
            return Result::Err(
                error::from_win32(win::imports::GetLastError())
            );
        }

        win::imports::CloseHandle(self.thread as win::abi::Handle);
        win::imports::CloseHandle(self.process as win::abi::Handle);
        self.waited = 1;

        ExitStatus st;
        st.code = code as i32;
        return Result::Ok(st);
    } else {
        i32 status = 0;

        while true {
            isize r = linux::syscall::wait4(
                self.pid as linux::abi::Pid,
                &status,
                0
            );

            if !linux::abi::is_error(r) {
                self.waited = 1;
                return Result::Ok(decode_status(status));
            }

            if linux::abi::errno_of(r) != linux::abi::EINTR {
                return Result::Err(error::from_syscall(r));
            }
        }
    }
}

/// polls once. `None` means still running; like `wait`, a finished child
/// is reaped and must not be waited again.
public Result(Optional(ExitStatus), Error) try_wait(Child* self) {
    if self.waited != 0 {
        return Result::Err(Error::BadHandle);
    }

    static if core::target::OS == core::target::Os::Windows {
        win::abi::Dword r = win::imports::WaitForSingleObject(
            self.process as win::abi::Handle,
            0
        );

        if r == win::abi::WAIT_TIMEOUT {
            return Result::Ok(Optional::None);
        }

        if r != win::abi::WAIT_OBJECT_0 {
            return Result::Err(
                error::from_win32(win::imports::GetLastError())
            );
        }

        win::abi::Dword code = 0;
        win::abi::Bool ok = win::imports::GetExitCodeProcess(
            self.process as win::abi::Handle,
            &code
        );

        if !win::abi::succeeded(ok) {
            return Result::Err(
                error::from_win32(win::imports::GetLastError())
            );
        }

        win::imports::CloseHandle(self.thread as win::abi::Handle);
        win::imports::CloseHandle(self.process as win::abi::Handle);
        self.waited = 1;

        ExitStatus st;
        st.code = code as i32;
        return Result::Ok(Optional::Some(st));
    } else {
        i32 status = 0;

        while true {
            isize r = linux::syscall::wait4(
                self.pid as linux::abi::Pid,
                &status,
                linux::abi::WNOHANG
            );

            if r == 0 {
                return Result::Ok(Optional::None);
            }

            if !linux::abi::is_error(r) {
                self.waited = 1;
                return Result::Ok(Optional::Some(decode_status(status)));
            }

            if linux::abi::errno_of(r) != linux::abi::EINTR {
                return Result::Err(error::from_syscall(r));
            }
        }
    }
}

/// asks the child to terminate. the signal is honored on Linux and
/// ignored on Windows, where termination is unconditional. does not
/// reap: `wait` afterwards.
public Status(Error) kill(Child* self, i32 signal) {
    if self.waited != 0 {
        return Status::Err(Error::BadHandle);
    }

    static if core::target::OS == core::target::Os::Windows {
        win::abi::Bool ok = win::imports::TerminateProcess(
            self.process as win::abi::Handle,
            1 as u32
        );

        if !win::abi::succeeded(ok) {
            return Status::Err(
                error::from_win32(win::imports::GetLastError())
            );
        }

        return Status::Ok;
    } else {
        isize r = linux::syscall::kill(
            self.pid as linux::abi::Pid,
            signal
        );

        if linux::abi::is_error(r) {
            return Status::Err(error::from_syscall(r));
        }

        return Status::Ok;
    }
}
