//!!
//!! Process control and runtime startup
//!!
//!! Also holds the hosted panic handler. `std::debug` spins on an
//!! unhandled panic because a freestanding target may have nowhere to
//!! report to; this module supplies the handler that writes to stderr and
//!! terminates, and `__dc_rt_init` installs it from the entry stub.
//!!

module std::os::process;

import core;
import core::target;
import core::source_location;
import std::alloc;
import std::fmt;
import std::mem;
import std::slice;
import std::sys::linux::abi;
import std::sys::linux::syscall;
import std::sys::win::abi;
import std::sys::win::imports;
import std::os::file;
import std::os::path;
import std::os::pipe;
public import std::os::error;
public import std::debug;
public import std::result;

using sys::linux;
using sys::win;
using core::source_location::SourceLocation;
using result::{ Result, Status, Optional };
using alloc::AllocatorPolicy;
using error::Error;

//!
//! Termination
//!

static if core::target::OS != core::target::Os::Freestanding {
    /// ends the process. does not return and does not run any cleanup.
    @noreturn
    public void exit(i32 status) {
        static if core::target::OS == core::target::Os::Windows {
            win::imports::ExitProcess(status as u32);
        } else {
            linux::syscall::exit_group(status);
        }

    }
}

public using i32 ABORT_EXIT_STATUS = 134;

static if core::target::OS != core::target::Os::Freestanding {
    /// ends the process abnormally, without flushing anything.
    @noreturn
    public void abort() {
        static if core::target::OS == core::target::Os::Windows {
            win::imports::TerminateProcess(
                win::imports::GetCurrentProcess(),
                ABORT_EXIT_STATUS as u32
            );
        } else {
            linux::syscall::kill(
                linux::syscall::getpid() as linux::abi::Pid,
                linux::abi::SIGABRT
            );
        }

        // a blocked or ignored SIGABRT lands here
        exit(ABORT_EXIT_STATUS);
    }
}

//!
//! Identity and scheduling
//!

static if core::target::OS != core::target::Os::Freestanding {
    public u32 process_id() {
        static if core::target::OS == core::target::Os::Windows {
            return win::imports::GetCurrentProcessId();
        } else {
            return linux::syscall::getpid() as u32;
        }
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    /// hands the rest of the current time slice back to the scheduler.
    public void yield_now() {
        static if core::target::OS == core::target::Os::Windows {
            win::imports::Sleep(0);
        } else {
            linux::syscall::sched_yield();
        }
    }
}

//!
//! Panic handler
//!
//! The message is written before the location is formatted: if the
//! formatting fails or the buffer overflows, the caller still learns what
//! happened. Write failures are ignored throughout, we are already
//! dying, and there is no second channel to report on.
//!

static if core::target::OS != core::target::Os::Freestanding {
    void report_panic([] const char message, SourceLocation sl) {
        char[512] scratch;
        file::File err = file::stderr();

        file::write_all(&err, "panic: ");
        file::write_all(&err, message as [] const u8);
        file::write_all(&err, "\n  at ");

        match fmt::format_buf(
            scratch,
            "{}:{}:{} in {}\n",
            sl.file,
            sl.line,
            sl.column,
            sl.function
        ) {
            Result::Ok(rendered) => file::write_all(&err, rendered as [] const u8),
            Result::Err(_) => file::write_all(&err, "<unknown location>\n"),
        }

        file::sync(&err);
        exit(ABORT_EXIT_STATUS);
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    /// routes panics to stderr and terminates. install once, early.
    public void install_panic_handler() {
        debug::set_panic_handler(report_panic);
    }
}

//!
//! Runtime startup
//!
//! Called by the entry stub before it dispatches to main.
//!

static if core::target::OS != core::target::Os::Freestanding {
    @nomangle public void __dc_rt_init(i32 argc, void** argv) {
        install_panic_handler();

        saved_argc = argc;
        saved_argv = argv as const char**;

        static if core::target::OS == core::target::Os::Linux {
            // envp sits right after the argv NULL: argv[argc + 1].
            saved_envp = (
                argv as usize + (argc as usize + 1) * 8
            ) as const char**;
        } else {
            saved_envp = &empty_env as const char**;
        }
    }
}

//!
//! Command line and environment
//!
//! The entry stub hands `__dc_rt_init` the block the kernel set up, and
//! it stays mapped for the life of the process, so the slices below
//! borrow it rather than copying. On Windows the environment is a
//! UTF-16 block that has to be transcoded, so there the iterator owns a
//! buffer and each entry borrows it until the next `next`, exactly like
//! `dir::Entry`. Treat every returned slice that way on both targets.
//!

i32 saved_argc;
const char** saved_argv;

public using usize MAX_ENV_ENTRY = 4096;

usize cstr_len(const char* s, usize bound) {
    usize n = 0;
    while n < bound && s[n] != '\0' {
        n++;
    }

    return n;
}

/// the process arguments, argv[0] first. empty before `__dc_rt_init`
/// runs, and on Windows, where the stub has no argv to pass on; use
/// `command_line` there.
public usize arg_count() {
    if saved_argc < 0 {
        return 0;
    }

    return saved_argc as usize;
}

public Optional([] const char) arg(usize index) {
    if index >= arg_count() || (saved_argv as usize) == 0 {
        return Optional::None;
    }

    const char* raw = saved_argv[index];
    if (raw as usize) == 0 {
        return Optional::None;
    }

    return Optional::Some(
        slice::from_raw_const!char(raw, cstr_len(raw, MAX_ENV_ENTRY))
    );
}

public struct Var {
    [] const char name;
    [] const char value;
}

public struct Vars {
    const char** cursor;
    void* block;
    usize offset;
    char[4096] buffer;
    bool done;
}

static if core::target::OS != core::target::Os::Freestanding {
    /// starts an iteration over the environment. call `close` when done;
    /// on Windows it releases the block the OS handed us.
    public Vars vars() {
        Vars self;
        self.offset = 0;
        self.done = false;

        static if core::target::OS == core::target::Os::Windows {
            self.cursor = null as const char**;
            self.block = win::imports::GetEnvironmentStringsW() as void*;
            if self.block == null {
                self.done = true;
            }
        } else {
            self.cursor = saved_envp;
            self.block = null as void*;
            if (self.cursor as usize) == 0 {
                self.done = true;
            }
        }

        return self;
    }
}

Optional(Var) split_entry([] const char text) {
    for usize i = 0; i < text.len; i++ {
        if text[i] == ('=' as char) {
            // a leading `=` starts a Windows drive-cwd entry, not a name
            if i == 0 {
                return Optional::None;
            }

            Var out = {name = text[0..i], value = text[i + 1..text.len]};
            return Optional::Some(out);
        }
    }

    return Optional::None;
}

/// yields the next variable. malformed entries are skipped.
public Optional(Var) next(Vars* self) {
    if self.done {
        return Optional::None;
    }

    static if core::target::OS == core::target::Os::Windows {
        [] char view = slice::from_raw(&self.buffer[0], 4096);
        const u16* units = self.block as const u16*;

        while true {
            if units[self.offset] == 0 {
                self.done = true;
                return Optional::None;
            }

            usize start = self.offset;
            while units[self.offset] != 0 {
                self.offset++;
            }

            [] const u16 wide = slice::from_raw_const!u16(
                &units[start],
                self.offset - start
            );
            self.offset++;

            Result(usize, error::Error) text = path::from_wide(wide, view);
            if text.is_err() {
                continue;
            }

            Optional(Var) split = split_entry(view[0..text.unwrap()]);
            if split.is_some() {
                return split;
            }
        }
    } else {
        while true {
            const char* raw = self.cursor[self.offset];
            if (raw as usize) == 0 {
                self.done = true;
                return Optional::None;
            }

            self.offset++;

            Optional(Var) split = split_entry(
                slice::from_raw_const!char(raw, cstr_len(raw, MAX_ENV_ENTRY))
            );

            if split.is_some() {
                return split;
            }
        }
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    public void close(Vars* self) {
        self.done = true;

        static if core::target::OS == core::target::Os::Windows {
            if self.block != null {
                win::imports::FreeEnvironmentStringsW(
                    self.block as win::abi::Wchar*
                );

                self.block = null as void*;
            }
        } else {
            return;
        }
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    /// copies the value of `name` into `out` and returns the written
    /// subslice. reports `NotFound` when the variable is unset. the copy is
    /// deliberate: it gives one lifetime rule on both targets.
    public Result([] const char, Error) get_var([] const char name, [] char out) {
        Vars it = vars();
        defer close(&it);

        while true {
            Optional(Var) step = next(&it);
            if step.is_none() {
                break;
            }

            Var entry = step.unwrap_some();
            if !mem::equal(entry.name, name) {
                continue;
            }

            if entry.value.len > out.len {
                return Error::NameTooLong;
            }

            mem::copy(out[0..entry.value.len], entry.value);
            return Result::Ok(out[0..entry.value.len] as [] const char);
        }

        return Error::NotFound;
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    public bool has_var([] const char name) {
        char[1] scratch;
        Result([] const char, Error) got = get_var(name, scratch[0..1]);

        if got.is_ok() {
            return true;
        }

        // a value too long for the probe buffer still means the name is set
        return got.unwrap_err() == Error::NameTooLong;
    }
}

//!
//! Working directory
//!
//! Process-wide mutable state: changing it races with every other
//! thread's relative path. Prefer resolving paths against a base you
//! carry yourself.
//!

static if core::target::OS != core::target::Os::Freestanding {
    public Result([] const char, Error) current_dir([] char out) {
        static if core::target::OS == core::target::Os::Windows {
            u16[4096] units;
            win::abi::Dword got = win::imports::GetCurrentDirectoryW(
                4096,
                &units[0]
            );

            if got == 0 {
                return Result::Err(error::from_win32(win::imports::GetLastError()));
            }

            if got as usize >= 4096 {
                return Error::NameTooLong;
            }

            [] const u16 wide = slice::from_raw_const!u16(&units[0], got as usize);
            usize n = path::from_wide(wide, out) ?;
            return Result::Ok(out[0..n] as [] const char);
        } else {
            isize ret = linux::syscall::getcwd(out);
            if linux::abi::is_error(ret) {
                return Result::Err(error::from_syscall(ret));
            }

            // getcwd counts the terminator; the caller wants the name
            usize n = ret as usize;
            if n == 0 {
                return Error::Unexpected;
            }

            return Result::Ok(out[0..n - 1] as [] const char);
        }
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    public Status(Error) set_current_dir([] const char name) {
        static if core::target::OS == core::target::Os::Windows {
            path::PathW p;
            path::to_pathw(name, &p) ?;

            win::abi::Bool ok = win::imports::SetCurrentDirectoryW(
                path::wide_ptr(&p)
            );

            if !win::abi::succeeded(ok) {
                return Status::Err(error::from_win32(win::imports::GetLastError()));
            }

            return Status::Ok;
        } else {
            path::PathZ p;
            path::to_pathz(name, &p) ?;

            isize ret = linux::syscall::chdir(path::ptr(&p));
            if linux::abi::is_error(ret) {
                return Status::Err(error::from_syscall(ret));
            }

            return Status::Ok;
        }
    }
}

//!
//! Spawning
//!
//! `Command` borrows everything: the caller owns the `PathZ` buffers for
//! the program and its arguments.
//!

public using file::Handle STDIO_INHERIT = -2;

public struct Stdio {
    file::Handle input;
    file::Handle output;
    file::Handle error;
}

public Stdio inherit_stdio() {
    return {
        input = STDIO_INHERIT,
        output = STDIO_INHERIT,
        error = STDIO_INHERIT,
    };
}

public using Arg = [] const char;

public struct Command {
    [] const char program;
    /// arguments after argv[0], which `spawn` fills in from `program`
    [] const Arg args;
    Stdio stdio;
}

public Command new_command([] const char program) {
    return {
        program = program,
        args = slice::from_raw_const(null as const Arg*, 0),
        stdio = inherit_stdio(),
    };
}
public using Command::new = new_command;

/// Borrowed configuration used only during a spawn call.
public struct EnvironmentChange {
    [] const char name;
    [] const char value;
    bool remove;
}

public struct SpawnOptions {
    [] const char directory;
    [] const EnvironmentChange environment;
    bool checked_launch;
    bool search_path;
}

public struct ExitStatus {
    i32 code;
    i32 signal = 0;
}

/// true for exit code 0. signaled children report 128 plus the signal.
public bool success(ExitStatus* self) {
    return self.code == 0;
}

public struct Child {
    usize pid;
    void* process;
    void* thread;
    u32 waited;
    u32 reserved;
}

void* empty_env;
const char** saved_envp;

bool has_nul([] const char text) {
    for usize i = 0; i < text.len; i++ {
        if text[i] == '\0' {
            return true;
        }
    }

    return false;
}

//!
//! Windows argument quoting
//!
//! CreateProcessW takes one string and the C runtime splits it again, so
//! an argument containing a space, tab or quote has to survive the round
//! trip. Backslashes are only special in front of a quote, where they
//! double; elsewhere they are literal.
//!

Optional(usize) checked_quote_bound([] const char arg) {
    Optional(usize) doubled = process_checked_mul(arg.len, 2);
    if doubled.is_none() { return Optional::None; }
    return process_checked_add(doubled.unwrap_some(), 3);
}

usize quote_bound([] const char arg) {
    Optional(usize) bound = checked_quote_bound(arg);
    if bound.is_none() { debug::panic("process::quote_bound: size overflow"); }
    return bound.unwrap_some();
}

usize push_quoted([] char out, usize at, [] const char arg) {
    usize n = at;
    bool quote = arg.len == 0;

    for usize i = 0; i < arg.len; i++ {
        char b = arg[i];
        if b == (' ' as char) || b == ('\t' as char) || b == ('"' as char) {
            quote = true;
        }
    }

    if quote {
        out[n] = '"' as char;
        n++;
    }

    usize i = 0;
    while i < arg.len {
        usize slashes = 0;
        while i < arg.len && arg[i] == ('\\' as char) {
            slashes++;
            i++;
        }

        if i == arg.len {
            // trailing run: doubled only when a closing quote follows
            usize repeat = if quote {
                slashes * 2
            } else {
                slashes
            };
            for usize k = 0; k < repeat; k++ {
                out[n] = '\\' as char;
                n++;
            }
        } else if arg[i] == ('"' as char) {
            for usize k = 0; k < slashes * 2 + 1; k++ {
                out[n] = '\\' as char;
                n++;
            }

            out[n] = '"' as char;
            n++;
            i++;
        } else {
            for usize k = 0; k < slashes; k++ {
                out[n] = '\\' as char;
                n++;
            }

            out[n] = arg[i];
            n++;
            i++;
        }
    }

    if quote {
        out[n] = '"' as char;
        n++;
    }

    return n;
}

[] const char raw_text(const char* text) {
    usize length = 0;
    while text[length] != '\0' { length++; }
    return slice::from_raw_const(text, length);
}

bool env_name_matches([] const char entry, [] const char name) {
    return entry.len > name.len && entry[name.len] == '=' && mem::equal(entry[0..name.len], name);
}

static if core::target::OS == core::target::Os::Linux {
    @noreturn void child_failed(i32 fd, isize failure) {
        i32 code = linux::abi::errno_of(failure);
        if fd >= 0 {
            [] u8 bytes = slice::from_raw(&code as u8*, sizeof(i32));
            usize sent = 0;
            while sent < bytes.len {
                isize written = linux::syscall::write(fd, bytes[sent..bytes.len]);
                if linux::abi::is_error(written) {
                    if linux::abi::errno_of(written) == linux::abi::EINTR { continue; }
                    break;
                }
                if written == 0 { break; }
                sent += written as usize;
            }
        }
        linux::syscall::exit_group(127);
    }

    void reap_failed(linux::abi::Pid pid) {
        i32 status = 0;
        while true {
            isize reaped = linux::syscall::wait4(pid, &status, 0);
            if !linux::abi::is_error(reaped) || linux::abi::errno_of(reaped) != linux::abi::EINTR { break; }
        }
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    /// spawns `cmd`. stdio handles that are not `STDIO_INHERIT` become the
    /// child's standard streams; on Windows they must be inheritable (see
    /// `pipe::create_inheritable`). the parent keeps its own copies and must
    /// close the ends it does not use. the environment is inherited.
    ///
    /// `alloc` backs the argument vector only, and everything taken from it
    /// is released before this returns.
    public Result(Child, Error) spawn(A)(
        A* alloc,
        const Command* cmd
    ) if AllocatorPolicy(A) {
        SpawnOptions options = {};
        return spawn_with_options(alloc, cmd, &options);
    }

    /// Extended spawn with borrowed child-only cwd and environment edits.
    /// Linux checked_launch reports setup/exec errors and reaps failed children.
    /// search_path enables shell-free PATH lookup on Linux. Windows uses its
    /// existing CreateProcessW lookup and rejects environment edits.
    public Result(Child, Error) spawn_with_options(A)(
        A* alloc,
        const Command* cmd,
        const SpawnOptions* options
    ) if AllocatorPolicy(A) {
        if has_nul(options.directory) { return Error::InvalidArgument; }
        for change in options.environment {
            if change.name.len == 0 || has_nul(change.name) || has_nul(change.value) { return Error::InvalidArgument; }
            for c in change.name { if c == '=' { return Error::InvalidArgument; } }
        }
        if cmd.program.len == 0 || has_nul(cmd.program) {
            return Result::Err(Error::InvalidArgument);
        }

        for usize i = 0; i < cmd.args.len; i++ {
            if has_nul(cmd.args[i]) {
                return Result::Err(Error::InvalidArgument);
            }
        }

        static if core::target::OS == core::target::Os::Windows {
            if options.environment.len != 0 { return Error::NotSupported; }
            path::PathW directory;
            const u16* directory_ptr = null;
            if options.directory.len != 0 {
                path::to_pathw(options.directory, &directory)?;
                directory_ptr = path::wide_ptr(&directory);
            }
            Optional(usize) initial = checked_quote_bound(cmd.program);
            if initial.is_none() { return Error::OutOfMemory; }
            usize bound = initial.unwrap_some();
            for usize i = 0; i < cmd.args.len; i++ {
                Optional(usize) arg_bound = checked_quote_bound(cmd.args[i]);
                if arg_bound.is_none() { return Error::OutOfMemory; }
                Optional(usize) combined = process_checked_add(bound, arg_bound.unwrap_some());
                if combined.is_none() { return Error::OutOfMemory; }
                Optional(usize) spaced = process_checked_add(combined.unwrap_some(), 1);
                if spaced.is_none() { return Error::OutOfMemory; }
                bound = spaced.unwrap_some();
            }
            Optional(usize) max_units = process_checked_add(bound, 1);
            if max_units.is_none() || process_checked_mul(max_units.unwrap_some(), 2).is_none() { return Error::OutOfMemory; }

            Result([] u8, mem::AllocError) narrow_slot = alloc.allocate(bound, 1);
            if narrow_slot.is_err() {
                return if narrow_slot.unwrap_err() == mem::AllocError::OutOfMemory { Error::OutOfMemory } else { Error::OutOfMemory };
            }

            [] char narrow = narrow_slot.unwrap() as [] char;
            defer alloc.free(narrow as [] u8, 1);

            usize n = push_quoted(narrow, 0, cmd.program);
            for usize i = 0; i < cmd.args.len; i++ {
                narrow[n] = ' ' as char;
                n++;
                n = push_quoted(narrow, n, cmd.args[i]);
            }

            // one UTF-16 unit per UTF-8 byte is always enough, plus the NUL
            Optional(usize) units = process_checked_add(n, 1);
            if units.is_none() { return Error::OutOfMemory; }
            Optional(usize) wide_size = process_checked_mul(units.unwrap_some(), 2);
            if wide_size.is_none() { return Error::OutOfMemory; }
            Result([] u8, mem::AllocError) wide_slot = alloc.allocate(
                wide_size.unwrap_some(),
                alignof (u16)
            );
            if wide_slot.is_err() {
                return if wide_slot.unwrap_err() == mem::AllocError::OutOfMemory { Error::OutOfMemory } else { Error::OutOfMemory };
            }

            [] u8 wide_bytes = wide_slot.unwrap();
            defer alloc.free(wide_bytes, alignof (u16));

            [] u16 wide = slice::from_raw(wide_bytes.ptr as u16*, n + 1);
            path::to_wide(narrow[0..n], wide) ?;

            win::abi::StartupInfoW si;
            si.cb = sizeof (win::abi::StartupInfoW) as u32;
            si.reserved = null as win::abi::Wchar*;
            si.desktop = null as win::abi::Wchar*;
            si.title = null as win::abi::Wchar*;
            si.x = 0;
            si.y = 0;
            si.x_size = 0;
            si.y_size = 0;
            si.x_count_chars = 0;
            si.y_count_chars = 0;
            si.fill_attribute = 0;
            si.flags = 0;
            si.show_window = 0;
            si.reserved2_len = 0;
            si.reserved2 = null as win::abi::Byte*;
            si.std_input = win::imports::GetStdHandle(
                win::abi::STD_INPUT_HANDLE
            );
            si.std_output = win::imports::GetStdHandle(
                win::abi::STD_OUTPUT_HANDLE
            );
            si.std_error = win::imports::GetStdHandle(
                win::abi::STD_ERROR_HANDLE
            );

            if cmd.stdio.input != STDIO_INHERIT {
                si.std_input = cmd.stdio.input as win::abi::Handle;
                si.flags = win::abi::STARTF_USESTDHANDLES;
            }

            if cmd.stdio.output != STDIO_INHERIT {
                si.std_output = cmd.stdio.output as win::abi::Handle;
                si.flags = win::abi::STARTF_USESTDHANDLES;
            }

            if cmd.stdio.error != STDIO_INHERIT {
                si.std_error = cmd.stdio.error as win::abi::Handle;
                si.flags = win::abi::STARTF_USESTDHANDLES;
            }

            win::abi::ProcessInformation pi;
            win::abi::Bool ok = win::imports::CreateProcessW(
                null,
                &wide[0],
                null,
                null,
                win::abi::TRUE,
                0,
                null,
                directory_ptr,
                &si,
                &pi
            );

            if !win::abi::succeeded(ok) {
                return Result::Err(
                    error::from_win32(win::imports::GetLastError())
                );
            }

            Child c;
            c.pid = pi.process_id as usize;
            c.process = pi.process;
            c.thread = pi.thread;
            c.waited = 0;
            c.reserved = 0;
            return Result::Ok(c);
        } else {
            Optional(usize) initial = process_checked_add(cmd.program.len, 1);
            if initial.is_none() { return Error::OutOfMemory; }
            usize blob_len = initial.unwrap_some();
            for usize i = 0; i < cmd.args.len; i++ {
                Optional(usize) combined = process_checked_add(blob_len, cmd.args[i].len);
                if combined.is_none() { return Error::OutOfMemory; }
                Optional(usize) terminated = process_checked_add(combined.unwrap_some(), 1);
                if terminated.is_none() { return Error::OutOfMemory; }
                blob_len = terminated.unwrap_some();
            }
            Optional(usize) count = process_checked_add(cmd.args.len, 2);
            if count.is_none() { return Error::OutOfMemory; }
            Optional(usize) vector_bytes = process_checked_mul(count.unwrap_some(), sizeof(void*));
            if vector_bytes.is_none() { return Error::OutOfMemory; }

            Result([] u8, mem::AllocError) blob_slot = alloc.allocate(blob_len, 1);
            if blob_slot.is_err() {
                return if blob_slot.unwrap_err() == mem::AllocError::OutOfMemory { Error::OutOfMemory } else { Error::OutOfMemory };
            }

            [] char blob = blob_slot.unwrap() as [] char;
            defer alloc.free(blob as [] u8, 1);

            Result([] u8, mem::AllocError) vec_slot = alloc.allocate(
                vector_bytes.unwrap_some(),
                alignof (void*)
            );
            if vec_slot.is_err() {
                return if vec_slot.unwrap_err() == mem::AllocError::OutOfMemory { Error::OutOfMemory } else { Error::OutOfMemory };
            }

            [] u8 vec_bytes = vec_slot.unwrap();
            defer alloc.free(vec_bytes, alignof (void*));

            const char** vec = vec_bytes.ptr as const char**;

            usize at = 0;
            mem::copy(blob[at..at + cmd.program.len], cmd.program);
            blob[at + cmd.program.len] = '\0';
            vec[0] = &blob[at] as const char*;
            at = at + cmd.program.len + 1;

            for usize i = 0; i < cmd.args.len; i++ {
                [] const char arg = cmd.args[i];
                mem::copy(blob[at..at + arg.len], arg);
                blob[at + arg.len] = '\0';
                vec[i + 1] = &blob[at] as const char*;
                at = at + arg.len + 1;
            }

            vec[cmd.args.len + 1] = null as const char*;

            const char** envp = saved_envp;
            if (envp as usize) == 0 {
                envp = &empty_env as const char**;
            }

            usize inherited = 0;
            while envp[inherited] != null { inherited++; }
            usize env_bytes = 0;
            for change in options.environment {
                Optional(usize) size = process_checked_add(change.name.len, change.value.len);
                if size.is_none() { return Error::OutOfMemory; }
                size = process_checked_add(size.unwrap_some(), 2);
                if size.is_none() { return Error::OutOfMemory; }
                size = process_checked_add(env_bytes, size.unwrap_some());
                if size.is_none() { return Error::OutOfMemory; }
                env_bytes = size.unwrap_some();
            }
            [] u8 env_storage = {};
            [] u8 env_vector = {};
            defer { if env_storage.len != 0 { alloc.free(env_storage, 1); } }
            defer { if env_vector.len != 0 { alloc.free(env_vector, alignof(void*)); } }
            if options.environment.len != 0 {
                Optional(usize) count_env = process_checked_add(inherited, options.environment.len);
                if count_env.is_none() { return Error::OutOfMemory; }
                count_env = process_checked_add(count_env.unwrap_some(), 1);
                if count_env.is_none() { return Error::OutOfMemory; }
                Optional(usize) bytes_env = process_checked_mul(count_env.unwrap_some(), sizeof(void*));
                if bytes_env.is_none() { return Error::OutOfMemory; }
                Result([] u8, mem::AllocError) storage_r = alloc.allocate(env_bytes, 1);
                if storage_r.is_err() { return Error::OutOfMemory; }
                env_storage = storage_r.unwrap();
                Result([] u8, mem::AllocError) vector_r = alloc.allocate(bytes_env.unwrap_some(), alignof(void*));
                if vector_r.is_err() { return Error::OutOfMemory; }
                env_vector = vector_r.unwrap();
                const char** merged = env_vector.ptr as const char**;
                usize used = 0;
                for usize i = 0; i < inherited; i++ {
                    [] const char entry = raw_text(envp[i]);
                    bool replaced = false;
                    for change in options.environment {
                        if env_name_matches(entry, change.name) { replaced = true; }
                    }
                    if !replaced { merged[used] = envp[i]; used++; }
                }
                usize offset = 0;
                for usize i = 0; i < options.environment.len; i++ {
                    EnvironmentChange change = options.environment[i];
                    bool later = false;
                    for usize j = i + 1; j < options.environment.len; j++ {
                        if mem::equal(change.name, options.environment[j].name) { later = true; }
                    }
                    if change.remove || later { continue; }
                    merged[used] = (env_storage.ptr + offset) as const char*;
                    for c in change.name { env_storage[offset] = c as u8; offset++; }
                    env_storage[offset] = '=' as u8; offset++;
                    for c in change.value { env_storage[offset] = c as u8; offset++; }
                    env_storage[offset] = 0; offset++;
                    used++;
                }
                merged[used] = null;
                envp = merged;
            }
            [] const char search = "/bin:/usr/bin";
            for usize i = 0; envp[i] != null; i++ {
                [] const char entry = raw_text(envp[i]);
                if env_name_matches(entry, "PATH") { search = entry[5..entry.len]; }
            }
            bool search_program = options.search_path;
            for c in cmd.program { if c == '/' { search_program = false; } }
            [] u8 candidate = {};
            defer { if candidate.len != 0 { alloc.free(candidate, 1); } }
            if search_program {
                Optional(usize) bound = process_checked_add(search.len, cmd.program.len);
                if bound.is_none() { return Error::OutOfMemory; }
                bound = process_checked_add(bound.unwrap_some(), 2);
                if bound.is_none() { return Error::OutOfMemory; }
                Result([] u8, mem::AllocError) candidate_r = alloc.allocate(bound.unwrap_some(), 1);
                if candidate_r.is_err() { return Error::OutOfMemory; }
                candidate = candidate_r.unwrap();
            }
            path::PathZ directory;
            if options.directory.len != 0 { path::to_pathz(options.directory, &directory)?; }
            i32[3] sources = {cmd.stdio.input as i32, cmd.stdio.output as i32, cmd.stdio.error as i32};
            i32[3] copies = {-1,-1,-1};
            defer { for fd in copies { if fd >= 0 { linux::syscall::close(fd); } } }
            for usize i = 0; i < 3; i++ {
                if sources[i] == STDIO_INHERIT as i32 { continue; }
                isize duplicate = linux::syscall::fcntl(sources[i], linux::abi::F_DUPFD_CLOEXEC, 3);
                if linux::abi::is_error(duplicate) { return error::from_syscall(duplicate); }
                copies[i] = duplicate as i32;
            }
            i32[2] failure_pipe = {-1,-1};
            defer {
                if failure_pipe[0] >= 0 { linux::syscall::close(failure_pipe[0]); }
                if failure_pipe[1] >= 0 { linux::syscall::close(failure_pipe[1]); }
            }
            if options.checked_launch {
                isize opened = linux::syscall::pipe2(&failure_pipe[0], linux::abi::O_CLOEXEC);
                if linux::abi::is_error(opened) { return error::from_syscall(opened); }
                if failure_pipe[1] < 3 {
                    isize moved = linux::syscall::fcntl(failure_pipe[1], linux::abi::F_DUPFD_CLOEXEC, 3);
                    if linux::abi::is_error(moved) { return error::from_syscall(moved); }
                    linux::syscall::close(failure_pipe[1]);
                    failure_pipe[1] = moved as i32;
                }
            }
            isize r = linux::syscall::clone(linux::abi::SIGCHLD, 0, 0, 0, 0);
            if linux::abi::is_error(r) { return error::from_syscall(r); }
            if r == 0 {
                if failure_pipe[0] >= 0 { linux::syscall::close(failure_pipe[0]); }
                if options.directory.len != 0 {
                    isize changed = linux::syscall::chdir(path::ptr(&directory));
                    if linux::abi::is_error(changed) { child_failed(failure_pipe[1], changed); }
                }
                for usize i = 0; i < 3; i++ {
                    if copies[i] < 0 { continue; }
                    isize redirected = linux::syscall::dup3(copies[i], i as i32, 0);
                    if linux::abi::is_error(redirected) { child_failed(failure_pipe[1], redirected); }
                }
                for fd in copies { if fd >= 0 { linux::syscall::close(fd); } }
                for usize i = 0; i < 3; i++ {
                    if sources[i] < 3 { continue; }
                    bool earlier = false;
                    for usize j = 0; j < i; j++ { if sources[j] == sources[i] { earlier = true; } }
                    if !earlier { linux::syscall::close(sources[i]); }
                }
                isize exec_error = -(linux::abi::ENOENT as isize);
                if search_program {
                    usize start = 0;
                    bool denied = false;
                    while start <= search.len {
                        usize end = start;
                        while end < search.len && search[end] != ':' { end++; }
                        usize at = 0;
                        for usize i = start; i < end; i++ { candidate[at] = search[i] as u8; at++; }
                        if end != start { candidate[at] = '/' as u8; at++; }
                        for c in cmd.program { candidate[at] = c as u8; at++; }
                        candidate[at] = 0;
                        exec_error = linux::syscall::execve(candidate.ptr as const char*, vec, envp);
                        i32 code = linux::abi::errno_of(exec_error);
                        if code == linux::abi::EACCES { denied = true; }
                        else if code != linux::abi::ENOENT && code != linux::abi::ENOTDIR { break; }
                        start = end + 1;
                    }
                    if denied && (linux::abi::errno_of(exec_error) == linux::abi::ENOENT || linux::abi::errno_of(exec_error) == linux::abi::ENOTDIR) {
                        exec_error = -(linux::abi::EACCES as isize);
                    }
                } else {
                    exec_error = linux::syscall::execve(vec[0], vec, envp);
                }
                child_failed(failure_pipe[1], exec_error);
            }
            if options.checked_launch {
                linux::syscall::close(failure_pipe[1]); failure_pipe[1] = -1;
                i32 exec_errno = 0;
                [] u8 report = slice::from_raw(&exec_errno as u8*, sizeof(i32));
                usize received = 0;
                while received < report.len {
                    isize got = linux::syscall::read(failure_pipe[0], report[received..report.len]);
                    if linux::abi::is_error(got) {
                        if linux::abi::errno_of(got) == linux::abi::EINTR { continue; }
                        linux::syscall::kill(r as linux::abi::Pid, 9);
                        reap_failed(r as linux::abi::Pid);
                        return error::from_syscall(got);
                    }
                    if got == 0 { break; }
                    received += got as usize;
                }
                if received != 0 {
                    reap_failed(r as linux::abi::Pid);
                    if received != report.len { return Error::InputOutput; }
                    return error::from_syscall(-(exec_errno as isize));
                }
            }

            Child c;
            c.pid = r as usize;
            c.process = null as void*;
            c.thread = null as void*;
            c.waited = 0;
            c.reserved = 0;
            return Result::Ok(c);
        }
    }
}

ExitStatus decode_status(i32 status) {
    ExitStatus st;
    st.signal = 0;

    if (status & 0x7f) == 0 {
        st.code = (status >> 8) & 0xff;
    } else {
        st.signal = status & 0x7f;
        st.code = 128 + st.signal;
    }

    return st;
}

static if core::target::OS != core::target::Os::Freestanding {
    /// waits for the child, reaps it, and releases its handles. each child
    /// must be waited exactly once; waiting again reports `BadHandle`.
    /// always wait after `kill`: killing does not reap.
    public Result(ExitStatus, Error) wait(Child* self) {
        if self.waited != 0 {
            return Result::Err(Error::BadHandle);
        }

        static if core::target::OS == core::target::Os::Windows {
            win::abi::Dword r = win::imports::WaitForSingleObject(
                self.process as win::abi::Handle,
                win::abi::INFINITE
            );

            if r != win::abi::WAIT_OBJECT_0 {
                return Result::Err(
                    error::from_win32(win::imports::GetLastError())
                );
            }

            win::abi::Dword code = 0;
            win::abi::Bool ok = win::imports::GetExitCodeProcess(
                self.process as win::abi::Handle,
                &code
            );

            if !win::abi::succeeded(ok) {
                return Result::Err(
                    error::from_win32(win::imports::GetLastError())
                );
            }

            win::imports::CloseHandle(self.thread as win::abi::Handle);
            win::imports::CloseHandle(self.process as win::abi::Handle);
            self.waited = 1;

            ExitStatus st;
            st.code = code as i32;
            st.signal = 0;
            return Result::Ok(st);
        } else {
            i32 status = 0;

            while true {
                isize r = linux::syscall::wait4(
                    self.pid as linux::abi::Pid,
                    &status,
                    0
                );

                if !linux::abi::is_error(r) {
                    self.waited = 1;
                    return Result::Ok(decode_status(status));
                }

                if linux::abi::errno_of(r) != linux::abi::EINTR {
                    return Result::Err(error::from_syscall(r));
                }
            }
        }
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    /// polls once. `None` means still running; like `wait`, a finished child
    /// is reaped and must not be waited again.
    public Result(Optional(ExitStatus), Error) try_wait(Child* self) {
        if self.waited != 0 {
            return Result::Err(Error::BadHandle);
        }

        static if core::target::OS == core::target::Os::Windows {
            win::abi::Dword r = win::imports::WaitForSingleObject(
                self.process as win::abi::Handle,
                0
            );

            if r == win::abi::WAIT_TIMEOUT {
                return Result::Ok(Optional::None);
            }

            if r != win::abi::WAIT_OBJECT_0 {
                return Result::Err(
                    error::from_win32(win::imports::GetLastError())
                );
            }

            win::abi::Dword code = 0;
            win::abi::Bool ok = win::imports::GetExitCodeProcess(
                self.process as win::abi::Handle,
                &code
            );

            if !win::abi::succeeded(ok) {
                return Result::Err(
                    error::from_win32(win::imports::GetLastError())
                );
            }

            win::imports::CloseHandle(self.thread as win::abi::Handle);
            win::imports::CloseHandle(self.process as win::abi::Handle);
            self.waited = 1;

            ExitStatus st;
            st.code = code as i32;
            st.signal = 0;
            return Result::Ok(Optional::Some(st));
        } else {
            i32 status = 0;

            while true {
                isize r = linux::syscall::wait4(
                    self.pid as linux::abi::Pid,
                    &status,
                    linux::abi::WNOHANG
                );

                if r == 0 {
                    return Result::Ok(Optional::None);
                }

                if !linux::abi::is_error(r) {
                    self.waited = 1;
                    return Result::Ok(Optional::Some(decode_status(status)));
                }

                if linux::abi::errno_of(r) != linux::abi::EINTR {
                    return Result::Err(error::from_syscall(r));
                }
            }
        }
    }
}

static if core::target::OS != core::target::Os::Freestanding {
    /// asks the child to terminate. the signal is honored on Linux and
    /// ignored on Windows, where termination is unconditional. does not
    /// reap: `wait` afterwards.
    public Status(Error) kill(Child* self, i32 signal) {
        if self.waited != 0 {
            return Status::Err(Error::BadHandle);
        }

        static if core::target::OS == core::target::Os::Windows {
            win::abi::Bool ok = win::imports::TerminateProcess(
                self.process as win::abi::Handle,
                1 as u32
            );

            if !win::abi::succeeded(ok) {
                return Status::Err(
                    error::from_win32(win::imports::GetLastError())
                );
            }

            return Status::Ok;
        } else {
            isize r = linux::syscall::kill(
                self.pid as linux::abi::Pid,
                signal
            );

            if linux::abi::is_error(r) {
                return Status::Err(error::from_syscall(r));
            }

            return Status::Ok;
        }
    }
}

Optional(usize) process_checked_add(usize a, usize b) {
    if b > (~(0 as usize)) - a { return Optional::None; }
    return Optional::Some(a + b);
}

Optional(usize) process_checked_mul(usize a, usize b) {
    if a != 0 && b > (~(0 as usize)) / a { return Optional::None; }
    return Optional::Some(a * b);
}
