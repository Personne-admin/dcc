//!!
//!! SHA-1 and SHA-2
//!!
//!! Streaming implementations of SHA-1, SHA-224, SHA-256, SHA-384 and
//!! SHA-512. Each hasher buffers a partial block internally, so `update`
//!! may be called with arbitrary chunk boundaries.
//!!
//!! SHA-1 is kept for interoperability with existing formats only. It is
//!! not collision resistant; do not use it for signatures or anything
//!! else where an adversary picks the input.
//!!

module std::sha;

import std::math;
import std::mem;
import std::slice;
public import std::result;

using result::{ Result, Status, Optional };

//!
//! Errors and lengths
//!

public enum ShaError : u8 {
    OutputTooSmall,
}

public using usize SHA1_DIGEST_LEN = 20;
public using usize SHA224_DIGEST_LEN = 28;
public using usize SHA256_DIGEST_LEN = 32;
public using usize SHA384_DIGEST_LEN = 48;
public using usize SHA512_DIGEST_LEN = 64;

public using usize SHA1_BLOCK_LEN = 64;
public using usize SHA256_BLOCK_LEN = 64;
public using usize SHA512_BLOCK_LEN = 128;

//!
//! Word access
//!

public u32 rotl32(u32 v, u32 n) {
    u32 k = n & 31;
    if k == 0 {
        return v;
    }

    return (v << k) | (v >> (32 - k));
}

public u32 rotr32(u32 v, u32 n) {
    return rotl32(v, 32 - (n & 31));
}

u32 load_be32([] const u8 bytes, usize at) {
    return ((bytes[at] as u32) << 24) | ((bytes[at + 1] as u32) << 16)
        | ((bytes[at + 2] as u32) << 8)
        | (bytes[at + 3] as u32);
}

u64 load_be64([] const u8 bytes, usize at) {
    u64 v = 0;

    for usize k = 0; k < 8; k++ {
        v = (v << 8) | (bytes[at + k] as u64);
    }

    return v;
}

void store_be32([] u8 out, usize at, u32 v) {
    out[at] = (v >> 24) as u8;
    out[at + 1] = (v >> 16) as u8;
    out[at + 2] = (v >> 8) as u8;
    out[at + 3] = v as u8;
}

void store_be64([] u8 out, usize at, u64 v) {
    for usize k = 0; k < 8; k++ {
        out[at + k] = (v >> ((56 - k * 8) as u64)) as u8;
    }
}

