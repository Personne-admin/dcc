//!
//! SHA-1
//!

public struct Sha1 {
    u32[5] state;
    u8[64] buffer;
    usize buffered;
    u64 length;
}

public Sha1 new_sha1() {
    Sha1 self;
    // Borrow explicitly as slices: implicit array decay copies, which
    // would leave the state uninitialized.
    mem::copy(self.state[0..5], IV1[0..5]);
    self.buffered = 0;
    self.length = 0;
    return self;
}
public using Sha1::new = new_sha1;

u32 sha1_f(usize round, u32 b, u32 c, u32 d) {
    if round < 20 {
        return (b & c) | (~b & d);
    }

    if round < 40 {
        return b ^ c ^ d;
    }

    if round < 60 {
        return (b & c) | (b & d) | (c & d);
    }

    return b ^ c ^ d;
}

u32 sha1_k(usize round) {
    if round < 20 {
        return 0x5A827999;
    }

    if round < 40 {
        return 0x6ED9EBA1;
    }

    if round < 60 {
        return 0x8F1BBCDC;
    }

    return 0xCA62C1D6;
}

void sha1_block(Sha1* self, [] const u8 block) {
    u32[80] w;

    for usize i = 0; i < 16; i++ {
        w[i] = load_be32(block, i * 4);
    }
    for usize i = 16; i < 80; i++ {
        w[i] = rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
    }

    u32 a = self.state[0];
    u32 b = self.state[1];
    u32 c = self.state[2];
    u32 d = self.state[3];
    u32 e = self.state[4];

    for usize i = 0; i < 80; i++ {
        u32 t = rotl32(a, 5) + sha1_f(i, b, c, d) + e + sha1_k(i) + w[i];
        e = d;
        d = c;
        c = rotl32(b, 30);
        b = a;
        a = t;
    }

    self.state[0] = self.state[0] + a;
    self.state[1] = self.state[1] + b;
    self.state[2] = self.state[2] + c;
    self.state[3] = self.state[3] + d;
    self.state[4] = self.state[4] + e;
}

public void update(Sha1* self, [] const u8 bytes) {
    // Slice explicitly: initializing from the bare array would copy.
    [] u8 buf = self.buffer[0..SHA1_BLOCK_LEN];
    usize i = 0;

    while i < bytes.len {
        if self.buffered == 0 && bytes.len - i >= SHA1_BLOCK_LEN {
            sha1_block(self, bytes[i..i + SHA1_BLOCK_LEN]);
            i = i + SHA1_BLOCK_LEN;
        } else {
            usize take = math::min(
                SHA1_BLOCK_LEN - self.buffered,
                bytes.len - i
            );

            mem::copy(
                buf[self.buffered..self.buffered + take],
                bytes[i..i + take]
            );
            self.buffered = self.buffered + take;
            i = i + take;

            if self.buffered == SHA1_BLOCK_LEN {
                sha1_block(self, buf);
                self.buffered = 0;
            }
        }
    }

    self.length = self.length + bytes.len as u64;
}

/// appends the padding and writes the digest. the hasher must not be
/// used again afterwards without being reset.
public Status(ShaError) finish(Sha1* self, [] u8 out) {
    if out.len < SHA1_DIGEST_LEN {
        return ShaError::OutputTooSmall;
    }

    u64 bits = self.length * 8;

    u8[1] mark = { 0x80 };
    self.update(mark);

    u8[1] pad = { 0x0 };
    while self.buffered != 56 {
        self.update(pad);
    }

    u8[8] tail;
    store_be64(tail[0..8], 0, bits);
    self.update(tail);

    for usize i = 0; i < 5; i++ {
        store_be32(out, i * 4, self.state[i]);
    }

    return Status::Ok;
}

public void reset(Sha1* self) {
    *self = new_sha1();
}

//!
//! SHA-224 and SHA-256
//!

public struct Sha256 {
    u32[8] state;
    u8[64] buffer;
    usize buffered;
    u64 length;
    usize digest_len;
}

public Sha256 new_sha256() {
    Sha256 self;
    // See new_sha1: borrow explicitly so the copy lands in state.
    mem::copy(self.state[0..8], IV256[0..8]);
    self.buffered = 0;
    self.length = 0;
    self.digest_len = SHA256_DIGEST_LEN;
    return self;
}
public using Sha256::new = new_sha256;

/// SHA-224 shares the SHA-256 compression function.
public Sha256 new_sha224() {
    Sha256 self;
    // See new_sha1: borrow explicitly so the copy lands in state.
    mem::copy(self.state[0..8], IV224[0..8]);
    self.buffered = 0;
    self.length = 0;
    self.digest_len = SHA224_DIGEST_LEN;
    return self;
}

public usize digest_len(const Sha256* self) {
    return self.digest_len;
}

void sha256_block(Sha256* self, [] const u8 block) {
    u32[64] w;

    for usize i = 0; i < 16; i++ {
        w[i] = load_be32(block, i * 4);
    }
    for usize i = 16; i < 64; i++ {
        u32 x = w[i - 15];
        u32 y = w[i - 2];
        u32 s0 = rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3);
        u32 s1 = rotr32(y, 17) ^ rotr32(y, 19) ^ (y >> 10);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }

    u32 a = self.state[0];
    u32 b = self.state[1];
    u32 c = self.state[2];
    u32 d = self.state[3];
    u32 e = self.state[4];
    u32 f = self.state[5];
    u32 g = self.state[6];
    u32 h = self.state[7];

    for usize i = 0; i < 64; i++ {
        u32 s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
        u32 ch = (e & f) ^ (~e & g);
        u32 t1 = h + s1 + ch + K256[i] + w[i];

        u32 s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
        u32 maj = (a & b) ^ (a & c) ^ (b & c);
        u32 t2 = s0 + maj;

        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }

    self.state[0] = self.state[0] + a;
    self.state[1] = self.state[1] + b;
    self.state[2] = self.state[2] + c;
    self.state[3] = self.state[3] + d;
    self.state[4] = self.state[4] + e;
    self.state[5] = self.state[5] + f;
    self.state[6] = self.state[6] + g;
    self.state[7] = self.state[7] + h;
}

public void update(Sha256* self, [] const u8 bytes) {
    // See Sha1::update: slice explicitly so buffered bytes are kept.
    [] u8 buf = self.buffer[0..SHA256_BLOCK_LEN];
    usize i = 0;

    while i < bytes.len {
        if self.buffered == 0 && bytes.len - i >= SHA256_BLOCK_LEN {
            sha256_block(self, bytes[i..i + SHA256_BLOCK_LEN]);
            i = i + SHA256_BLOCK_LEN;
        } else {
            usize take = math::min(
                SHA256_BLOCK_LEN - self.buffered,
                bytes.len - i
            );

            mem::copy(
                buf[self.buffered..self.buffered + take],
                bytes[i..i + take]
            );
            self.buffered = self.buffered + take;
            i = i + take;

            if self.buffered == SHA256_BLOCK_LEN {
                sha256_block(self, buf);
                self.buffered = 0;
            }
        }
    }

    self.length = self.length + bytes.len as u64;
}

public Status(ShaError) finish(Sha256* self, [] u8 out) {
    if out.len < self.digest_len {
        return ShaError::OutputTooSmall;
    }

    u64 bits = self.length * 8;

    u8[1] mark = { 0x80 };
    self.update(mark);

    u8[1] pad = { 0x0 };
    while self.buffered != 56 {
        self.update(pad);
    }

    u8[8] tail;
    store_be64(tail[0..8], 0, bits);
    self.update(tail);

    u8[32] full;
    // Slice explicitly so the stores below land in `full`.
    [] u8 view = full[0..32];
    for usize i = 0; i < 8; i++ {
        store_be32(view, i * 4, self.state[i]);
    }

    // SHA-224 keeps the leading 28 bytes of the same state
    mem::copy(out[0..self.digest_len], view[0..self.digest_len]);
    return Status::Ok;
}

public void reset(Sha256* self) {
    usize want = self.digest_len;
    *self = if want == SHA224_DIGEST_LEN {
        new_sha224()
    } else {
        new_sha256()
    };
}

//!
//! SHA-384 and SHA-512
//!

public struct Sha512 {
    u64[8] state;
    u8[128] buffer;
    usize buffered;
    u64 length;
    usize digest_len;
}

public Sha512 new_sha512() {
    Sha512 self;
    // See new_sha1: borrow explicitly so the copy lands in state.
    mem::copy(self.state[0..8], IV512[0..8]);
    self.buffered = 0;
    self.length = 0;
    self.digest_len = SHA512_DIGEST_LEN;
    return self;
}
public using Sha512::new = new_sha512;

public Sha512 new_sha384() {
    Sha512 self;
    // See new_sha1: borrow explicitly so the copy lands in state.
    mem::copy(self.state[0..8], IV384[0..8]);
    self.buffered = 0;
    self.length = 0;
    self.digest_len = SHA384_DIGEST_LEN;
    return self;
}

public usize digest_len(const Sha512* self) {
    return self.digest_len;
}

void sha512_block(Sha512* self, [] const u8 block) {
    u64[80] w;

    for usize i = 0; i < 16; i++ {
        w[i] = load_be64(block, i * 8);
    }
    for usize i = 16; i < 80; i++ {
        u64 x = w[i - 15];
        u64 y = w[i - 2];
        u64 s0 = math::rotr64(x, 1) ^ math::rotr64(x, 8) ^ (x >> 7);
        u64 s1 = math::rotr64(y, 19) ^ math::rotr64(y, 61) ^ (y >> 6);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }

    u64 a = self.state[0];
    u64 b = self.state[1];
    u64 c = self.state[2];
    u64 d = self.state[3];
    u64 e = self.state[4];
    u64 f = self.state[5];
    u64 g = self.state[6];
    u64 h = self.state[7];

    for usize i = 0; i < 80; i++ {
        u64 s1 = math::rotr64(e, 14) ^ math::rotr64(e, 18) ^ math::rotr64(e, 41);
        u64 ch = (e & f) ^ (~e & g);
        u64 t1 = h + s1 + ch + K512[i] + w[i];

        u64 s0 = math::rotr64(a, 28)
            ^ math::rotr64(a, 34)
            ^ math::rotr64(a, 39);
        u64 maj = (a & b) ^ (a & c) ^ (b & c);
        u64 t2 = s0 + maj;

        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }

    self.state[0] = self.state[0] + a;
    self.state[1] = self.state[1] + b;
    self.state[2] = self.state[2] + c;
    self.state[3] = self.state[3] + d;
    self.state[4] = self.state[4] + e;
    self.state[5] = self.state[5] + f;
    self.state[6] = self.state[6] + g;
    self.state[7] = self.state[7] + h;
}

public void update(Sha512* self, [] const u8 bytes) {
    // See Sha1::update: slice explicitly so buffered bytes are kept.
    [] u8 buf = self.buffer[0..SHA512_BLOCK_LEN];
    usize i = 0;

    while i < bytes.len {
        if self.buffered == 0 && bytes.len - i >= SHA512_BLOCK_LEN {
            sha512_block(self, bytes[i..i + SHA512_BLOCK_LEN]);
            i = i + SHA512_BLOCK_LEN;
        } else {
            usize take = math::min(
                SHA512_BLOCK_LEN - self.buffered,
                bytes.len - i
            );

            mem::copy(
                buf[self.buffered..self.buffered + take],
                bytes[i..i + take]
            );
            self.buffered = self.buffered + take;
            i = i + take;

            if self.buffered == SHA512_BLOCK_LEN {
                sha512_block(self, buf);
                self.buffered = 0;
            }
        }
    }

    self.length = self.length + bytes.len as u64;
}

/// the length field is 128 bits wide; the byte counter is 64 bits, so
/// the high half is always zero. inputs are limited to 2^61 - 1 bytes.
public Status(ShaError) finish(Sha512* self, [] u8 out) {
    if out.len < self.digest_len {
        return ShaError::OutputTooSmall;
    }

    u64 bits = self.length * 8;

    u8[1] mark = { 0x80 };
    self.update(mark);

    u8[1] pad = { 0x0 };
    while self.buffered != 112 {
        self.update(pad);
    }

    u8[16] tail;
    store_be64(tail[0..16], 0, 0);
    store_be64(tail[0..16], 8, bits);
    self.update(tail);

    u8[64] full;
    // Slice explicitly so the stores below land in `full`.
    [] u8 view = full[0..64];
    for usize i = 0; i < 8; i++ {
        store_be64(view, i * 8, self.state[i]);
    }

    mem::copy(out[0..self.digest_len], view[0..self.digest_len]);
    return Status::Ok;
}

public void reset(Sha512* self) {
    usize want = self.digest_len;
    *self = if want == SHA384_DIGEST_LEN {
        new_sha384()
    } else {
        new_sha512()
    };
}

//!
//! One-shot helpers
//!

public Status(ShaError) sha1([] const u8 data, [] u8 out) {
    Sha1 h = Sha1::new();
    h.update(data);
    return h.finish(out);
}

public Status(ShaError) sha224([] const u8 data, [] u8 out) {
    Sha256 h = new_sha224();
    h.update(data);
    return h.finish(out);
}

public Status(ShaError) sha256([] const u8 data, [] u8 out) {
    Sha256 h = Sha256::new();
    h.update(data);
    return h.finish(out);
}

public Status(ShaError) sha384([] const u8 data, [] u8 out) {
    Sha512 h = new_sha384();
    h.update(data);
    return h.finish(out);
}

public Status(ShaError) sha512([] const u8 data, [] u8 out) {
    Sha512 h = Sha512::new();
    h.update(data);
    return h.finish(out);
}

//!
//! Hex rendering
//!

u8 hex_digit(u8 nibble, bool uppercase) {
    if nibble < 10 {
        return ('0' as u8) + nibble;
    }

    return (
        if uppercase {
            'A' as u8
        } else {
            'a' as u8
        }
    ) + (nibble - 10);
}

/// writes `digest` as lowercase hex. `out` needs twice as many bytes.
public Status(ShaError) hex_encode([] const u8 digest, [] u8 out) {
    if out.len < digest.len * 2 {
        return ShaError::OutputTooSmall;
    }

    for usize i = 0; i < digest.len; i++ {
        out[i * 2] = hex_digit(digest[i] >> 4, false);
        out[i * 2 + 1] = hex_digit(digest[i] & 0xF, false);
    }

    return Status::Ok;
}
