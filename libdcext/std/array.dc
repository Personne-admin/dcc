module std::array;

import core::allocator_config;
import std::math;
import std::slice;
import std::alloc;
public import std::mem;
public import std::result;

using result::{ Result, Status, Optional };
using alloc::{ AllocError, AllocatorPolicy, as_bytes };

//!
//! Growable array
//!

public struct Array(T, A = DefaultAllocator) if AllocatorPolicy(A) {
    A alloc;
    [] T storage;
    usize count;
}

using usize MIN_CAPACITY = 8;

//!
//! Construction
//!

public Array(T) new_array(T)() {
    return {
        alloc = DefaultAllocator{},
        storage = slice::from_raw(null as T*, 0),
        count = 0,
    };
}

public Array(T, A) new_array(T, A)(A alloc) if AllocatorPolicy(A) {
    return {
        alloc = alloc,
        storage = slice::from_raw(null as T*, 0),
        count = 0,
    };
}

public Result(Array(T), AllocError) with_capacity(T)(
    usize capacity
) {
    Array(T) self = new_array();
    Status(AllocError) cap_st = self.reserve(capacity);
    if !cap_st.is_ok() {
        return cap_st.unwrap_err();
    }
    return Result::Ok(self);
}

public Result(Array(T, A), AllocError) with_capacity(T, A)(
    A alloc,
    usize capacity
) if AllocatorPolicy(A) {
    Array(T, A) self = new_array(alloc);
    Status(AllocError) cap_st = self.reserve(capacity);
    if !cap_st.is_ok() {
        return cap_st.unwrap_err();
    }
    return Result::Ok(self);
}

/// copies `source` into a new array.
public Result(Array(T), AllocError) from_slice(T)(
    [] const T source
) {
    Result(Array(T), AllocError) self_r = with_capacity(source.len);
    if self_r.is_err() {
        return self_r;
    }
    Array(T) self = self_r.unwrap();
    mem::copy(self.storage, source);
    self.count = source.len;
    return Result::Ok(self);
}

public Result(Array(T, A), AllocError) from_slice(T, A)(
    A alloc,
    [] const T source
) if AllocatorPolicy(A) {
    Result(Array(T, A), AllocError) self_r = with_capacity(alloc, source.len);
    if self_r.is_err() {
        return self_r;
    }
    Array(T, A) self = self_r.unwrap();
    mem::copy(self.storage, source);
    self.count = source.len;
    return Result::Ok(self);
}

/// releases the backing storage.
public void deinit(T, A)(Array(T, A)* self) {
    Array(T, A) b = *self;
    if b.storage.len > 0 {
        b.alloc.free_slice(b.storage);
    }

    b.storage = slice::from_raw(null as T*, 0);
    b.count = 0;
    *self = b;
}

//!
//! Access
//!

public [] T items(T, A)(Array(T, A)* self) {
    Array(T, A) b = *self;
    return b.storage[0..b.count];
}

public [] const T items(T, A)(const Array(T, A)* self) {
    Array(T, A) b = *self;
    return b.storage[0..b.count];
}

public usize len(T, A)(const Array(T, A)* self) {
    Array(T, A) b = *self;
    return b.count;
}

public usize capacity(T, A)(const Array(T, A)* self) {
    Array(T, A) b = *self;
    return b.storage.len;
}

public bool is_empty(T, A)(const Array(T, A)* self) {
    Array(T, A) b = *self;
    return b.count == 0;
}

public Optional(T*) at(T, A)(Array(T, A)* self, usize index) {
    Array(T, A) b = *self;
    if index >= b.count {
        return Optional::None;
    }

    return Optional::Some(&b.storage[index]);
}

public Optional(T) last(T, A)(const Array(T, A)* self) {
    Array(T, A) b = *self;
    if b.count == 0 {
        return Optional::None;
    }

    return Optional::Some(b.storage[b.count - 1]);
}

//!
//! Capacity
//!

public Status(AllocError) reserve(T, A)(Array(T, A)* self, usize needed) {
    Array(T, A) b = *self;
    if needed <= b.storage.len {
        return Status::Ok;
    }

    Optional(usize) doubled = array_checked_mul(b.storage.len, 2);
    if doubled.is_none() { return AllocError::OutOfMemory; }
    usize target = math::max(math::max(needed, MIN_CAPACITY), doubled.unwrap_some());
    Optional(usize) bytes = array_checked_mul(target, sizeof(T));
    if bytes.is_none() { return AllocError::OutOfMemory; }

    bool grown_in_place = b.storage.len > 0 && b.alloc.resize_in_place(
        as_bytes(b.storage),
        bytes.unwrap_some(),
        alignof (T)
    );
    if grown_in_place {
        b.storage = slice::from_raw(b.storage.ptr, target);
        *self = b;
        return Status::Ok;
    }

    Result([] T, AllocError) grown_r = b.alloc.allocate_slice(target);
    if grown_r.is_err() {
        return grown_r.unwrap_err();
    }
    [] T grown = grown_r.unwrap();
    mem::copy(grown, b.storage[0..b.count]);

    if b.storage.len > 0 {
        b.alloc.free_slice(b.storage);
    }

    b.storage = grown;
    *self = b;
    return Status::Ok;
}

/// releases capacity beyond the current length.
public Status(AllocError) shrink_to_fit(T, A)(Array(T, A)* self) {
    Array(T, A) b = *self;
    if b.count == b.storage.len {
        return Status::Ok;
    }

    if b.count == 0 {
        *self = b;
        self.deinit();
        return Status::Ok;
    }

    Result([] T, AllocError) tight_r = b.alloc.allocate_slice(b.count);
    if tight_r.is_err() {
        return tight_r.unwrap_err();
    }
    [] T tight = tight_r.unwrap();
    mem::copy(tight, b.storage[0..b.count]);
    b.alloc.free_slice(b.storage);
    b.storage = tight;
    *self = b;
    return Status::Ok;
}

//!
//! Mutation
//!

public Status(AllocError) push(T, A)(Array(T, A)* self, T value) {
    Array(T, A) b = *self;
    usize n = b.count;
    *self = b;
    Optional(usize) needed = array_checked_add(n, 1);
    if needed.is_none() { return AllocError::OutOfMemory; }
    Status(AllocError) push_st = self.reserve(needed.unwrap_some());
    if !push_st.is_ok() {
        return push_st.unwrap_err();
    }
    Array(T, A) c = *self;
    c.storage[n] = value;
    c.count = n + 1;
    *self = c;
    return Status::Ok;
}

public Optional(T) pop(T, A)(Array(T, A)* self) {
    Array(T, A) b = *self;
    if b.count == 0 {
        return Optional::None;
    }

    b.count--;
    T value = b.storage[b.count];
    *self = b;
    return Optional::Some(value);
}

public Status(AllocError) append_slice(T, A)(Array(T, A)* self, [] const T source) {
    Array(T, A) b = *self;
    usize n = b.count;
    *self = b;
    Optional(usize) needed = array_checked_add(n, source.len);
    if needed.is_none() { return AllocError::OutOfMemory; }
    Status(AllocError) app_st = self.reserve(needed.unwrap_some());
    if !app_st.is_ok() {
        return app_st.unwrap_err();
    }
    Array(T, A) c = *self;
    mem::copy(
        c.storage[n..c.storage.len],
        source
    );

    c.count = n + source.len;
    *self = c;
    return Status::Ok;
}

public Status(AllocError) insert(T, A)(Array(T, A)* self, usize index, T value) {
    Array(T, A) b = *self;
    usize n = b.count;
    *self = b;
    Optional(usize) needed = array_checked_add(n, 1);
    if needed.is_none() { return AllocError::OutOfMemory; }
    Status(AllocError) ins_st = self.reserve(needed.unwrap_some());
    if !ins_st.is_ok() {
        return ins_st.unwrap_err();
    }
    Array(T, A) c = *self;

    if index < n {
        mem::move(
            c.storage[index + 1..n + 1],
            c.storage[index..n]
        );
    }

    c.storage[index] = value;
    c.count = n + 1;
    *self = c;
    return Status::Ok;
}

/// removes the element at `index`, preserving order.
public Optional(T) remove(T, A)(Array(T, A)* self, usize index) {
    Array(T, A) b = *self;
    if index >= b.count {
        return Optional::None;
    }

    T value = b.storage[index];
    mem::move(
        b.storage[index..b.count - 1],
        b.storage[index + 1..b.count]
    );

    b.count--;
    *self = b;
    return Optional::Some(value);
}

/// removes the element at `index` in constant time by moving the last
/// element into the hole.
public Optional(T) swap_remove(T, A)(Array(T, A)* self, usize index) {
    Array(T, A) b = *self;
    if index >= b.count {
        return Optional::None;
    }

    T value = b.storage[index];
    b.count--;

    if index != b.count {
        b.storage[index] = b.storage[b.count];
    }

    *self = b;
    return Optional::Some(value);
}

/// grows or shrinks the length.
public Status(AllocError) resize(T, A)(Array(T, A)* self, usize new_len) {
    Array(T, A) b = *self;
    if new_len > b.count {
        usize want = new_len;
        *self = b;
        Status(AllocError) rsz_st = self.reserve(want);
        if !rsz_st.is_ok() {
            return rsz_st.unwrap_err();
        }
        Array(T, A) c = *self;
        c.count = want;
        *self = c;
        return Status::Ok;
    }

    b.count = new_len;
    *self = b;
    return Status::Ok;
}

public void clear(T, A)(Array(T, A)* self) {
    Array(T, A) b = *self;
    b.count = 0;
    *self = b;
}

/// hands the storage to the caller and empties the array.
public Result([] T, AllocError) to_owned_slice(T, A)(Array(T, A)* self) {
    Status(AllocError) own_st = self.shrink_to_fit();
    if !own_st.is_ok() {
        return own_st.unwrap_err();
    }

    Array(T, A) b = *self;
    [] T out = b.storage[0..b.count];
    Array(T, A) empty = {
        alloc = b.alloc,
        storage = slice::from_raw(null as T*, 0),
        count = 0,
    };
    *self = empty;
    return Result::Ok(out);
}

Optional(usize) array_checked_add(usize a, usize b) {
    if b > (~(0 as usize)) - a { return Optional::None; }
    return Optional::Some(a + b);
}

Optional(usize) array_checked_mul(usize a, usize b) {
    if a != 0 && b > (~(0 as usize)) / a { return Optional::None; }
    return Optional::Some(a * b);
}
