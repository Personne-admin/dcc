module std::fmt;

import core;
import core::meta;
import core::target;
import std::math;
import std::mem;
import std::slice;
import std::utf8;
public import std::result;

using result::{ Result, Status, Optional };

//!
//! Writer concept
//!
//! a writer is any type with one accessible `write_all` taking its
//! receiver and the bytes and returning a status whose error type can be
//! projected out. everything below instantiates per writer type; the
//! shared conversion and parsing code stays ordinary.
//!

public using WriteStatus(W) = typeof((null as W*).write_all(""));
public using WriterError(W) = core::meta::type_argument(WriteStatus(W), 0);

public using Writer(W) = compiles (W* writer, [] const char bytes) {
    Status(WriterError(W)) result = writer.write_all(bytes);
};

//!
//! Errors
//!

/// errors the formatter itself reports; a writer failure keeps its own
/// error value in `Write`.
public enum FormatError(E) {
    BadFormat,
    WidthOverflow,
    @implicit_construction Write(E),
}

public enum BufferError : u8 {
    OutOfSpace,
}

public enum CountError : u8 {
    Overflow,
}

/// why a format string cannot be parsed. `next` reports it; the entry
/// maps it into `FormatError`.
public enum ParseError : u8 {
    Malformed,
    Overflow,
}

/// a format string wider or more precise than this would need unbounded
/// stack space in the float staging buffer.
using usize MAX_PRECISION = 64;

//!
//! Chunk writers
//!

public Status(WriterError(W)) write_byte(W)(W* self, char byte) if Writer(W) {
    char[1] one = { byte };
    return self.write_all(one);
}

public Status(FormatError(WriterError(W))) write_codepoint(W)(W* self, u32 cp) if Writer(W) {
    char[4] buf;
    [] char view = buf;

    return match utf8::encode(cp, view) {
        Result::Ok(n) => {
            self.write_all(view[0..n]) ?;
            Status::Ok
        },
        Result::Err(_) => Status::Err(FormatError::BadFormat),
    };
}

using usize REPEAT_CHUNK = 32;

/// writes `byte` `times` times from a bounded local chunk, so a wide
/// field never needs a width-sized buffer.
public Status(WriterError(W)) write_repeat(W)(W* self, char byte, usize times) if Writer(W) {
    char[REPEAT_CHUNK] chunk;
    [] const char view = chunk;
    usize remaining = times;

    for usize i = 0; i < REPEAT_CHUNK; i++ {
        chunk[i] = byte;
    }

    while remaining > 0 {
        usize count = if remaining < REPEAT_CHUNK {
            remaining
        } else {
            REPEAT_CHUNK
        };

        self.write_all(view[0..count]) ?;
        remaining = remaining - count;
    }

    return Status::Ok;
}

//!
//! Buffer writers
//!

public struct BufferWriter {
    [] char buffer;
    usize written;
    bool overflowed;
}

public Status(BufferError) write_all(BufferWriter* self, [] const char bytes) {
    if bytes.len > self.buffer.len - self.written {
        self.overflowed = true;
        return Status::Err(BufferError::OutOfSpace);
    }

    mem::copy(
        self.buffer[self.written..self.buffer.len],
        bytes
    );
    self.written = self.written + bytes.len;
    return Status::Ok;
}

public BufferWriter new_buffer_writer([] char backing) {
    return {buffer = backing, written = 0, overflowed = false};
}
public using BufferWriter::new = new_buffer_writer;

/// the bytes written so far.
public [] const char written_slice(const BufferWriter* self) {
    return self.buffer[0..self.written];
}

//!
//! Counting writer
//!

public struct CountingWriter {
    usize count;
}

public Status(CountError) write_all(CountingWriter* self, [] const char bytes) {
    Optional(usize) count = fmt_checked_add(self.count, bytes.len);
    if count.is_none() { return Status::Err(CountError::Overflow); }
    self.count = count.unwrap_some();
    return Status::Ok;
}

public CountingWriter new_counting_writer() {
    return CountingWriter {count = 0};
}
public using CountingWriter::new = new_counting_writer;

//!
//! Format options
//!

public enum Align : u8 {
    Left,
    Right,
    Center,
}

public struct Options {
    char fill;
    Align align;
    u8 base;
    bool uppercase;
    bool plus_sign;
    bool zero_pad;
    bool scientific;
    char spec;
    usize width;
    usize precision;
}


public using usize NO_PRECISION = ~(0 as usize);

public Options default_options() {
    return Options {
        fill = ' ' as char,
        align = Align::Right,
        base = 10,
        uppercase = false,
        plus_sign = false,
        zero_pad = false,
        scientific = false,
        spec = '\0',
        width = 0,
        precision = NO_PRECISION,
    };
}
public using Options::default = default_options;

//!
//! Padding
//!

public Status(WriterError(W)) write_padded(W)(
    W* w,
    [] const char body,
    const Options* opts
) if Writer(W) {
    if body.len >= opts.width {
        return w.write_all(body);
    }

    usize slack = opts.width - body.len;

    match opts.align {
        Align::Left => {
            w.write_all(body) ?;
            w.write_repeat(opts.fill, slack) ?;
        },
        Align::Right => {
            w.write_repeat(opts.fill, slack) ?;
            w.write_all(body) ?;
        },
        Align::Center => {
            w.write_repeat(opts.fill, slack / 2) ?;
            w.write_all(body) ?;
            w.write_repeat(opts.fill, slack - slack / 2) ?;
        },
    }

    return Status::Ok;
}

//!
//! Integers
//!

char digit_char(u64 value, bool uppercase) {
    if value < 10 {
        return (('0' as u8) + value as u8) as char;
    }
    u8 base = if uppercase { 'A' as u8 } else { 'a' as u8 };
    return (base + (value - 10) as u8) as char;
}

/// renders `value` into `scratch` and returns the populated tail.
[] char render_unsigned(u64 value, [] char scratch, const Options* opts) {
    usize i = scratch.len;
    u64 v = value;
    u64 base = opts.base as u64;

    if v == 0 {
        i--;
        scratch[i] = '0' as char;
    }

    while v > 0 {
        i--;
        scratch[i] = digit_char(v % base, opts.uppercase);
        v = v / base;
    }

    return scratch[i..scratch.len];
}

using usize INTEGER_SCRATCH = 72;

/// the chunk order for one rendered integer. the digits live in a
/// separate scratch: an opaque writer call that receives a slice of the
/// scratch must not make the still-needed plan fields unknown when the
/// formatter runs at compile time.
struct IntegerPlan {
    usize start;
    usize len;
    char sign;
    char fill;
    usize fill_before;
    usize zeros;
    usize fill_after;
}

void plan_unsigned(IntegerPlan* self, [] char scratch, u64 value, const Options* opts) {
    [] char rendered = render_unsigned(value, scratch, opts);
    self.len = rendered.len;
    self.start = INTEGER_SCRATCH - rendered.len;
    self.sign = '\0';
    self.fill = opts.fill;
    self.fill_before = 0;
    self.zeros = 0;
    self.fill_after = 0;

    if opts.width > self.len {
        usize slack = opts.width - self.len;
        if opts.zero_pad && opts.align == Align::Right {
            self.zeros = slack;
        } else if opts.align == Align::Left {
            self.fill_after = slack;
        } else if opts.align == Align::Center {
            self.fill_before = slack / 2;
            self.fill_after = slack - slack / 2;
        } else {
            self.fill_before = slack;
        }
    }
}

void plan_signed(IntegerPlan* self, [] char scratch, i64 value, const Options* opts) {
    bool negative = value < 0;
    u64 magnitude = if negative {
        (0 - value) as u64
    } else {
        value as u64
    };

    [] char rendered = render_unsigned(magnitude, scratch, opts);
    self.len = rendered.len;
    self.start = INTEGER_SCRATCH - rendered.len;
    self.sign = if negative {
        '-' as char
    } else {
        if opts.plus_sign {
            '+' as char
        } else {
            '\0'
        }
    };

    self.fill = opts.fill;
    self.fill_before = 0;
    self.zeros = 0;
    self.fill_after = 0;

    usize total = self.len + if self.sign != '\0' {
        1 as usize
    } else {
        0 as usize
    };

    if opts.zero_pad && total < opts.width && opts.align == Align::Right {
        self.zeros = opts.width - total;
        return;
    }

    if self.sign == '\0' {
        if opts.width > self.len {
            usize slack = opts.width - self.len;
            if opts.align == Align::Left {
                self.fill_after = slack;
            } else if opts.align == Align::Center {
                self.fill_before = slack / 2;
                self.fill_after = slack - slack / 2;
            } else {
                self.fill_before = slack;
            }
        }

        return;
    }

    if total < opts.width && opts.align == Align::Right {
        self.fill_before = opts.width - total;
    }

    if total < opts.width && opts.align == Align::Left {
        self.fill_after = opts.width - total;
    }
}

Status(WriterError(W)) emit_integer(W)(W* w, const IntegerPlan* self, [] const char digits) if Writer(W) {
    if self.fill_before > 0 {
        w.write_repeat(self.fill, self.fill_before) ?;
    }

    if self.sign != '\0' {
        w.write_byte(self.sign) ?;
    }

    if self.zeros > 0 {
        w.write_repeat('0' as char, self.zeros) ?;
    }

    if self.len > 0 {
        w.write_all(digits[self.start..self.start + self.len]) ?;
    }

    if self.fill_after > 0 {
        w.write_repeat(self.fill, self.fill_after) ?;
    }

    return Status::Ok;
}

public Status(WriterError(W)) format_unsigned(W)(
    W* w,
    u64 value,
    const Options* opts
) if Writer(W) {
    IntegerPlan plan;
    char[INTEGER_SCRATCH] scratch;
    [] char view = scratch;
    plan_unsigned(&plan, view, value, opts);
    return emit_integer(w, &plan, view);
}

public Status(WriterError(W)) format_signed(W)(
    W* w,
    i64 value,
    const Options* opts
) if Writer(W) {
    IntegerPlan plan;
    char[INTEGER_SCRATCH] scratch;
    [] char view = scratch;
    plan_signed(&plan, view, value, opts);
    return emit_integer(w, &plan, view);
}

//!
//! Floats
//!

public using usize DEFAULT_PRECISION = 6;

static if core::target::FLOAT_AVAILABLE {
    Status(WriterError(W)) write_special(W)(W* w, f64 value, const Options* opts) if Writer(W) {
        if math::is_nan(value) {
            return write_padded(w, "nan", opts);
        }

        if math::signbit(value) {
            return write_padded(w, "-inf", opts);
        }

        return write_padded(
            w,
            if opts.plus_sign {
                "+inf"
            } else {
                "inf"
            },
            opts
        );
    }

    /// stages the whole float text in the buffer. the buffer is sized for
    /// the integral bound and MAX_PRECISION digits, so a formatter-produced
    /// precision cannot overflow it.
    Status(BufferError) stage_float(BufferWriter* sink, f64 value, const Options* opts, usize precision) {
        f64 v = value;
        if math::signbit(v) {
            sink.write_byte('-' as char) ?;
            v = -v;
        } else if opts.plus_sign {
            sink.write_byte('+' as char) ?;
        }

        i32 exponent = 0;
        if opts.scientific && v != 0.0 {
            exponent = math::floor(math::log10(v)) as i32;
            v = v / math::pow(10.0, exponent as f64);

            if v >= 10.0 {
                v = v / 10.0;
                exponent++;
            }
            if v < 1.0 {
                v = v * 10.0;
                exponent--;
            }
        }

        write_fixed(sink, v, precision) ?;

        if opts.scientific {
            sink.write_byte(
                if opts.uppercase {
                    'E' as char
                } else {
                    'e' as char
                }
            ) ?;
            sink.write_byte(
                if exponent < 0 {
                    '-' as char
                } else {
                    '+' as char
                }
            ) ?;

            Options exp_opts = Options::default();
            exp_opts.width = 2;
            exp_opts.zero_pad = true;
            format_unsigned(
                sink,
                if exponent < 0 {
                    (0 - exponent) as u64
                } else {
                    exponent as u64
                },
                &exp_opts
            ) ?;
        }

        return Status::Ok;
    }

    public Status(FormatError(WriterError(W))) format_float(W)(
        W* w,
        f64 value,
        const Options* opts
    ) if Writer(W) {
        if !math::is_finite(value) {
            write_special(w, value, opts) ?;
            return Status::Ok;
        }

        char[512] scratch;
        [] char view = scratch;
        BufferWriter sink = BufferWriter::new(view);

        usize precision = if opts.precision == NO_PRECISION { DEFAULT_PRECISION } else { opts.precision };
        if precision > MAX_PRECISION {
            return Status::Err(FormatError::WidthOverflow);
        }

        match stage_float(&sink, value, opts, precision) {
            Status::Ok => {},
            Status::Err(_) => return Status::Err(FormatError::WidthOverflow),
        }

        write_padded(w, sink.written_slice(), opts) ?;
        return Status::Ok;
    }

    Status(BufferError) write_fixed(BufferWriter* w, f64 value, usize precision) {
        f64 rounded = value + 0.5 * math::pow(10.0, -(precision as f64));

        f64 integral = math::floor(rounded);
        f64 fraction = rounded - integral;

        Options plain = Options::default();

        if integral < 1.8446744073709552e19 {
            format_unsigned(w, integral as u64, &plain) ?;
        } else {
            w.write_all("<overflow>") ?;
        }

        if precision == 0 {
            return Status::Ok;
        }

        w.write_byte('.' as char) ?;

        f64 f = fraction;
        for usize i = 0; i < precision; i++ {
            f = f * 10.0;
            f64 digit = math::floor(f);
            w.write_byte((('0' as u32) + digit as u32) as char) ?;
            f = f - digit;
        }

        return Status::Ok;
    }
}

//!
//! JSON escaping
//!
//! literal runs come from the input, escape sequences from a small fixed
//! buffer, so a writer only hands bytes on and no intermediate string is
//! built.
//!

public enum JsonEscapePhase : u8 {
    Open,
    Body,
    Close,
    Done,
}

public struct JsonEscapeCursor {
    [] const char text;
    usize index;
    usize literal_start;
    char[8] pending;
    usize pending_len;
    JsonEscapePhase phase;
}

public JsonEscapeCursor new_json_escape([] const char text) {
    return {
        text = text,
        index = 0,
        literal_start = 0,
        pending = {},
        pending_len = 0,
        phase = JsonEscapePhase::Open,
    };
}

char hex_digit(u32 nibble) {
    if nibble < 10 {
        return (('0' as u32) + nibble) as char;
    }

    return (('a' as u32) + nibble - 10) as char;
}

void fill_escape(JsonEscapeCursor* self, char c) {
    self.pending[0] = '\\' as char;
    self.pending_len = 2;

    if c == ('"' as char) {
        self.pending[1] = '"' as char;
        return;
    }

    if c == ('\\' as char) {
        self.pending[1] = '\\' as char;
        return;
    }

    if c == ('\n' as char) {
        self.pending[1] = 'n' as char;
        return;
    }

    if c == ('\r' as char) {
        self.pending[1] = 'r' as char;
        return;
    }

    if c == ('\t' as char) {
        self.pending[1] = 't' as char;
        return;
    }

    if c == '\x08' {
        self.pending[1] = 'b' as char;
        return;
    }

    if c == '\x0c' {
        self.pending[1] = 'f' as char;
        return;
    }

    self.pending_len = 6;
    self.pending[1] = 'u' as char;
    self.pending[2] = '0' as char;
    self.pending[3] = '0' as char;
    self.pending[4] = hex_digit((c as u8 >> 4) as u32);
    self.pending[5] = hex_digit((c as u8 & 0xF) as u32);
}

/// next chunk of a quoted JSON string, or an empty slice when finished.
public [] const char next(JsonEscapeCursor* self) {
    if self.phase == JsonEscapePhase::Done {
        return self.text[0..0];
    }

    if self.phase == JsonEscapePhase::Open {
        self.phase = JsonEscapePhase::Body;
        self.pending[0] = '"' as char;
        self.pending_len = 1;
        return self.pending[0..1];
    }

    if self.phase == JsonEscapePhase::Body {
        while self.index < self.text.len {
            char c = self.text[self.index];
            if c != ('"' as char) && c != ('\\' as char) && (c as u8) >= 0x20 {
                self.index++;
                continue;
            }

            if self.index > self.literal_start {
                [] const char piece = self.text[self.literal_start..self.index];
                self.literal_start = self.index;
                return piece;
            }

            fill_escape(self, c);
            self.index++;
            self.literal_start = self.index;
            return self.pending[0..self.pending_len];
        }

        if self.text.len > self.literal_start {
            [] const char piece = self.text[self.literal_start..self.text.len];
            self.literal_start = self.text.len;
            self.index = self.text.len;
            return piece;
        }

        self.phase = JsonEscapePhase::Close;
    }

    self.phase = JsonEscapePhase::Done;
    self.pending[0] = '"' as char;
    self.pending_len = 1;
    return self.pending[0..1];
}

//!
//! Value dispatch
//!

public Status(FormatError(WriterError(W))) format_value(W, T)(
    W* w,
    T value,
    const Options* opts
) if Writer(W) {
    static if T == bool || T == u8 || T == u16 || T == u32 || T == u64 || T == usize || T == char || T == i8 || T == i16 || T == i32 || T == i64 || T == isize {
        static if T == bool {
            format_builtin_unsigned(w, value, opts) ?;
        } else static if compiles (T t) {
            t as u64;
            t - t;
        } {
            // unsigned when subtracting cannot produce a negative
            static if T == u8 || T == u16 || T == u32 || T == u64 || T == usize || T == char {
                format_builtin_unsigned(w, value, opts) ?;
            } else {
                format_signed(w, value as i64, opts) ?;
            }
        } else {
            format_signed(w, value as i64, opts) ?;
        }
    } else static if core::target::FLOAT_AVAILABLE {
        static if T == f32 || T == f64 {
            format_float(w, value as f64, opts) ?;
        } else {
            format_other(w, value, opts) ?;
        }
    } else {
        format_other(w, value, opts) ?;
    }
    return Status::Ok;
}

Status(WriterError(W)) format_other(W, T)(W* w, T value, const Options* opts) if Writer(W) {
    static if T == [] const char {
        write_padded(w, value as [] const char, opts) ?;
    } else static if compiles (T t, W* q, const Options* o) {
        t.format(q, o);
    } {
        value.format(w, opts) ?;
    } else {
        core::compile_error(
            "type is not formattable: add format(const T*, W*, const Options*)"
        );
    }

    return Status::Ok;
}

Status(WriterError(W)) format_builtin_unsigned(W, T)(
    W* w,
    T value,
    const Options* opts
) if Writer(W) {
    static if T == bool {
        return write_padded(
            w,
            if value {
                "true"
            } else {
                "false"
            },
            opts
        );
    } else static if T == char {
        if opts.spec == ('c' as char) || opts.spec == '\0' {
            char[1] one = { value as char };
            return write_padded(w, one, opts);
        }
        return format_unsigned(w, value as u64, opts);
    } else {
        return format_unsigned(w, value as u64, opts);
    }
}

//!
//! Placeholder parsing
//!

struct Chunk {
    usize cursor;
    Options opts;
    bool found;
}

/// one token of a format string: literal bytes to emit, the options of the
/// next placeholder, or the end of the format. the cursor itself is
/// ordinary code, so a formatter instantiated for many writers shares it.
public struct FormatStep {
    [] const char literal;
    Options opts;
    bool placeholder;
    bool done;
}

public struct FormatCursor {
    [] const char format;
    usize cursor;
    usize literal_start;
    usize spec_at;
    bool have_spec;
    bool done;
}

public FormatCursor new_format_cursor([] const char format) {
    return {
        format = format,
        cursor = 0,
        literal_start = 0,
        spec_at = 0,
        have_spec = false,
        done = false,
    };
}

/// advances to the next literal run or placeholder. a doubled brace is
/// returned as its own literal run; the caller keeps asking until it gets
/// a placeholder or the end.
public Result(FormatStep, ParseError) next(FormatCursor* self) {
    if self.done {
        FormatStep end = {
            literal = self.format[0..0],
            opts = Options::default(),
            placeholder = false,
            done = true,
        };
        return Result::Ok(end);
    }

    if self.have_spec {
        self.have_spec = false;
        Result(Chunk, ParseError) parsed = parse_spec(self.format, self.spec_at);
        if parsed.is_err() {
            self.done = true;
            return parsed.unwrap_err();
        }

        Chunk chunk = parsed.unwrap();
        self.cursor = chunk.cursor;
        self.literal_start = chunk.cursor;
        FormatStep step = {
            literal = self.format[0..0],
            opts = chunk.opts,
            placeholder = true,
            done = false,
        };
        return Result::Ok(step);
    }

    usize i = self.cursor;
    while i < self.format.len {
        char c = self.format[i];

        if c == ('{' as char) {
            if i + 1 < self.format.len && self.format[i + 1] == ('{' as char) {
                [] const char piece = self.format[self.literal_start..i + 1];
                self.cursor = i + 2;
                self.literal_start = i + 2;
                FormatStep step = {
                    literal = piece,
                    opts = Options::default(),
                    placeholder = false,
                    done = false,
                };
                return Result::Ok(step);
            }

            if i > self.literal_start {
                [] const char piece = self.format[self.literal_start..i];
                self.spec_at = i + 1;
                self.have_spec = true;
                self.cursor = i + 1;
                self.literal_start = i;
                FormatStep step = {
                    literal = piece,
                    opts = Options::default(),
                    placeholder = false,
                    done = false,
                };
                return Result::Ok(step);
            }

            Result(Chunk, ParseError) parsed = parse_spec(self.format, i + 1);
            if parsed.is_err() {
                self.done = true;
                return parsed.unwrap_err();
            }

            Chunk chunk = parsed.unwrap();
            self.cursor = chunk.cursor;
            self.literal_start = chunk.cursor;
            FormatStep step = {
                literal = self.format[0..0],
                opts = chunk.opts,
                placeholder = true,
                done = false,
            };
            return Result::Ok(step);
        }

        if c == ('}' as char) && i + 1 < self.format.len && self.format[i + 1] == ('}' as char) {
            [] const char piece = self.format[self.literal_start..i + 1];
            self.cursor = i + 2;
            self.literal_start = i + 2;
            FormatStep step = {
                literal = piece,
                opts = Options::default(),
                placeholder = false,
                done = false,
            };
            return Result::Ok(step);
        }

        i++;
    }

    self.cursor = self.format.len;
    self.done = true;
    [] const char piece = self.format[self.literal_start..self.format.len];
    self.literal_start = self.format.len;
    FormatStep step = {
        literal = piece,
        opts = Options::default(),
        placeholder = false,
        done = true,
    };
    return Result::Ok(step);
}

Result(Chunk, ParseError) parse_spec([] const char fmt, usize from) {
    Options opts = Options::default();
    usize i = from;

    // placeholders may use an explicit `:` separator before the spec
    // (`{:x}`), or give the spec directly (`{x}`). skip the separator so
    // the option parsing below sees the same shape either way.
    if i < fmt.len && fmt[i] == (':' as char) {
        i++;
    }

    if i < fmt.len && fmt.len - i > 1 && is_align(fmt[i + 1]) {
        opts.fill = fmt[i];
        opts.align = align_of(fmt[i + 1]);
        i = i + 2;
    } else if i < fmt.len && is_align(fmt[i]) {
        opts.align = align_of(fmt[i]);
        i++;
    }

    if i < fmt.len && fmt[i] == ('+' as char) {
        opts.plus_sign = true;
        i++;
    }

    if i < fmt.len && fmt[i] == ('0' as char) {
        opts.zero_pad = true;
        i++;
    }

    while i < fmt.len && is_digit(fmt[i]) {
        Optional(usize) scaled = fmt_checked_mul(opts.width, 10);
        if scaled.is_none() { return ParseError::Overflow; }
        Optional(usize) width = fmt_checked_add(scaled.unwrap_some(), (fmt[i] as u32 - ('0' as u32)) as usize);
        if width.is_none() { return ParseError::Overflow; }
        opts.width = width.unwrap_some();
        i++;
    }

    if i < fmt.len && fmt[i] == ('.' as char) {
        i++;
        usize precision = 0;
        while i < fmt.len && is_digit(fmt[i]) {
            Optional(usize) scaled = fmt_checked_mul(precision, 10);
            if scaled.is_none() { return ParseError::Overflow; }
            Optional(usize) parsed = fmt_checked_add(scaled.unwrap_some(), (fmt[i] as u32 - ('0' as u32)) as usize);
            if parsed.is_none() { return ParseError::Overflow; }
            precision = parsed.unwrap_some();
            i++;
        }
        if precision > MAX_PRECISION {
            return ParseError::Overflow;
        }
        opts.precision = precision;
    }

    if i < fmt.len && fmt[i] != ('}' as char) {
        opts.spec = fmt[i];
        apply_spec(&opts, fmt[i]);
        i++;
    }

    if i >= fmt.len || fmt[i] != ('}' as char) {
        return ParseError::Malformed;
    }

    return Result::Ok({cursor = i + 1, opts = opts, found = true});
}

void apply_spec(Options* opts, char spec) {
    match spec as char {
        'x' => opts.base = 16,
        'X' => {
            opts.base = 16;
            opts.uppercase = true;
        },
        'o' => opts.base = 8,
        'b' => opts.base = 2,
        'e' => opts.scientific = true,
        'E' => {
            opts.scientific = true;
            opts.uppercase = true;
        },
        'p' => {
            opts.base = 16;
            opts.zero_pad = true;
            opts.width = 16;
        },
        _ => {},
    }
}

bool is_digit(char c) {
    return c >= ('0' as char) && c <= ('9' as char);
}

bool is_align(char c) {
    return c == ('<' as char) || c == ('>' as char) || c == ('^' as char);
}

Align align_of(char c) {
    return match c as char {
        '<' => Align::Left,
        '^' => Align::Center,
        _ => Align::Right,
    };
}

//!
//! Entry points
//!

/// validates the whole format before the first byte is written. the
/// returned kind says whether the string is malformed, needs more width
/// than usize can carry, or has more placeholders than arguments.
enum FormatIssue : u8 {
    Clean,
    Malformed,
    Overflow,
    MissingArgument,
}

FormatIssue validate_format([] const char fmt, usize arg_count) {
    FormatCursor cursor = new_format_cursor(fmt);
    usize placeholders = 0;
    bool finished = false;

    while !finished {
        Result(FormatStep, ParseError) parsed = next(&cursor);
        if parsed.is_err() {
            return match parsed.unwrap_err() {
                ParseError::Overflow => FormatIssue::Overflow,
                _ => FormatIssue::Malformed,
            };
        }

        FormatStep step = parsed.unwrap();
        if step.placeholder {
            placeholders = placeholders + 1;
            if placeholders > arg_count {
                return FormatIssue::MissingArgument;
            }
        }

        finished = step.done;
    }

    return FormatIssue::Clean;
}

/// the next token of a validated format; validation rules out the parser
/// errors, but the status still carries them.
Status(FormatError(WriterError(W))) next_step(W)(W* w, FormatCursor* cursor, FormatStep* out) if Writer(W) {
    Result(FormatStep, ParseError) parsed = next(cursor);
    if parsed.is_err() {
        return match parsed.unwrap_err() {
            ParseError::Overflow => Status::Err(FormatError::WidthOverflow),
            _ => Status::Err(FormatError::BadFormat),
        };
    }

    *out = parsed.unwrap();
    return Status::Ok;
}

/// formats `args` through `w`. the format string is validated first, so a
/// malformed or too-narrow format writes nothing.
public Status(FormatError(WriterError(W))) format(W, T...)(W* w, [] const char fmt, T args) if Writer(W) {
    match validate_format(fmt, sizeof...(T)) {
        FormatIssue::Clean => {},
        FormatIssue::Overflow => return Status::Err(FormatError::WidthOverflow),
        _ => return Status::Err(FormatError::BadFormat),
    }

    FormatCursor cursor = new_format_cursor(fmt);

    static for arg in args {
        bool placed = false;
        while !placed {
            FormatStep step;
            next_step(w, &cursor, &step) ?;
            if step.literal.len > 0 {
                w.write_all(step.literal) ?;
            }

            if step.placeholder {
                format_value(w, arg, &step.opts) ?;
                placed = true;
            } else if step.done {
                placed = true;
            }
        }
    }

    bool finished = false;
    while !finished {
        FormatStep step;
        next_step(w, &cursor, &step) ?;
        if step.literal.len > 0 {
            w.write_all(step.literal) ?;
        }

        if step.placeholder {
            return Status::Err(FormatError::BadFormat);
        }

        finished = step.done;
    }

    return Status::Ok;
}

/// formats into `out` and returns the bytes written.
public Result([] char, FormatError(BufferError)) format_buf(T...)(
    [] char out,
    [] const char fmt,
    T args
) {
    BufferWriter sink = BufferWriter::new(out);
    match format(&sink, fmt, args...) {
        Status::Err(e) => return e,
        _ => {},
    }

    return Result::Ok(out[0..sink.written]);
}

/// byte length the formatted output would occupy.
public Result(usize, FormatError(CountError)) format_len(T...)([] const char fmt, T args) {
    CountingWriter sink = CountingWriter::new();
    match format(&sink, fmt, args...) {
        Status::Err(e) => return e,
        _ => {},
    }

    return Result::Ok(sink.count);
}

/// formats into freshly allocated storage owned by the caller.
public Result([] char, mem::AllocError) format_alloc(T...)(
    const mem::Allocator* alloc,
    [] const char fmt,
    T args
) {
    CountingWriter counter = CountingWriter::new();

    match format(&counter, fmt, args...) {
        Status::Err(_) => return mem::AllocError::OutOfMemory,
        _ => {},
    }

    [] char buffer = alloc.alloc(counter.count) ?;
    BufferWriter sink = BufferWriter::new(buffer);

    match format(&sink, fmt, args...) {
        Status::Err(_) => {
            alloc.free(buffer);
            return mem::AllocError::OutOfMemory;
        },
        _ => {},
    }

    return Result::Ok(buffer);
}

Optional(usize) fmt_checked_add(usize a, usize b) {
    if b > (~(0 as usize)) - a { return Optional::None; }
    return Optional::Some(a + b);
}

Optional(usize) fmt_checked_mul(usize a, usize b) {
    if a != 0 && b > (~(0 as usize)) / a { return Optional::None; }
    return Optional::Some(a * b);
}
