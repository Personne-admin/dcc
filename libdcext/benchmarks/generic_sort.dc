module main;
import std::sort;
i32 algorithm(T)(T seed) {
    T[128] values;
    for usize i = 0; i < 128; i++ { values[i] = ((127-i) as T) + seed; }
    std::sort::sort(values[0..128]);
    for usize i = 0; i < 128; i++ { if values[i] != (i as T) + seed { return 1; } }
    return 0;
}
public i32 main() {
    for usize round = 0; round < 20000; round++ {
        if algorithm(1 as i32) != 0 { return 1; }
        if algorithm(1 as u32) != 0 { return 2; }
        if algorithm(1 as i64) != 0 { return 3; }
        if algorithm(1 as u64) != 0 { return 4; }
        if algorithm(1 as f32) != 0 { return 5; }
        if algorithm(1 as f64) != 0 { return 6; }
    }
    return 0;
}
