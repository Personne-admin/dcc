module main;

import std::result;
using std::result::Result;

Result(i32, u8) step(i32 x) {
    if x < 0 {
        return Result::Err(7);
    }
    return Result::Ok(x + 1);
}

Result(i32, u8) chain(i32 x) {
    i32 a = step(x) ?;
    i32 b = step(a) ?;
    i32 c = step(b) ?;
    return step(c);
}

i32 workload(i32 seed) {
    for i32 i = 0; i < 100; i++ {
        Result(i32, u8) r = chain(i + seed);
        if !r.is_ok() || r.unwrap() != i + seed + 4 {
            return 1;
        }
    }
    if chain(seed - 200).unwrap_err() != 7 {
        return 2;
    }
    return 0;
}

public i32 main() {
    for usize round = 0; round < 20000; round++ {
        i32 status = workload((round % 97) as i32);
        if status != 0 {
            return status;
        }
    }
    return 0;
}
