module names;

import std::slice;

public bool is_admin([]const char name) {
    return std::slice::eq(name, "admin");
}

public usize count_name([]const []const char names, []const char who) {
    usize total = 0;
    for name in names {
        if std::slice::eq(name, who) {
            total++;
        }
    }
    return total;
}

public bool has_name([]const []const char names, []const char who) {
    for name in names {
        if std::slice::eq(name, who) {
            return true;
        }
    }
    return false;
}
