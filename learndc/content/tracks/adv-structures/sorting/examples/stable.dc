module main;

import std::sort;
import std::os::heap;

struct Task {
    u8 priority;
    u8 id;
}

i32 by_priority(const Task* a, const Task* b) {
    if a.priority < b.priority {
        return -1;
    }
    if a.priority > b.priority {
        return 1;
    }
    return 0;
}

Status(Error) show([]const Task tasks) {
    for Task t in tasks {
        print(" {}:{}", t.priority, t.id)?;
    }
    println("")?;
    return Status::Ok;
}

public Status(Error) main() {
    Task[8] arrival = {
        { priority = 2, id = 1 },
        { priority = 1, id = 2 },
        { priority = 2, id = 3 },
        { priority = 1, id = 4 },
        { priority = 3, id = 5 },
        { priority = 2, id = 6 },
        { priority = 1, id = 7 },
        { priority = 3, id = 8 },
    };
    Task[8] scratch = {};
    []Task view = arrival;
    []Task spare = scratch;
    std::sort::sort_stable_by(view, spare, by_priority);
    print("stable:")?;
    show(view)?;

    Task[4] more = {
        { priority = 9, id = 1 },
        { priority = 4, id = 2 },
        { priority = 9, id = 3 },
        { priority = 4, id = 4 },
    };
    []Task more_view = more;
    std::os::heap::Heap heap = {};
    std::sort::sort_stable_alloc(&heap, more_view, by_priority)?;
    print("alloc:")?;
    show(more_view)?;
    return Status::Ok;
}
