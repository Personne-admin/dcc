module search;

public import counter;
using counter::Counter;

public usize lower_bound([]const i32 items, i32 key, Counter* counter) {
    usize low = 0;
    usize high = items.len;
    while low < high {
        usize mid = low + (high - low) / 2;
        if counter::less(counter, items[mid], key) {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

public usize upper_bound([]const i32 items, i32 key, Counter* counter) {
    usize low = 0;
    usize high = items.len;
    while low < high {
        usize mid = low + (high - low) / 2;
        if counter::less(counter, key, items[mid]) {
            high = mid;
        } else {
            low = mid + 1;
        }
    }
    return low;
}

public usize count_of([]const i32 items, i32 key, Counter* counter) {
    return upper_bound(items, key, counter) - lower_bound(items, key, counter);
}

public Optional(usize) find_first([]const i32 items, i32 key, Counter* counter) {
    usize at = lower_bound(items, key, counter);
    if at < items.len && !counter::less(counter, key, items[at]) {
        return Optional::Some(at);
    }
    return Optional::None;
}
