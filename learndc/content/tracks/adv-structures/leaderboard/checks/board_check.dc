module board_check;

import board;
import std::sort;
using board::Player;

struct Rec {
    u8 key;
    u8 id;
}

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

i32 by_key(const Rec* a, const Rec* b) {
    if a.key < b.key {
        return -1;
    }
    if a.key > b.key {
        return 1;
    }
    return 0;
}

i32 up(const i32* a, const i32* b) {
    if *a < *b {
        return -1;
    }
    return if *a > *b { 1 } else { 0 };
}

i32 down(const i32* a, const i32* b) {
    return up(b, a);
}

public i32 main() {
    i32 failures = 0;

    i32[9] numbers = { 5, -2, 9, 0, 5, 7, -2, 3, 1 };
    []i32 nums = numbers;
    board::insertion_sort_by(nums, up);
    expect(std::sort::is_sorted_by(nums, up), "insertion_sort_by sorts i32 ascending", &failures);
    board::insertion_sort_by(nums, down);
    expect(std::sort::is_sorted_by(nums, down) && numbers[0] == 9 && numbers[8] == -2, "the comparator decides the order", &failures);

    i32[1] single = { 4 };
    []i32 one = single;
    board::insertion_sort_by(one, up);
    expect(single[0] == 4, "one item is untouched", &failures);
    i32[2] pair = { 2, 1 };
    []i32 two = pair;
    board::insertion_sort_by(two, up);
    expect(pair[0] == 1 && pair[1] == 2, "two items are ordered", &failures);

    Rec[12] records = {
        { key = 3, id = 0 }, { key = 1, id = 1 }, { key = 3, id = 2 }, { key = 2, id = 3 },
        { key = 1, id = 4 }, { key = 2, id = 5 }, { key = 3, id = 6 }, { key = 1, id = 7 },
        { key = 2, id = 8 }, { key = 3, id = 9 }, { key = 1, id = 10 }, { key = 2, id = 11 },
    };
    Rec[12] expected = records;
    Rec[12] scratch = {};
    []Rec got = records;
    []Rec want = expected;
    []Rec spare = scratch;
    board::insertion_sort_by(got, by_key);
    std::sort::sort_stable_by(want, spare, by_key);
    bool same = true;
    for usize i in 0..12 {
        if got[i].id != want[i].id {
            same = false;
        }
    }
    expect(same, "equal keys keep their arrival order (the sort is stable)", &failures);

    Player a = { name = "ada", score = 10 };
    Player b = { name = "bo", score = 10 };
    Player c = { name = "cy", score = 20 };
    expect(board::by_score_then_name(&c, &a) < 0, "a higher score comes first", &failures);
    expect(board::by_score_then_name(&a, &c) > 0, "a lower score comes later", &failures);
    expect(board::by_score_then_name(&a, &b) < 0, "equal scores are ordered by name", &failures);
    expect(board::by_score_then_name(&b, &a) > 0, "equal scores, later name", &failures);
    expect(board::by_score_then_name(&a, &a) == 0, "an entry equals itself", &failures);

    Player[6] sorted = {
        { name = "a", score = 9 }, { name = "b", score = 9 }, { name = "c", score = 9 },
        { name = "d", score = 5 }, { name = "e", score = 4 }, { name = "f", score = 4 },
    };
    u32[6] ranks = {};
    board::assign_ranks(sorted, ranks);
    expect(ranks[0] == 1 && ranks[1] == 1 && ranks[2] == 1, "tied players share the rank of the first", &failures);
    expect(ranks[3] == 4, "the next rank skips the tied places", &failures);
    expect(ranks[4] == 5 && ranks[5] == 5, "a later tie shares its first place", &failures);
    return failures;
}
