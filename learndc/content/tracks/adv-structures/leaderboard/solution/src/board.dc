module board;

import std::mem;

public struct Player {
    []const char name;
    i32 score;
}

public i32 by_score_then_name(const Player* a, const Player* b) {
    if a.score > b.score {
        return -1;
    }
    if a.score < b.score {
        return 1;
    }
    return std::mem::compare(a.name, b.name);
}

public i32 by_name(const Player* a, const Player* b) {
    return std::mem::compare(a.name, b.name);
}

public i32 by_score_desc(const Player* a, const Player* b) {
    if a.score > b.score {
        return -1;
    }
    if a.score < b.score {
        return 1;
    }
    return 0;
}

public void insertion_sort_by(T)([]T items, i32(*)(const T*, const T*) compare) {
    for usize i = 1; i < items.len; i++ {
        T value = items[i];
        usize j = i;
        while j > 0 && compare(&items[j - 1], &value) > 0 {
            items[j] = items[j - 1];
            j -= 1;
        }
        items[j] = value;
    }
}

public void assign_ranks([]const Player sorted, []u32 ranks) {
    for usize i in 0..sorted.len {
        if i > 0 && sorted[i].score == sorted[i - 1].score {
            ranks[i] = ranks[i - 1];
        } else {
            ranks[i] = (i + 1) as u32;
        }
    }
}
