module queue_check;

import queue;
import std::mem;
import std::alloc;
using queue::Queue;

struct Counting {
    std::mem::FixedHandle inner;
    usize allocs;
    usize frees;
    usize budget;
}

Result([] u8, std::alloc::AllocError) allocate(Counting* self, usize len, usize align) {
    if self.allocs >= self.budget {
        return std::alloc::AllocError::OutOfMemory;
    }
    Result([] u8, std::alloc::AllocError) got = self.inner.allocate(len, align);
    if got.is_ok() {
        self.allocs += 1;
    }
    return got;
}

bool resize_in_place(Counting* self, [] u8 block, usize new_bytes, usize align) {
    return self.inner.resize_in_place(block, new_bytes, align);
}

void free(Counting* self, [] u8 block, usize align) {
    self.frees += 1;
    self.inner.free(block, align);
}

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

public i32 main() {
    i32 failures = 0;
    u8[2048] backing = {};
    std::mem::FixedBuffer buffer = std::mem::new_fixed_buffer(backing[0..2048]);
    Counting alloc = { inner = std::mem::borrow(&buffer), allocs = 0, frees = 0, budget = 1000 };

    Queue(i32) q = {};
    expect(queue::size(&q) == 0 && queue::peek(&q).is_none() && queue::pop(&q, &alloc).is_none(), "a new queue is empty", &failures);

    expect(queue::push(&q, &alloc, 10).is_ok() && queue::push(&q, &alloc, 20).is_ok() && queue::push(&q, &alloc, 30).is_ok(), "push accepts values", &failures);
    expect(queue::size(&q) == 3, "size counts the items", &failures);
    expect(queue::peek(&q).unwrap_some() == 10, "peek shows the oldest item", &failures);
    expect(queue::size(&q) == 3, "peek removes nothing", &failures);
    expect(queue::pop(&q, &alloc).unwrap_some() == 10, "pop returns the oldest item first", &failures);
    expect(queue::pop(&q, &alloc).unwrap_some() == 20, "then the next", &failures);
    expect(alloc.allocs == 3 && alloc.frees == 2, "every pop frees its node", &failures);
    expect(queue::push(&q, &alloc, 40).is_ok(), "push after pops", &failures);
    expect(queue::pop(&q, &alloc).unwrap_some() == 30 && queue::pop(&q, &alloc).unwrap_some() == 40, "order is first in first out", &failures);
    expect(queue::size(&q) == 0 && queue::pop(&q, &alloc).is_none(), "drained queue is empty", &failures);
    expect(queue::push(&q, &alloc, 50).is_ok() && queue::peek(&q).unwrap_some() == 50 && queue::pop(&q, &alloc).unwrap_some() == 50, "a drained queue works again (tail was reset)", &failures);
    expect(alloc.allocs == alloc.frees, "allocations and frees match when the queue is empty", &failures);

    Queue(i32) many = {};
    for i32 n in 0..20 {
        queue::push(&many, &alloc, n);
    }
    queue::clear(&many, &alloc);
    expect(queue::size(&many) == 0 && queue::peek(&many).is_none(), "clear empties the queue", &failures);
    expect(alloc.allocs == alloc.frees, "clear frees every node", &failures);
    queue::clear(&many, &alloc);
    expect(alloc.allocs == alloc.frees, "clearing twice frees nothing more", &failures);

    Counting limited = { inner = std::mem::borrow(&buffer), allocs = 0, frees = 0, budget = 3 };
    Queue(u8) small = {};
    bool a = queue::push(&small, &limited, 1 as u8).is_ok();
    bool b = queue::push(&small, &limited, 2 as u8).is_ok();
    bool c = queue::push(&small, &limited, 3 as u8).is_ok();
    bool d = queue::push(&small, &limited, 4 as u8).is_ok();
    expect(a && b && c && !d, "a push fails when the allocator fails", &failures);
    expect(queue::size(&small) == 3, "a failed push changes nothing", &failures);
    expect(queue::pop(&small, &limited).unwrap_some() == 1 && queue::pop(&small, &limited).unwrap_some() == 2 && queue::pop(&small, &limited).unwrap_some() == 3, "the items before the failure are intact", &failures);
    expect(limited.allocs == limited.frees, "no leak after a failed push", &failures);

    Queue(f64) reals = {};
    queue::push(&reals, &alloc, 1.5);
    queue::push(&reals, &alloc, 2.5);
    expect(queue::pop(&reals, &alloc).unwrap_some() == 1.5, "the queue is generic: f64", &failures);
    queue::clear(&reals, &alloc);
    expect(alloc.allocs == alloc.frees, "everything is freed at the end", &failures);
    return failures;
}
