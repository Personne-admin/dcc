module events;

public struct Event {
    u32 time;
    u32 seq;
    u32 kind;
    u32 period;
}

public using u32 KIND_TICK = 1;
public using u32 KIND_ALARM = 2;
public using u32 KIND_SYNC = 3;

public i32 by_time_then_seq(const Event* a, const Event* b) {
    if a.time != b.time {
        return if a.time < b.time { -1 } else { 1 };
    }
    if a.seq != b.seq {
        return if a.seq < b.seq { -1 } else { 1 };
    }
    return 0;
}

public i32 by_time(const Event* a, const Event* b) {
    if a.time != b.time {
        return if a.time < b.time { -1 } else { 1 };
    }
    return 0;
}

public i32 by_kind(const Event* a, const Event* b) {
    if a.kind != b.kind {
        return if a.kind < b.kind { -1 } else { 1 };
    }
    return 0;
}

public []const char kind_name(u32 kind) {
    if kind == KIND_TICK {
        return "tick";
    }
    if kind == KIND_ALARM {
        return "alarm";
    }
    if kind == KIND_SYNC {
        return "sync";
    }
    return "?";
}
