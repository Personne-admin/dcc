module cancel_check;

import events;
import heap;
import sched;
using events::Event;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

public i32 main() {
    i32 failures = 0;
    Array(Event) queue = {};
    defer queue.deinit();
    u32 seq = 0;
    sched::schedule(&queue, &seq, 30, 1, 0);
    sched::schedule(&queue, &seq, 10, 2, 0);
    sched::schedule(&queue, &seq, 20, 1, 0);
    sched::schedule(&queue, &seq, 5, 3, 0);
    sched::schedule(&queue, &seq, 25, 1, 0);
    sched::schedule(&queue, &seq, 15, 2, 0);

    expect(sched::cancel_kind(&queue, 9) == 0 && queue.len() == 6, "cancelling an unused kind removes nothing", &failures);
    expect(sched::cancel_kind(&queue, 1) == 3, "cancel_kind returns how many events it removed", &failures);
    expect(queue.len() == 3, "three events remain", &failures);
    expect(heap::is_heap(&queue, events::by_time_then_seq), "the queue is still a heap", &failures);
    expect(heap::heap_pop(&queue, events::by_time_then_seq).unwrap_some().time == 5, "the earliest remaining event is next", &failures);
    expect(heap::heap_pop(&queue, events::by_time_then_seq).unwrap_some().time == 10, "then the next", &failures);
    expect(heap::heap_pop(&queue, events::by_time_then_seq).unwrap_some().time == 15, "then the last", &failures);
    expect(sched::cancel_kind(&queue, 2) == 0, "an empty queue has nothing to cancel", &failures);
    return failures;
}
