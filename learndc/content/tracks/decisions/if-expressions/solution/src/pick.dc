module pick;

public i32 max_of(i32 a, i32 b) {
    return if a > b { a } else { b };
}

public i32 abs_of(i32 n) {
    i32 result = if n < 0 { -n } else { n };
    return result;
}

public i32 sign(i32 n) {
    return if n < 0 { -1 } else if n == 0 { 0 } else { 1 };
}

public []const char item_word(i32 count) {
    return if count == 1 { "item" } else { "items" };
}
