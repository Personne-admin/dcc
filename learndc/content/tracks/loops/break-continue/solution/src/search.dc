module search;

public i32 sum_skipping_threes(i32 n) {
    i32 total = 0;
    for i32 i in 1..=n {
        if i % 3 == 0 {
            continue;
        }
        total += i;
    }
    return total;
}

public i32 terms_to_reach(i32 target) {
    i32 sum = 0;
    i32 terms = 0;
    while true {
        terms += 1;
        sum += terms;
        if sum >= target {
            break;
        }
    }
    return terms;
}

public i32 smallest_divisor(i32 n) {
    i32 found = n;
    for i32 d in 2..=n {
        if n % d == 0 {
            found = d;
            break;
        }
    }
    return found;
}
