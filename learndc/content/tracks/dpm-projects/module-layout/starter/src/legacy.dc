module legacy;

public struct Ship {
    []const char name;
    i32 tons;
}

public const Ship[4] FLEET = {
    Ship { name = "Aurora", tons = 120 },
    Ship { name = "Brisa", tons = 80 },
    Ship { name = "Corvo", tons = 200 },
    Ship { name = "Delta", tons = 45 },
};

public i32 total_tons() {
    i32 sum = 0;
    for ship in FLEET {
        sum += ship.tons;
    }
    return sum;
}

public Status(Error) print_line(Ship ship) {
    println("{} {} t", ship.name, ship.tons)?;
    return Status::Ok;
}
