module main;

import std::hash;
import std::os::thread_pool;

struct Job {
    []const char name;
    []const char text;
    u64 checksum;
}

void checksum_task(void* context) {
    Job* job = context as Job*;
    job.checksum = std::hash::fnv1a_64(job.text as []const u8);
}

Status(Error) run_pool([] Job jobs, usize workers) {
    std::os::thread_pool::ThreadPool* pool = std::os::thread_pool::create(workers)?;
    defer pool.destroy();
    for usize i = 0; i < jobs.len; i++ {
        pool.submit(checksum_task, &jobs[i] as void*)?;
    }
    pool.wait_all();
    return Status::Ok;
}

public Status(Error) main() {
    Job[6] jobs = {
        { "empty", "", 0 },
        { "letter", "a", 0 },
        { "greeting", "hello world", 0 },
        { "numbers", "0123456789", 0 },
        { "sentence", "the quick brown fox jumps over the lazy dog", 0 },
        { "repeat", "abcabcabcabc", 0 },
    };
    run_pool(jobs[0..6], 3)?;
    u64[6] first = {};
    for usize i = 0; i < 6; i++ {
        first[i] = jobs[i].checksum;
        println("{:<9}{:016x}", jobs[i].name, jobs[i].checksum)?;
        jobs[i].checksum = 0;
    }
    run_pool(jobs[0..6], 1)?;
    bool same = true;
    for usize i = 0; i < 6; i++ {
        if jobs[i].checksum != first[i] {
            same = false;
        }
    }
    println("same sums with one worker: {}", same)?;
    return Status::Ok;
}
