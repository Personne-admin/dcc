        { "apple", 12 },
        { "pear", 4 },
        { "plum", 7 },
        { "apple", 3 },
    };
    []const Order orders = {
        { "apple", 5 },
        { "pear", 6 },
        { "fig", 1 },
        { "pear", 4 },
        { "plum", 2 },
    };

    // Stage 5, the night shift, starts here: create the shelf, stock it with
