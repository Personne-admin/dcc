module neighbours;

import maze;
using maze::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool is_err(Result(i32, MazeError) r, MazeError expected) {
    match r {
        Result::Ok(v) => return false,
        Result::Err(e) => return e == expected,
    }
}

bool sequence(const Array(usize)* got, []const usize expected) {
    if got.len() != expected.len {
        return false;
    }
    for usize i in 0..expected.len {
        if got.items()[i] != expected[i] {
            return false;
        }
    }
    return true;
}

public i32 main() {
    i32 failures = 0;
    Array(usize) out = {};
    defer out.deinit();
    []const []const char open = {
        "...",
        "...",
        "...",
    };
    expect(open_neighbours(open, 4, &out).is_ok() && sequence(&out, { 1, 5, 7, 3 }), "the middle cell: up, right, down, left", &failures);
    out.clear();
    expect(open_neighbours(open, 0, &out).is_ok() && sequence(&out, { 1, 3 }), "the top left corner has only right and down", &failures);
    out.clear();
    expect(open_neighbours(open, 8, &out).is_ok() && sequence(&out, { 5, 7 }), "the bottom right corner has only up and left", &failures);
    out.clear();
    expect(open_neighbours(open, 2, &out).is_ok() && sequence(&out, { 5, 1 }), "the top right corner has down and left: no wrap to the next row", &failures);
    out.clear();
    expect(open_neighbours(open, 6, &out).is_ok() && sequence(&out, { 3, 7 }), "the bottom left corner has up and right: no wrap to the row above", &failures);
    out.clear();

    []const []const char walls = {
        "#.#",
        "...",
        "#S#",
    };
    expect(open_neighbours(walls, 7, &out).is_ok() && sequence(&out, { 4 }), "S at the bottom has only the open cell above it: no wall, no wrap", &failures);
    out.clear();
    expect(open_neighbours(walls, 4, &out).is_ok() && sequence(&out, { 1, 5, 7, 3 }), "S and floor both count as open", &failures);
    out.clear();
    expect(open_neighbours(walls, 3, &out).is_ok() && sequence(&out, { 4 }), "walls above and below, only the right is open", &failures);
    out.clear();

    []const []const char dead = {
        "###",
        "#S#",
        "###",
    };
    expect(open_neighbours(dead, 4, &out).is_ok() && out.len() == 0, "a cell closed on all sides", &failures);
    expect(open_neighbours(open, 4, &out).is_ok() && open_neighbours(open, 0, &out).is_ok() && out.len() == 6, "it appends and never clears", &failures);
    return failures;
}
