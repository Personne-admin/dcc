module listing_check;

import vm;
using vm::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool pushes(Result(Instr, VmError) r, i64 value) {
    match r {
        Result::Ok(i) => match i {
            Instr::Push(n) => return n == value,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool jumps(Result(Instr, VmError) r, usize target) {
    match r {
        Result::Ok(i) => match i {
            Instr::Jump(t) => return t == target,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool jumps_if_zero(Result(Instr, VmError) r, usize target) {
    match r {
        Result::Ok(i) => match i {
            Instr::JumpIfZero(t) => return t == target,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool plain(Result(Instr, VmError) r, Instr expected) {
    match r {
        Result::Ok(i) => return i == expected,
        Result::Err(e) => return false,
    }
}

bool fails(Result(Instr, VmError) r, VmError expected) {
    match r {
        Result::Ok(i) => return false,
        Result::Err(e) => return e == expected,
    }
}

bool refused(Status(VmError) s, VmError expected) {
    match s {
        Status::Ok => return false,
        Status::Err(e) => return e == expected,
    }
}

bool outputs(const Array(i64)* out, []const i64 expected) {
    if out.len() != expected.len {
        return false;
    }
    for usize i in 0..expected.len {
        if out.items()[i] != expected[i] {
            return false;
        }
    }
    return true;
}

Status(Error) show() {
    []const Instr program = { Instr::Push(-3), Instr::Dup, Instr::Add, Instr::Sub, Instr::Mul, Instr::Div, Instr::Over, Instr::Swap, Instr::Drop, Instr::JumpIfZero(12), Instr::Jump(0), Instr::Print, Instr::Halt };
    listing(program)?;
    println("--")?;
    []const Instr none = {};
    listing(none)?;
    return Status::Ok;
}

public i32 main() {
    if !show().is_ok() {
        return 1;
    }
    return 0;
}
