module assembling;

import vm;
using vm::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool pushes(Result(Instr, VmError) r, i64 value) {
    match r {
        Result::Ok(i) => match i {
            Instr::Push(n) => return n == value,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool jumps(Result(Instr, VmError) r, usize target) {
    match r {
        Result::Ok(i) => match i {
            Instr::Jump(t) => return t == target,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool jumps_if_zero(Result(Instr, VmError) r, usize target) {
    match r {
        Result::Ok(i) => match i {
            Instr::JumpIfZero(t) => return t == target,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool plain(Result(Instr, VmError) r, Instr expected) {
    match r {
        Result::Ok(i) => return i == expected,
        Result::Err(e) => return false,
    }
}

bool fails(Result(Instr, VmError) r, VmError expected) {
    match r {
        Result::Ok(i) => return false,
        Result::Err(e) => return e == expected,
    }
}

bool refused(Status(VmError) s, VmError expected) {
    match s {
        Status::Ok => return false,
        Status::Err(e) => return e == expected,
    }
}

bool outputs(const Array(i64)* out, []const i64 expected) {
    if out.len() != expected.len {
        return false;
    }
    for usize i in 0..expected.len {
        if out.items()[i] != expected[i] {
            return false;
        }
    }
    return true;
}

public i32 main() {
    i32 failures = 0;
    Array(Instr) program = {};
    defer program.deinit();
    usize bad = 0;

    []const []const char good = { "; double a number", "push 21", "", "   ", "dup  ", "  ; another comment", "add", "print", "halt" };
    expect(assemble(good, &program, &bad).is_ok(), "a program with comments and blank lines assembles", &failures);
    expect(program.len() == 5, "only the five instructions are kept", &failures);
    if program.len() == 5 {
        expect(plain(Result::Ok(program.items()[1]), Instr::Dup), "the second instruction is dup", &failures);
        expect(pushes(Result::Ok(program.items()[0]), 21), "the first is push 21", &failures);
        expect(plain(Result::Ok(program.items()[4]), Instr::Halt), "the last is halt", &failures);
    }

    Array(Instr) broken = {};
    defer broken.deinit();
    []const []const char typo = { "push 1", "", "; note", "pust 2", "add" };
    expect(refused(assemble(typo, &broken, &bad), VmError::UnknownOp), "the first bad line stops the assembly", &failures);
    expect(bad == 4, "bad_line counts text lines from 1, blank lines and comments included", &failures);

    Array(Instr) another = {};
    defer another.deinit();
    []const []const char operand = { "push 1", "jump" };
    expect(refused(assemble(operand, &another, &bad), VmError::MissingOperand) && bad == 2, "a missing operand on line 2", &failures);

    Array(Instr) none = {};
    defer none.deinit();
    []const []const char nothing = {};
    expect(assemble(nothing, &none, &bad).is_ok() && none.len() == 0, "no lines, no program", &failures);
    []const []const char only_comments = { "; nothing", "   " };
    expect(assemble(only_comments, &none, &bad).is_ok() && none.len() == 0, "only comments, no program", &failures);
    return failures;
}
