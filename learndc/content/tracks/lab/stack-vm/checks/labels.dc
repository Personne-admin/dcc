module labels;

import vm;
using vm::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool pushes(Result(Instr, VmError) r, i64 value) {
    match r {
        Result::Ok(i) => match i {
            Instr::Push(n) => return n == value,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool jumps(Result(Instr, VmError) r, usize target) {
    match r {
        Result::Ok(i) => match i {
            Instr::Jump(t) => return t == target,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool jumps_if_zero(Result(Instr, VmError) r, usize target) {
    match r {
        Result::Ok(i) => match i {
            Instr::JumpIfZero(t) => return t == target,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool plain(Result(Instr, VmError) r, Instr expected) {
    match r {
        Result::Ok(i) => return i == expected,
        Result::Err(e) => return false,
    }
}

bool fails(Result(Instr, VmError) r, VmError expected) {
    match r {
        Result::Ok(i) => return false,
        Result::Err(e) => return e == expected,
    }
}

bool refused(Status(VmError) s, VmError expected) {
    match s {
        Status::Ok => return false,
        Status::Err(e) => return e == expected,
    }
}

bool outputs(const Array(i64)* out, []const i64 expected) {
    if out.len() != expected.len {
        return false;
    }
    for usize i in 0..expected.len {
        if out.items()[i] != expected[i] {
            return false;
        }
    }
    return true;
}

public i32 main() {
    i32 failures = 0;
    usize bad = 0;
    Array(Instr) program = {};
    defer program.deinit();
    []const []const char counting = {
        "push 3",
        "again:",
        "dup",
        "print",
        "push 1",
        "sub",
        "dup",
        "jz done",
        "jump again",
        "done:",
        "halt",
    };
    expect(assemble_labels(counting, &program, &bad).is_ok(), "labels assemble", &failures);
    expect(program.len() == 9, "labels are not instructions", &failures);
    if program.len() == 9 {
        expect(jumps_if_zero(Result::Ok(program.items()[6]), 8), "jz done jumps to the instruction after the label", &failures);
        expect(jumps(Result::Ok(program.items()[7]), 1), "jump again jumps back", &failures);
    }
    Array(i64) out = {};
    defer out.deinit();
    expect(run(program.items(), &out, 100).is_ok() && outputs(&out, { 3, 2, 1 }), "and the program runs", &failures);

    Array(Instr) numeric = {};
    defer numeric.deinit();
    []const []const char mixed = { "push 0", "jz 3", "start:", "jump start", "jump 0", "end:" };
    expect(assemble_labels(mixed, &numeric, &bad).is_ok(), "numbers and labels can be mixed", &failures);
    expect(numeric.len() == 4, "four instructions", &failures);
    if numeric.len() == 4 {
        expect(jumps_if_zero(Result::Ok(numeric.items()[1]), 3), "numeric targets stay numeric", &failures);
        expect(jumps(Result::Ok(numeric.items()[2]), 2), "a label may sit before its jump on the same address", &failures);
        expect(jumps(Result::Ok(numeric.items()[3]), 0), "a numeric jump", &failures);
    }

    Array(Instr) forward = {};
    defer forward.deinit();
    []const []const char tail = { "jump out", "push 1", "out:" };
    expect(assemble_labels(tail, &forward, &bad).is_ok() && forward.len() == 2, "a label at the very end", &failures);
    if forward.len() == 2 {
        expect(jumps(Result::Ok(forward.items()[0]), 2), "points just past the last instruction", &failures);
    }

    Array(Instr) missing = {};
    defer missing.deinit();
    []const []const char lost = { "push 1", "; x", "jump nowhere" };
    expect(refused(assemble_labels(lost, &missing, &bad), VmError::UnknownLabel) && bad == 3, "an unknown label is reported on its line", &failures);
    Array(Instr) typo = {};
    defer typo.deinit();
    []const []const char wrong = { "top:", "pust 1" };
    expect(refused(assemble_labels(wrong, &typo, &bad), VmError::UnknownOp) && bad == 2, "other errors keep their line numbers", &failures);
    return failures;
}
