module running;

import vm;
using vm::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool pushes(Result(Instr, VmError) r, i64 value) {
    match r {
        Result::Ok(i) => match i {
            Instr::Push(n) => return n == value,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool jumps(Result(Instr, VmError) r, usize target) {
    match r {
        Result::Ok(i) => match i {
            Instr::Jump(t) => return t == target,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool jumps_if_zero(Result(Instr, VmError) r, usize target) {
    match r {
        Result::Ok(i) => match i {
            Instr::JumpIfZero(t) => return t == target,
            _ => return false,
        },
        Result::Err(e) => return false,
    }
}

bool plain(Result(Instr, VmError) r, Instr expected) {
    match r {
        Result::Ok(i) => return i == expected,
        Result::Err(e) => return false,
    }
}

bool fails(Result(Instr, VmError) r, VmError expected) {
    match r {
        Result::Ok(i) => return false,
        Result::Err(e) => return e == expected,
    }
}

bool refused(Status(VmError) s, VmError expected) {
    match s {
        Status::Ok => return false,
        Status::Err(e) => return e == expected,
    }
}

bool outputs(const Array(i64)* out, []const i64 expected) {
    if out.len() != expected.len {
        return false;
    }
    for usize i in 0..expected.len {
        if out.items()[i] != expected[i] {
            return false;
        }
    }
    return true;
}

Status(VmError) go([]const Instr program, Array(i64)* out, usize limit) {
    return run(program, out, limit);
}

public i32 main() {
    i32 failures = 0;
    Array(i64) out = {};
    defer out.deinit();

    []const Instr arithmetic = { Instr::Push(7), Instr::Push(3), Instr::Sub, Instr::Print, Instr::Push(6), Instr::Push(7), Instr::Mul, Instr::Print, Instr::Push(-9), Instr::Push(2), Instr::Div, Instr::Print, Instr::Push(1), Instr::Push(2), Instr::Add, Instr::Print };
    expect(go(arithmetic, &out, 100).is_ok(), "arithmetic runs", &failures);
    expect(outputs(&out, { 4, 42, -4, 3 }), "7 - 3, 6 * 7, -9 / 2 truncates toward zero, 1 + 2", &failures);

    out.clear();
    []const Instr shuffling = { Instr::Push(1), Instr::Push(2), Instr::Swap, Instr::Print, Instr::Print, Instr::Push(5), Instr::Dup, Instr::Print, Instr::Print, Instr::Push(8), Instr::Push(9), Instr::Over, Instr::Print, Instr::Drop, Instr::Print };
    expect(go(shuffling, &out, 100).is_ok(), "stack words run", &failures);
    expect(outputs(&out, { 1, 2, 5, 5, 8, 8 }), "swap, dup, over and drop", &failures);

    out.clear();
    []const Instr early = { Instr::Push(1), Instr::Print, Instr::Halt, Instr::Push(2), Instr::Print };
    expect(go(early, &out, 100).is_ok() && outputs(&out, { 1 }), "halt stops the program", &failures);

    out.clear();
    []const Instr countdown = { Instr::Push(3), Instr::Dup, Instr::Print, Instr::Push(1), Instr::Sub, Instr::Dup, Instr::JumpIfZero(8), Instr::Jump(1), Instr::Halt };
    expect(go(countdown, &out, 100).is_ok() && outputs(&out, { 3, 2, 1 }), "a loop with jump and jz", &failures);

    out.clear();
    []const Instr skip = { Instr::Push(0), Instr::JumpIfZero(4), Instr::Push(1), Instr::Print, Instr::Push(2), Instr::Print };
    expect(go(skip, &out, 100).is_ok() && outputs(&out, { 2 }), "jz jumps on zero and pops the value", &failures);
    out.clear();
    []const Instr no_skip = { Instr::Push(5), Instr::JumpIfZero(4), Instr::Push(1), Instr::Print, Instr::Push(2), Instr::Print };
    expect(go(no_skip, &out, 100).is_ok() && outputs(&out, { 1, 2 }), "jz falls through on a non-zero value", &failures);

    out.clear();
    []const Instr to_end = { Instr::Jump(2), Instr::Print };
    expect(go(to_end, &out, 100).is_ok() && out.len() == 0, "jumping to the end of the program ends it", &failures);
    []const Instr nothing = {};
    expect(go(nothing, &out, 0).is_ok(), "an empty program with no steps is fine", &failures);

    expect(refused(go({ Instr::Jump(3), Instr::Halt }, &out, 100), VmError::BadJump), "a jump beyond the end is refused", &failures);
    expect(refused(go({ Instr::Push(0), Instr::JumpIfZero(9) }, &out, 100), VmError::BadJump), "so is a jz beyond the end", &failures);
    expect(refused(go({ Instr::Add }, &out, 100), VmError::StackUnderflow), "add on an empty stack", &failures);
    expect(refused(go({ Instr::Push(1), Instr::Sub }, &out, 100), VmError::StackUnderflow), "sub with one value", &failures);
    expect(refused(go({ Instr::Dup }, &out, 100), VmError::StackUnderflow), "dup on an empty stack", &failures);
    expect(refused(go({ Instr::Push(1), Instr::Over }, &out, 100), VmError::StackUnderflow), "over with one value", &failures);
    expect(refused(go({ Instr::Print }, &out, 100), VmError::StackUnderflow), "print on an empty stack", &failures);
    expect(refused(go({ Instr::Drop }, &out, 100), VmError::StackUnderflow), "drop on an empty stack", &failures);
    expect(refused(go({ Instr::JumpIfZero(0) }, &out, 100), VmError::StackUnderflow), "jz on an empty stack", &failures);
    expect(refused(go({ Instr::Push(1), Instr::Push(0), Instr::Div }, &out, 100), VmError::DivideByZero), "dividing by zero", &failures);

    out.clear();
    []const Instr partial = { Instr::Push(4), Instr::Print, Instr::Add };
    expect(refused(go(partial, &out, 100), VmError::StackUnderflow) && outputs(&out, { 4 }), "output printed before an error is kept", &failures);

    []const Instr forever = { Instr::Jump(0) };
    expect(refused(go(forever, &out, 50), VmError::StepLimit), "an endless loop hits the step limit", &failures);
    []const Instr three = { Instr::Push(1), Instr::Drop, Instr::Halt };
    expect(go(three, &out, 3).is_ok(), "exactly max_steps instructions are allowed", &failures);
    expect(refused(go(three, &out, 2), VmError::StepLimit), "one more is not", &failures);
    expect(refused(go(three, &out, 0), VmError::StepLimit), "a limit of 0 allows nothing", &failures);
    return failures;
}
