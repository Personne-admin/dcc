module applying;

import std::slice;
import rpn;
using rpn::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool refused(Status(CalcError) s, CalcError expected) {
    match s {
        Status::Ok => return false,
        Status::Err(e) => return e == expected,
    }
}

bool stack_is(Array(i64)* stack, []const i64 expected) {
    if stack.len() != expected.len {
        return false;
    }
    for usize i in 0..expected.len {
        if stack.items()[i] != expected[i] {
            return false;
        }
    }
    return true;
}

void load(Array(i64)* stack, []const i64 values) {
    stack.clear();
    for v in values {
        stack.push(v).unwrap();
    }
}

public i32 main() {
    i32 failures = 0;
    Array(i64) stack = {};
    defer stack.deinit();

    load(&stack, { 9, 7, 3 });
    expect(apply(&stack, "+").is_ok() && stack_is(&stack, { 9, 10 }), "+ replaces the top two values", &failures);
    load(&stack, { 9, 7, 3 });
    expect(apply(&stack, "-").is_ok() && stack_is(&stack, { 9, 4 }), "7 3 - is 4: the lower value is the left operand", &failures);
    load(&stack, { 6, 7 });
    expect(apply(&stack, "*").is_ok() && stack_is(&stack, { 42 }), "*", &failures);
    load(&stack, { 100, 7 });
    expect(apply(&stack, "/").is_ok() && stack_is(&stack, { 14 }), "/ truncates", &failures);
    load(&stack, { -7, 2 });
    expect(apply(&stack, "/").is_ok() && stack_is(&stack, { -3 }), "/ truncates toward zero", &failures);
    load(&stack, { -7, 3 });
    expect(apply(&stack, "%").is_ok() && stack_is(&stack, { -1 }), "% keeps the sign of the left operand", &failures);

    load(&stack, { 5 });
    expect(refused(apply(&stack, "+"), CalcError::StackUnderflow) && stack_is(&stack, { 5 }), "one value is too few and stays put", &failures);
    load(&stack, {});
    expect(refused(apply(&stack, "*"), CalcError::StackUnderflow), "an empty stack underflows", &failures);
    load(&stack, { 8, 0 });
    expect(refused(apply(&stack, "/"), CalcError::DivideByZero) && stack_is(&stack, { 8, 0 }), "dividing by zero leaves the stack alone", &failures);
    load(&stack, { 8, 0 });
    expect(refused(apply(&stack, "%"), CalcError::DivideByZero), "so does remainder", &failures);
    load(&stack, { 1, 2 });
    expect(refused(apply(&stack, "^"), CalcError::BadToken), "^ is not an operator", &failures);
    expect(refused(apply(&stack, "plus"), CalcError::BadToken), "neither is plus", &failures);
    expect(refused(apply(&stack, "++"), CalcError::BadToken), "nor ++", &failures);
    expect(refused(apply(&stack, ""), CalcError::BadToken), "nor the empty token", &failures);
    expect(stack_is(&stack, { 1, 2 }), "a bad token changes nothing", &failures);
    load(&stack, { 0 });
    expect(refused(apply(&stack, "x"), CalcError::BadToken), "bad token wins over underflow", &failures);
    return failures;
}
