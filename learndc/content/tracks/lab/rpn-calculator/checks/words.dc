module words;

import std::slice;
import rpn;
using rpn::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool refused(Status(CalcError) s, CalcError expected) {
    match s {
        Status::Ok => return false,
        Status::Err(e) => return e == expected,
    }
}

bool stack_is(Array(i64)* stack, []const i64 expected) {
    if stack.len() != expected.len {
        return false;
    }
    for usize i in 0..expected.len {
        if stack.items()[i] != expected[i] {
            return false;
        }
    }
    return true;
}

void load(Array(i64)* stack, []const i64 values) {
    stack.clear();
    for v in values {
        stack.push(v).unwrap();
    }
}

public i32 main() {
    i32 failures = 0;
    Array(i64) stack = {};
    defer stack.deinit();

    load(&stack, { 1, 5 });
    expect(apply(&stack, "dup").is_ok() && stack_is(&stack, { 1, 5, 5 }), "dup copies the top value", &failures);
    load(&stack, { 1, 5 });
    expect(apply(&stack, "neg").is_ok() && stack_is(&stack, { 1, -5 }), "neg flips the sign of the top value", &failures);
    load(&stack, { 1, 2, 3 });
    expect(apply(&stack, "swap").is_ok() && stack_is(&stack, { 1, 3, 2 }), "swap exchanges the top two", &failures);
    load(&stack, {});
    expect(refused(apply(&stack, "dup"), CalcError::StackUnderflow), "dup needs one value", &failures);
    expect(refused(apply(&stack, "neg"), CalcError::StackUnderflow), "neg needs one value", &failures);
    load(&stack, { 4 });
    expect(refused(apply(&stack, "swap"), CalcError::StackUnderflow) && stack_is(&stack, { 4 }), "swap needs two values", &failures);
    expect(evaluate("6 dup *").is_ok() && evaluate("6 dup *").unwrap() == 36, "6 dup * squares", &failures);
    expect(evaluate("4 6 swap -").unwrap() == 2, "swap changes the order of a subtraction", &failures);
    expect(evaluate("3 neg 4 +").unwrap() == 1, "neg inside an expression", &failures);
    return failures;
}
