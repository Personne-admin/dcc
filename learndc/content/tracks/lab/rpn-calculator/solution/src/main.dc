module main;

import rpn;
using rpn::*;

public Status(Error) main() {
    []const []const char expressions = {
        "3 4 +",
        "5 1 2 + 4 * + 3 -",
        "100 7 /",
        "-7 2 /",
        "-7 3 %",
        "10 0 /",
        "1 +",
        "2 x *",
        "1 2",
        "",
        "42",
        "10 4 3 - 2 * -",
    };
    usize good = 0;
    usize bad = 0;
    for text in expressions {
        match evaluate(text) {
            Result::Ok(value) => {
                println("{} = {}", text, value)?;
                good += 1;
            },
            Result::Err(e) => {
                bad += 1;
                match e {
                    CalcError::Alloc(a) => println("out of memory")?,
                    CalcError::BadToken => println("[{}]: unknown token", text)?,
                    CalcError::StackUnderflow => println("[{}]: stack underflow", text)?,
                    CalcError::DivideByZero => println("[{}]: divide by zero", text)?,
                    CalcError::EmptyExpression => println("[{}]: empty expression", text)?,
                    CalcError::LeftOverValues => println("[{}]: more than one value left", text)?,
                }
            },
        }
    }
    println("{} evaluated, {} failed", good, bad)?;
    return Status::Ok;
}
