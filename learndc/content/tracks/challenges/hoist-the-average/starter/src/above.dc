module above;

import probe;

i32 average([]const i32 values) {
    i32 sum = 0;
    for usize i = 0; i < values.len; i++ {
        sum += probe::read(values, i);
    }
    return sum / (values.len as i32);
}

public u32 count_above_average([]const i32 values) {
    if values.len == 0 {
        return 0;
    }
    u32 count = 0;
    for usize i = 0; i < values.len; i++ {
        if probe::read(values, i) > average(values) {
            count += 1;
        }
    }
    return count;
}
