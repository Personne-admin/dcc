module main;

import ages;

Status(Error) report(i32 age) {
    Result(i32, ages::AgeError) checked = ages::check_age(age);
    match checked {
        Result::Ok(valid) => println("{} is a valid age", valid)?,
        Result::Err(problem) => match problem {
            ages::AgeError::Negative => println("{}: ages cannot be negative", age)?,
            ages::AgeError::TooOld => println("{}: too old to be real", age)?,
        },
    }
    return Status::Ok;
}

public Status(Error) main() {
    report(30)?;
    report(-4)?;
    report(200)?;
    report(150)?;
    return Status::Ok;
}
