module math_check;

import native;

using native::{ MathError, checked_sqrt, checked_log, distance };

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool close(f64 a, f64 b) {
    f64 d = a - b;
    if d < 0.0 {
        d = -d;
    }
    return d < 0.000001;
}

public i32 main() {
    i32 failures = 0;
    f64 zero = 0.0;
    f64 not_a_number = zero / zero;

    Result(f64, MathError) root = checked_sqrt(2.25);
    expect(root.is_ok() && close(root.unwrap(), 1.5), "sqrt(2.25) is 1.5", &failures);
    Result(f64, MathError) root_zero = checked_sqrt(0.0);
    expect(root_zero.is_ok() && close(root_zero.unwrap(), 0.0), "sqrt(0) is 0", &failures);
    expect(checked_sqrt(-1.0).is_err(), "sqrt of a negative number is a domain error", &failures);
    expect(checked_sqrt(not_a_number).is_err(), "sqrt of NaN is a domain error", &failures);
    Result(f64, MathError) big = checked_sqrt(1000000.0);
    expect(big.is_ok() && close(big.unwrap(), 1000.0), "sqrt(1000000) is 1000", &failures);

    Result(f64, MathError) one = checked_log(1.0);
    expect(one.is_ok() && close(one.unwrap(), 0.0), "ln(1) is 0", &failures);
    Result(f64, MathError) ten = checked_log(10.0);
    expect(ten.is_ok() && close(ten.unwrap(), 2.302585092994046), "ln(10)", &failures);
    expect(checked_log(0.0).is_err(), "ln(0) is a domain error", &failures);
    expect(checked_log(-5.0).is_err(), "ln of a negative number is a domain error", &failures);
    expect(checked_log(not_a_number).is_err(), "ln of NaN is a domain error", &failures);

    expect(close(distance(0.0, 0.0, 3.0, 4.0), 5.0), "distance 3-4-5", &failures);
    expect(close(distance(1.0, 1.0, 1.0, 1.0), 0.0), "distance of a point to itself", &failures);
    expect(close(distance(-2.0, 5.0, 1.0, 1.0), 5.0), "distance with negative coordinates", &failures);
    expect(close(distance(1.0e200, 0.0, 0.0, 1.0e200), 1.4142135623730951e200), "hypot does not overflow where x*x + y*y would", &failures);
    return failures;
}
