module main;

struct Tm {
    i32 sec;
    i32 min;
    i32 hour;
    i32 mday;
    i32 mon;
    i32 year;
    i32 wday;
    i32 yday;
    i32 isdst;
    i64 gmtoff;
    const char* zone;
}

struct DivResult {
    i32 quot;
    i32 rem;
}

public Status(Error) main() {
    println("struct tm: {} bytes, align {}", sizeof(Tm), alignof(Tm))?;
    println("year at {}, isdst at {}", offsetof(Tm, year), offsetof(Tm, isdst))?;
    println("gmtoff at {}, zone at {}", offsetof(Tm, gmtoff), offsetof(Tm, zone))?;
    println("div_t: {} bytes", sizeof(DivResult))?;
    return Status::Ok;
}
