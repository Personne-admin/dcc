module main;

@nomangle extern f32 cos(f32 x);
@nomangle extern f64 sqrt(f64 x);
@nomangle extern f64 power(f64 x, f64 y);

public Status(Error) main() {
    println("cos(0) = {:.4}", cos(0.0))?;
    println("sqrt(2) = {:.4}", sqrt(2.0))?;
    println("pow(2, 10) = {:.4}", power(2.0, 10.0))?;
    return Status::Ok;
}
