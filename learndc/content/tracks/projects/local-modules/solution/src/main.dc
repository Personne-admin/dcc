module main;

import temperature;

public Status(Error) main() {
    println("0 C = {} F", temperature::to_fahrenheit(0))?;
    println("37 C = {} F", temperature::to_fahrenheit(37))?;
    println("100 C = {} F", temperature::to_fahrenheit(100))?;
    println("-5 C freezing: {}", temperature::is_freezing(-5))?;
    return Status::Ok;
}
