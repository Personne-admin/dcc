module main;

import words;

public Status(Error) main() {
    []const char text = "the quick brown fox\njumps over the lazy dog\n\nend";
    println("lines: {}", words::count_lines(text))?;
    println("words: {}", words::count_words(text))?;
    println("longest word: {}", words::longest_word(text))?;
    return Status::Ok;
}
