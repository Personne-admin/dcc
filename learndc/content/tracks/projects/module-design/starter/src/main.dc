module main;

i32 weight_class(i32 grams) {
    if grams <= 500 {
        return 1;
    }
    if grams <= 2000 {
        return 2;
    }
    if grams <= 10000 {
        return 3;
    }
    return 4;
}

i32 surcharge(i32 base) {
    return base / 2;
}

i32 shipping_cost(i32 grams, bool express) {
    i32 base = 200 + 150 * weight_class(grams);
    if express {
        return base + surcharge(base);
    }
    return base;
}

public Status(Error) main() {
    i32[4] weights = { 250, 1200, 5000, 20000 };
    for grams in weights {
        println("{} g: {} / {}", grams, shipping_cost(grams, false), shipping_cost(grams, true))?;
    }
    return Status::Ok;
}
