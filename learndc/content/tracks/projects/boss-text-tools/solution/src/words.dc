module words;

bool is_separator(char c) {
    return c == ' ' || c == '\n' || c == '\t' || c == ',' || c == '.';
}

public Status(Error) split(Array([]const char)* out, []const char text) {
    usize start = 0;
    bool in_word = false;
    for usize i = 0; i < text.len; i++ {
        if is_separator(text[i]) {
            if in_word {
                out.push(text[start..i])?;
                in_word = false;
            }
        } else if !in_word {
            start = i;
            in_word = true;
        }
    }
    if in_word {
        out.push(text[start..text.len])?;
    }
    return Status::Ok;
}
