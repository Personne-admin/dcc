module sheet;

public import sdl3;

public const i32 FRAME = 8;
public const i32 COLUMNS = 2;

public []const []const char SHEET = {
    "################",
    "#wrrrrr##wggggg#",
    "#rrrrrr##gggggg#",
    "#rrrrrr##gggggg#",
    "#rrrrrr##gggggg#",
    "#rrrrrr##gggggg#",
    "#rrrrrr##gggggg#",
    "################",
    "################",
    "#wbbbbb##wyyyyy#",
    "#bbbbbb##yyyyyy#",
    "#bbbbbb##yyyyyy#",
    "#bbbbbb##yyyyyy#",
    "#bbbbbb##yyyyyy#",
    "#bbbbbb##yyyyyy#",
    "################",
};

struct Rgba {
    u8 r;
    u8 g;
    u8 b;
    u8 a;
}

Rgba color_for(char c) {
    match c {
        '#' => return Rgba { r = 30, g = 30, b = 50, a = 255 },
        'w' => return Rgba { r = 255, g = 255, b = 255, a = 255 },
        'r' => return Rgba { r = 200, g = 40, b = 40, a = 255 },
        'g' => return Rgba { r = 60, g = 180, b = 60, a = 255 },
        'b' => return Rgba { r = 50, g = 90, b = 200, a = 255 },
        'y' => return Rgba { r = 230, g = 200, b = 50, a = 255 },
        _ => return Rgba { r = 0, g = 0, b = 0, a = 0 },
    }
}

public sdl3::SDL_Texture* create(sdl3::SDL_Renderer* renderer) {
    i32 width = SHEET[0].len as i32;
    i32 height = SHEET.len as i32;
    sdl3::SDL_Texture* texture = sdl3::SDL_CreateTexture(
        renderer,
        sdl3::SDL_PixelFormat::SDL_PIXELFORMAT_ABGR8888,
        sdl3::SDL_TextureAccess::SDL_TEXTUREACCESS_STATIC,
        width,
        height);
    if texture == null {
        return null;
    }
    u8[1024] pixels = {};
    usize y = 0;
    for row in SHEET {
        usize x = 0;
        for c in row {
            Rgba color = color_for(c);
            usize at = (y * (width as usize) + x) * 4;
            pixels[at] = color.r;
            pixels[at + 1] = color.g;
            pixels[at + 2] = color.b;
            pixels[at + 3] = color.a;
            x += 1;
        }
        y += 1;
    }
    if !sdl3::SDL_UpdateTexture(texture, null, &pixels[0] as const void*, width * 4) {
        sdl3::SDL_DestroyTexture(texture);
        return null;
    }
    sdl3::SDL_SetTextureScaleMode(texture, sdl3::SDL_ScaleMode::SDL_SCALEMODE_NEAREST);
    return texture;
}

public sdl3::SDL_FRect frame_rect(i32 index, i32 columns, i32 size) {
    return sdl3::SDL_FRect {x = 0.0, y = 0.0, w = 0.0, h = 0.0};
}

public void draw_frame(sdl3::SDL_Renderer* renderer, sdl3::SDL_Texture* sheet, i32 index, f32 x, f32 y, f32 scale, bool flip) {
}
