module checker;

public import sdl3;

public const i32 SIZE = 4;

public void fill_pixels(u8* pixels) {
    for i32 y in 0..SIZE {
        for i32 x in 0..SIZE {
            usize at = ((y * SIZE + x) * 4) as usize;
            if (x + y) % 2 == 0 {
                pixels[at] = 230;
                pixels[at + 1] = 120;
                pixels[at + 2] = 40;
            } else {
                pixels[at] = 20;
                pixels[at + 1] = 24;
                pixels[at + 2] = 90;
            }
            pixels[at + 3] = 255;
        }
    }
}

public sdl3::SDL_Texture* make_texture(sdl3::SDL_Renderer* renderer) {
    sdl3::SDL_Texture* texture = sdl3::SDL_CreateTexture(
        renderer,
        sdl3::SDL_PixelFormat::SDL_PIXELFORMAT_ABGR8888,
        sdl3::SDL_TextureAccess::SDL_TEXTUREACCESS_STATIC,
        SIZE,
        SIZE);
    if texture == null {
        return null;
    }
    u8[64] pixels = {};
    fill_pixels(&pixels[0]);
    if !sdl3::SDL_UpdateTexture(texture, null, &pixels[0] as const void*, SIZE * 4) {
        sdl3::SDL_DestroyTexture(texture);
        return null;
    }
    sdl3::SDL_SetTextureScaleMode(texture, sdl3::SDL_ScaleMode::SDL_SCALEMODE_NEAREST);
    return texture;
}

public void draw(sdl3::SDL_Renderer* renderer, sdl3::SDL_Texture* texture) {
    sdl3::SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
    sdl3::SDL_RenderClear(renderer);
    sdl3::SDL_FRect dst = {x = 80.0, y = 40.0, w = 160.0, h = 160.0};
    sdl3::SDL_RenderTexture(renderer, texture, null, &dst);
}
