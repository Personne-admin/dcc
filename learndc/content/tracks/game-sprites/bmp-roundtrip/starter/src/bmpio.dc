module bmpio;

import core::slice;

public import sdl3;

public []const char last_error() {
    const char* p = sdl3::SDL_GetError();
    usize n = 0;
    while p[n] != (0 as char) {
        n += 1;
    }
    return core::slice::from_raw_const(p, n);
}

