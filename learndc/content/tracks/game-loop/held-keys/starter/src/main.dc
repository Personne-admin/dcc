module main;

import sdl3;
import controls;

public i32 main() {
    sdl3::SDL_SetMainReady();
    if !sdl3::SDL_Init(sdl3::SDL_INIT_VIDEO) {
        return 1;
    }
    defer sdl3::SDL_Quit();
    sdl3::SDL_Window* window = null;
    sdl3::SDL_Renderer* renderer = null;
    if !sdl3::SDL_CreateWindowAndRenderer("Held keys", 400, 300, 0, &window, &renderer) {
        return 2;
    }
    defer sdl3::SDL_DestroyWindow(window);
    defer sdl3::SDL_DestroyRenderer(renderer);

    f32 x = 190.0;
    f32 y = 140.0;
    controls::Held held = {};
    bool running = true;
    sdl3::SDL_Event ev;
    while running {
        while sdl3::SDL_PollEvent(&ev) {
            if ev.type == (sdl3::SDL_EventType::SDL_EVENT_QUIT as u32) {
                running = false;
            } else if ev.type == (sdl3::SDL_EventType::SDL_EVENT_KEY_DOWN as u32) {
                if ev.key.scancode == sdl3::SDL_Scancode::SDL_SCANCODE_ESCAPE {
                    running = false;
                }
            }
        }
        i32 count = 0;
        const bool* keys = sdl3::SDL_GetKeyboardState(&count);
        controls::read_keyboard(keys, &held);
        x += (controls::axis(held.left, held.right) * 4) as f32;
        y += (controls::axis(held.up, held.down) * 4) as f32;

        f32 mouse_x = 0.0;
        f32 mouse_y = 0.0;
        u32 buttons = sdl3::SDL_GetMouseState(&mouse_x, &mouse_y);
        bool pressing = controls::button_down(buttons, sdl3::SDL_BUTTON_LEFT);

        sdl3::SDL_SetRenderDrawColor(renderer, 20, 24, 40, 255);
        sdl3::SDL_RenderClear(renderer);
        sdl3::SDL_FRect box = {x = x, y = y, w = 20.0, h = 20.0};
        if pressing {
            sdl3::SDL_SetRenderDrawColor(renderer, 240, 220, 80, 255);
        } else {
            sdl3::SDL_SetRenderDrawColor(renderer, 230, 120, 40, 255);
        }
        sdl3::SDL_RenderFillRect(renderer, &box);
        sdl3::SDL_FRect cursor = {x = mouse_x - 3.0, y = mouse_y - 3.0, w = 6.0, h = 6.0};
        sdl3::SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255);
        sdl3::SDL_RenderRect(renderer, &cursor);
        sdl3::SDL_RenderPresent(renderer);
        sdl3::SDL_Delay(16);
    }
    return 0;
}
