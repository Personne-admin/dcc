module input;

public import sdl3;

public struct Input {
    bool left;
    bool right;
    bool up;
    bool down;
    bool quit;
    bool pause_pressed;
    bool clicked;
    f32 mouse_x;
    f32 mouse_y;
}

public void begin_frame(Input* in) {
    in.pause_pressed = false;
    in.clicked = false;
}

public void apply_event(Input* in, const sdl3::SDL_Event* ev) {
    if ev.type == (sdl3::SDL_EventType::SDL_EVENT_QUIT as u32) {
        in.quit = true;
    } else if ev.type == (sdl3::SDL_EventType::SDL_EVENT_KEY_DOWN as u32) || ev.type == (sdl3::SDL_EventType::SDL_EVENT_KEY_UP as u32) {
        bool down = ev.key.down;
        sdl3::SDL_Scancode code = ev.key.scancode;
        if code == sdl3::SDL_Scancode::SDL_SCANCODE_LEFT || code == sdl3::SDL_Scancode::SDL_SCANCODE_A {
            in.left = down;
        } else if code == sdl3::SDL_Scancode::SDL_SCANCODE_RIGHT || code == sdl3::SDL_Scancode::SDL_SCANCODE_D {
            in.right = down;
        } else if code == sdl3::SDL_Scancode::SDL_SCANCODE_UP || code == sdl3::SDL_Scancode::SDL_SCANCODE_W {
            in.up = down;
        } else if code == sdl3::SDL_Scancode::SDL_SCANCODE_DOWN || code == sdl3::SDL_Scancode::SDL_SCANCODE_S {
            in.down = down;
        } else if code == sdl3::SDL_Scancode::SDL_SCANCODE_ESCAPE {
            if down {
                in.quit = true;
            }
        } else if code == sdl3::SDL_Scancode::SDL_SCANCODE_SPACE {
            if down && !ev.key.repeat {
                in.pause_pressed = true;
            }
        }
    } else if ev.type == (sdl3::SDL_EventType::SDL_EVENT_MOUSE_BUTTON_DOWN as u32) {
        if ev.button.button == sdl3::SDL_BUTTON_LEFT {
            in.clicked = true;
            in.mouse_x = ev.button.x;
            in.mouse_y = ev.button.y;
        }
    }
}

public void pump(Input* in) {
    begin_frame(in);
    sdl3::SDL_Event ev = {};
    while sdl3::SDL_PollEvent(&ev) {
        apply_event(in, &ev);
    }
}
