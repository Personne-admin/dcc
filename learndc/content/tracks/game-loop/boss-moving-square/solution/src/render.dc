module render;

public import sdl3;
public import game;

public struct Color {
    u8 r;
    u8 g;
    u8 b;
}

public Color palette(i32 index) {
    if index == 1 {
        return Color { r = 70, g = 150, b = 230 };
    }
    if index == 2 {
        return Color { r = 90, g = 200, b = 120 };
    }
    if index == 3 {
        return Color { r = 230, g = 80, b = 100 };
    }
    return Color { r = 230, g = 120, b = 40 };
}

public void draw(sdl3::SDL_Renderer* renderer, game::State state) {
    sdl3::SDL_SetRenderDrawColor(renderer, 20, 24, 40, 255);
    sdl3::SDL_RenderClear(renderer);

    Color c = palette(state.color);
    sdl3::SDL_FRect square = {x = state.x, y = state.y, w = game::SIZE, h = game::SIZE};
    sdl3::SDL_SetRenderDrawColor(renderer, c.r, c.g, c.b, 255);
    sdl3::SDL_RenderFillRect(renderer, &square);

    if state.paused {
        sdl3::SDL_FRect left_bar = {x = 10.0, y = 10.0, w = 7.0, h = 30.0};
        sdl3::SDL_FRect right_bar = {x = 24.0, y = 10.0, w = 7.0, h = 30.0};
        sdl3::SDL_SetRenderDrawColor(renderer, 255, 255, 255, 255);
        sdl3::SDL_RenderFillRect(renderer, &left_bar);
        sdl3::SDL_RenderFillRect(renderer, &right_bar);
    }
}
