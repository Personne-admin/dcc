module game;

public import input;

public const f32 WIDTH = 640.0;
public const f32 HEIGHT = 480.0;
public const f32 SIZE = 40.0;
public const f32 SPEED = 240.0;
public const i32 COLORS = 4;

public struct State {
    f32 x;
    f32 y;
    i32 color;
    bool paused;
}

public State new_state() {
    return State { x = 300.0, y = 220.0, color = 0, paused = false };
}

public f32 axis(bool negative, bool positive) {
    f32 value = 0.0;
    if negative {
        value -= 1.0;
    }
    if positive {
        value += 1.0;
    }
    return value;
}

public f32 current_speed(input::Input in) {
    return SPEED;
}

public void move_square(State* s, input::Input in, f32 dt) {
}

public void keep_inside(State* s) {
}

public void click(State* s, input::Input in) {
}

public void toggle_pause(State* s, input::Input in) {
}

public void update(State* s, input::Input in, f32 dt) {
    toggle_pause(s, in);
    if s.paused {
        return;
    }
    click(s, in);
    move_square(s, in, dt);
    keep_inside(s);
}
