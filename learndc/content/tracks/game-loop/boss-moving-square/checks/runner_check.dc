module runner_check;

import sdl3;
import game;
import runner;

i32 expect(bool good, []const char what) {
    if good {
        println("ok   {}", what);
        return 0;
    }
    println("FAIL {}", what);
    return 1;
}

void push_key(bool down, sdl3::SDL_Scancode code) {
    sdl3::SDL_Event ev = {};
    if down {
        ev.type = (sdl3::SDL_EventType::SDL_EVENT_KEY_DOWN as u32);
    } else {
        ev.type = (sdl3::SDL_EventType::SDL_EVENT_KEY_UP as u32);
    }
    ev.key.scancode = code;
    ev.key.down = down;
    sdl3::SDL_PushEvent(&ev);
}

public i32 main() {
    sdl3::SDL_SetHint("SDL_VIDEO_DRIVER", "offscreen");
    sdl3::SDL_SetMainReady();
    if !sdl3::SDL_Init(sdl3::SDL_INIT_VIDEO) {
        println("FAIL SDL_Init");
        return 1;
    }
    defer sdl3::SDL_Quit();
    sdl3::SDL_Window* window = null;
    sdl3::SDL_Renderer* renderer = null;
    if !sdl3::SDL_CreateWindowAndRenderer("check", 640, 480, 0, &window, &renderer) {
        println("FAIL window");
        return 1;
    }
    defer sdl3::SDL_DestroyWindow(window);
    defer sdl3::SDL_DestroyRenderer(renderer);
    i32 failures = 0;

    game::State s = {x = 100.0, y = 100.0, color = 0, paused = false};
    push_key(true, sdl3::SDL_Scancode::SDL_SCANCODE_RIGHT);
    i32 frames = runner::run(renderer, &s, 30);
    failures += expect(frames == 30, "run stops after max_frames frames and returns how many ran");
    failures += expect(s.x > 150.0, "the held right key moved the square while the loop ran");
    failures += expect(s.x <= game::WIDTH - game::SIZE && s.y == 100.0, "the square stayed inside the window and did not drift up or down");

    sdl3::SDL_Event click = {};
    click.type = (sdl3::SDL_EventType::SDL_EVENT_MOUSE_BUTTON_DOWN as u32);
    click.button.button = sdl3::SDL_BUTTON_LEFT;
    click.button.down = true;
    click.button.x = 400.0;
    click.button.y = 300.0;
    sdl3::SDL_PushEvent(&click);
    game::State c = game::new_state();
    frames = runner::run(renderer, &c, 3);
    failures += expect(frames == 3 && c.color == 1 && c.x == 380.0 && c.y == 280.0, "a click queued before the loop is handled in its first frame");

    sdl3::SDL_Event quit = {};
    quit.type = (sdl3::SDL_EventType::SDL_EVENT_QUIT as u32);
    sdl3::SDL_PushEvent(&quit);
    game::State q = game::new_state();
    frames = runner::run(renderer, &q, 100);
    failures += expect(frames == 0, "the quit event ends the loop before a frame is completed");
    failures += expect(q.x == 300.0 && q.y == 220.0, "and the state is untouched");
    return failures;
}
