module main;

import std::os::heap;
import std::array;
import std::alloc;
using std::alloc::AllocError;

struct Stats {
    usize allocs;
    usize frees;
    usize fail_at;
    usize calls;
}

struct Probe {
    Stats* stats;
}

Result([] u8, AllocError) allocate(Probe* self, usize len, usize align) {
    self.stats.calls += 1;
    if self.stats.calls == self.stats.fail_at {
        return AllocError::OutOfMemory;
    }
    std::os::heap::Heap heap = {};
    Result([] u8, AllocError) got = heap.allocate(len, align);
    if got.is_ok() {
        self.stats.allocs += 1;
    }
    return got;
}

bool resize_in_place(Probe* self, [] u8 block, usize new_bytes, usize align) {
    return false;
}

void free(Probe* self, [] u8 block, usize align) {
    std::os::heap::Heap heap = {};
    self.stats.frees += 1;
    heap.free(block, align);
}

Status(AllocError) build_two(Stats* stats) {
    Probe probe = { stats = stats };
    Array(i32, Probe) squares = std::array::new_array!(i32, Probe)(probe);
    Array(i32, Probe) doubles = std::array::new_array!(i32, Probe)(probe);
    for i32 n in 0..40 {
        squares.push(n * n)?;
        doubles.push(n * 2)?;
    }
    squares.deinit();
    doubles.deinit();
    return Status::Ok;
}

public Status(Error) main() {
    println("manual cleanup")?;
    Stats clean = { allocs = 0, frees = 0, fail_at = 0, calls = 0 };
    build_two(&clean)?;
    println("clean run: {} allocations, {} frees", clean.allocs, clean.frees)?;
    usize leaks = 0;
    for usize n in 1..=clean.calls {
        Stats run = { allocs = 0, frees = 0, fail_at = n, calls = 0 };
        Status(AllocError) outcome = build_two(&run);
        usize leaked = run.allocs - run.frees;
        if leaked > 0 {
            println("fail #{}: {} blocks leaked", n, leaked)?;
            leaks += 1;
        }
    }
    println("leaking failure points: {} of {}", leaks, clean.calls)?;
    return Status::Ok;
}
