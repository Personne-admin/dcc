module main;

struct Ball {
    f32 x;
    f32 vx;
}

void step(Ball* b, f32 dt) {
    b.x += b.vx * dt;
    if b.x > 10.0 {
        b.x = 10.0 - (b.x - 10.0);
        b.vx = 0.0 - b.vx;
    }
}

public Status(Error) main() {
    Ball b = Ball { x = 6.0, vx = 4.0 };
    for i32 i = 0; i < 4; i++ {
        step(&b, 1.0);
        println("x = {:.1}, vx = {:.1}", b.x, b.vx)?;
    }
    return Status::Ok;
}
