module pong;

public import input;

public const f32 W = 640.0;
public const f32 H = 360.0;
public const f32 PADDLE_W = 12.0;
public const f32 PADDLE_H = 64.0;
public const f32 BALL = 12.0;
public const f32 LEFT_X = 20.0;
public const f32 RIGHT_X = 608.0;
public const f32 PADDLE_SPEED = 320.0;
public const f32 AI_SPEED = 220.0;
public const f32 BALL_SPEED = 300.0;
public const f32 MAX_VY = 225.0;
public const f32 MAX_BALL_SPEED = 600.0;
public const i32 WIN_SCORE = 5;

public struct Paddle {
    f32 y;
}

public struct Ball {
    f32 x;
    f32 y;
    f32 vx;
    f32 vy;
}

public struct Game {
    Paddle left;
    Paddle right;
    Ball ball;
    i32 left_score;
    i32 right_score;
    i32 winner;
    bool vs_ai;
    u32 seed;
}

public Game new_game(u32 seed) {
    return Game {
        left = Paddle { y = (H - PADDLE_H) / 2.0 },
        right = Paddle { y = (H - PADDLE_H) / 2.0 },
        ball = Ball { x = (W - BALL) / 2.0, y = (H - BALL) / 2.0, vx = BALL_SPEED, vy = 0.0 },
        left_score = 0,
        right_score = 0,
        winner = 0,
        vs_ai = true,
        seed = seed,
    };
}

public u32 next_random(Game* g) {
    g.seed = g.seed * 1664525 + 1013904223;
    return g.seed;
}

public f32 axis(bool negative, bool positive) {
    f32 value = 0.0;
    if negative {
        value -= 1.0;
    }
    if positive {
        value += 1.0;
    }
    return value;
}

public void move_paddle(Paddle* p, f32 dir, f32 dt) {
    p.y += dir * PADDLE_SPEED * dt;
    if p.y < 0.0 {
        p.y = 0.0;
    }
    if p.y > H - PADDLE_H {
        p.y = H - PADDLE_H;
    }
}

public void step_ball(Ball* b, f32 dt) {
    b.x += b.vx * dt;
    b.y += b.vy * dt;
    f32 max_y = H - BALL;
    if b.y < 0.0 {
        b.y = 0.0 - b.y;
        b.vy = 0.0 - b.vy;
    } else if b.y > max_y {
        b.y = max_y - (b.y - max_y);
        b.vy = 0.0 - b.vy;
    }
}

public void speed_up(Ball* b) {
    b.vx *= 1.05;
    if b.vx > MAX_BALL_SPEED {
        b.vx = MAX_BALL_SPEED;
    }
    if b.vx < 0.0 - MAX_BALL_SPEED {
        b.vx = 0.0 - MAX_BALL_SPEED;
    }
}

public bool hit_paddle(Ball* b, Paddle p, i32 side) {
    f32 paddle_x = LEFT_X;
    if side == 2 {
        paddle_x = RIGHT_X;
    }
    bool toward = (side == 1 && b.vx < 0.0) || (side == 2 && b.vx > 0.0);
    if !toward {
        return false;
    }
    bool overlap = b.x < paddle_x + PADDLE_W && paddle_x < b.x + BALL && b.y < p.y + PADDLE_H && p.y < b.y + BALL;
    if !overlap {
        return false;
    }
    if side == 1 {
        b.x = LEFT_X + PADDLE_W;
    } else {
        b.x = RIGHT_X - BALL;
    }
    b.vx = 0.0 - b.vx;
    f32 offset = ((b.y + BALL / 2.0) - (p.y + PADDLE_H / 2.0)) / (PADDLE_H / 2.0);
    if offset > 1.0 {
        offset = 1.0;
    }
    if offset + 1.0 < 0.0 {
        offset = 0.0 - 1.0;
    }
    b.vy = offset * MAX_VY;
    speed_up(b);
    return true;
}

public void serve(Game* g, i32 dir) {
    g.ball.x = (W - BALL) / 2.0;
    g.ball.y = (H - BALL) / 2.0;
    g.ball.vx = (dir as f32) * BALL_SPEED;
    g.ball.vy = (((next_random(g) >> 16) % 301) as f32) - 150.0;
}

public i32 score_if_out(Game* g) {
    if g.ball.x + BALL < 0.0 {
        g.right_score += 1;
        serve(g, -1);
        return 2;
    }
    if g.ball.x > W {
        g.left_score += 1;
        serve(g, 1);
        return 1;
    }
    return 0;
}

public void update_winner(Game* g) {
    if g.left_score >= WIN_SCORE {
        g.winner = 1;
    } else if g.right_score >= WIN_SCORE {
        g.winner = 2;
    }
}

public void restart(Game* g) {
    g.left_score = 0;
    g.right_score = 0;
    g.winner = 0;
    g.left.y = (H - PADDLE_H) / 2.0;
    g.right.y = (H - PADDLE_H) / 2.0;
    serve(g, 1);
}

public void ai_paddle(Game* g, f32 dt) {
    f32 target = g.ball.y + BALL / 2.0;
    f32 center = g.right.y + PADDLE_H / 2.0;
    f32 diff = target - center;
    f32 dir = 0.0;
    if diff > 10.0 {
        dir = 1.0;
    } else if diff + 10.0 < 0.0 {
        dir = 0.0 - 1.0;
    }
    move_paddle(&g.right, dir * (AI_SPEED / PADDLE_SPEED), dt);
}

public void update(Game* g, input::Input in, f32 dt) {
    if in.toggle_ai {
        g.vs_ai = !g.vs_ai;
    }
    if g.winner != 0 {
        if in.restart {
            restart(g);
        }
        return;
    }
    move_paddle(&g.left, axis(in.w, in.s), dt);
    if g.vs_ai {
        ai_paddle(g, dt);
    } else {
        move_paddle(&g.right, axis(in.up, in.down), dt);
    }
    step_ball(&g.ball, dt);
    hit_paddle(&g.ball, g.left, 1);
    hit_paddle(&g.ball, g.right, 2);
    score_if_out(g);
    update_winner(g);
}
