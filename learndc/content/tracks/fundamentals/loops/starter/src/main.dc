module main;

import sums;
using sums::*;

public Status(Error) main() {
    println("Sum of 1 to 1 is {}", sum_to(1))?;
    println("Sum of 1 to 5 is {}", sum_to(5))?;
    println("Sum of 1 to 10 is {}", sum_to(10))?;

    i32 count = 3;
    while count > 0 {
        println("{}...", count)?;
        count -= 1;
    }
    println("Liftoff!")?;
    return Status::Ok;
}
