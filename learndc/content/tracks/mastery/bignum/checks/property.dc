module property;

import std::slice;
import bignum;
using bignum::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool is_text(const Array(u32)* n, []const char expected) {
    Array(char) text = {};
    defer text.deinit();
    if !to_text(n, &text).is_ok() {
        return false;
    }
    []const char got = text.items();
    bool same = std::slice::eq(got, expected);
    if !same {
        println("      got [{}], expected [{}]", got, expected);
    }
    return same;
}

bool is_normal(const Array(u32)* n) {
    if n.len() == 0 {
        return false;
    }
    for limb in n.items() {
        if limb >= BASE {
            return false;
        }
    }
    return n.len() == 1 || n.items()[n.len() - 1] != 0;
}

Status(AllocError) from(Array(u32)* n, u64 value) {
    return set_u64(n, value);
}

bool refused(Status(BigError) s, BigError expected) {
    match s {
        Status::Ok => return false,
        Status::Err(e) => return e == expected,
    }
}

u32 next(u32* state) {
    *state = *state * 1103515245 + 12345;
    return *state;
}

u64 value(u32* state) {
    u32 shape = (next(state) / 65536) % 4;
    u64 high = (next(state) / 65536) as u64 % 32768;
    u64 low = (next(state) / 65536) as u64 % 32768;
    if shape == 0 {
        return low % 1000;
    }
    if shape == 1 {
        return low * 32768 + high;
    }
    if shape == 2 {
        return (low * 32768 + high) * 1000000000 % 4000000000000000000;
    }
    return 999999999 * (low % 3);
}

Status(Error) cases(i32* failures) {
    u32 state = 987654321;
    Array(u32) a = {};
    defer a.deinit();
    Array(u32) b = {};
    defer b.deinit();
    Array(u32) out = {};
    defer out.deinit();
    Array(u32) want = {};
    defer want.deinit();
    usize bad = 0;
    for usize round in 0..400 {
        u64 x = value(&state);
        u64 y = value(&state);
        u32 small = (next(&state) / 65536) % 70000 + 1;
        from(&a, x)?;
        from(&b, y)?;

        add(&a, &b)?;
        from(&want, x + y)?;
        if compare(&a, &want) != 0 || !is_normal(&a) {
            bad += 1;
        }

        from(&a, x)?;
        mul_small(&a, small)?;
        from(&want, x * small as u64 % 18446744073709551615)?;
        if x * small as u64 / small as u64 == x {
            if compare(&a, &want) != 0 || !is_normal(&a) {
                bad += 1;
            }
        }

        from(&a, x)?;
        if x < 4294967296 && y < 4294967296 {
            mul(&a, &b, &out)?;
            from(&want, x * y)?;
            if compare(&out, &want) != 0 || !is_normal(&out) {
                bad += 1;
            }
        }

        from(&a, x)?;
        from(&b, y)?;
        i32 order = compare(&a, &b);
        i32 expected_order = if x < y { -1 } else if x > y { 1 } else { 0 };
        if order != expected_order {
            bad += 1;
        }
        if x >= y {
            match sub(&a, &b) {
                Status::Ok => {},
                Status::Err(e) => bad += 1,
            }
            from(&want, x - y)?;
            if compare(&a, &want) != 0 || !is_normal(&a) {
                bad += 1;
            }
        } else {
            match sub(&a, &b) {
                Status::Ok => bad += 1,
                Status::Err(e) => {},
            }
        }

        from(&a, x)?;
        match divmod_small(&a, small) {
            Result::Ok(r) => {
                from(&want, x / small as u64)?;
                if r as u64 != x % small as u64 || compare(&a, &want) != 0 || !is_normal(&a) {
                    bad += 1;
                }
            },
            Result::Err(e) => bad += 1,
        }
    }
    expect(bad == 0, "400 random cases compared with native u64 arithmetic", failures);
    return Status::Ok;
}

public i32 main() {
    i32 failures = 0;
    if !cases(&failures).is_ok() {
        return 100;
    }
    return failures;
}
