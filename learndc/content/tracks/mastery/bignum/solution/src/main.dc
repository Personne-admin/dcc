module main;

import bignum;
using bignum::*;

Status(Error) text_of(const Array(u32)* n, Array(char)* out) {
    to_text(n, out)?;
    return Status::Ok;
}

Status(Error) factorial(u32 n, Array(u32)* out) {
    set_u64(out, 1)?;
    for u32 k in 2..=n {
        mul_small(out, k)?;
    }
    return Status::Ok;
}

Status(Error) power_of_two(usize exponent, Array(u32)* out) {
    set_u64(out, 1)?;
    for usize k in 0..exponent {
        mul_small(out, 2)?;
    }
    return Status::Ok;
}

u32 digit_sum([]const char digits) {
    u32 total = 0;
    for c in digits {
        total += c as u32 - '0' as u32;
    }
    return total;
}

public Status(Error) main() {
    Array(u32) n = {};
    defer n.deinit();
    Array(char) digits = {};
    defer digits.deinit();

    factorial(25, &n)?;
    text_of(&n, &digits)?;
    []const char shown = digits.items();
    println("25! = {}", shown)?;

    power_of_two(100, &n)?;
    text_of(&n, &digits)?;
    shown = digits.items();
    println("2^100 = {}", shown)?;

    Array(u32) square = {};
    defer square.deinit();
    mul(&n, &n, &square)?;
    text_of(&square, &digits)?;
    shown = digits.items();
    println("2^200 = {}", shown)?;

    Array(u32) a = {};
    defer a.deinit();
    Array(u32) b = {};
    defer b.deinit();
    Array(u32) t = {};
    defer t.deinit();
    set_u64(&a, 0)?;
    set_u64(&b, 1)?;
    for usize k in 0..100 {
        set_u64(&t, 0)?;
        add(&t, &a)?;
        add(&t, &b)?;
        a.clear();
        for limb in b.items() {
            a.push(limb)?;
        }
        b.clear();
        for limb in t.items() {
            b.push(limb)?;
        }
    }
    text_of(&a, &digits)?;
    shown = digits.items();
    println("fib(100) = {}", shown)?;

    factorial(100, &n)?;
    text_of(&n, &digits)?;
    shown = digits.items();
    println("100! has {} digits, digit sum {}", shown.len, digit_sum(shown))?;

    power_of_two(1000, &n)?;
    text_of(&n, &digits)?;
    shown = digits.items();
    println("2^1000 has {} digits, digit sum {}", shown.len, digit_sum(shown))?;

    set_u64(&n, 18446744073709551615)?;
    add(&n, &n)?;
    u32 rest = divmod_small(&n, 7).unwrap();
    text_of(&n, &digits)?;
    shown = digits.items();
    println("(2^64 - 1) * 2 / 7 = {} remainder {}", shown, rest)?;

    set_u64(&n, 1000)?;
    set_u64(&a, 2000)?;
    match sub(&n, &a) {
        Status::Ok => println("1000 - 2000 = ?")?,
        Status::Err(e) => match e {
            BigError::Alloc(x) => println("out of memory")?,
            BigError::Underflow => println("1000 - 2000: underflow")?,
            BigError::DivideByZero => println("division by zero")?,
        },
    }
    return Status::Ok;
}
