module property;

import lcs;
using lcs::*;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

bool matches(const Array(Edit)* got, []const char kinds, []const usize indexes) {
    if got.len() != kinds.len || kinds.len != indexes.len {
        return false;
    }
    for usize i in 0..kinds.len {
        char want = kinds[i];
        EditKind kind = got.items()[i].kind;
        bool kind_ok = (want == 'K' && kind == EditKind::Keep) || (want == 'R' && kind == EditKind::Remove) || (want == 'A' && kind == EditKind::Add);
        if !kind_ok || got.items()[i].index != indexes[i] {
            return false;
        }
    }
    return true;
}

bool lcs_is(Result(usize, DiffError) r, usize expected) {
    match r {
        Result::Ok(n) => return n == expected,
        Result::Err(e) => return false,
    }
}

bool too_large(Result(usize, DiffError) r) {
    match r {
        Result::Ok(n) => return false,
        Result::Err(e) => return e == DiffError::TooLarge,
    }
}

u32 next(u32* state) {
    *state = *state * 1103515245 + 12345;
    return (*state / 65536) % 32768;
}

bool consistent([]const u32 a, []const u32 b, i32* failures) {
    Array(Edit) script = {};
    defer script.deinit();
    if !diff(a, b, &script).is_ok() {
        return false;
    }
    usize i = 0;
    usize j = 0;
    usize keeps = 0;
    for edit in script.items() {
        if edit.kind == EditKind::Keep {
            if i >= a.len || j >= b.len || edit.index != i || a[i] != b[j] {
                return false;
            }
            i += 1;
            j += 1;
            keeps += 1;
        } else if edit.kind == EditKind::Remove {
            if i >= a.len || edit.index != i {
                return false;
            }
            i += 1;
        } else {
            if j >= b.len || edit.index != j {
                return false;
            }
            j += 1;
        }
    }
    if i != a.len || j != b.len {
        return false;
    }
    Result(usize, DiffError) length = lcs_length(a, b);
    return lcs_is(length, keeps);
}

Status(Error) cases(i32* failures) {
    u32 state = 12345;
    Array(u32) a = {};
    defer a.deinit();
    Array(u32) b = {};
    defer b.deinit();
    usize bad = 0;
    for usize round in 0..300 {
        a.clear();
        b.clear();
        usize n = next(&state) as usize % 14;
        usize m = next(&state) as usize % 14;
        u32 alphabet = 2 + next(&state) % 3;
        for usize i in 0..n {
            a.push(next(&state) % alphabet)?;
        }
        for usize i in 0..m {
            b.push(next(&state) % alphabet)?;
        }
        if !consistent(a.items(), b.items(), failures) {
            bad += 1;
        }
    }
    expect(bad == 0, "300 random pairs: every script replays both sequences and its Keeps equal the LCS length", failures);
    return Status::Ok;
}

public i32 main() {
    i32 failures = 0;
    if !cases(&failures).is_ok() {
        return 100;
    }
    return failures;
}
