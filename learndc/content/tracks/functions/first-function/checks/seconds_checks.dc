module seconds_checks;

import basics;
using basics::*;

bool expect([]const char call, i32 got, i32 want) {
    if got == want {
        println("ok    {}", call);
        return true;
    }
    println("FAIL  {}: expected {}, got {}", call, want, got);
    return false;
}

public i32 main() {
    i32 failures = 0;
    if !expect("seconds_in(0)", seconds_in(0), 0) { failures += 1; }
    if !expect("seconds_in(1)", seconds_in(1), 60) { failures += 1; }
    if !expect("seconds_in(3)", seconds_in(3), 180) { failures += 1; }
    if !expect("seconds_in(90)", seconds_in(90), 5400) { failures += 1; }
    return failures;
}
