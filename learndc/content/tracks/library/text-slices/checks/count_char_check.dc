module count_char_check;

import words;

i32 expect([]const char text, char target, usize want) {
    usize got = words::count_char(text, target);
    if got == want {
        return 0;
    }
    println("count_char(\"{}\", '{}'): expected {}, got {}", text, target, want, got).unwrap();
    return 1;
}

public i32 main() {
    i32 failures = 0;
    failures += expect("banana", 'a', 3);
    failures += expect("banana", 'n', 2);
    failures += expect("banana", 'z', 0);
    failures += expect("", 'a', 0);
    failures += expect("   ", ' ', 3);
    failures += expect("a,b,,c", ',', 3);
    return if failures == 0 { 0 } else { 1 };
}
