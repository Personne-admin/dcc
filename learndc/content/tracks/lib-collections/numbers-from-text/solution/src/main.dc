module main;

import std::parse;
import std::slice;

enum ParseFail : u8 {
    Empty,
    NotANumber,
    TooBig,
}

Result(i64, ParseFail) parse_i64([]const char text) {
    if text.len == 0 {
        return ParseFail::Empty;
    }
    usize cursor = 0;
    bool negative = false;
    if text[0] == '-' as char {
        negative = true;
        cursor = 1;
    } else if text[0] == '+' as char {
        cursor = 1;
    }
    usize digits = 0;
    Result(u64, std::parse::NumError) magnitude = std::parse::accumulate_digits(text, &cursor, 10, false, &digits);
    if magnitude.is_err() {
        return match magnitude.unwrap_err() {
            std::parse::NumError::OutOfRange => ParseFail::TooBig,
            _ => ParseFail::NotANumber,
        };
    }
    if cursor != text.len {
        return ParseFail::NotANumber;
    }
    Result(i64, std::parse::NumError) value = std::parse::signed_from_magnitude(magnitude.unwrap(), negative);
    if value.is_err() {
        return ParseFail::TooBig;
    }
    return Result::Ok(value.unwrap());
}

Result(i64, ParseFail) sum_line([]const char line) {
    i64 total = 0;
    std::slice::Split(char) parts = std::slice::split(line, ' ' as char);
    bool more = true;
    while more {
        match parts.next() {
            Optional::Some(token) => {
                if token.len > 0 {
                    total += parse_i64(token)?;
                }
            },
            Optional::None => more = false,
        }
    }
    return Result::Ok(total);
}

Status(Error) report([]const char text) {
    print("{:>22} -> ", text)?;
    match parse_i64(text) {
        Result::Ok(n) => println("{}", n)?,
        Result::Err(e) => match e {
            ParseFail::Empty => println("empty")?,
            ParseFail::NotANumber => println("not a number")?,
            ParseFail::TooBig => println("too big")?,
        },
    }
    return Status::Ok;
}

public Status(Error) main() {
    []const []const char inputs = {
        "42", "-17", "+8", "", "-", "12ab",
        "99999999999999999999", "9223372036854775807",
        "-9223372036854775808", "-9223372036854775809",
    };
    for text in inputs {
        report(text)?;
    }
    []const []const char lines = { "3 4 5", "10 -4  1", "7 x 2", "1 99999999999999999999" };
    for line in lines {
        match sum_line(line) {
            Result::Ok(total) => println("sum of '{}' is {}", line, total)?,
            Result::Err(e) => println("'{}' has a bad number", line)?,
        }
    }
    return Status::Ok;
}
