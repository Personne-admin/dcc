module scene_check;

import sdl3;
import canvas;

@nomangle extern sdl3::SDL_Surface* SDL_RenderReadPixels(sdl3::SDL_Renderer* renderer, const sdl3::SDL_Rect* rect);
@nomangle extern bool SDL_ReadSurfacePixel(sdl3::SDL_Surface* surface, i32 x, i32 y, u8* r, u8* g, u8* b, u8* a);

i32 expect(sdl3::SDL_Surface* shot, i32 x, i32 y, u8 r, u8 g, u8 b) {
    u8 pr = 0;
    u8 pg = 0;
    u8 pb = 0;
    u8 pa = 0;
    SDL_ReadSurfacePixel(shot, x, y, &pr, &pg, &pb, &pa);
    if pr == r && pg == g && pb == b {
        println("ok   pixel {},{} is {} {} {}", x, y, r, g, b);
        return 0;
    }
    println("FAIL pixel {},{} is {} {} {}, expected {} {} {}", x, y, pr, pg, pb, r, g, b);
    return 1;
}

public i32 main() {
    sdl3::SDL_SetHint("SDL_VIDEO_DRIVER", "offscreen");
    sdl3::SDL_SetMainReady();
    if !sdl3::SDL_Init(sdl3::SDL_INIT_VIDEO) {
        println("FAIL SDL_Init");
        return 1;
    }
    defer sdl3::SDL_Quit();
    sdl3::SDL_Window* window = null;
    sdl3::SDL_Renderer* renderer = null;
    if !sdl3::SDL_CreateWindowAndRenderer("check", 320, 240, 0, &window, &renderer) {
        println("FAIL window");
        return 1;
    }
    defer sdl3::SDL_DestroyWindow(window);
    defer sdl3::SDL_DestroyRenderer(renderer);
    canvas::setup(renderer);
    canvas::draw(renderer);
    sdl3::SDL_Surface* shot = SDL_RenderReadPixels(renderer, null);
    if shot == null {
        println("FAIL read pixels");
        return 1;
    }
    defer sdl3::SDL_DestroySurface(shot);
    i32 failures = 0;
    if shot.w != 320 || shot.h != 180 {
        println("FAIL read-back size is {} x {}, expected 320 x 180", shot.w, shot.h);
        failures += 1;
    } else {
        println("ok   read-back size is 320 x 180");
    }
    failures += expect(shot, 0, 0, 240, 190, 60);
    failures += expect(shot, 1, 1, 240, 190, 60);
    failures += expect(shot, 319, 179, 240, 190, 60);
    failures += expect(shot, 318, 0, 240, 190, 60);
    failures += expect(shot, 2, 2, 20, 24, 40);
    failures += expect(shot, 100, 50, 20, 24, 40);
    failures += expect(shot, 140, 70, 230, 80, 100);
    failures += expect(shot, 179, 109, 230, 80, 100);
    failures += expect(shot, 160, 90, 230, 80, 100);
    failures += expect(shot, 139, 90, 20, 24, 40);
    failures += expect(shot, 180, 90, 20, 24, 40);
    return failures;
}
