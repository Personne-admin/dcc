module scene;

public import sdl3;

public void set_color(sdl3::SDL_Renderer* renderer, u8 r, u8 g, u8 b) {
    sdl3::SDL_SetRenderDrawColor(renderer, r, g, b, 255);
}

public void draw(sdl3::SDL_Renderer* renderer) {
    set_color(renderer, 110, 170, 230);
    sdl3::SDL_RenderClear(renderer);

    sdl3::SDL_FRect ground = {x = 0.0, y = 110.0, w = 200.0, h = 40.0};
    set_color(renderer, 60, 150, 70);
    sdl3::SDL_RenderFillRect(renderer, &ground);

    sdl3::SDL_FRect body = {x = 60.0, y = 60.0, w = 80.0, h = 50.0};
    set_color(renderer, 200, 170, 120);
    sdl3::SDL_RenderFillRect(renderer, &body);

    sdl3::SDL_FRect door = {x = 90.0, y = 80.0, w = 20.0, h = 30.0};
    set_color(renderer, 110, 70, 40);
    sdl3::SDL_RenderFillRect(renderer, &door);

    sdl3::SDL_FRect window = {x = 68.0, y = 68.0, w = 16.0, h = 14.0};
    set_color(renderer, 255, 255, 255);
    sdl3::SDL_RenderRect(renderer, &window);

    set_color(renderer, 180, 50, 50);
    sdl3::SDL_RenderLine(renderer, 55.0, 60.0, 100.0, 15.0);
    sdl3::SDL_RenderLine(renderer, 100.0, 15.0, 145.0, 60.0);

    set_color(renderer, 20, 20, 20);
    sdl3::SDL_RenderPoint(renderer, 20.0, 20.0);
    sdl3::SDL_RenderPoint(renderer, 30.0, 25.0);
    sdl3::SDL_RenderPoint(renderer, 40.0, 20.0);
}
