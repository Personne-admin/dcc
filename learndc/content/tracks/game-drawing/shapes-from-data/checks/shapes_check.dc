module shapes_check;

import sdl3;
import chart;

@nomangle extern sdl3::SDL_Surface* SDL_RenderReadPixels(sdl3::SDL_Renderer* renderer, const sdl3::SDL_Rect* rect);
@nomangle extern bool SDL_ReadSurfacePixel(sdl3::SDL_Surface* surface, i32 x, i32 y, u8* r, u8* g, u8* b, u8* a);

i32 expect(sdl3::SDL_Surface* shot, i32 x, i32 y, u8 r, u8 g, u8 b) {
    u8 pr = 0;
    u8 pg = 0;
    u8 pb = 0;
    u8 pa = 0;
    SDL_ReadSurfacePixel(shot, x, y, &pr, &pg, &pb, &pa);
    if pr == r && pg == g && pb == b {
        println("ok   pixel {},{} is {} {} {}", x, y, r, g, b);
        return 0;
    }
    println("FAIL pixel {},{} is {} {} {}, expected {} {} {}", x, y, pr, pg, pb, r, g, b);
    return 1;
}

chart::Shape[3] shapes() {
    chart::Shape[3] list = {
        chart::Shape { rect = {x = 10.0, y = 10.0, w = 40.0, h = 30.0}, color = chart::Color { r = 200, g = 50, b = 50 }, filled = true },
        chart::Shape { rect = {x = 30.0, y = 20.0, w = 40.0, h = 30.0}, color = chart::Color { r = 50, g = 200, b = 50 }, filled = false },
        chart::Shape { rect = {x = 40.0, y = 25.0, w = 20.0, h = 20.0}, color = chart::Color { r = 50, g = 50, b = 200 }, filled = true },
    };
    return list;
}

public i32 main() {
    sdl3::SDL_SetHint("SDL_VIDEO_DRIVER", "offscreen");
    sdl3::SDL_SetMainReady();
    if !sdl3::SDL_Init(sdl3::SDL_INIT_VIDEO) {
        println("FAIL SDL_Init");
        return 1;
    }
    defer sdl3::SDL_Quit();
    sdl3::SDL_Window* window = null;
    sdl3::SDL_Renderer* renderer = null;
    if !sdl3::SDL_CreateWindowAndRenderer("check", 100, 100, 0, &window, &renderer) {
        println("FAIL window");
        return 1;
    }
    defer sdl3::SDL_DestroyWindow(window);
    defer sdl3::SDL_DestroyRenderer(renderer);
    chart::Color bg = chart::Color { r = 10, g = 10, b = 10 };
    chart::set_color(renderer, bg);
    sdl3::SDL_RenderClear(renderer);
    chart::Shape[3] list = shapes();
    chart::draw_shapes(renderer, list[0..3]);
    sdl3::SDL_Surface* shot = SDL_RenderReadPixels(renderer, null);
    if shot == null {
        println("FAIL read pixels");
        return 1;
    }
    defer sdl3::SDL_DestroySurface(shot);
    i32 failures = 0;
    failures += expect(shot, 5, 5, 10, 10, 10);
    failures += expect(shot, 10, 10, 200, 50, 50);
    failures += expect(shot, 39, 39, 200, 50, 50);
    failures += expect(shot, 50, 12, 10, 10, 10);
    failures += expect(shot, 20, 15, 200, 50, 50);
    failures += expect(shot, 30, 20, 50, 200, 50);
    failures += expect(shot, 69, 20, 50, 200, 50);
    failures += expect(shot, 69, 49, 50, 200, 50);
    failures += expect(shot, 70, 20, 10, 10, 10);
    failures += expect(shot, 35, 25, 200, 50, 50);
    failures += expect(shot, 40, 25, 50, 50, 200);
    failures += expect(shot, 50, 44, 50, 50, 200);
    failures += expect(shot, 60, 45, 10, 10, 10);
    failures += expect(shot, 45, 49, 50, 200, 50);
    failures += expect(shot, 45, 46, 10, 10, 10);
    return failures;
}
