module main;

import sdl3;
import chart;

public i32 main() {
    sdl3::SDL_SetMainReady();
    if !sdl3::SDL_Init(sdl3::SDL_INIT_VIDEO) {
        return 1;
    }
    defer sdl3::SDL_Quit();
    sdl3::SDL_Window* window = null;
    sdl3::SDL_Renderer* renderer = null;
    if !sdl3::SDL_CreateWindowAndRenderer("Shapes from data", 320, 200, 0, &window, &renderer) {
        return 2;
    }
    defer sdl3::SDL_DestroyWindow(window);
    defer sdl3::SDL_DestroyRenderer(renderer);

    chart::Shape[3] shapes = {
        chart::Shape { rect = {x = 10.0, y = 10.0, w = 120.0, h = 60.0}, color = chart::Color { r = 70, g = 150, b = 230 }, filled = true },
        chart::Shape { rect = {x = 70.0, y = 40.0, w = 120.0, h = 60.0}, color = chart::Color { r = 240, g = 190, b = 60 }, filled = false },
        chart::Shape { rect = {x = 150.0, y = 20.0, w = 40.0, h = 40.0}, color = chart::Color { r = 230, g = 80, b = 100 }, filled = true },
    };
    i32[6] sales = {40, 90, 65, 120, 30, 80};

    bool running = true;
    sdl3::SDL_Event ev;
    while running {
        while sdl3::SDL_PollEvent(&ev) {
            if ev.type == (sdl3::SDL_EventType::SDL_EVENT_QUIT as u32) {
                running = false;
            } else if ev.type == (sdl3::SDL_EventType::SDL_EVENT_KEY_DOWN as u32) {
                if ev.key.key == sdl3::SDLK_ESCAPE {
                    running = false;
                }
            }
        }
        sdl3::SDL_SetRenderDrawColor(renderer, 20, 24, 40, 255);
        sdl3::SDL_RenderClear(renderer);
        chart::draw_shapes(renderer, shapes[0..3]);
        chart::draw_bars(renderer, sales[0..6], 30, 10, 190, chart::Color { r = 90, g = 200, b = 120 });
        sdl3::SDL_RenderPresent(renderer);
        sdl3::SDL_Delay(16);
    }
    return 0;
}
