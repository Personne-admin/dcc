module fail_check;

import sdl3;
import resources;
import art;

@nomangle extern sdl3::SDL_Surface* SDL_RenderReadPixels(sdl3::SDL_Renderer* renderer, const sdl3::SDL_Rect* rect);
@nomangle extern bool SDL_ReadSurfacePixel(sdl3::SDL_Surface* surface, i32 x, i32 y, u8* r, u8* g, u8* b, u8* a);

i32 expect_px(sdl3::SDL_Surface* shot, i32 x, i32 y, u8 r, u8 g, u8 b) {
    u8 pr = 0;
    u8 pg = 0;
    u8 pb = 0;
    u8 pa = 0;
    SDL_ReadSurfacePixel(shot, x, y, &pr, &pg, &pb, &pa);
    if pr == r && pg == g && pb == b {
        println("ok   pixel {},{} is {} {} {}", x, y, r, g, b);
        return 0;
    }
    println("FAIL pixel {},{} is {} {} {}, expected {} {} {}", x, y, pr, pg, pb, r, g, b);
    return 1;
}

i32 expect_that(bool cond, []const char what) {
    if cond {
        println("ok   {}", what);
        return 0;
    }
    println("FAIL {}", what);
    return 1;
}

public i32 main() {
    sdl3::SDL_SetHint("SDL_VIDEO_DRIVER", "offscreen");
    sdl3::SDL_SetMainReady();
    if !sdl3::SDL_Init(sdl3::SDL_INIT_VIDEO) {
        println("FAIL SDL_Init");
        return 1;
    }
    defer sdl3::SDL_Quit();
    sdl3::SDL_Window* window = null;
    sdl3::SDL_Renderer* renderer = null;
    if !sdl3::SDL_CreateWindowAndRenderer("check", 320, 240, 0, &window, &renderer) {
        println("FAIL window");
        return 1;
    }
    defer sdl3::SDL_DestroyWindow(window);
    defer sdl3::SDL_DestroyRenderer(renderer);
    i32 failures = 0;
    []const []const char bad = {"####", "##"};
    resources::Resources res = {};
    failures += expect_that(!resources::load_with(&res, renderer, bad, art::HERO, art::KEY), "a bad first picture fails the load");
    failures += expect_that(res.wall == null && res.hero == null && res.key == null, "nothing is left after a first failure");
    failures += expect_that(!resources::load_with(&res, renderer, art::WALL, bad, art::KEY), "a bad second picture fails the load");
    failures += expect_that(res.wall == null && res.hero == null && res.key == null, "the wall texture is released after a second failure");
    failures += expect_that(!resources::load_with(&res, renderer, art::WALL, art::HERO, bad), "a bad third picture fails the load");
    failures += expect_that(res.wall == null && res.hero == null && res.key == null, "wall and hero are released after a third failure");
    failures += expect_that(resources::load(&res, renderer), "a good load works after the failures");
    resources::unload(&res);
    return failures;
}
