module main;

import sdl3;
import map;

public i32 main() {
    sdl3::SDL_SetMainReady();
    if !sdl3::SDL_Init(sdl3::SDL_INIT_VIDEO) {
        return 1;
    }
    defer sdl3::SDL_Quit();
    sdl3::SDL_Window* window = null;
    sdl3::SDL_Renderer* renderer = null;
    if !sdl3::SDL_CreateWindowAndRenderer("Tile maps", 320, 240, 0, &window, &renderer) {
        return 2;
    }
    defer sdl3::SDL_DestroyWindow(window);
    defer sdl3::SDL_DestroyRenderer(renderer);
    map::Map level = {};
    if !map::parse(&level, map::LEVEL) {
        return 3;
    }
    f32 cam_x = 0.0;
    f32 cam_y = 0.0;
    bool running = true;
    sdl3::SDL_Event ev;
    while running {
        while sdl3::SDL_PollEvent(&ev) {
            if ev.type == (sdl3::SDL_EventType::SDL_EVENT_QUIT as u32) {
                running = false;
            } else if ev.type == (sdl3::SDL_EventType::SDL_EVENT_KEY_DOWN as u32) {
                if ev.key.key == sdl3::SDLK_ESCAPE {
                    running = false;
                }
            }
        }
        const bool* keys = sdl3::SDL_GetKeyboardState(null);
        if keys[sdl3::SDL_Scancode::SDL_SCANCODE_LEFT as i32] {
            cam_x -= 2.0;
        }
        if keys[sdl3::SDL_Scancode::SDL_SCANCODE_RIGHT as i32] {
            cam_x += 2.0;
        }
        if keys[sdl3::SDL_Scancode::SDL_SCANCODE_UP as i32] {
            cam_y -= 2.0;
        }
        if keys[sdl3::SDL_Scancode::SDL_SCANCODE_DOWN as i32] {
            cam_y += 2.0;
        }
        sdl3::SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
        sdl3::SDL_RenderClear(renderer);
        map::draw(renderer, &level, cam_x, cam_y);
        sdl3::SDL_RenderPresent(renderer);
        sdl3::SDL_Delay(16);
    }
    return 0;
}
