module game;

public import level;
public import collision;

public enum Scene : u8 {
    Title,
    Play,
    Pause,
    Win,
}

public struct Input {
    bool left;
    bool right;
    bool up;
    bool down;
    bool confirm;
    bool pause;
    bool use;
}

public struct Game {
    Scene scene;
    level::Level level;
    collision::Body player;
    i32 keys;
    i32 collected;
    bool exit_reached;
    u32 elapsed_ms;
    Input prev;
}

public const f32 SPEED = 80.0;
public const f32 BODY = 12.0;

public Input no_input() {
    return Input { left = false, right = false, up = false, down = false, confirm = false, pause = false, use = false };
}

public void start(Game* g) {
    level::load(&g.level, level::LEVEL);
    g.player = collision::Body {
        x = (g.level.start_col * level::TILE) as f32 + 4.0,
        y = (g.level.start_row * level::TILE) as f32 + 4.0,
        w = BODY,
        h = BODY,
    };
    g.keys = 0;
    g.collected = 0;
    g.exit_reached = false;
    g.elapsed_ms = 0;
    g.scene = Scene::Play;
}

public Game new_game() {
    Game g = {};
    g.prev = no_input();
    return g;
}

public void walk(Game* g, Input in, f32 dt) {
}

public void interact(Game* g, Input in) {
}

public void update(Game* g, Input in, f32 dt) {
}
