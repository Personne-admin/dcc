module lamp;

public import sdl3;

public const i32 FRAME = 8;
public const i32 COUNT = 4;

public []const []const char LAMP = {
    "..####....####....####....####..",
    ".#rrrr#..#yyyy#..#gggg#..#bbbb#.",
    "#rrrrrr##yyyyyy##gggggg##bbbbbb#",
    "#rrrrrr##yyyyyy##gggggg##bbbbbb#",
    "#rrrrrr##yyyyyy##gggggg##bbbbbb#",
    "#rrrrrr##yyyyyy##gggggg##bbbbbb#",
    ".#rrrr#..#yyyy#..#gggg#..#bbbb#.",
    "..####....####....####....####..",
};

struct Rgba {
    u8 r;
    u8 g;
    u8 b;
    u8 a;
}

Rgba color_for(char c) {
    match c {
        '#' => return Rgba { r = 30, g = 30, b = 50, a = 255 },
        'r' => return Rgba { r = 200, g = 40, b = 40, a = 255 },
        'y' => return Rgba { r = 240, g = 210, b = 60, a = 255 },
        'g' => return Rgba { r = 60, g = 180, b = 60, a = 255 },
        'b' => return Rgba { r = 50, g = 90, b = 200, a = 255 },
        _ => return Rgba { r = 0, g = 0, b = 0, a = 0 },
    }
}

public sdl3::SDL_FRect frame_rect(i32 index) {
    return sdl3::SDL_FRect { x = (index * FRAME) as f32, y = 0.0, w = FRAME as f32, h = FRAME as f32 };
}

public sdl3::SDL_Texture* create(sdl3::SDL_Renderer* renderer) {
    i32 width = LAMP[0].len as i32;
    i32 height = LAMP.len as i32;
    sdl3::SDL_Texture* texture = sdl3::SDL_CreateTexture(
        renderer,
        sdl3::SDL_PixelFormat::SDL_PIXELFORMAT_ABGR8888,
        sdl3::SDL_TextureAccess::SDL_TEXTUREACCESS_STATIC,
        width,
        height);
    if texture == null {
        return null;
    }
    u8[1024] pixels = {};
    usize y = 0;
    for row in LAMP {
        usize x = 0;
        for c in row {
            Rgba color = color_for(c);
            usize at = (y * (width as usize) + x) * 4;
            pixels[at] = color.r;
            pixels[at + 1] = color.g;
            pixels[at + 2] = color.b;
            pixels[at + 3] = color.a;
            x += 1;
        }
        y += 1;
    }
    if !sdl3::SDL_UpdateTexture(texture, null, &pixels[0] as const void*, width * 4) {
        sdl3::SDL_DestroyTexture(texture);
        return null;
    }
    sdl3::SDL_SetTextureScaleMode(texture, sdl3::SDL_ScaleMode::SDL_SCALEMODE_NEAREST);
    return texture;
}
