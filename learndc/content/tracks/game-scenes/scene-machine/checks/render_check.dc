module render_check;

import sdl3;
import game;
import render;

@nomangle extern sdl3::SDL_Surface* SDL_RenderReadPixels(sdl3::SDL_Renderer* renderer, const sdl3::SDL_Rect* rect);
@nomangle extern bool SDL_ReadSurfacePixel(sdl3::SDL_Surface* surface, i32 x, i32 y, u8* r, u8* g, u8* b, u8* a);

i32 expect_px(sdl3::SDL_Surface* shot, i32 x, i32 y, u8 r, u8 g, u8 b) {
    u8 pr = 0;
    u8 pg = 0;
    u8 pb = 0;
    u8 pa = 0;
    SDL_ReadSurfacePixel(shot, x, y, &pr, &pg, &pb, &pa);
    if pr == r && pg == g && pb == b {
        println("ok   pixel {},{} is {} {} {}", x, y, r, g, b);
        return 0;
    }
    println("FAIL pixel {},{} is {} {} {}, expected {} {} {}", x, y, pr, pg, pb, r, g, b);
    return 1;
}

i32 expect_that(bool cond, []const char what) {
    if cond {
        println("ok   {}", what);
        return 0;
    }
    println("FAIL {}", what);
    return 1;
}

public i32 main() {
    sdl3::SDL_SetHint("SDL_VIDEO_DRIVER", "offscreen");
    sdl3::SDL_SetMainReady();
    if !sdl3::SDL_Init(sdl3::SDL_INIT_VIDEO) {
        println("FAIL SDL_Init");
        return 1;
    }
    defer sdl3::SDL_Quit();
    sdl3::SDL_Window* window = null;
    sdl3::SDL_Renderer* renderer = null;
    if !sdl3::SDL_CreateWindowAndRenderer("check", 320, 240, 0, &window, &renderer) {
        println("FAIL window");
        return 1;
    }
    defer sdl3::SDL_DestroyWindow(window);
    defer sdl3::SDL_DestroyRenderer(renderer);
    i32 failures = 0;
    game::Game g = game::new_game();
    sdl3::SDL_Surface* shot = null;
    render::draw(renderer, &g);
    shot = SDL_RenderReadPixels(renderer, null);
    if shot == null {
        println("FAIL read pixels");
        return 1;
    }
    failures += expect_px(shot, 5, 5, 20, 30, 80);
    failures += expect_px(shot, 100, 120, 230, 120, 40);
    sdl3::SDL_DestroySurface(shot);

    g.scene = game::Scene::Play;
    g.score = 4;
    render::draw(renderer, &g);
    shot = SDL_RenderReadPixels(renderer, null);
    failures += expect_px(shot, 5, 5, 20, 60, 30);
    failures += expect_px(shot, 15, 15, 200, 40, 40);
    failures += expect_px(shot, 75, 15, 200, 40, 40);
    failures += expect_px(shot, 105, 15, 20, 60, 30);
    failures += expect_px(shot, 30, 45, 240, 220, 60);
    failures += expect_px(shot, 60, 45, 20, 60, 30);
    failures += expect_px(shot, 160, 120, 20, 60, 30);
    sdl3::SDL_DestroySurface(shot);

    g.scene = game::Scene::Pause;
    g.lives = 2;
    render::draw(renderer, &g);
    shot = SDL_RenderReadPixels(renderer, null);
    failures += expect_px(shot, 15, 15, 200, 40, 40);
    failures += expect_px(shot, 75, 15, 20, 60, 30);
    failures += expect_px(shot, 140, 120, 230, 230, 230);
    failures += expect_px(shot, 180, 120, 230, 230, 230);
    failures += expect_px(shot, 160, 120, 20, 60, 30);
    sdl3::SDL_DestroySurface(shot);

    g.scene = game::Scene::GameOver;
    render::draw(renderer, &g);
    shot = SDL_RenderReadPixels(renderer, null);
    failures += expect_px(shot, 5, 5, 90, 20, 20);
    failures += expect_px(shot, 160, 120, 240, 240, 240);
    sdl3::SDL_DestroySurface(shot);
    return failures;
}
