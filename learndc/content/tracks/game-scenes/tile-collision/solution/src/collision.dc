module collision;

public import sdl3;
public import map;

public struct Body {
    f32 x;
    f32 y;
    f32 w;
    f32 h;
}

public bool blocked(map::Map* m, f32 x, f32 y, f32 w, f32 h) {
    f32 tile = map::TILE as f32;
    i32 first_col = (x / tile) as i32;
    if x < 0.0 {
        first_col = -1;
    }
    i32 last_col = ((x + w - 0.001) / tile) as i32;
    if x + w - 0.001 < 0.0 {
        last_col = -1;
    }
    i32 first_row = (y / tile) as i32;
    if y < 0.0 {
        first_row = -1;
    }
    i32 last_row = ((y + h - 0.001) / tile) as i32;
    if y + h - 0.001 < 0.0 {
        last_row = -1;
    }
    for i32 row in first_row..=last_row {
        for i32 col in first_col..=last_col {
            if map::is_wall(m, col, row) {
                return true;
            }
        }
    }
    return false;
}

public void move(map::Map* m, Body* b, f32 dx, f32 dy) {
    f32 tile = map::TILE as f32;
    f32 nx = b.x + dx;
    if blocked(m, nx, b.y, b.w, b.h) {
        if dx > 0.0 {
            nx = ((((nx + b.w) / tile) as i32) as f32) * tile - b.w;
        } else {
            nx = ((((nx / tile) as i32) + 1) as f32) * tile;
        }
    }
    b.x = nx;
    f32 ny = b.y + dy;
    if blocked(m, b.x, ny, b.w, b.h) {
        if dy > 0.0 {
            ny = ((((ny + b.h) / tile) as i32) as f32) * tile - b.h;
        } else {
            ny = ((((ny / tile) as i32) + 1) as f32) * tile;
        }
    }
    b.y = ny;
}
