module gfx;

import core::slice;

public import sdl3;

public struct Gfx {
    sdl3::SDL_Window* window;
    sdl3::SDL_Renderer* renderer;
}

public []const char last_error() {
    const char* text = sdl3::SDL_GetError();
    if text == null {
        return "";
    }
    usize n = 0;
    while text[n] != (0 as char) {
        n += 1;
    }
    return core::slice::from_raw_const(text, n);
}

public bool open(Gfx* g, const char* title, i32 width, i32 height, const char* renderer_name) {
    return false;
}

public void close(Gfx* g) {
}
