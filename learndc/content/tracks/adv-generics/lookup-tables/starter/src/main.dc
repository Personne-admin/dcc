module main;

import tables;

public Status(Error) main() {
    []const char text = "Hello World 2026: DC rocks!";
    usize digits = 0;
    usize upper = 0;
    usize lower = 0;
    usize spaces = 0;
    usize others = 0;

    for char c in text {
        u8 class = tables::class_of(c);
        if class == tables::DIGIT {
            digits += 1;
        } else if class == tables::UPPER {
            upper += 1;
        } else if class == tables::LOWER {
            lower += 1;
        } else if class == tables::SPACE {
            spaces += 1;
        } else {
            others += 1;
        }
    }

    println("digits {} upper {} lower {} spaces {} others {}", digits, upper, lower, spaces, others)?;
    for char c in text {
        print("{}", tables::rot13(c))?;
    }
    println("")?;
    return Status::Ok;
}
