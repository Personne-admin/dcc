module main;

using Addable(T) = compiles(T a, T b) {
    a + b;
};

T total(T)([]const T items) if Addable(T) {
    T acc = items[0];
    for usize i = 1; i < items.len; i++ {
        acc += items[i];
    }
    return acc;
}

public Status(Error) main() {
    i32[4] counts = { 4, 8, 15, 16 };
    f64[2] weights = { 0.5, 0.25 };
    println("{}", total(counts))?;
    println("{:.2}", total(weights))?;
    return Status::Ok;
}
