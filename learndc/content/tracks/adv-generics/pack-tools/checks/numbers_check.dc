module numbers_check;

import tools;

void expect(bool ok, []const char what, i32* failures) {
    if ok {
        println("ok    {}", what);
    } else {
        println("FAIL  {}", what);
        *failures += 1;
    }
}

public i32 main() {
    i32 failures = 0;

    expect(tools::sum_all() == 0.0, "sum_all of nothing is 0", &failures);
    expect(tools::sum_all(5) == 5.0, "sum_all of one value", &failures);
    expect(tools::sum_all(1 as u8, 2 as i64, 0.5, 4 as u16) == 7.5, "sum_all of mixed types", &failures);
    expect(tools::sum_all(-3, 3) == 0.0, "negative values cancel", &failures);

    expect(tools::largest_of(7) == 7.0, "largest_of one value", &failures);
    expect(tools::largest_of(-9, -2, -30) == -2.0, "largest_of all negative values", &failures);
    expect(tools::largest_of(1 as u8, 250 as u8, 3.5) == 250.0, "largest_of mixed types", &failures);
    expect(tools::largest_of(0.5, 3 as i64, 2 as u16) == 3.0, "the first value is only one candidate", &failures);

    expect(tools::count_negative() == 0, "count_negative of nothing", &failures);
    expect(tools::count_negative(1, 2, 3) == 0, "no negative value", &failures);
    expect(tools::count_negative(-1, -2.5, 0, 4 as i8, -3 as i64) == 3, "negative values of mixed types", &failures);
    expect(tools::count_negative(0.0, -0.001) == 1, "zero is not negative", &failures);
    return failures;
}
