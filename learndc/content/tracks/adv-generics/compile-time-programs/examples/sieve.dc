module main;

bool[32] build_primes() {
    bool[32] is_prime = {};
    for usize n = 2; n < 32; n++ {
        is_prime[n] = true;
    }
    for usize p = 2; p * p < 32; p++ {
        if is_prime[p] {
            for usize multiple = p * p; multiple < 32; multiple += p {
                is_prime[multiple] = false;
            }
        }
    }
    return is_prime;
}

using bool[32] IS_PRIME = build_primes();

usize count_primes_below(usize limit) {
    usize count = 0;
    for usize n = 0; n < limit; n++ {
        if IS_PRIME[n] {
            count += 1;
        }
    }
    return count;
}

public Status(Error) main() {
    println("{} {} {}", IS_PRIME[7], IS_PRIME[9], IS_PRIME[31])?;
    println("{}", count_primes_below(32))?;
    return Status::Ok;
}
