module kinds;

public using Addable(T) = compiles(T a, T b) { a + b; };
public using Orderable(T) = compiles(T a, T b) { a < b; };
public using Numeric(T) = Addable(T) && Orderable(T);

public using Integer(T) = compiles(T v) { v; };
public using Float(T) = compiles(T v) { v; };
public using Sequence(T) = compiles(T v) { v; };
public using Other(T) = compiles(T v) { v; };

public []const char kind(T)(T value) if Integer(T) {
    return "integer";
}

public []const char kind(T)(T value) if Float(T) {
    return "float";
}

public []const char kind(T)(T value) if Sequence(T) {
    return "sequence";
}

public []const char kind(T)(T value) if Other(T) {
    return "other";
}
