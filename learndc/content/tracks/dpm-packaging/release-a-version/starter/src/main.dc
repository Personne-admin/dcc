module main;

import audit;
import stats::summary;

public i32 main() {
    i32[3] m = { 2, 4, 9 };
    audit::Text manifest;
    audit::Text log;
    audit::expect(stats::summary::average(m[0..3]) > 4.99 && stats::summary::average(m[0..3]) < 5.01, "average of 2, 4, 9 is 5");
    audit::expect(audit::load(&manifest, "libs/stats/project.dcon"), "the library manifest is readable");
    audit::expect(audit::has(&manifest, "version=\"0.2.0\""), "the version is 0.2.0");
    audit::expect(audit::load(&log, "libs/stats/CHANGELOG.md"), "libs/stats/CHANGELOG.md exists");
    audit::expect(audit::has(&log, "##0.2.0"), "the changelog has a 0.2.0 section");
    audit::expect(audit::has(&log, "average") && audit::has(&log, "mean"), "the entry names the old and the new function");
    audit::expect(audit::has(&log, "##0.1.0"), "the 0.1.0 section is kept");
    return audit::finish();
}
