module main;

struct Pixel {
    u8 r;
    u8 g;
    u8 b;
}

public Status(Error) main() {
    Pixel[4] row = {};
    usize first = &row[0] as usize;
    usize second = &row[1] as usize;
    println("one pixel: {} bytes", sizeof(Pixel))?;
    println("distance between neighbours: {}", second - first)?;
    println("whole row: {} bytes", sizeof(Pixel[4]))?;
    []Pixel view = row[1..3];
    println("slice of {} pixels starts {} bytes in", view.len, view.ptr as usize - first)?;
    println("a slice value itself: {} bytes", sizeof([]Pixel))?;
    return Status::Ok;
}
