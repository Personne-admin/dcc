{
    "name": "dcc-vscode",
    "displayName": "DC Language Support",
    "description": "Syntax highlighting and language server support for the DC programming language, .dcc-test harness fixtures and DC IR (DIR) dumps",
    "publisher": "dcc",
    "version": "0.4.0",
    "license": "GPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/yeint-herp/dcc.git",
        "directory": "vscode"
    },
    "bugs": {
        "url": "https://github.com/yeint-herp/dcc/issues"
    },
    "homepage": "https://github.com/yeint-herp/dcc#readme",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:dc",
        "onLanguage:dcc-dir",
        "onLanguage:dcc-test",
        "onFileSystem:dcc-core"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "compile": "tsc -p .",
        "watch": "tsc -watch -p .",
        "test": "npm run compile && node --test \"out/test/*.test.js\"",
        "validate": "node scripts/validate.mjs",
        "vscode:prepublish": "npm run esbuild-base -- --minify",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node"
    },
    "contributes": {
        "languages": [
            {
                "id": "dc",
                "extensions": [
                    ".dc"
                ],
                "aliases": [
                    "DCC",
                    "dc"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "dcc-dir",
                "extensions": [
                    ".dir"
                ],
                "aliases": [
                    "DCC IR",
                    "dcc-dir"
                ],
                "configuration": "./language-configuration-dcc-dir.json"
            },
            {
                "id": "dcc-test",
                "extensions": [
                    ".dcc-test"
                ],
                "aliases": [
                    "DCC Test",
                    "dcc-test"
                ],
                "configuration": "./language-configuration-dcc-test.json"
            }
        ],
        "grammars": [
            {
                "language": "dc",
                "scopeName": "source.dc",
                "path": "./syntaxes/dcc.tmLanguage.json"
            },
            {
                "language": "dcc-dir",
                "scopeName": "source.dcc-dir",
                "path": "./syntaxes/dcc-dir.tmLanguage.json"
            },
            {
                "language": "dcc-test",
                "scopeName": "source.dcc-test",
                "path": "./syntaxes/dcc-test.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "DCC Language Server Configuration",
            "properties": {
                "dcc.serverPath": {
                    "type": "string",
                    "default": "dccd",
                    "description": "Path to the DCC language server executable (dccd)"
                },
                "dcc.includePaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional include/import paths used to resolve modules. Relative paths are resolved from the first workspace folder."
                },
                "dcc.compilationDatabase": {
                    "type": "string",
                    "default": "",
                    "description": "Path to compile_commands.json. Relative paths are resolved from the workspace folder. Empty uses automatic discovery."
                },
                "dcc.inlayHints.typeHints": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show inferred type hints (e.g. for-in binding types)."
                },
                "dcc.inlayHints.parameterHints": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show parameter name hints on call arguments."
                },
                "dcc.inlayHints.suppressParameterNameMatches": {
                    "type": "boolean",
                    "default": true,
                    "description": "Suppress a parameter hint when the argument is a simple identifier that already equals the parameter name."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/node": "^20.19.41",
        "@types/vscode": "^1.82.0",
        "esbuild": "^0.28.0",
        "typescript": "^5.3.3"
    }
}
