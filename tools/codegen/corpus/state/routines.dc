module routines;
@noinline public u16 scan(const u8* p, usize n) {
    u16 state = 0;
    u16 tokens = 0;
    for usize i = 0; i < n; i += 1 {
        u8 c = p[i];
        if c == 32 { state = 0; }
        else if c >= 48 && c <= 57 { if state != 1 { tokens += 1; } state = 1; }
        else { if state != 2 { tokens += 1; } state = 2; }
    }
    return tokens;
}
