module dpm::v1;

/// Tri-state switch: `Default` leaves the choice to dpm (nothing is passed to dcc),
/// `On` and `Off` force the setting.
public enum Tri : u8
{
    /// Use the value dpm picks for the selected profile and target.
    Default,
    /// Force the setting on.
    On,
    /// Force the setting off.
    Off,
}

/// Compilation target, passed to dcc as `-target`.
public enum Target : u8
{
    /// The host triple of the machine running dpm.
    Host,
    /// `x86_64-elf`.
    X86_64Elf,
    /// `x86_64-coff`.
    X86_64Coff,
    /// `x86-elf`.
    X86Elf,
    /// `x86-coff`.
    X86Coff,
    /// `i8086-binary`, a flat image.
    I8086Binary,
    /// `i8086-mz`, a DOS MZ executable.
    I8086Mz,
}

/// Code generator, passed to dcc as `-fbackend`.
public enum Backend : u8
{
    /// Use dcc's default backend.
    Default,
    /// The LLVM backend.
    Llvm,
    /// The native backend.
    Custom,
}

/// Pointer model, passed to dcc as `-mcmodel`.
public enum Model : u8
{
    /// Use dcc's default model for the target.
    Default,
    /// `small`.
    Small,
    /// `kernel`.
    Kernel,
    /// `medium`.
    Medium,
    /// `large`.
    Large,
    /// `unreal`.
    Unreal,
    /// `unreal32`.
    Unreal32,
}

/// Optimization level.
public enum Optimize : u8
{
    /// Use the level of the selected profile.
    Default,
    /// No optimization (`-O0`).
    O0,
    /// Basic optimization (`-O1`).
    O1,
    /// Full optimization (`-O2`).
    O2,
    /// Optimize for size (`-Os`).
    Size,
}

/// Which libdcext variant to link.
public enum Libdcext : u8
{
    /// Link the hosted variant when the target is `Host`; link nothing for any
    /// explicitly chosen target. Name a variant to get a runtime for a target.
    Default,
    /// Do not link libdcext.
    Off,
    /// The Linux variant.
    Linux,
    /// The Windows variant.
    Windows,
    /// The freestanding variant.
    Freestanding,
}

/// Kind of artifact a product builds.
public enum Kind : u8
{
    /// A program that `dpm run` can start.
    Executable,
    /// A shared library (`dcc -shared`).
    SharedLibrary,
}

/// Build settings.
///
/// The same struct is used project-wide, per product and per profile. A field
/// left at `Default` (or empty) is not passed to dcc and does not override a
/// lower layer. Layers, lowest to highest: profile defaults, `Project::settings`,
/// the selected `Profile::settings`, `Product::settings`, command-line options.
/// `extra_flags` concatenate across layers instead of overriding.
public struct Settings
{
    /// Compilation target.
    Target target = Target::Host;
    /// Code generator.
    Backend backend = Backend::Default;
    /// Instruction set (`-farch`), for example `i386`. Empty for dcc's default.
    []const char arch = "";
    /// Pointer model (`-mcmodel`).
    Model model = Model::Default;
    /// Optimization level.
    Optimize optimize = Optimize::Default;
    /// Whole-program compilation (`-fwhole-program`). dpm compiles a product with one
    /// dcc command, which includes the other modules of the import graph only in
    /// whole-program mode, so the debug and release profiles turn it on; `Off` is
    /// only useful for programs of a single module.
    Tri whole_program = Tri::Default;
    /// libdcext variant.
    Libdcext libdcext = Libdcext::Default;
    /// Emit debug information (`-g`).
    Tri debug_info = Tri::Default;
    /// Check array and slice bounds at run time.
    Tri bounds_check = Tri::Default;
    /// Trap when a restricted-range value is violated (`-frestricted-check`).
    Tri restricted_check = Tri::Default;
    /// Check dynamic-to-near pointer conversions (`-ffar-check`).
    Tri far_check = Tri::Default;
    /// Position-independent code (`-fPIC`).
    Tri pic = Tri::Default;
    /// Red zone below the stack pointer (`-fno-red-zone` when `Off`). Kernels and
    /// interrupt handlers need it off.
    Tri red_zone = Tri::Default;
    /// SIMD instructions (`-fno-simd` when `Off`). Freestanding code that has not
    /// enabled SIMD state needs it off.
    Tri simd = Tri::Default;
    /// x87 floating point (`-fno-x87` when `Off`).
    Tri x87 = Tri::Default;
    /// Stack protector (`-fno-stack-protector` when `Off`).
    Tri stack_protector = Tri::Default;
    /// Call-site partial evaluation (`-fpartial-eval` when `On`).
    Tri partial_eval = Tri::Default;
    /// i8086 load address as `SEG:OFF` (`-fbase`). Empty for none.
    []const char base = "";
    /// i8086 stack reservation (`-fstack-reserve`). Empty for none.
    []const char stack_reserve = "";
    /// Extra dcc arguments, appended last. Flags that dpm owns are rejected.
    []const []const char extra_flags = {};
}

/// A requirement on another package.
public struct Dependency
{
    /// Where the package comes from: a registry alias (`json5`), a repository
    /// location (`github.com/user/pkg` or `github.com/user/pkg/subdir`),
    /// `git+https://host/path.git[#subdir]`, `https://host/pkg.tar.gz`, or
    /// `path:../pkg`.
    []const char location;
    /// Minimum version. The resolved version is the lowest one that satisfies
    /// every requirement within the same series (same major, or same minor for
    /// 0.y). Empty for `path:` dependencies.
    []const char version = "";
}

/// One artifact a package builds.
public struct Product
{
    /// Product name, unique within the package.
    []const char name;
    /// What the product builds.
    Kind kind = Kind::Executable;
    /// Entry module file, relative to the package root.
    []const char entry = "src/main.dc";
    /// Settings that override the project and profile settings for this product.
    Settings settings = {};
    /// Libraries to link (`dcc -l`).
    []const []const char link = {};
    /// Linker script (`-T`), relative to the package root; the file must exist.
    /// dpm passes the flag and rebuilds when the script changes, so `-T` cannot
    /// be written in `extra_flags`.
    []const char linker_script = "";
}

/// The built-in profile a custom profile starts from.
public enum ProfileBase : u8
{
    /// Start from the `debug` defaults.
    Debug,
    /// Start from the `release` defaults.
    Release,
}

/// A named group of settings, selected with `--profile`.
///
/// The profiles `debug` and `release` always exist and cannot be declared;
/// a custom profile starts from the defaults of the built-in profile named by
/// `inherits` and applies its own settings on top.
public struct Profile
{
    /// Profile name. `debug` and `release` are reserved.
    []const char name;
    /// Built-in profile whose defaults this profile starts from.
    ProfileBase inherits = ProfileBase::Debug;
    /// Settings applied when the profile is selected.
    Settings settings = {};
}

/// The contents of `project.dcon`: one package.
public struct Project
{
    /// Package name and import namespace. A single identifier; modules are
    /// `module <name>::x;` in `<source>/<name>/x.dc`.
    []const char name;
    /// Version of this package, as `major.minor.patch` with an optional
    /// pre-release suffix.
    []const char version;
    /// One-line description.
    []const char description = "";
    /// SPDX license expression. Informational.
    []const char license = "";
    /// Registry alias this package claims. Checked by `dpm registry check`.
    []const char alias = "";
    /// Minimum dcc version needed to build this package.
    []const char requires_dcc = "";
    /// Import root that dependents see, relative to the package root.
    []const char source = "src";
    /// Packages needed to build and use this package.
    []const Dependency dependencies = {};
    /// Packages needed only by tests and `dpm run --dev`.
    []const Dependency dev_dependencies = {};
    /// Artifacts to build. A package without products is a source library.
    []const Product products = {};
    /// Directory holding test programs, relative to the package root.
    []const char test_dir = "tests";
    /// Project-wide build settings.
    Settings settings = {};
    /// Extra build profiles.
    []const Profile profiles = {};
    /// Registry base URL for this project. Empty to use the user configuration.
    []const char registry = "";
}

/// One resolved package in a lockfile.
public struct LockedPackage
{
    /// Canonical location, the identity of the package.
    []const char location;
    /// Exact resolved version.
    []const char version;
    /// Where the source was fetched from: `git+https://...`, `https://...tar.gz`,
    /// `path:../pkg` or `registry:<id>`.
    []const char source;
    /// Full 40-digit commit for git sources. Empty otherwise.
    []const char commit = "";
    /// `sha256:` followed by 64 hex digits, the hash of the source tree. Empty
    /// only for `path:` packages.
    []const char hash;
    /// Locations of the direct dependencies, sorted.
    []const []const char dependencies = {};
    /// `On` when only dev dependencies need this package.
    Tri dev = Tri::Default;
}

/// The contents of `project.lock.dcon`. Written by dpm; hand edits are overwritten.
public struct Lock
{
    /// Fingerprint of the evaluated requirement set, `sha256:` and 64 hex digits.
    []const char manifest;
    /// Version of the dcc that last built the project. Informational.
    []const char dcc = "";
    /// Resolved packages, sorted by location.
    []const LockedPackage packages;
}

/// One published version of a registry package.
public struct RegistryVersion
{
    /// Exact version.
    []const char version;
    /// Source: `git+https://...` or `https://...tar.gz`.
    []const char source;
    /// Full 40-digit commit. Required for git sources.
    []const char commit = "";
    /// `sha256:` followed by 64 hex digits, the hash of the source tree.
    []const char hash;
    /// Requirement summary, so resolution needs no fetch of the source.
    []const Dependency dependencies = {};
    /// Minimum dcc version needed by this version.
    []const char requires_dcc = "";
    /// A yanked version is not chosen by new resolutions.
    bool yanked = false;
}

/// A registry alias record, `aliases/<prefix>/<alias>.dcon`.
public struct RegistryAlias
{
    /// The alias.
    []const char alias;
    /// Canonical location of the package.
    []const char location;
    /// One-line description.
    []const char description = "";
    /// Published versions, ascending.
    []const RegistryVersion versions;
}

/// A registry template record, `templates/<prefix>/<name>.dcon`.
public struct RegistryTemplate
{
    /// The template name, as `dpm new --template <name>` writes it.
    []const char name;
    /// Canonical location of the template repository.
    []const char location;
    /// One-line description.
    []const char description = "";
    /// Published versions, ascending. A template version has no dependencies.
    []const RegistryVersion versions;
}

/// A registry location pointer, `locations/<host>/<owner>/<repo>.dcon`.
public struct RegistryLocation
{
    /// The alias that owns this location.
    []const char alias;
}

/// The registry descriptor, `registry.dcon` at the registry root.
public struct RegistryConfig
{
    /// Registry format number.
    i32 format = 1;
    /// Registry name.
    []const char name;
    /// One-line description.
    []const char description = "";
}

/// The contents of the user configuration, `~/.config/dpm/config.dcon`.
public struct UserConfig
{
    /// Registry base URLs, tried in order; the first hit wins. Empty for the
    /// default registry.
    []const []const char registries = {};
    /// Cache directory. Empty for the default.
    []const char cache_dir = "";
    /// Never touch the network unless a command asks to.
    bool offline = false;
}

/// How the value of a template variable is checked.
public enum VariableKind : u8
{
    /// Text from a restricted character set: letters, digits, space and `_ - . , : / + @ ( ) # %`.
    String,
    /// A DC identifier that is not a reserved word.
    Identifier,
    /// A decimal integer, optionally limited by `min` and `max`.
    Integer,
    /// `true` or `false`.
    Bool,
    /// One of `choices`.
    Choice,
}

/// A value the user can give to a template, written `@@name@@` in its files.
public struct TemplateVariable
{
    /// `[a-z][a-z0-9_]*`. `name` and `dir` are built in and cannot be declared.
    []const char name;
    /// Shown by `dpm template info` and in missing-variable errors.
    []const char description = "";
    /// How the value is checked.
    VariableKind kind = VariableKind::String;
    /// Used when the variable is not set. Must be empty when `required` is true.
    []const char default_value = "";
    /// When true there is no default and the variable must be given.
    bool required = false;
    /// The allowed values of a `Choice` variable.
    []const []const char choices = {};
    /// Maximum length in bytes of a `String` or `Identifier` value; 0 means 128. At most 256.
    i32 max_length = 0;
    /// Lowest allowed `Integer` value. Both `min` and `max` 0 means unrestricted.
    i64 min = 0;
    /// Highest allowed `Integer` value.
    i64 max = 0;
}

/// The contents of `template.dcon`: a project template for `dpm new`.
public struct Template
{
    /// Template name; for a registry template it must equal the registered name.
    []const char name;
    /// One-line description.
    []const char description = "";
    /// Directory inside the template whose contents are generated.
    []const char root = "files";
    /// Values the user can give.
    []const TemplateVariable variables = {};
    /// Files, as globs relative to `root`, whose contents get `@@name@@` substitution.
    /// Every other file is copied byte for byte.
    []const []const char substitute = {};
    /// Files, as globs relative to `root`, that are not generated.
    []const []const char exclude = {};
    /// Printed after generation, with substitution.
    []const char next_steps = "";
    /// Minimum dpm version needed by the generated project.
    []const char requires_dpm = "";
    /// Minimum dcc version needed by the generated project.
    []const char requires_dcc = "";
}
