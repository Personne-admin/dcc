=== FILE: test.dc ===
module test;

using Percent = u8{0..100};

i32[5] g_vals = {0, 50, 100, 7, 99};

@nomangle
public i32 dcc_main() {
    usize i = 0;
    while i < 5 {
        Percent p = g_vals[i] as Percent;
        if (p as i32) != g_vals[i] {
            return 1;
        }

        i = i + 1;
    }
    return 0;
}

