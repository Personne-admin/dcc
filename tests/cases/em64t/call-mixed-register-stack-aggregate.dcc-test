module test;

struct Wide {
    i64 a;
    i64 b;
    i64 c;
}

i32 mixed(i32 a, i32 b, i32 c, i32 d, i32 e, i32 f, i32 g, Wide w) {
    return a + b + c + d + e + f + g + (w.a + w.b + w.c) as i32;
}

@nomangle
public i32 dcc_main() {
    Wide w = { a = 1, b = 2, c = 3 };
    return mixed(1, 2, 3, 4, 5, 6, 7, w);
}

