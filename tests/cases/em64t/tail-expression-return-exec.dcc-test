=== FILE: test.dc ===
module test;

i32 positive = 1;
i32 negative = -1;

i32 pick(i32 x) {
    if x > 0 { 7 } else { 9 }
}

i32 after(i32 x) {
    return 100;
}

bool flip(bool x) {
    match x {
        true => false,
        false => true,
    }
}

i32 after2(i32 x) {
    return 200;
}

@nomangle
public i32 dcc_main() {
    if pick(positive) != 7 { return 1; }
    if pick(negative) != 9 { return 2; }
    if !flip(false) { return 3; }
    if flip(true) { return 4; }
    return 0;
}

