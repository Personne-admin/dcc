=== FILE: test.dc ===
module test;

struct Opts {
    u8 fill;
    u8 align;
    u8 base;
    bool uppercase;
    bool plus_sign;
    bool zero_pad;
    bool scientific;
    u8 spec;
    usize width;
    usize precision;
}

struct Chunk {
    usize cursor;
    Opts opts;
    bool found;
}

enum FmtError : u8 {
    OutOfSpace,
    SinkFailed,
    BadFormat,
}

enum Result(T, E) {
    Ok(T),
    @implicit_construction Err(E),
}

T default_of(T)() {
    T zero;
    return zero;
}

bool is_ok(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Ok(_) => true,
        _ => false,
    };
}

bool is_err(T, E)(const Result(T, E)* self) {
    return !self.is_ok();
}

T unwrap(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Ok(v) => v,
        _ => default_of(),
    };
}

E unwrap_err(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Err(e) => e,
        _ => default_of(),
    };
}

Opts default_opts() {
    return Opts { fill = 32 as u8, align = 1 as u8, base = 10 as u8, uppercase = false, plus_sign = false, zero_pad = false, scientific = false, spec = 0 as u8, width = 0, precision = 0xFFFFFFFFFFFFFFFF as usize };
}

Chunk make_chunk() {
    return Chunk { cursor = 8, opts = default_opts(), found = true };
}

Result(Chunk, FmtError) make_chunk_ok() {
    return Result::Ok(make_chunk());
}

Result(Chunk, FmtError) make_chunk_err() {
    return FmtError::BadFormat;
}

Result(usize, FmtError) make_usize_ok() {
    return Result::Ok(7 as usize);
}

Result(usize, FmtError) make_usize_err() {
    return FmtError::BadFormat;
}

const Chunk PLAIN = make_chunk();
const Result(Chunk, FmtError) CHUNK_OK = make_chunk_ok();
const Result(Chunk, FmtError) CHUNK_ERR = make_chunk_err();
const Result(usize, FmtError) USIZE_OK = make_usize_ok();
const Result(usize, FmtError) USIZE_ERR = make_usize_err();

@nomangle
public i32 dcc_main() {
    if PLAIN.cursor != 8 as usize { return 1; }
    if !PLAIN.found { return 2; }
    if PLAIN.opts.fill != 32 as u8 { return 3; }
    if !CHUNK_OK.is_ok() { return 4; }
    Chunk c = CHUNK_OK.unwrap();
    if c.cursor != 8 as usize { return 5; }
    if !c.found { return 6; }
    if c.opts.width != 0 as usize { return 7; }
    if c.opts.precision != 0xFFFFFFFFFFFFFFFF as usize { return 8; }
    if !CHUNK_ERR.is_err() { return 9; }
    if CHUNK_ERR.unwrap_err() != FmtError::BadFormat { return 10; }
    if !USIZE_OK.is_ok() { return 11; }
    if USIZE_OK.unwrap() != 7 as usize { return 12; }
    if !USIZE_ERR.is_err() { return 13; }
    if USIZE_ERR.unwrap_err() != FmtError::BadFormat { return 14; }
    return 0;
}

