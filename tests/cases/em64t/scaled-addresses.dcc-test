module test;
public struct Pair { i32 first; i32 second; }
public struct Triple { u8 a; u8 b; u8 c; }
public struct Wide { i64 a; i64 b; }
@nomangle public i32 load4(i32* p, i64 i) { return p[i + 1]; }
@nomangle public i32 before4(i32* p, i64 i) { return p[i - 1]; }
@nomangle public i32 pointer4(i32* p, i64 i) { return *(p + i); }
@nomangle public void store1(u8* p, u64 i, u8 x) { p[i] = x; }
@nomangle public void store2(u16* p, i64 i, u16 x) { p[i] = x; }
@nomangle public void store4(i32* p, i64 i, i32 x) { p[i + 1] = x; }
@nomangle public void store8(i64* p, u64 i, i64 x) { p[i] = x; }
@nomangle public i32 field(Pair* p, i64 i) { return p[i].second; }
@nomangle public u8 odd(Triple* p, i64 i) { return p[i].c; }
@nomangle public i64 wide(Wide* p, i64 i) { return p[i].b; }
@nomangle public i32 use_pointer(i32* p) { return *p; }
@nomangle public i32 shared(i32* p, i64 i) {
    i32* q = p + i;
    i32 x = *q;
    return x + use_pointer(q);
}
@nomangle public i32 dcc_main() {
    u8[4] a;
    u16[4] b;
    i32[4] c;
    i64[4] d;
    Pair[3] pairs;
    Triple[3] triples;
    Wide[3] wides;
    store1(&a[0], 2, 71);
    store2(&b[0], 2, 513);
    store4(&c[0], 1, 999);
    store8(&d[0], 2, 123456789);
    pairs[2].second = 33;
    triples[2].c = 17;
    wides[2].b = 1234567;
    if a[2] != 71 { return 1; }
    if b[2] != 513 { return 2; }
    if c[2] != 999 { return 3; }
    if d[2] != 123456789 { return 4; }
    if load4(&c[0], 1) != 999 { return 5; }
    if before4(&c[0], 3) != 999 { return 6; }
    if pointer4(&c[0], 2) != 999 { return 7; }
    if field(&pairs[0], 2) != 33 { return 8; }
    if odd(&triples[0], 2) != 17 { return 9; }
    if wide(&wides[0], 2) != 1234567 { return 10; }
    if shared(&c[0], 2) != 1998 { return 11; }
    i32[3][2] matrix;
    i64 i = 0;
    while i < 2 {
        i64 j = 0;
        while j < 3 {
            matrix[i][j] = (i * 10 + j) as i32;
            j += 1;
        }
        i += 1;
    }
    if matrix[1][2] != 12 { return 12; }
    return 0;
}
