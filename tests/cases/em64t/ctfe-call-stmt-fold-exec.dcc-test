=== FILE: test.dc ===
module test;

i64 work(i64 x) {
    i64 sum = 0;
    for i64 j = 0; j < 16; j++ {
        if (j % 2) == 0 { sum += x + j; } else { sum += x - j; }
    }
    return sum;
}

i64 ident(i64 x) {
    return x;
}

T pick(T)(T x) {
    return x;
}

u64 counter = 0;

i64 bumped(i64 x) {
    counter = counter + 1;
    return x;
}

@runtime i64 rtconst(i64 x) {
    return x;
}

i64 apply(i64(*)(i64) f, i64 x) {
    return f(x);
}

struct Pt {
    i64 x;
    i64 y;
}

i64 psum(const Pt* self) {
    return self.x + self.y;
}

i64 dyn_seed = 3;

i64 ret_call() {
    return work(7);
}

i64 usel(u64 a, u64 b) {
    return if a < b { 1 } else { 2 };
}

@nomangle
public i32 dcc_main() {
    i64 sum = 0;
    sum += work(1);
    if sum != 8 { return 1; }
    i64 m = work(2);
    if m != 24 { return 2; }
    work(3);
    if ret_call() != 104 { return 3; }
    const Pt p = { x = 10, y = 20 };
    if p.psum() != 30 { return 4; }
    if pick(41 as i64) != 41 { return 5; }
    i64 v = bumped(work(6));
    if v != 88 { return 6; }
    if counter != 1 as u64 { return 7; }
    if rtconst(9) != 9 { return 8; }
    if apply(ident, 11) != 11 { return 9; }
    i64 unfolded = work(dyn_seed);
    if unfolded != work(3) { return 10; }
    if usel(0xffffffffffffffff, 1) != 2 { return 11; }
    if usel(1, 0xffffffffffffffff) != 1 { return 12; }
    return 0;
}

