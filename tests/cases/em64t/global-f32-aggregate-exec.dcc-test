module test;

struct GlobalFloat { f32 value; }

f32 g_value = 2.5;

@nomangle
public i32 dcc_main() {
    GlobalFloat current = { value = g_value };
    if current.value != 2.5 {
        return 1;
    }
    return 0;
}

