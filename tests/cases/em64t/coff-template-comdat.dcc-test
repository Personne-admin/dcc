=== FILE: t.dc ===
module t;

public T twice(T)(T x) {
    return x + x;
}

public T scale(T)(T v) {
    return match v {
        0 => 2,
        1 => 3,
        2 => 5,
        3 => 7,
        4 => 11,
        5 => 13,
        6 => 17,
        7 => 40,
        _ => 0,
    };
}

=== FILE: main.dc ===
module main;

import t;

@nomangle
public i32 apply(i32 x) {
    return t::twice(x) + t::scale(x);
}

@nomangle
public i32 dcc_main() {
    return apply(1);
}

