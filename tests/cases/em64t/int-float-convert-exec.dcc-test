=== FILE: test.dc ===
module test;
public i32 convert(usize i) {
    f32 v = ((127 - i) as f32) + 1.0 as f32;
    f32 want = 128.0 as f32 - i as f32;
    if v != want { return 1; }
    return 0;
}
@nomangle
public i32 dcc_main() {
    if convert(0) != 0 { return 1; }
    if convert(1) != 0 { return 2; }
    if convert(100) != 0 { return 3; }
    usize i = 5;
    f64 d = i as f64;
    if d < 4.999 { return 4; }
    if d > 5.001 { return 5; }
    return 0;
}

