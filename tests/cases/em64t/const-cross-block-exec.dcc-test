=== FILE: test.dc ===
module test;
i64 workload(i64 x) {
    i64 sum = 0;
    if (x + 0) % 3 == 0 { sum += x + 0; } else { sum -= x + 0; }
    if (x + 1) % 3 == 0 { sum += x + 1; } else { sum -= x + 1; }
    if (x + 2) % 3 == 0 { sum += x + 2; } else { sum -= x + 2; }
    return sum;
}
@nomangle
public i32 dcc_main() {
    if workload(7) != (-6 as i64) { return 1; }
    if workload(8) != (-9 as i64) { return 2; }
    return 0;
}

