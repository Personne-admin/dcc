=== FILE: test.dc ===
module test;
import core;

struct Empty {}

i32 exercise() {
    i32[4] data = { 1, 2, 3, 4 };
    []i32 values = core::slice::from_raw(&data[0], 4);
    if values.len != 4 || values[2] != 3 { return 1; }
    values[1] = 7;
    []i32 tail = values[1..3];
    tail[0] = 9;
    if data[1] != 9 || tail[1] != 3 { return 2; }
    []const i32 read_only = core::slice::from_raw_const(&data[0], 4);
    if read_only[2] != 3 { return 3; }
    []u8 empty = core::slice::from_raw(null as u8*, 0);
    if empty.len != 0 { return 4; }
    Empty one = {};
    []Empty empties = core::slice::from_raw(&one, 1);
    if empties.len != 1 { return 5; }
    return 0;
}

const i32 CTFE = exercise();

@nomangle
public i32 dcc_main() {
    if CTFE != 0 { return 10 + CTFE; }
    return exercise();
}

