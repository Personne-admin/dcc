module test;

struct F32Arr4 {
    f32[2] arr;
}

i32 sum_f32_arr(F32Arr4 p) {
    return p.arr[0] as i32 + p.arr[1] as i32;
}

@nomangle
public i32 dcc_main() {
    f32[2] a = {5.0, 7.0};
    F32Arr4 p = { arr = a };
    return sum_f32_arr(p);
}

