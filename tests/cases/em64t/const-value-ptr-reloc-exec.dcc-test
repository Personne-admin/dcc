=== FILE: test.dc ===
module test;

@nomangle
i64 value = 42;
@nomangle
u8* const p = &value as u8*;
@nomangle
u8* const q = p;
@nomangle
const i32 dummy_ro = 0;
@nomangle
i32 dummy_bss;
@nomangle
public i32 dcc_main() {
    u8* v = q;
    return *v as i32;
}

=== EXPECT-EM64T-OBJECT ===
RUN-EXIT: 42
REQUIRE-SECTION-READONLY: .rodata
REQUIRE-SECTION-WRITABLE: .data.rel.ro
REQUIRE-SECTION-WRITABLE: .data
FORBID-RELA: .rodata R_X86_64_64

=== EXPECT-EM64T-ASM ===
CONTAINS: section .rodata
CONTAINS: section .data.rel.ro
CONTAINS: dq value
CONTAINS: section .data
CONTAINS: section .bss

=== EXPECT-LLVM FLAGS: -verify ===
; ModuleID = 'test'
source_filename = "test"
target triple = "x86_64-elf"

@value = global i64 42
@p = constant ptr @value
@q = constant ptr @value
@dummy_ro = constant i32 0
@dummy_bss = global i32 0

define i32 @dcc_main() {
entry:
  %"0" = alloca ptr, align 8
  %"1" = load ptr, ptr @q, align 8
  store ptr %"1", ptr %"0", align 8
  %"2" = load ptr, ptr %"0", align 8
  %"3" = load i8, ptr %"2", align 1
  %"4" = zext i8 %"3" to i32
  ret i32 %"4"
}
