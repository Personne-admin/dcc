=== FILE: test.dc ===
module test;
import std::fmt;

std::fmt::Status(std::fmt::FormatError(std::fmt::BufferError)) do_format_float(std::fmt::BufferWriter* w) {
    return std::fmt::format(w, "{}", 1.5);
}

@nomangle
public i32 dcc_main() {
    char[64] backing;
    std::fmt::BufferWriter bw = std::fmt::new_buffer_writer(backing[0..64]);
    match do_format_float(&bw) {
        std::fmt::Status::Ok => {},
        _ => return 1,
    }
    [] const char got = std::fmt::written_slice(&bw);
    if got.len == 0 {
        return 2;
    }
    return 0;
}

