=== FILE: test.dc ===
module test;

struct Single { u32 a : 3; u32 b : 5; }
struct Several { u32 a : 16; u32 b : 16; u32 c : 16; }
struct NoFit { u8 a : 6; u8 b : 4; }
struct ZeroSep { u32 a : 3; u32 : 0; u32 b : 5; }
struct ZeroSep2 { u8 a : 2; u32 : 0; u32 b : 4; }
struct Mixed { u32 a : 30; u8 b : 4; }
struct Signed { i32 a : 3; i32 b : 5; }
@packed struct Packed { u8 a; u32 b : 16; u32 c : 16; }
struct CrossSV { u32 a : 24; u16 b : 8; }
struct CrossX { u8 a : 2; u32 b : 3; }
struct CrossT { u32 a : 4; u16 b : 4; u8 c : 4; }
struct CrossU { u16 a : 8; u32 b : 8; }
struct CrossW { u32 a : 8; u16 : 0; u16 b : 8; }
struct OrdPre { u8 p; u32 a : 3; u32 b : 5; }
struct OrdPost { u32 a : 3; u32 b : 5; u8 p; }

union RawSingle { Single s; u32 raw; }
union RawSeveral { Several s; u32[2] raw; }
union RawNoFit { NoFit s; u8[2] raw; }
union RawMixed { Mixed s; u32[2] raw; }
union RawMixedB { Mixed s; u8[8] raw; }
union RawPacked { Packed s; u8[5] raw; }
union RawCrossSV { CrossSV s; u32[2] raw; }
union RawCrossX { CrossX s; u8[8] raw; }
union RawCrossT { CrossT s; u8[8] raw; }
union RawCrossU { CrossU s; u8[8] raw; }
union RawCrossW { CrossW s; u8[8] raw; }
union RawOrdPre { OrdPre s; u8[8] raw; }
union RawOrdPost { OrdPost s; u8[8] raw; }

@nomangle
public i32 dcc_main() {
    if (sizeof(Single) != 4) { return 1; }
    if (alignof(Single) != 4) { return 2; }
    if (sizeof(Several) != 8) { return 3; }
    if (alignof(Several) != 4) { return 4; }
    if (sizeof(NoFit) != 2) { return 5; }
    if (alignof(NoFit) != 1) { return 6; }
    if (sizeof(ZeroSep) != 8) { return 7; }
    if (alignof(ZeroSep) != 4) { return 8; }
    if (sizeof(ZeroSep2) != 8) { return 9; }
    if (alignof(ZeroSep2) != 4) { return 10; }
    if (sizeof(Mixed) != 8) { return 11; }
    if (alignof(Mixed) != 4) { return 12; }
    if (sizeof(Signed) != 4) { return 13; }
    if (alignof(Signed) != 4) { return 14; }
    if (sizeof(Packed) != 5) { return 15; }
    if (alignof(Packed) != 1) { return 16; }
    if (sizeof(CrossSV) != 8) { return 17; }
    if (sizeof(CrossX) != 8) { return 18; }
    if (sizeof(CrossT) != 8) { return 19; }
    if (sizeof(CrossU) != 8) { return 20; }
    if (sizeof(CrossW) != 8) { return 21; }
    if (sizeof(OrdPre) != 8) { return 22; }
    if (sizeof(OrdPost) != 8) { return 23; }

    RawSingle rs = RawSingle { s = Single { a = 5, b = 17 } };
    if (rs.raw != 141) { return 40; }
    RawSingle rs2 = RawSingle { s = Single { a = 7, b = 0 } };
    if (rs2.raw != 7) { return 41; }
    RawSingle rs3 = RawSingle { s = Single { a = 0, b = 31 } };
    if (rs3.raw != (31 << 3)) { return 42; }

    RawSeveral rsev = RawSeveral { s = Several { a = 0xABCD, b = 0x1234, c = 0x5678 } };
    if (rsev.raw[0] != 0x1234ABCD) { return 43; }
    if (rsev.raw[1] != 0x5678) { return 44; }

    RawNoFit rnf = RawNoFit { s = NoFit { a = 0x2A, b = 0x5 } };
    if (rnf.raw[0] != 0x2A) { return 45; }
    if (rnf.raw[1] != 0x05) { return 46; }

    RawMixed rm = RawMixed { s = Mixed { a = 0x2AAAAAAA, b = 0x5 } };
    if (rm.raw[0] != 0x2AAAAAAA) { return 47; }
    RawMixedB rmb = RawMixedB { s = Mixed { a = 0x2AAAAAAA, b = 0x5 } };
    if (rmb.raw[4] != 0x5) { return 48; }

    RawPacked rp = RawPacked { s = Packed { a = 0x12, b = 0xABCD, c = 0x3456 } };
    if (rp.raw[0] != 0x12) { return 49; }
    if (rp.raw[1] != 0xCD) { return 50; }
    if (rp.raw[2] != 0xAB) { return 51; }
    if (rp.raw[3] != 0x56) { return 52; }
    if (rp.raw[4] != 0x34) { return 53; }

    RawCrossSV rsv = RawCrossSV { s = CrossSV { a = 0, b = 0xAB } };
    if (rsv.raw[0] != 0) { return 54; }
    if (rsv.raw[1] != 0xAB) { return 55; }

    RawCrossX rx = RawCrossX { s = CrossX { a = 3, b = 5 } };
    if (rx.raw[0] != 3) { return 56; }
    if (rx.raw[4] != 5) { return 57; }

    RawCrossT rt = RawCrossT { s = CrossT { a = 0xF, b = 0xE, c = 0xD } };
    if (rt.raw[0] != 0xF) { return 58; }
    if (rt.raw[4] != 0xE) { return 59; }
    if (rt.raw[6] != 0xD) { return 60; }

    RawCrossU ru = RawCrossU { s = CrossU { a = 0xAB, b = 0xCD } };
    if (ru.raw[0] != 0xAB) { return 61; }
    if (ru.raw[4] != 0xCD) { return 62; }

    RawCrossW rw = RawCrossW { s = CrossW { a = 0, b = 0xAB } };
    if (rw.raw[4] != 0xAB) { return 63; }

    RawOrdPre rpre = RawOrdPre { s = OrdPre { p = 0x11, a = 5, b = 17 } };
    if (rpre.raw[0] != 0x11) { return 64; }
    if (rpre.raw[4] != 0x8D) { return 65; }

    RawOrdPost rpost = RawOrdPost { s = OrdPost { a = 5, b = 17, p = 0x77 } };
    if (rpost.raw[0] != 0x8D) { return 66; }
    if (rpost.raw[4] != 0x77) { return 67; }

    return 0;
}

