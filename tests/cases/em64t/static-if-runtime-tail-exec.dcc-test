=== FILE: test.dc ===
module test;

void choose(T)(T value, i32* output) {
    static if T == bool {
        *output = -1;
    } else static if T == char {
        if value == '!' {
            *output = 42;
        } else {
            *output = 7;
        }
    } else {
        *output = -2;
    }
}

@nomangle public i32 dcc_main() {
    i32 output = 0;
    @runtime choose('!', &output);
    if output != 42 { return 1; }
    @runtime choose('x', &output);
    if output != 7 { return 2; }
    return 0;
}

