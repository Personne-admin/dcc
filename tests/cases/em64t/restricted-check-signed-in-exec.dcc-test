=== FILE: test.dc ===
module test;

using Small = i8{-100..100};

i32[6] g_vals = {50, -100, 100, 0, -1, 99};

@nomangle
public i32 dcc_main() {
    usize i = 0;
    while i < 6 {
        Small s = g_vals[i] as Small;
        if (s as i32) != g_vals[i] {
            return 1;
        }

        i = i + 1;
    }
    return 0;
}

