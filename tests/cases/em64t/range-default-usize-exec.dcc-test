=== FILE: test.dc ===
module test;

@nomangle
public i32 dcc_main() {
    usize sum = 0;
    for i in 0..5 { sum += i; }
    i32 signed_sum = 0;
    for i32 i in -5..5 { signed_sum += i; }
    if sum != 10 { return 1; }
    if signed_sum != -5 { return 2; }
    return 0;
}

