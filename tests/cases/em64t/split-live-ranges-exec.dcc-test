=== FILE: main.dc ===
module main;
volatile u32 input = 13;
@nomangle @noinline @runtime public u32 boundary_call(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h) {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8;
}
@noinline @runtime u32 pressure(u32 x) {
    u32 a = x + 1; u32 b = x + 3; u32 c = x + 7; u32 d = x + 11;
    u32 e = x + 17; u32 f = x + 23; u32 g = x + 31; u32 h = x + 41;
    u64 wide = ((x as u64) << 40) + 0x12345678;
    u32 total = 0;
    for u16 i = 0; i < 9; i += 1 {
        u32 part = boundary_call(a, b, c, d, e, f, g, h);
        total ^= part + ((wide >> 17) as u32);
        wide = wide / (((i & 3) + 1) as u64) + ((part as u64) << 21);
        u32 temporary = a; a = b; b = temporary;
        if (i & 1) != 0 { c += part; d ^= a; } else { e += part; f ^= b; }
        g = (g << (((i & 3) + 1) as u32)) + part / 7;
        h += g;
    }
    return total ^ (wide as u32) ^ ((wide >> 32) as u32) ^ a ^ h;
}
@nomangle public i32 dcc_main() {
    if pressure(input) != 1002919275 as u32 { return 1; }
    return 0;
}

