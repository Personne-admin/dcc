module test;

struct F32Pair {
    f32 a;
    f32 b;
}

i32 sum_f32_pair(F32Pair p) {
    return p.a as i32 + p.b as i32;
}

@nomangle
public i32 dcc_main() {
    F32Pair p = { a = 10.0, b = 20.0 };
    return sum_f32_pair(p);
}

