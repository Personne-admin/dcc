=== FILE: test.dc ===
module test;

@nomangle
i32 dummy_data = 0;

@nomangle
i32 dummy_bss;

using u64[4] Vals = { 10, 20, 30, 40 };
const u64[4] stored = Vals;

@nomangle
public u64 get_elem(u64 idx) {
    return stored[idx];
}

@nomangle
public i32 dcc_main() {
    return get_elem(2) as i32;
}

