=== EXPECT-IR ===
module "test"
@nomangle
u64@get(u64) {
%entry(u64 %i):
  %0 = alloca [4 x u64]
  store [4 x u64] aggregate [4 x u64], #10, #20, #30, #40, ptr<[4 x u64]> %0
  %1 = gep ptr<[4 x u64]> %0, %i
  %2 = load u64, ptr<u64> %1
  ret u64 %2
}

@nomangle
i32@dcc_main() {
%entry:
  %0 = call fn(@get)(u64 #3) -> u64
  %1 = trunc u64 %0 to i32
  ret i32 %1
}

