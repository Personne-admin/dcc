=== FILE: test.dc ===
module test;

using u64[4] Values = { 10, 20, 30, 40 };

@nomangle
public u64 get(u64 i) {
    return Values[i];
}

@nomangle
public i32 dcc_main() {
    return get(3) as i32;
}

