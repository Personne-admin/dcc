=== FILE: test.dc ===
module test;

usize scan([] const u8 s) {
    usize i = 0;
    while i < s.len {
        if s[i] == 123 as u8 { return i; }
        i++;
    }
    return i;
}

u64 counter = 0;

usize bump() {
    counter = counter + 1;
    return 6 as usize;
}

@runtime usize rt() {
    return 6 as usize;
}

u64 read_vol() {
    volatile u64 value = 7;
    return value;
}

usize apply(usize(*)(usize) f, usize x) {
    return f(x);
}

usize ident(usize x) {
    return x;
}

usize folded() {
    const usize n = scan("hello {} world");
    return n;
}

@nomangle
public i32 dcc_main() {
    if folded() != 6 as usize { return 1; }
    if bump() != 6 as usize { return 2; }
    if counter != 1 as u64 { return 3; }
    const usize e = bump();
    if e != 6 as usize { return 4; }
    if counter != 2 as u64 { return 5; }
    if rt() != 6 as usize { return 6; }
    const usize r = rt();
    if r != 6 as usize { return 7; }
    if read_vol() != 7 as u64 { return 8; }
    const u64 v = read_vol();
    if v != 7 as u64 { return 9; }
    if apply(ident, 6 as usize) != 6 as usize { return 10; }
    const usize q = apply(ident, 6 as usize);
    if q != 6 as usize { return 11; }
    return 0;
}

