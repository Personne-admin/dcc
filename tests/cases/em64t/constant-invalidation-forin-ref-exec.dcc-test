module test;
import core::atomic;
void set(i32* self) { *self = 7; }
i32 check(bool flag) { i32[2] array = {0, 0}; for &value in array { *value = 7; } if (array[0] as i64) != 7 || (array[1] as i64) != 7 { return 1; }
    i32[2] copied = {1, 2};
    for value in copied { value = 9; }
    if copied[0] != 1 || copied[1] != 2 { return 2; }
    const i32[2] readonly = {1, 2};
    i32 sum = 0;
    for &value in readonly { sum += *value; }
    return if sum == 3 { 0 } else { 3 }; }
@nomangle public i32 dcc_main() { u32 seed = asm @[intel, output(u32 in eax)] { "mov eax, 1" }; return check(seed != 0) + check(seed == 0); }

