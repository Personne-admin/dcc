=== FILE: test.dc ===
module test;

u8 gu8 = 5;
u16 gu16 = 1000;
u32 gu32 = 100000;
i32 gi32 = -7;
i8 gi8 = -100 as i8;
i16 gi16 = -30000 as i16;
bool gb = true;

@nomangle
public i32 dcc_main() {
    if gu8 != 5 as u8 { return 1; }
    if gu16 != 1000 as u16 { return 2; }
    if gu32 != 100000 as u32 { return 3; }
    if gi32 != -7 { return 4; }
    if gi8 != (-100 as i8) { return 5; }
    if gi16 != (-30000 as i16) { return 6; }
    if !gb { return 7; }
    gu8 = 6 as u8;
    gu16 = 1001 as u16;
    gu32 = 100001 as u32;
    gi32 = -8;
    gi8 = -99 as i8;
    gi16 = -29999 as i16;
    gb = false;
    if gu8 != 6 as u8 { return 8; }
    if gu16 != 1001 as u16 { return 9; }
    if gu32 != 100001 as u32 { return 10; }
    if gi32 != -8 { return 11; }
    if gi8 != (-99 as i8) { return 12; }
    if gi16 != (-29999 as i16) { return 13; }
    if gb { return 14; }
    return 0;
}

