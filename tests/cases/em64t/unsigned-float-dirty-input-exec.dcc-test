module main;
asm @[intel, arch("x86_64")] { ".text\n.global dirty\ndirty:\nmov rax, 0x12345678c0000000\nret\n" };
@nomangle extern u32 dirty();
@noinline @runtime f64 wide(u32 x) { return x as f64; }
@noinline @runtime f32 narrow(u32 x) { return x as f32; }
@nomangle public i32 dcc_main() {
    if wide(dirty()) != 3221225472.0 { return 1; }
    if narrow(dirty()) != 3221225472.0 { return 2; }
    return 0;
}

