module test;

[]T as_slice(T)(T* p, usize n) {
    []T s;
    s.ptr = p;
    s.len = n;
    return s;
}

@nomangle
public i32 dcc_main() {
    i32[4] arr = {10, 20, 30, 40};
    []i32 s = as_slice(arr as i32*, 3);
    i32 sum = 0;
    for x in s {
        sum = sum + x;
    }

    return sum;
}

