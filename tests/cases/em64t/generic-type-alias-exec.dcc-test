=== FILE: main.dc ===
module main;

struct Box(T) { T value; }
struct Pair(A, B) { A first; B second; }
union Slot { i32 value; u8 bits; }
enum Maybe(T) { None, Some(T) }

using BoxAlias(T) = Box(T);
using Nested(T) = Box(Box(T));
using PairAlias(A) = Pair(u8, A);
using SlotAlias(T) = Slot;
using MaybeAlias(T) = Maybe(T);

i32 read_box(BoxAlias(i32) value) { return value.value; }

BoxAlias(i32) make_box() {
    BoxAlias(i32) result = { value = 5 };
    return result;
}

i32 generic(T)(T value) {
    BoxAlias(T) boxed = { value = value };
    return boxed.value as i32;
}

using IsInt(T) = compiles(T x) {
    i32 y = x;
};
using Delegated(T) = IsInt(T);
using Combined(T) = IsInt(T) & !IsInt(f64);

void accept(T)(T value) if Delegated(T) {}
void accept_combined(T)(T value) if Combined(T) {}

@nomangle public i32 dcc_main() {
    BoxAlias(i32) boxed = { value = 3 };
    Nested(i32) nested = { value = { value = 4 } };
    PairAlias(i32) pair = { first = 1, second = 2 };
    SlotAlias(i32) slot = { value = 6 };
    MaybeAlias(i32) maybe = Maybe(i32)::Some(7);
    i32 total = read_box(boxed) + make_box().value + nested.value.value + pair.second + slot.value;
    total += match maybe { Maybe::Some(value) => value, Maybe::None => 0, };
    total += generic(8);
    accept(1);
    accept_combined(2);
    if total != 3 + 5 + 4 + 2 + 6 + 7 + 8 { return 1; }
    return 0;
}

