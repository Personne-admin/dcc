=== FILE: test.dc ===
module test;
public struct S {
    volatile u32 a : 3;
    u32 b : 5;
}
@nomangle public u32 get(S* s) {
    return s.a;
}
@nomangle public void set(S* s, u32 v) {
    s.a = v;
}

=== EXPECT-IR ===
module "test"
@nomangle
u32@get(ptr<{@0 u32, @4 u32}>) {
%entry(ptr<{@0 u32, @4 u32}> %s):
  %0 = gep ptr<{@0 u32, @4 u32}> %s, field #0
  %1 = load.volatile u32, ptr<u32> %0
  %2 = and u32 %1, u32 #7
  ret u32 %2
}

@nomangle
void@set(ptr<{@0 u32, @4 u32}>, u32) {
%entry(ptr<{@0 u32, @4 u32}> %s, u32 %v):
  %0 = gep ptr<{@0 u32, @4 u32}> %s, field #0
  %1 = and u32 %v, u32 #7
  %2 = xor u32 #7, u32 #18446744073709551615
  %3 = load.volatile u32, ptr<u32> %0
  %4 = and u32 %3, u32 %2
  %5 = or u32 %4, u32 %1
  store.volatile u32 %5, ptr<u32> %0
  ret void
}
