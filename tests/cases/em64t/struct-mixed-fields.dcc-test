module test;

public struct TwoFloats {
    f64 x;
    f64 y;
}

@nomangle
public TwoFloats make_tf(f64 a, f64 b) {
    return { x = a, y = b };
}

@nomangle
public i32 dcc_main() {
    f64 a = 3.0;
    f64 b = 4.0;
    TwoFloats tf = make_tf(a, b);
    i64 sum = (tf.x + tf.y) as i64;

    return sum as i32;
}

