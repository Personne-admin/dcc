=== FILE: test.dc ===
module test;
import std::result;
using std::result::Result;
Result(i32, u8) step(i32 x) {
    if x < 0 { return Result::Err(7); }
    return Result::Ok(x + 1);
}
Result(i32, u8) chain(i32 x) {
    i32 a = step(x)?;
    i32 b = step(a)?;
    return step(b);
}
i32 workload(i32 seed) {
    for i32 i = 0; i < 10; i++ {
        Result(i32, u8) r = chain(i + seed);
        if !r.is_ok() || r.unwrap() != i + seed + 3 { return 1; }
    }
    if chain(seed - 200).unwrap_err() != 7 { return 2; }
    return 0;
}
@nomangle
public i32 dcc_main() {
    if workload(5) != 0 { return 3; }
    if workload(0) != 0 { return 4; }
    return 0;
}

