=== FILE: test.dc ===
module test;

enum FmtError : u8 {
    OutOfSpace,
    SinkFailed,
    BadFormat,
}

enum Result(T, E) {
    Ok(T),
    @implicit_construction Err(E),
}

T default_of(T)() {
    T zero;
    return zero;
}

bool is_ok(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Ok(_) => true,
        _ => false,
    };
}

bool is_err(T, E)(const Result(T, E)* self) {
    return !self.is_ok();
}

T unwrap(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Ok(v) => v,
        _ => default_of(),
    };
}

E unwrap_err(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Err(e) => e,
        _ => default_of(),
    };
}

usize scan([] const u8 s) {
    usize i = 0;
    while i < s.len {
        if s[i] == 123 as u8 { return i; }
        i++;
    }
    return i;
}

Result(usize, FmtError) checked(bool ok) {
    if !ok { return Result::Err(FmtError::BadFormat); }
    return Result::Ok(scan("hello {} world"));
}

Result(usize, FmtError) question(bool ok) {
    usize n = checked(ok)?;
    return Result::Ok(n + 1);
}

Result(usize, FmtError) chain(bool ok) {
    usize n = question(ok)?;
    usize m = checked(ok)?;
    return Result::Ok(n + m);
}

Result(usize, FmtError) acc_question(bool ok) {
    usize acc = 10;
    acc += checked(ok)?;
    return Result::Ok(acc);
}

FmtError first_err(bool ok) {
    checked(ok)?;
    return FmtError::OutOfSpace;
}

const Result(usize, FmtError) Q_OK = question(true);
const Result(usize, FmtError) Q_ERR = question(false);
const Result(usize, FmtError) C_OK = chain(true);
const Result(usize, FmtError) C_ERR = chain(false);
const Result(usize, FmtError) A_OK = acc_question(true);
const Result(usize, FmtError) A_ERR = acc_question(false);
const FmtError E_OK = first_err(true);
const FmtError E_ERR = first_err(false);

void verify_first_err() {
    static if first_err(true) != FmtError::OutOfSpace {
        incorrect_first_err_ok();
    }
    static if first_err(false) != FmtError::BadFormat {
        incorrect_first_err_err();
    }
}

@nomangle
public i32 dcc_main() {
    if !Q_OK.is_ok() { return 1; }
    if Q_OK.unwrap() != 7 as usize { return 2; }
    if !Q_ERR.is_err() { return 3; }
    if Q_ERR.unwrap_err() != FmtError::BadFormat { return 4; }
    if !C_OK.is_ok() { return 5; }
    if C_OK.unwrap() != 13 as usize { return 6; }
    if !C_ERR.is_err() { return 7; }
    if C_ERR.unwrap_err() != FmtError::BadFormat { return 8; }
    if !A_OK.is_ok() { return 9; }
    if A_OK.unwrap() != 16 as usize { return 10; }
    if !A_ERR.is_err() { return 11; }
    if A_ERR.unwrap_err() != FmtError::BadFormat { return 12; }
    Result(usize, FmtError) r1 = question(true);
    if !r1.is_ok() || r1.unwrap() != 7 as usize { return 13; }
    Result(usize, FmtError) r2 = question(false);
    if !r2.is_err() { return 14; }
    const FmtError e_ok = first_err(true);
    const FmtError e_err = first_err(false);
    if e_ok != FmtError::OutOfSpace { return 15; }
    if e_err != FmtError::BadFormat { return 16; }
    if E_OK != FmtError::OutOfSpace { return 17; }
    if E_ERR != FmtError::BadFormat { return 18; }
    return 0;
}

