@nomangle
public i32 classify(i32 v) {
    return match v {
        1 => 10,
        2 => 20,
        3 => 30,
        _ => 99,
    };
}

@nomangle
public i32 dcc_main() {
    i32 s = classify(1) + classify(2) + classify(3) + classify(4);
    return s % 127;
}

