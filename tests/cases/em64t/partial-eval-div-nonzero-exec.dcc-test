=== FILE: test.dc ===
module test;

i32 g_y;

i32 divw(i32 x, i32 y) {
    return x / y;
}

@nomangle
public i32 dcc_main() {
    g_y = 2;
    i32 r = divw(7, g_y);
    if r != 3 {
        return 1;
    }
    return 0;
}

