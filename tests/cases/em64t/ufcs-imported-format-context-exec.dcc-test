module main;
import device;
import bridge;
@nomangle public i32 dcc_main() {
 device::Uart u = 7 as device::Uart;
 const device::Uart* c = &u;
 if bridge::forward(u) != 7 { return 1; }
 if bridge::forward(&u) != 7 { return 2; }
 if bridge::forward(c) != 7 { return 3; }
 return 0;
}

