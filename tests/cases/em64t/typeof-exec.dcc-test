module writers;

public enum Status(E) { Ok, Err(E), }
public enum BufferError : u8 { Full, }
public enum OtherError : u8 { Rejected, }
public struct Buffer { usize count; }
public struct Other {}

public Status(BufferError) write_all(Buffer* writer, []const char bytes) {
    writer.count += bytes.len;
    return Status::Ok;
}

public Status(OtherError) write_all(Other* writer, []const char bytes) {
    return Status::Err(OtherError::Rejected);
}

