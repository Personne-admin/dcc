=== FILE: test.dc ===
module test;
@nomangle
const i32 dummy_ro = 0;

@nomangle
i32 dummy_data = 0;

@nomangle
i32 dummy_bss;


using u64 MASK = 0xFF;
using u64 SHIFT = 8;

@nomangle
public u64 apply_mask(u64 x) {
    return (x & MASK) >> SHIFT;
}

@nomangle
public i32 dcc_main() {
    u64 r = apply_mask(0x1234);
    return r as i32;
}

