; ModuleID = 'test'
source_filename = "test"
target triple = "x86_64-elf"

@dummy_ro = internal constant i32 0
@dummy_data = internal global i32 0
@dummy_bss = internal global i32 0

define i64 @apply_mask(i64 %x) {
entry:
  %"0" = and i64 %x, 255
  %"1" = lshr i64 %"0", 8
  ret i64 %"1"
}

define i32 @dcc_main() {
entry:
  %"0" = alloca i64, align 8
  %"1" = call i64 @apply_mask(i64 4660)
  store i64 %"1", ptr %"0", align 4
  %"2" = load i64, ptr %"0", align 4
  %"3" = trunc i64 %"2" to i32
  ret i32 %"3"
}
