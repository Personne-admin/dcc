=== FILE: main.dc ===
module main;

volatile i32 low = -3;
volatile i32 high = 3;

@nomangle
public i32 dcc_main() {
    i32 ok = 0;
    i32 signed8 = 0;
    i32 unsigned8 = 0;
    i32 both8 = 0;
    i32 both16 = 0;
    for i32 x = low; x < high; x++ {
        for i32 y = low; y < high; y++ {
            i8 a = x as i8;
            i8 b = y as i8;
            u8 ua = a as u8;
            u8 ub = b as u8;
            if a < b {
                signed8 = signed8 + 1;
            }
            if ua < ub {
                unsigned8 = unsigned8 + 1;
            }
            if a < b && ua < ub {
                both8 = both8 + 1;
            }
            i16 c = x as i16;
            i16 d = y as i16;
            if c >= d || (c as u16) > (d as u16) {
                both16 = both16 + 1;
            }
        }
    }
    ok = ok + (signed8 == 15) as i32 + (unsigned8 == 15) as i32 + (both8 == 6) as i32 + (both16 == 30) as i32;
    i32 negative = 0;
    i32 zero = 0;
    i32 positive = 0;
    for i32 v = low - 2; v < high + 3; v++ {
        if v < 0 {
            negative = negative + 1;
        } else if v == 0 {
            zero = zero + 1;
        } else {
            positive = positive + v;
        }
    }
    ok = ok + (negative == 5) as i32 + (zero == 1) as i32 + (positive == 15) as i32;
    bool any = low > 0 || high > 2;
    bool all = low < 0 && high < 2;
    ok = ok + any as i32 + (!all) as i32;
    return ok;
}

