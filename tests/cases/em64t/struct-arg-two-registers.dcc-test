=== FILE: test.dc ===
module test;

struct Quad {
    i32 a;
    i32 b;
    i32 c;
    i32 d;
}

i32 sum(Quad q) {
    return q.a + q.b + q.c + q.d;
}

@nomangle
public i32 dcc_main() {
    Quad q = { a = 10, b = 20, c = 30, d = 40 };
    return sum(q);
}

