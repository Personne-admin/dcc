=== FILE: main.dc ===
module main;
@nomangle public i32 pick(u16 value) {
    return match value {
        0 => 3, 1 => 4, 2 => 5, 3 => 6, 4 => 7, 5 => 8,
        6 => 9, 7 => 10, 8 => 11, 9 => 12, 10 => 13, 11 => 14,
        _ => 1
    };
}
@nomangle public i32 dcc_main() {
    u16 i = 0;
    while i < 12 {
        if pick(i) != (i + 3) as i32 { return 1; }
        i = i + 1;
    }
    if pick(100) != 1 { return 2; }
    return 42;
}
