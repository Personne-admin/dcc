=== TARGET: i8086-binary FLAGS: -mcmodel=small ===
=== FILE: main.dc ===
module main;
@nomangle extern void install_handler();
@noinline i32 divide(i32 a, i32 b) { return a / b; }
@nomangle i32 sink;
@nomangle i32 dividend;
@nomangle i32 divisor;
@nomangle public i32 dcc_main() {
    install_handler();
    sink = divide(dividend, divisor);
    return 1;
}

=== FILE: helpers.asm ===
bits 16
section .text
global install_handler
extern dividend
extern divisor
install_handler:
    push ds
    xor ax, ax
    mov ds, ax
    mov word [0], handler
    mov ax, cs
    mov [2], ax
    pop ds
    mov dword [dividend], 0x80000000
    mov dword [divisor], 0xffffffff
    ret
handler:
    mov al, 42
    out 0xf4, al
    hlt

=== EXPECT-I8086-RUN ===
RUN-EXIT: 42
