=== TARGET: i8086-binary FLAGS: -mcmodel=small ===
=== FILE: main.dc ===
module main;

public u8* scratch = 0x8000 as u8*;

public void write_port(T)(u16 port, T value) {
    asm @[intel, inputs(p in dx = port, v in accumulator = value)] { "out %[p], %[v]" };
}

public T read_port(T)(u16 port) {
    T value;
    asm @[intel, output(v = value in accumulator), inputs(p in dx = port)] { "in %[v], %[p]" };
    return value;
}

@nomangle
public i32 dcc_main() {
    u8* p = scratch;
    *p = 0x2a;
    *(p + 1) = 0x2b;
    if (*p != 0x2a) { return 1; }
    if (*(p + 1) != 0x2b) { return 2; }
    u8 ready = read_port!u8(0x3fd);
    if (ready & 0x20) == 0 { return 3; }
    write_port(0x3f8, 79 as u8);
    write_port(0x3f8, 75 as u8);
    write_port(0x3f8, 10 as u8);
    return 0;
}

