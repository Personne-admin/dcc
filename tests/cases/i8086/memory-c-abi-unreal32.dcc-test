=== TARGET: i8086-binary FLAGS: -mcmodel=unreal32 ===
=== FILE: main.dc ===
module main;
public struct One { u8 v; }
public struct Two { u16 v; }
public struct Three { u8 a; u8 b; u8 c; }
public struct Four { u16 lo; u16 hi; }
public struct Big { u16[5] words; }
struct Odd { u8[11] bytes; }
@nomangle public One dc_one(One a) { return a; }
@nomangle public Two dc_two(Two a) { return a; }
@nomangle public Three dc_three(Three a) { return a; }
@nomangle public Four dc_four(Four a) { return a; }
@nomangle public Big dc_big(u16 a, u16 b) {
    Big value;
    value.words[0] = a;
    value.words[4] = b;
    return value;
}
@nomangle public []u16 dc_slice([]u16 s) { return s; }
@nomangle public u16* dc_pointer(u16* p) { return p; }
@nomangle extern u16* nasm_pointer(u16* p);
@nomangle extern Big nasm_big(u16 v);
@nomangle extern u16 nasm_read(Big b, u16 tag);
@nomangle extern u16 nasm_slice([]u16 s, u16 tag);
@nomangle extern i32 nasm_call_dc();
@nomangle extern void poison_es();
@noinline Odd odd_copy(Odd a, u16 n) {
    a.bytes[10] = n as u8;
    return a;
}
@nomangle public i32 dcc_main() {
    Three tiny = dc_three(Three {a = 3, b = 4, c = 5});
    if tiny.a != 3 || tiny.b != 4 || tiny.c != 5 { return 7; }
    Big a = nasm_big(13);
    Big b = a;
    if *nasm_pointer(&b.words[0]) != 13 { return 6; }
    if nasm_read(b, 3) != 33 { return 1; }
    if nasm_slice(b.words[0..5], 4) != 22 { return 2; }
    if nasm_call_dc() != 42 { return 3; }
    poison_es();
    Odd x;
    if x.bytes[0] != 0 || x.bytes[10] != 0 { return 4; }
    x.bytes[0] = 5;
    poison_es();
    Odd y = odd_copy(x, 7);
    if y.bytes[0] != 5 || y.bytes[10] != 7 || x.bytes[10] != 0 { return 5; }
    return 42;
}


