    \\cmp ax, 0x5678
    \\jne Lmem_fail
    \\cmp dx, 0x1234
    \\jne Lmem_fail
    \\push word 9
    \\push word 7
    \\lea bx, [bp - 18]
    \\movzx ebx, bx
    \\push ebx
