=== TARGET: i8086-binary FLAGS: -mcmodel=small ===
=== FILE: main.dc ===
module main;
@nomangle extern void install_handler();
@noinline u32 divide(u32 a, u32 b) { return a / b; }
@nomangle u32 sink;
@nomangle u32 dividend;
@nomangle u32 divisor;
@nomangle public i32 dcc_main() {
    install_handler();
    sink = divide(dividend, divisor);
    return 1;
}


asm @[intel] {
    \\.text
    \\.globl install_handler
    \\install_handler:
    \\push ds
    \\xor ax, ax
    \\mov ds, ax
    \\mov word ptr [0], offset Ltrap_handler
    \\mov ax, cs
    \\mov [2], ax
    \\pop ds
    \\mov dword ptr [dividend], 0xb
    \\mov dword ptr [divisor], 0x0
    \\ret
    \\Ltrap_handler:
    \\mov al, 42
    \\out 0xf4, al
    \\hlt
    \\
};
=== EXPECT-I8086-RUN ===
RUN-EXIT: 42
