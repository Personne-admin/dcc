module main;

@nomangle
extern i32 nasm_mix(i8 a, u8 b, i16 c, u16 d, i32 e, u32 f, bool g);
@nomangle
extern i8 nasm_ret_i8();
@nomangle
extern u8 nasm_ret_u8();
@nomangle
extern i16 nasm_ret_i16();
@nomangle
extern u16 nasm_ret_u16();
@nomangle
extern i32 nasm_ret_i32();
@nomangle
extern u32 nasm_ret_u32();
@nomangle
extern bool nasm_ret_bool();
@nomangle
extern i32 nasm_call_dc();
@nomangle
extern void dcc_putc(u8 c);

volatile i32 seed = 3;

@nomangle
public i32 dc_mix(i8 a, u8 b, i16 c, u16 d, i32 e, u32 f, bool g) {
    return a as i32 + b as i32 + c as i32 + d as i32 + e - f as i32 + g as i32 * 1000;
}

@nomangle
public i32 dcc_main() {
    i32 s = seed;
    i32 ok = 0;
    i32 r = nasm_mix((s - 10) as i8, (s + 247) as u8, (s - 303) as i16, (s + 59997) as u16, s + 99997, (s + 4) as u32, s > 0);
    ok = ok + (r == 160936) as i32;
    ok = ok + (nasm_mix(-7, 250, -300, 60000, 100000, 7, true) == 160936) as i32;
    ok = ok + (nasm_ret_i8() == -5) as i32;
    ok = ok + (nasm_ret_u8() == 250) as i32;
    ok = ok + (nasm_ret_i16() == -3000) as i32;
    ok = ok + (nasm_ret_u16() == 65000) as i32;
    ok = ok + (nasm_ret_i32() == 0x12345678) as i32;
    ok = ok + (nasm_ret_u32() == 0xFEDCBA98) as i32;
    ok = ok + nasm_ret_bool() as i32;
    ok = ok + (nasm_call_dc() == 160936) as i32;
    ok = ok + (s == 3) as i32;
    dcc_putc(79);
    dcc_putc(75);
    dcc_putc(10);
    return ok;
}


