=== TARGET: i8086-binary FLAGS: -mcmodel=small ===
=== FILE: main.dc ===
module main;
@nomangle extern void install_handler();
@noinline i64 divide(i64 a, i64 b) { return a % b; }
@nomangle i64 sink;
@nomangle i64 dividend;
@nomangle i64 divisor;
@nomangle public i32 dcc_main() {
    install_handler();
    sink = divide(dividend, divisor);
    return 1;
}


asm @[intel] {
    \\.text
    \\.globl install_handler
    \\install_handler:
    \\push ds
    \\xor ax, ax
    \\mov ds, ax
    \\mov word ptr [0], offset Ltrap_handler
    \\mov ax, cs
    \\mov [2], ax
    \\pop ds
    \\mov dword ptr [dividend], 0xfffffff5
    \\mov dword ptr [dividend + 4], 0xffffffff
    \\mov dword ptr [divisor], 0x0
    \\mov dword ptr [divisor + 4], 0x0
    \\ret
    \\Ltrap_handler:
    \\mov al, 42
    \\out 0xf4, al
    \\hlt
    \\
};
=== EXPECT-I8086-RUN ===
RUN-EXIT: 42
