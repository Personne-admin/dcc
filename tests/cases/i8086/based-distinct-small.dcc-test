=== FILE: main.dc ===
module main;
struct BoxCS { u16 tag; [^CS]u16 values; }
@noinline u16 nestedCS(BoxCS b) {
    u16 total = b.values[0];
    [^CS]u16 tail = b.values[1..3];
    for x in tail { total += x; }
    u16 reference_total = 0;
    for &x in tail {
        u16^CS q = x;
        reference_total += *q;
    }
    if reference_total != total - b.values[0] { return 0; }
    return total + b.tag;
}
