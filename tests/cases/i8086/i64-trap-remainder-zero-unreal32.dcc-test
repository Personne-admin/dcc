=== TARGET: i8086-binary FLAGS: -mcmodel=unreal32 ===
=== FILE: main.dc ===
module main;
@nomangle extern void install_handler();
@noinline i64 divide(i64 a, i64 b) { return a % b; }
@nomangle i64 sink;
@nomangle i64 dividend;
@nomangle i64 divisor;
@nomangle public i32 dcc_main() {
    install_handler();
    sink = divide(dividend, divisor);
    return 1;
}

=== FILE: helpers.asm ===
bits 16
section .text
global install_handler
extern dividend
extern divisor
install_handler:
    push ds
    xor ax, ax
    mov ds, ax
    mov word [0], handler
    mov ax, cs
    mov [2], ax
    pop ds
    mov dword [dividend], 0xfffffff5
    mov dword [dividend + 4], 0xffffffff
    mov dword [divisor], 0x0
    mov dword [divisor + 4], 0x0
    ret
handler:
    mov al, 42
    out 0xf4, al
    hlt

=== EXPECT-I8086-RUN ===
RUN-EXIT: 42
