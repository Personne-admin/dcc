module math;

using F = i32(*)(i32);

public const F g_neg = |i32 x -> -x;

public i32 apply(i32(*)(i32) f) {
    return f(2);
}

=== FILE: main.dc ===
module main;
import math;

i32 use_imported_global() {
    return math::g_neg(5);
}

i32 call_imported_fn() {
    return math::apply(|i32 x -> x * 10);
}

i32 use_local_lambda() {
    i32(*)(i32) f = |i32 x -> x - 1;
    return f(8);
}

