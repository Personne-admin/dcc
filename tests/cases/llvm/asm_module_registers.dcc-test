=== FILE: test.dc ===
module test;

asm { ".globl att_copy\natt_copy:\n    movq %%rdi, %%rax\n    addq %%rsi, %%rax\n    ret\n" };

asm @[intel] { ".globl intel_copy\nintel_copy:\n    mov rax, %%rdi\n    ret\n" };

=== EXPECT-LLVM ===
; ModuleID = 'test'
source_filename = "test"
target triple = "x86_64-elf"

