=== FILE: test.dc ===
module test;

public u32 element(u32* base, usize n) {
    return *(base + n);
}

public isize gap(u32* a, u32* b) {
    return b - a;
}

public u32* back(u32* p) {
    p -= 2;
    return p - 1;
}

