CONTAINS: define i32 @probe(ptr %p, i32 %limit) #0 personality ptr @__C_specific_handler
CONTAINS: call void (...) @llvm.localescape(
CONTAINS: invoke void @llvm.seh.scope.begin()
CONTAINS: invoke void @llvm.seh.try.begin()
CONTAINS: invoke void @llvm.seh.try.end()
CONTAINS: invoke void @llvm.seh.scope.end()
CONTAINS: cleanuppad within none []
CONTAINS: [ "funclet"(token
CONTAINS: catchswitch within none [label %seh.catch
CONTAINS: [ptr @"probe$seh_filter1"]
CONTAINS: [ptr null]
CONTAINS: call i32 @llvm.eh.exceptioncode(token
CONTAINS: load volatile i32, ptr %p
CONTAINS: call ptr @llvm.eh.recoverfp(ptr @probe, ptr %frame)
CONTAINS: call ptr @llvm.localrecover(ptr @probe,
CONTAINS: define internal i32 @"probe$seh_filter1"(ptr %exception_pointers, ptr %frame)
CONTAINS: !"eh-asynch", i32 1}
CONTAINS: define i32 @plain(i32 %v) #0 personality ptr @__C_specific_handler
