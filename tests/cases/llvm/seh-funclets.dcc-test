=== TARGET: x86_64-coff FLAGS: -fseh ===
=== FILE: main.dc ===
module test;

import core::seh;

@nomangle extern void use(i32* p);
@nomangle extern void note(i32 v);

@nomangle public i32 probe(i32* p, i32 limit) {
    i32 local = 1;
    defer note(local);
    try {
        try {
            local = *p;
            use(&local);
        } finally {
            note(core::seh::abnormal_termination() as i32);
        }
    } except core::seh::exception_code() == core::seh::EXCEPTION_ACCESS_VIOLATION && local < limit {
        return core::seh::exception_code() as i32;
    }
    return local;
}

@nomangle public i32 catch_all(i32* p) {
    try {
        return *p;
    } except 1 {
        return -1;
    }
}

@nomangle public i32 plain(i32 v) {
    defer note(v);
    return v;
}

