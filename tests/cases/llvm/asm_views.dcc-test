entry:
  %"0" = alloca i32, align 4
  %"1" = call i32 asm sideeffect inteldialect "mov ${0:k}, ${1:w}", "=&{eax},{ebx}"(i32 %x)
  store i32 %"1", ptr %"0", align 4
  store i32 %"1", ptr %"0", align 4
  %"2" = load i32, ptr %"0", align 4
  ret i32 %"2"
}

