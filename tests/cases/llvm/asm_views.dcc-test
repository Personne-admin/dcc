=== FILE: test.dc ===
module test;

u32 narrow(u32 x) {
    u32 y = asm @[intel, output(dst = y in eax), inputs(v in ebx = x)] { "mov %[dst:dword], %[v:word]" };
    return y;
}

void colon_after() {
    u32 x = 1;
    u32 y = 0;
    asm @[intel, output(dst = y in eax), inputs(p in ebx = x)] { "%[p]: nop" };
}

void seg_prefix() {
    u32 x = 1;
    u32 y = 0;
    asm @[intel, output(dst = y in eax), inputs(p in ebx = x)] { "mov eax, fs:[%[p]]" };
}

=== EXPECT-LLVM ===
