module test;

using Named = void(*)(i32 value, bool enabled);
using Unnamed = void(*)(i32, bool);
using NamedI32 = void(*)(i32 value);

public void impl(i32 value, bool enabled) {}
public void impl_i32(i32 value) {}

public void dispatch(Named cb) { cb(1, true); }
public void dispatch(NamedI32 cb) { cb(2); }

public void call_named(Named cb) { dispatch(cb); }
public void call_unnamed(Unnamed cb) { dispatch(cb); }
public void call_named_i32(NamedI32 cb) { dispatch(cb); }

public void test_both() {
    Named n = impl;
    Unnamed u = impl;
    call_named(n);
    call_unnamed(u);
}
