=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module m;
struct Tuple(T...) { T... items; }

asm @[intel, arch("x86_64")] {
    ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n"
};

i32 take(Tuple(i32, i64) t) { return t.items.0 + (t.items.1 as i32); }
@nomangle
public i32 dcc_main() {
    if take({10, 20}) != 30 { return 1; }
    return 0;
}

