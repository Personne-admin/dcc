=== FILE: test.dc ===
module test;

struct Pair {
    i32 a;
    i32 b;
}

public i32 aggregates(i32 n) {
    i32 total = 0;
    i32 i = 0;
    while (i < n) {
        i32[2] row = {i, i + 1};
        Pair p = { a = row[0], b = row[1] };
        total = total + p.a + p.b;
        i++;
    }
    return total;
}

