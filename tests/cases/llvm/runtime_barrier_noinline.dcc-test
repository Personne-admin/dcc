=== FILE: test.dc ===
module test;

@nomangle
@runtime
public i32 rt_func(i32 x) {
    return x * 2;
}

@nomangle
public i32 normal_func(i32 x) {
    return x * 3;
}

@nomangle
public i32 caller() {
    i32 a = rt_func(5);
    i32 b = @runtime normal_func(5);
    return a + b;
}

