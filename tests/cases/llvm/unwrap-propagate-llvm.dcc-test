=== FILE: test.dc ===
module test;

public struct Res {
    bool ok;
    i32 val;
}

public bool is_ok(Res self) {
    return self.ok;
}

public i32 unwrap(Res self) {
    return self.val;
}

public i32 unwrap_err(Res self) {
    return self.val;
}

@nomangle
public i32 test_ok() {
    Res r = { ok = true, val = 42 };
    return r?;
}

@nomangle
public i32 test_err() {
    Res r = { ok = false, val = 7 };
    return r?;
}

