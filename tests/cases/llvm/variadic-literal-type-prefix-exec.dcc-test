=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module m;
struct Tuple(T...) { T... items; }

asm @[intel, arch("x86_64")] {
    ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n"
};

using TI = Tuple(i32, i64);
TI make() { return TI{7, 8}; }
@nomangle
public i32 dcc_main() {
    TI t = make();
    if t.items.0 != 7 || t.items.1 != 8 { return 1; }
    return 0;
}

