=== FILE: lib.dc ===
module lib;

public i32 handle(T)() {
    static if T == void {
        return 0;
    } else {
        return 1;
    }
}

=== FILE: main.dc ===
module main;
import lib;

public i32 entry() {
    i32 a = lib::handle!(void)();
    i32 b = lib::handle!(i32)();

    return a + b;
}

