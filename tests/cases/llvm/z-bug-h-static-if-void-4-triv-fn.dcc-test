module test;

// Test 4: Trivial static if T == void with f!(void)() and f!(i32)()
public i32 f(T)() {
    static if T == void {
        return 10;
    } else {
        return 20;
    }
}

public i32 entry() {
    return f!(void)() + f!(i32)();  // 10 + 20 = 30
}

