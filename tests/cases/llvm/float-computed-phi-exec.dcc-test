=== FILE: main.dc ===
module main;
volatile u32 input = 1;
volatile u32 trips = 2;
@noinline @runtime f32 loop_f32(u32 x, u32 count, bool choose) {
    f32 a = 7.5;
    f32 b = (x as f32) * 0.5;
    if choose { a = 8.5; } else { a = b + 0.25; }
    for u32 i = 0; i < count; i += 1 {
        if (i & 1) == 0 { a += 0.5; } else { a = b + 0.25; }
        b += 0.25;
    }
    return a + b;
}
@noinline @runtime f64 loop_f64(u32 x, u32 count, bool choose) {
    f64 a = 7.5;
    f64 b = (x as f64) * 0.5;
    if choose { a = 8.5; } else { a = b + 0.25; }
    for u32 i = 0; i < count; i += 1 {
        if (i & 1) == 0 { a += 0.5; } else { a = b + 0.25; }
        b += 0.25;
    }
    return a + b;
}
@nomangle public i32 dcc_main() {
    if loop_f32(input, trips, true) != 2.0 { return 1; }
    if loop_f32(input, trips, false) != 2.0 { return 2; }
    if loop_f64(input, trips, true) != 2.0 { return 3; }
    if loop_f64(input, trips, false) != 2.0 { return 4; }
    if loop_f32(input, 0, false) != 1.25 { return 5; }
    if loop_f64(input, 0, true) != 9.0 { return 6; }
    return 0;
}
asm @[intel, arch("x86_64")] { ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n" };

