=== FILE: test.dc ===
module test;

struct Inner {
    i32 value;
}

struct Outer {
    Inner inner;
    Inner* pinner;
}

struct ArenaBlock {
    ArenaBlock* next;
    i32 used;
}

struct Arena(T) {
    ArenaBlock* first;
    ArenaBlock* current;
    usize block_size;
}

ArenaBlock* allocate_block(T)(Arena(T)* self, ArenaBlock* block) {
    block.next = null;
    block.used = 0;

    if self.first == null {
        self.first = block;
    }

    if self.current != null {
        self.current.next = block;
    }

    self.current = block;

    return block;
}

struct Expr {
    i32 kind;
}

i32 arena_chain(Arena(Expr)* self, ArenaBlock* b0, ArenaBlock* b1) {
    self.first = b0;
    self.current = b0;
    ArenaBlock* r = allocate_block!Expr(self, b1);
    return r.used;
}

i32 main() {
    return 0;
}

