=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module m;

asm @[intel, arch("x86_64")] {
    ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n"
};

struct Tuple(T...) { T... items; }
i32 acc = 0;
Tuple(i32, i64) pair(i32 s) { return {s, 2}; }
i32 first(Tuple(i32, i64) t) { return t.0; }
i32 viaptr(Tuple(i32, i64)* t) { return t.0 + (t.1 as i32); }
void run_0(Args...)(i32 s, Args args) {
    static for arg in args {
        Tuple(i32, i64) r = pair(s);
        acc += r.0 + (r.1 as i32);
    }
}
void run_1(Args...)(Tuple(i32, i64) t, Args args) {
    static for arg in args { acc += t.0 * 10 + (t.1 as i32); }
}
void run_2(Args...)(i32 s, Args args) {
    static for arg in args { acc += pair(s).0 + first(pair(s)); }
}
void run_3(Args...)(Tuple(i32, i64)* t, Args args) {
    static for arg in args { acc += t.0 + (t.1 as i32) + viaptr(t); t.0 = t.0 + 1; }
}
void run_4(Args...)(Args args) {
    Tuple(Tuple(i32, i32), bool) n = {{3, 4}, true};
    static for arg in args { acc += (n.0).0 + (n.0).1 + (n.1 as i32); }
}
void run_5(Args...)(Args args) {
    Tuple(i32, i32) m = {1, 2};
    static for arg in args { acc += (arg as i32) * 100 + m.1 + args.0 as i32; }
}
void run_6(T)(T x) {
    Tuple(i32, i64) r = pair(x as i32);
    acc += r.0 + (r.1 as i32);
}
@nomangle
public i32 dcc_main() {
    acc = 0;
    run_0(5, 1, 2);
    if acc != 14 { return 1; }
    acc = 0;
    run_1({4, 5}, 1, 2, 3);
    if acc != 135 { return 2; }
    acc = 0;
    run_2(7, 1, 2);
    if acc != 28 { return 3; }
    Tuple(i32, i64) t = {1, 2};
    acc = 0;
    run_3(&t, 1, 2);
    if acc != 14 || t.0 != 3 { return 4; }
    acc = 0;
    run_4(1, 2);
    if acc != 16 { return 5; }
    acc = 0;
    run_5(10, 20);
    if acc != 3024 { return 6; }
    acc = 0;
    run_6(5);
    if acc != 7 { return 7; }
    return 0;
}

