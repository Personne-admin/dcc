=== FILE: test.dc ===
module test;

struct Inner {
    bool a;
    bool b;
}

struct Outer {
    u32 x;
    Inner inner;
}

struct Pair {
    bool p;
    bool q;
}

@nomangle
bool test(const Outer* value) {
    if value.inner.a {
        return true;
    }

    if value.inner.b {
        return true;
    }

    return false;
}

@nomangle
bool get_a(const Outer* value) {
    return value.inner.a;
}

@nomangle
bool both(const Outer* value) {
    return value.inner.a && value.inner.b;
}

@nomangle
bool test_value(Outer value) {
    return value.inner.a;
}

@nomangle
Pair make_pair(bool a, bool b) {
    return {p = a, q = b};
}

=== EXPECT-LLVM FLAGS: -verify ===
; ModuleID = 'test'
source_filename = "test"
target triple = "x86_64-elf"

%0 = type { i32, %1, [2 x i8] }
%1 = type { i8, i8 }
%2 = type { i8, i8 }

define i1 @test(ptr %value) {
entry:
  %"0" = getelementptr %0, ptr %value, i32 0, i32 1
  %"1" = load %1, ptr %"0", align 1
  %0 = extractvalue %1 %"1", 0
  %"2" = trunc i8 %0 to i1
  br i1 %"2", label %if.then1, label %if.else2

if.then1:                                         ; preds = %entry
  ret i1 true

if.else2:                                         ; preds = %entry
  br label %if.merge3

if.merge3:                                        ; preds = %if.else2
  %"3" = getelementptr %0, ptr %value, i32 0, i32 1
  %"4" = load %1, ptr %"3", align 1
  %1 = extractvalue %1 %"4", 1
  %"5" = trunc i8 %1 to i1
  br i1 %"5", label %if.then4, label %if.else5

if.then4:                                         ; preds = %if.merge3
  ret i1 true

if.else5:                                         ; preds = %if.merge3
  br label %if.merge6

if.merge6:                                        ; preds = %if.else5
  ret i1 false
}

define i1 @get_a(ptr %value) {
entry:
  %"0" = getelementptr %0, ptr %value, i32 0, i32 1
  %"1" = load %1, ptr %"0", align 1
  %0 = extractvalue %1 %"1", 0
  %"2" = trunc i8 %0 to i1
  ret i1 %"2"
}

define i1 @both(ptr %value) {
entry:
  %"0" = getelementptr %0, ptr %value, i32 0, i32 1
  %"1" = load %1, ptr %"0", align 1
  %0 = extractvalue %1 %"1", 0
  %"2" = trunc i8 %0 to i1
  br i1 %"2", label %sc.rhs1, label %sc.merge2

sc.rhs1:                                          ; preds = %entry
  %"3" = getelementptr %0, ptr %value, i32 0, i32 1
  %"4" = load %1, ptr %"3", align 1
  %1 = extractvalue %1 %"4", 1
  %"5" = trunc i8 %1 to i1
  br label %sc.merge2

sc.merge2:                                        ; preds = %sc.rhs1, %entry
  %"6" = phi i1 [ false, %entry ], [ %"5", %sc.rhs1 ]
  ret i1 %"6"
}

define i1 @test_value(%0 %value) {
entry:
  %"0" = alloca %0, align 8
  store %0 %value, ptr %"0", align 4
  %"1" = getelementptr %0, ptr %"0", i32 0, i32 1
  %"2" = load %1, ptr %"1", align 1
  %0 = extractvalue %1 %"2", 0
  %"3" = trunc i8 %0 to i1
  ret i1 %"3"
}

define %2 @make_pair(i1 %a, i1 %b) {
entry:
  %0 = zext i1 %a to i8
  %1 = insertvalue %2 undef, i8 %0, 0
  %2 = zext i1 %b to i8
  %"0" = insertvalue %2 %1, i8 %2, 1
  ret %2 %"0"
}
