=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module m;
struct Tuple(T...) { T... items; }

asm @[intel, arch("x86_64")] {
    ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n"
};

struct Holder { i32 tag; Tuple(i32, i64) t; }
@nomangle
public i32 dcc_main() {
    Holder h = {1, {2, 3}};
    if h.tag != 1 || h.t.items.0 != 2 || h.t.items.1 != 3 { return 1; }
    return 0;
}

