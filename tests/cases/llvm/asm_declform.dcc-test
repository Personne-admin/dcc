=== FILE: test.dc ===
module test;

u64 rdtsc() {
    u64 tsc asm @[output(tsc in edx:eax)] { "rdtsc" };
    return tsc;
}

u32 simple_out() {
    u32 x asm @[output(x in eax)] { "mov $42, %%eax" };
    return x;
}

u32 no_placement() {
    u32 x asm { "mov $42, %%eax" };
    return x;
}

u64 rdtsc_deduced() {
    u64 tsc = asm @[output(edx:eax)] { "rdtsc" };
    return tsc;
}

u64 rdtsc_deduced_in() {
    u64 tsc = asm @[output(in edx:eax)] { "rdtsc" };
    return tsc;
}

u32 eax_deduced() {
    u32 x = asm @[output(eax)] { "mov $42, %%eax" };
    return x;
}

=== EXPECT-LLVM FLAGS: -verify ===
