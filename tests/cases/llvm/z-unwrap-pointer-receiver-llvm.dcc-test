=== FILE: test.dc ===
module test;

public enum Result(T, E) {
    Ok(T),
    Err(E),
}

public bool is_ok(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Err(_) => false,
        _ => true,
    };
}

public T unwrap(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Ok(v) => v,
        Result::Err(e) => e,
    };
}

public E unwrap_err(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Err(e) => e,
        Result::Ok(v) => v,
    };
}

@nomangle
public i32 test_propagate() {
    Result(i32, i32) maybe = Result::Err(1);
    i32 certain = maybe?;
    return certain;
}

