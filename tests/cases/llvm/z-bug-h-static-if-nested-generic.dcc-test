module test;

public i32 f(T, E)() {
    static if T == void {
        static if E == i32 {
            return 1;
        } else {
            return 2;
        }
    } else {
        return 3;
    }
}

public i32 entry() {
    i32 a = f!(void, i32)();
    i32 b = f!(void, u64)();
    i32 c = f!(i32, i32)();

    return a + b + c;
}

