module m;

asm @[intel, arch("x86_64")] {
    ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n"
};

struct Tuple(T...) { T... items; }
i32 acc = 0;
Tuple(i32, i64) pair(i32 s) { return {s, 2}; }
i32 first(Tuple(i32, i64) t) { return t.0; }
i32 viaptr(Tuple(i32, i64)* t) { return t.0 + (t.1 as i32); }
void run(Args...)(i32 s, Args args) {
    static for arg in args { acc += pair(s).0 + first(pair(s)); }
}
@nomangle
public i32 dcc_main() {
    run(7, 1, 2);
    if acc != 28 { return 1; }
    return 0;
}

