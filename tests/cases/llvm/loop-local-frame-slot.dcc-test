=== FILE: test.dc ===
module test;

public u32 sum(const u8* p, usize n) {
    u32 acc = 0;
    while (n > 0) {
        n--;
        char c = *p as char;
        acc = acc + (c as u32);
        p++;
    }
    return acc;
}

