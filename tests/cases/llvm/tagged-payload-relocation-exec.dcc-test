=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module test;

asm @[intel, arch("x86_64")] {
    ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n"
};

enum Res(T, F) {
    Ok(T),
    Err(F),
}

enum Failure : u8 {
    Missing,
}

struct Inner {
    [] const char s;
    u32 n;
}

struct Big {
    Inner[2] items;
}

Res(Big, Failure) make_zero() {
    Big b = {};
    return Res::Ok(b);
}

Res(Big, Failure) make_named() {
    Big b = {};
    b.items[0].s = "first";
    b.items[0].n = 3;
    b.items[1].s = "xy";
    b.items[1].n = 9;
    return Res::Ok(b);
}

Res([] const char, Failure) make_text() {
    return Res::Ok("hey");
}

Res([] const char, Failure) make_missing() {
    return Res::Err(Failure::Missing);
}

@nomangle
public i32 dcc_main() {
    match make_zero() {
        Res::Ok(b) => {
            if b.items[0].n != 0 || b.items[1].s.len != 0 { return 1; }
        },
        Res::Err(e) => return 2,
    }
    match make_named() {
        Res::Ok(b) => {
            if b.items[0].s.len != 5 || b.items[0].s[4] != 't' || b.items[0].n != 3 { return 3; }
            if b.items[1].s.len != 2 || b.items[1].s[1] != 'y' || b.items[1].n != 9 { return 4; }
        },
        Res::Err(e) => return 5,
    }
    match make_text() {
        Res::Ok(s) => {
            if s.len != 3 || s[0] != 'h' || s[2] != 'y' { return 6; }
        },
        Res::Err(e) => return 7,
    }
    match make_missing() {
        Res::Ok(s) => return 8,
        Res::Err(e) => {},
    }
    return 0;
}

