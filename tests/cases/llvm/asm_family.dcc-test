=== FILE: test.dc ===
module test;

public u8 ident8(u8 v) {
    u8 r = 0;
    asm @[intel, output(dst = r in accumulator), inputs(x in counter = v)] { "mov %[dst], %[x]" };
    return r;
}

public u32 ident32(u32 v) {
    u32 r = 0;
    asm @[intel, output(dst = r in accumulator), inputs(x in counter = v)] { "mov %[dst], %[x]" };
    return r;
}

public u64 bump(u64 v) {
    u64 acc = v;
    asm @[intel, inout(a = acc in accumulator)] { "add %[a], 1" };
    return acc;
}

