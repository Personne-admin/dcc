=== FILE: test.dc ===
module test;

public union Data {
    i32 as_int;
    u8 as_byte;
}

@nomangle
Data g_data;

@nomangle
public i32 dcc_main() {
    g_data.as_int = 0x12345678;
    return g_data.as_byte as i32;
}

