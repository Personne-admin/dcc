=== FILE: test.dc ===
module test;

bool is_equal(u64 a, u64 b) {
    bool ok = false;
    asm @[intel, output(ok in flag equal), inputs(x in rax = a, y in rbx = b)] { "cmp %[x], %[y]" };
    return ok;
}

