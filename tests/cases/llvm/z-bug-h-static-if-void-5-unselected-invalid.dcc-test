module test;

public enum Res(T, E) { Ok(T), Err(E), }

public i32 f(T, E)() {
    static if T == void {
        Res(void, E) r = Res::Ok;
        return 1;
    } else {
        Res(T, E) r = Res::Ok(42);
        return 2;
    }
}

public i32 entry() {
    return f!(void, i32)();
}

