=== FILE: test.dc ===
module test;
i32 f(i32 x, bool c) {
    i32 y = 0;
    match x {
        1 => {
            if c { y = 1; }
            y = y + 2;
        },
        _ => {},
    };
    return y;
}
@nomangle
public i32 dcc_main() {
    if f(1, true) != 3 {
        return 1;
    }
    if f(1, false) != 2 {
        return 2;
    }
    if f(9, true) != 0 {
        return 3;
    }
    return 0;
}

