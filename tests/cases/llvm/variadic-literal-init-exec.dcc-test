=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module m;
struct Tuple(T...) { T... items; }

asm @[intel, arch("x86_64")] {
    ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n"
};

@nomangle
public i32 dcc_main() {
    Tuple(i32, i64) t = {3, 4};
    if t.items.0 != 3 || t.items.1 != 4 { return 1; }
    Tuple([]const char, bool) s = {"ab", true};
    if s.items.0.len != 2 || !s.items.1 { return 2; }
    return 0;
}

