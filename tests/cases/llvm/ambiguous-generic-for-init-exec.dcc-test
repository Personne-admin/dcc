=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module m;

struct Node {
    Node* next;
    i32 value;
}

asm @[intel, arch("x86_64")] {
    ".text\n.global _start\n_start:\nand rsp, -16\ncall dcc_main\nmov edi, eax\nmov eax, 60\nsyscall\nud2\n"
};

i32 sum(T)(T* start) {
    i32 total = 0;
    for T* q = start; q != null; q = q.next {
        total += q.value;
    }
    return total;
}

@nomangle
public i32 dcc_main() {
    Node second;
    second.next = null;
    second.value = 40;

    Node first;
    first.next = &second;
    first.value = 2;

    return sum(&first);
}

