=== TARGET: x86-elf ===
=== FILE: main.dc ===
module m;
import core::seg;
public usize demo(u8* near, u8^FS based, u8^ far, usize off, u16 seg) {
    u8^ a = near;
    u8^ b = based as u8^;
    u8* c = far as u8*;
    u8^ d = seg:off;
    u8^ e = d.with_segment(seg);
    u8^ f = e.with_offset(off);
    return a.offset() + b.offset() + c as usize + d.offset() + e.segment() as usize + f.offset();
}

