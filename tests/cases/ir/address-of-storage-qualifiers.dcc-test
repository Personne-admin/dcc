void f(volatile u32* vp, const u32* cp, const volatile u32* cvp, S* sp) {
    volatile u32 v;
    const u32 c = 1;
    const volatile u32 cv = 1;
    volatile u32[2] va;
    const u32[2] ca = {1, 2};
    const volatile u32[2] cva = {1, 2};
    volatile u32* p1 = &v;
    const u32* p2 = &c;
    const volatile u32* p3 = &cv;
    volatile u32* p4 = &gv;
    const u32* p5 = &gc;
    const volatile u32* p6 = &gcv;
    volatile u32* p7 = &sp.v;
    const u32* p8 = &sp.c;
    const volatile u32* p9 = &sp.cv;
    volatile u32* p10 = &va[0];
    const u32* p11 = &ca[0];
    const volatile u32* p12 = &cva[0];
    volatile u32* p13 = &*vp;
    const u32* p14 = &*cp;
    const volatile u32* p15 = &*cvp;
    volatile u32* p16 = &vp[0];
    const u32* p17 = &cp[0];
    const volatile u32* p18 = &cvp[0];
    *p1 = 2; *p4 = 3; *p7 = 4; *p10 = 5; *p13 = 6; *p16 = 7;
}

