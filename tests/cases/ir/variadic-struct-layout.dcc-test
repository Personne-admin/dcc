module test;

public struct Tuple(T...) {
	T... items;
}

public struct Tagged(K, T...) {
	K key;
	T... rest;
}

@[packed]
public struct PT(T...) {
	T... items;
}

public Tuple(u64) ident1(Tuple(u64) t) {
	return t;
}
public Tuple(u8, u8) ident2(Tuple(u8, u8) t) {
	return t;
}
public Tuple(u8, u64, u8) ident3(Tuple(u8, u64, u8) t) {
	return t;
}
public Tagged(u32, u8, u64) ident_tagged(Tagged(u32, u8, u64) t) {
	return t;
}
public Tuple() ident_empty(Tuple() t) {
	return t;
}
public PT(u8, u64, u8) ident_packed(PT(u8, u64, u8) t) {
	return t;
}

