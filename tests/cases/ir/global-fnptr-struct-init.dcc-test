module test;

using BinOp = i64(*)(i64, i64);

public struct Inner {
    i64 id;
    BinOp fn;
}

public struct Table {
    BinOp first;
    Inner inner;
    BinOp[2] arr;
}

i64 add(i64 a, i64 b) {
    return a + b;
}

i64 sub(i64 a, i64 b) {
    return a - b;
}

@nomangle
const Table table = {first = add, inner = {id = 5, fn = sub}, arr = {add, sub}};

