module test;

struct Box { u8{32, 64} tag; }

u8{32, 64} bump(u8{32, 64} v) {
    u8{32, 64}[2] arr;
    arr[0] = v;
    arr[1] = 64;
    return arr[1];
}

public i64 test() {
    Box b;
    b.tag = 32;
    u8{32, 64} x = bump(64);
    return x as i64;
}

