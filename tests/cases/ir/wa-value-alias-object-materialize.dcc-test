module test;
using u64 A = 1;
using u64 B = 2;
using u64[4] Vals = { A, B, A + B, 4 };
const u64[4] stored = Vals;
public i32 dcc_main() {
    return (stored[0] + stored[1] + stored[2] + stored[3]) as i32;
}

