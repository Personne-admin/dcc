module test;

struct Res {
    bool ok;
    i32 val;
}

bool is_ok(Res self) { return self.ok; }
i32 unwrap(Res self) { return self.val; }
i32 unwrap_err(Res self) { return self.val; }

void cleanup() {}

i32 propagate(Res self) {
    defer cleanup();
    i32 value = self?;
    return value + 1;
}

i32 test_ok() {
    return propagate({ ok = true, val = 41 });
}

i32 test_err() {
    return propagate({ ok = false, val = 7 });
}

