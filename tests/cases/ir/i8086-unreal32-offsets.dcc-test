=== TARGET: i8086-binary FLAGS: -mcmodel=unreal32 ===
=== FILE: main.dc ===
module m;
import core::seg;
public usize demo(u32^FS f, u8* near, usize i, usize big, u16 seg) {
    u8^ far = near;
    u8^ moved = far.with_offset(big);
    u8^ based = f as u8^;
    u8* back = moved as u8*;
    u8^ built = seg:big;
    u32^FS fixed = FS:big;
    u32 v = f[i] + *fixed;
    usize s = sizeof(usize) + sizeof(u8^FS) + sizeof(u8^);
    return v as usize + s + far.offset() as usize + based.offset() as usize + back as usize + built.offset() as usize + near.offset() as usize;
}

