=== FILE: test.dc ===
module test;

struct Res {
    bool ok;
    i32 val;
}

bool is_ok(Res* self) {
    self.val = self.val + 1;
    return self.ok;
}

i32 unwrap(Res self) {
    return self.val;
}

i32 unwrap_err(Res self) {
    return self.val;
}

@nomangle
i32 g_evals = 0;

@nomangle
Res g_res;

@nomangle
Res* select_res() {
    g_evals = g_evals + 1;
    return &g_res;
}

i32 test_propagate() {
    g_evals = 0;
    g_res = { ok = true, val = 41 };
    i32 v = (*select_res())?;
    if v != 41 {
        return 1;
    }
    if g_evals != 1 {
        return 2;
    }
    if g_res.val != 42 {
        return 3;
    }
    return 0;
}

i32 main() {
    return 0;
}

