=== TARGET: i8086-binary FLAGS: -mcmodel=unreal ===
=== FILE: main.dc ===
module main;
@nomangle public void refsCS([^CS]u16 values) {
    for &x in values {
        u16^CS p = x;
        *p += 1;
    }
}
@nomangle public void refsDS([^DS]u16 values) {
    for &x in values {
        u16^DS p = x;
        *p += 1;
    }
}
@nomangle public void refsES([^ES]u16 values) {
    for &x in values {
        u16^ES p = x;
        *p += 1;
    }
}
@nomangle public void refsSS([^SS]u16 values) {
    for &x in values {
        u16^SS p = x;
        *p += 1;
    }
}
@nomangle public void refsFS([^FS]u16 values) {
    for &x in values {
        u16^FS p = x;
        *p += 1;
    }
}
@nomangle public void refsGS([^GS]u16 values) {
    for &x in values {
        u16^GS p = x;
        *p += 1;
    }
}

=== EXPECT-IR ===
module "main"
@nomangle
void@refsCS([]cs u16) {
%entry([]cs u16 %values):
  %0 = alloca []cs u16
  store []cs u16 %values, ptr<[]cs u16> %0
  %1 = load []cs u16, ptr<[]cs u16> %0
  %2 = extract []cs u16 %1, field #1
  %3 = extract []cs u16 %1, field #0
  %4 = alloca usize
  store usize #0, ptr<usize> %4
  %9 = alloca ptr<u16, based=cs>
  br label %forin.header1
%forin.header1:
  %5 = load usize, ptr<usize> %4
  %6 = cmp.ult usize %5, %2
  br.cond %6, label %forin.body2, label %forin.exit4
%forin.body2:
  %7 = load usize, ptr<usize> %4
  %8 = gep ptr<u16, based=cs> %3, %7
  store ptr<u16, based=cs> %8, ptr<ptr<u16, based=cs>> %9
  %10 = load ptr<u16, based=cs>, ptr<ptr<u16, based=cs>> %9
  %11 = load u16, ptr<u16, based=cs> %10
  %12 = add u16 %11, u16 #1
  store u16 %12, ptr<u16, based=cs> %10
  br label %forin.step3
%forin.step3:
  %13 = load usize, ptr<usize> %4
  %14 = add usize %13, usize #1
  store usize %14, ptr<usize> %4
  br label %forin.header1
%forin.exit4:
  ret void
}

