module test;

i32 make_inner() {
    i32(*)(i32) outer = |i32 a -> {
        i32(*)(i32) inner = |i32 v -> v * 2;
        inner(a)
    };
    return outer(5);
}

i32 direct_nested() {
    return (|i32 a -> { i32(*)(i32) f = |i32 v -> v + 1; f(a) })(41);
}

