=== FILE: test.dc ===
module test;

f64 apply_f64(f64(*)(f64) f) {
    return f(2.5);
}

f64 call_f64() {
    return apply_f64(|x -> x * 2.0);
}

i64 apply_i64(i64(*)(i64, i64) f) {
    return f(10, 20);
}

i64 call_i64() {
    return apply_i64(|a, b -> a + b);
}

i32 apply_ptr(i32(*)(i32*) f) {
    i32 v = 7;
    return f(&v);
}

i32 call_ptr() {
    return apply_ptr(|p -> *p + 1);
}

i32 sum_slice(i32(*)([]i32) f) {
    return f({1, 2});
}

i32 call_slice() {
    return sum_slice(|s -> s[0] + s[1]);
}

struct Pair {
    i32 a;
    i32 b;
}

i32 apply_agg(i32(*)(Pair) f) {
    Pair p = {a = 3, b = 4};
    return f(p);
}

i32 call_agg() {
    return apply_agg(|q -> q.a + q.b);
}

