=== FILE: test.dc ===
module test;

public u64 readonly(u64 x) { return x; }
public u64 plain(u64 x) { x = 10; return x; }
public u64 arithmetic(u64 x) {
    x += 1; x -= 1; x *= 2; x /= 2; x %= 3;
    x &= 15; x |= 16; x ^= 3; x <<= 1; x >>= 1;
    return x;
}
public u64 incdec(u64 x) { ++x; x++; --x; x--; return x; }
public u64 address(u64 x) { u64* p = &x; *p = 7; return x; }
public u64 through(u64* p) { *p = 7; return *p; }
public u64* rebind(u64* p, u64* q) { p = q; return p; }
public u64 control(u64 x, bool b) { u64 before = x; if b { x += 1; } return before + x; }
public u64 loop(u64 x) { while x != 0 { x /= 10; } return x; }

public struct Pair { u64 a; u64 b; }
public Pair aggregate(Pair p) { p.a = 1; return p; }

