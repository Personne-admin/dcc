void target2(i32 x, f64 y) {
    sunk0 = x;
}

i32 main() {
    Wrap(void(*)(i32, f64)) w;
    w.entry = target2 as void(*)(i32, f64);
    Wrap(void(*)(i32, f64))* back = &w;
    back.entry(1, 2.0);
    w.entry(1, 2.0);
    void(*)(i32, f64) e1 = back.entry;
    e1(1, 2.0);
    void(*)(i32, f64) e2 = w.entry;
    e2(1, 2.0);
    return 0;
}

