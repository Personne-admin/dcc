=== FILE: test.dc ===
module test;
import core::atomic;

public i32 cas_i32(volatile i32* p, i32 expected, i32 desired) {
    return core::atomic::atomic_compare_exchange(p, expected, desired, core::atomic::MemoryOrder::SeqCst, core::atomic::MemoryOrder::SeqCst);
}

public i8 cas_i8(volatile i8* p, i8 expected, i8 desired) {
    return core::atomic::atomic_compare_exchange(p, expected, desired, core::atomic::MemoryOrder::AcqRel, core::atomic::MemoryOrder::Acquire);
}

public i16 cas_i16(volatile i16* p, i16 expected, i16 desired) {
    return core::atomic::atomic_compare_exchange(p, expected, desired, core::atomic::MemoryOrder::Release, core::atomic::MemoryOrder::Relaxed);
}

public i64 cas_i64(volatile i64* p, i64 expected, i64 desired) {
    return core::atomic::atomic_compare_exchange(p, expected, desired, core::atomic::MemoryOrder::Relaxed, core::atomic::MemoryOrder::Relaxed);
}

u32 cas_wrapper(core::atomic::Atomic(u32)* p, u32 expected, u32 desired) {
    return core::atomic::atomic_compare_exchange(p, expected, desired, core::atomic::MemoryOrder::Acquire, core::atomic::MemoryOrder::Acquire);
}

