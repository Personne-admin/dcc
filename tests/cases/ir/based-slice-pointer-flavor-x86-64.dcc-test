=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module main;
@nomangle public usize sumFS([^FS]usize values) {
    usize total = 0;
    for x in values { total += x; };
    [^FS]usize tail = values[1..2];
    tail.ptr = values.ptr + 1;
    for &x in tail {
        usize^FS p = x;
        total += *p;
    }
    return total;
}
@nomangle public usize sumGS([^GS]usize values) {
    usize total = 0;
    for x in values { total += x; };
    [^GS]usize tail = values[1..2];
    tail.ptr = values.ptr + 1;
    for &x in tail {
        usize^GS p = x;
        total += *p;
    }
    return total;
}

