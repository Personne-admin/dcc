module test;

void handle(i32 x) {}
void handle(i64 x) {}

void f(T...)(T args) {
    static for arg in args {
        i32 outer_local = 1;
        static for i in 0..2 {
            i32 inner_local = 2;
            handle(arg);
            handle(outer_local);
            handle(inner_local);
        }
    }
}

public void caller() {
    i32 a = 42;
    i64 b = 100;
    f(a, b);
}

