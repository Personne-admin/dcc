=== EXPECT-IR ===
module "test"

const global @c_arr : [2 x u64] = aggregate [2 x u64], #1, #2

global @m_arr : [2 x u64] = aggregate [2 x u64], #3, #4

global @cp : ptr<u64> = @c_arr

global @mp : ptr<u64> = @m_arr

const global @copy : [2 x u64] = aggregate [2 x u64], #1, #2

