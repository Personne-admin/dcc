=== FILE: test.dc ===
module test;

public u8 vla(usize n) {
    u8 total = 0;
    usize i = 0;
    while (i < n) {
        u8 fixed = i as u8;
        u8[n] scratch;
        scratch[0] = fixed;
        total = total + scratch[0];
        i++;
    }
    return total;
}

