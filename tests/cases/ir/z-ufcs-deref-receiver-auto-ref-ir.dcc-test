=== FILE: test.dc ===
module test;

struct Res {
    bool ok;
    i32 val;
}

i32 bump(Res* self) {
    self.val = self.val + 1;
    return self.val;
}

i32 direct(Res* p) {
    return (*p).bump();
}

@nomangle
const i32 dummy_ro = 0;

@nomangle
i32 dummy_data = 0;

@nomangle
i32 dummy_bss;

@nomangle
public i32 test_identity() {
    Res r = { ok = true, val = 41 };
    Res* p = &r;
    i32 v = (*p).bump();
    if v != 42 {
        return 1;
    }

    if r.val != 42 {
        return 2;
    }
    return 0;
}

@nomangle
public i32 dcc_main() {
    return test_identity();
}

i32 main() {
    return 0;
}

