=== FILE: math.dc ===
module math;

using Number(T) = compiles(T value) {
    value += value;
};

public T reduce(T)(T value) if Number(T) {
    while value > 1 {
        value /= 2;
    }
    return value;
}

public void digits(W)(W* out, u64 value, u8 base) {
    while value != 0 {
        u64 digit = value % (base as u64);
        value /= base as u64;
    }
}

=== FILE: main.dc ===
module main;

import math;

public u64 run(u64 x) {
    return math::reduce(x);
}

public void format(u64 x) {
    math::digits(&x, x, 10);
}

