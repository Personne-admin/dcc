  store []cs u16 %13, ptr<[]cs u16> %7
  %14 = load []cs u16, ptr<[]cs u16> %7
  %15 = extract []cs u16 %14, field #1
  %16 = extract []cs u16 %14, field #0
  %17 = alloca usize
  store usize #0, ptr<usize> %17
  %22 = alloca u16
  br label %forin.header1
%forin.header1:
  %18 = load usize, ptr<usize> %17
  %19 = cmp.ult usize %18, %15
  br.cond %19, label %forin.body2, label %forin.exit4
%forin.body2:
  %20 = load usize, ptr<usize> %17
  %21 = gep ptr<u16, based=cs> %16, %20
  %23 = load u16, ptr<u16, based=cs> %21
  store u16 %23, ptr<u16> %22
  %24 = load u16, ptr<u16> %1
  %25 = load u16, ptr<u16> %22
  %26 = add u16 %24, u16 %25
  store u16 %26, ptr<u16> %1
  br label %forin.step3
%forin.step3:
  %27 = load usize, ptr<usize> %17
  %28 = add usize %27, usize #1
  store usize %28, ptr<usize> %17
  br label %forin.header1
%forin.exit4:
  %29 = load u16, ptr<u16> %1
  ret u16 %29
}

