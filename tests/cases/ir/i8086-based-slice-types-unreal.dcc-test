u16@sumCS([]cs u16) {
%entry([]cs u16 %values):
  %0 = alloca []cs u16
  store []cs u16 %values, ptr<[]cs u16> %0
  %1 = alloca u16
  %2 = load []cs u16, ptr<[]cs u16> %0
