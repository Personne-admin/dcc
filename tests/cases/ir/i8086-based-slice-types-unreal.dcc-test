=== TARGET: i8086-binary FLAGS: -mcmodel=unreal ===
=== FILE: main.dc ===
module main;
@nomangle public u16 sumCS([^CS]u16 values) {
    u16 result = values[0];
    [^CS]u16 tail = values[1..3];
    for x in tail { result += x; }
    return result;
}
@nomangle public u16 sumDS([^DS]u16 values) {
    u16 result = values[0];
    [^DS]u16 tail = values[1..3];
    for x in tail { result += x; }
    return result;
}
@nomangle public u16 sumES([^ES]u16 values) {
    u16 result = values[0];
    [^ES]u16 tail = values[1..3];
    for x in tail { result += x; }
    return result;
}
@nomangle public u16 sumSS([^SS]u16 values) {
    u16 result = values[0];
    [^SS]u16 tail = values[1..3];
    for x in tail { result += x; }
    return result;
}
@nomangle public u16 sumFS([^FS]u16 values) {
    u16 result = values[0];
    [^FS]u16 tail = values[1..3];
    for x in tail { result += x; }
    return result;
}
@nomangle public u16 sumGS([^GS]u16 values) {
    u16 result = values[0];
    [^GS]u16 tail = values[1..3];
    for x in tail { result += x; }
    return result;
}

