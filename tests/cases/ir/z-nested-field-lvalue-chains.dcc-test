=== FILE: test.dc ===
module test;

struct Inner {
    i32 value;
}

struct Outer {
    Inner inner;
    Inner* pinner;
}

struct Link {
    Inner* target;
    Link2* next;
}

struct Link2 {
    Inner* target;
}

struct Wrap {
    Inner*[2] items;
}

i32 take_ptr(i32* p) {
    return *p;
}

i32 nested_chain(Outer* po) {
    po.inner.value = 5;
    i32 a = po.inner.value;

    po.pinner.value = 7;
    i32 b = po.pinner.value;

    i32 c = take_ptr(&po.inner.value);

    i32* pv = &po.pinner.value;
    i32 d = take_ptr(pv);

    return a + b + c + d;
}

struct Leaf {
    i32 value;
}

struct Mid {
    Leaf leaf;
}

struct TripleHolder {
    Mid mid;
}

i32 three_level(TripleHolder* th) {
    th.mid.leaf.value = 11;
    return th.mid.leaf.value;
}

i32 indexed_pointer_element(Wrap* w) {
    w.items[0].value = 21;
    i32 a = w.items[0].value;
    w.items[1].value = 22;
    i32 b = w.items[1].value;
    return a + b;
}

i32 link_chain(Link* pl) {
    pl.next.target.value = 31;
    return pl.next.target.value;
}

i32 main() {
    return 0;
}

