module test;

i32 arg_sink;
bool arg_flag;

struct Box(T) {
    bool ok;
    T value;
}

bool is_ok(T)(Box(T) self) { return self.ok; }
T unwrap(T)(Box(T) self) { return self.value; }
T unwrap_err(T)(Box(T) self) { return self.value; }

i32 test_box(Box(i32) val) {
    return val?;
}

i32 test_ok() {
    return test_box({ ok = true, value = arg_sink });
}

i32 test_err() {
    return test_box({ ok = arg_flag, value = 7 });
}

