=== FILE: test.dc ===
module test;

public enum Result(T, E) {
    Ok(T),
    Err(E),
}

public bool is_ok(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Err(_) => false,
        _ => true,
    };
}

public T unwrap(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Ok(v) => v,
        Result::Err(e) => e,
    };
}

public E unwrap_err(T, E)(const Result(T, E)* self) {
    return match *self {
        Result::Err(e) => e,
        Result::Ok(v) => v,
    };
}

i32 propagate(Result(i32, i32) r) {
    return r?;
}

i32 main() {
    return 0;
}

