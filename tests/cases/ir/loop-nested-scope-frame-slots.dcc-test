=== FILE: test.dc ===
module test;

struct Pair {
    i32 a;
    i32 b;
}

public i32 walk(i32 n) {
    i32 total = 0;
    i32 i = 0;
    while (i < n) {
        i32 a = i;
        if (a > 2) {
            i32 b = a * 2;
            total = total + b;
        }
        i32 j = 0;
        while (j < 2) {
            i32 a = j + 1;
            i32[2] row = {a, j};
            Pair p = { a = row[0], b = row[1] };
            total = total + p.a + p.b;
            j++;
        }
        i++;
    }
    return total;
}

