=== FILE: test.dc ===
module test;

struct Triple(T) {
    T a;
    T b;
    T c;
}

public i32 touch() {
    Triple(i32) p = {1, 2, 3};
    p.a = 10;
    p.b = 20;
    p.c = 30;
    Triple(i32)* pp = &p;
    (*pp).c = 300;
    Triple(f64) q = {1.5, 2.5, 3.5};
    Triple(f64)* qp = &q;
    i32 s = p.a + p.b + (*pp).c;
    i32 qc = (*qp).c as i32;
    return s + qc;
}

