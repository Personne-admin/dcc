module m;
i32 f(i32 x, bool c) {
    i32 y = 0;
    defer {
        if c { y = 1; }
        y = y + 2;
    };
    defer {
        if c { y = 1; } else { y = 3; }
        y = y + 4;
    };
    defer {
        match y {
            0 => { y = 5; },
            _ => {},
        }
        y = y + 6;
    };
    defer {
        { y = 7; }
        y = y + 8;
    };
    return y;
}

