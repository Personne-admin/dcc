=== FILE: main.dc ===
module m;

struct Holder {
    i32 in;
    i32 out;
}

const i32 in_const = 3;
i32 in = 4;

i32 in_fn(i32 in) {
    return in + 1;
}

i32 uses_locals(Holder h) {
    i32 total = h.in;
    total += in;
    Holder g = Holder{ in = total, out = 2 };
    return g.in + in_fn(g.out) + in_const;
}

i32 shadow(i32 in) {
    i32 copy = in;
    {
        i32 in = copy + 1;
        copy = in;
    }
    return copy;
}

