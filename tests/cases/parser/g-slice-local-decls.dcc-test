module m;

public struct Vec(T) {
    T* data;
    usize len;
}

[]T push_uninitialised(T)(Vec(T)* self, usize n) {
    []T s;
    s.ptr = self.data;
    s.len = n;
    return s;
}

public void extend(T)(Vec(T)* self, [] const T values) {
    []T a;
    [] T b;
    []const T c;
    [] const T d;
    [] T destination = self.push_uninitialised(values.len);
}

