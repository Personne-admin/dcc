=== FILE: main.dc ===
module m;

void sink(T)(T value) {}

void name_binding(T...)(T x) {
    static for in in x {
        sink(in);
    }
}

void plain_binding(T...)(T x) {
    static for item in x {
        sink(item);
    }
}

void pack_named_in(T...)(T in) {
    static for item in in {
        sink(item);
    }
}

void range_binding(T...)(T x) {
    static for in in 0..sizeof...(T) {
        sink(x.in);
    }
}

void use() {
    name_binding(1, 2);
    plain_binding(3, 4);
    pack_named_in(5, 6);
    range_binding(7, 8);
}

