=== FILE: main.dc ===
module m;

struct Item { i32 v; }

i32 name_binding(i32[4] xs) {
    i32 total = 0;
    for in in xs {
        total += in;
    }
    return total;
}

i32 typed_name_binding(i32[4] xs) {
    i32 total = 0;
    for i32 in in xs {
        total += in;
    }
    return total;
}

i32 range_name_binding() {
    i32 total = 0;
    for usize in in 0..4 {
        total += in as i32;
    }
    return total;
}

i32 c_style(i32[4] xs) {
    i32 total = 0;
    for usize in = 0; in < 4; in++ {
        total += xs[in];
    }
    return total;
}

i32 user_type_binding(Item[2] items) {
    i32 total = 0;
    for Item in in items {
        total += in.v;
    }
    return total;
}

i32 iterable_named_in(i32[4] in) {
    i32 total = 0;
    for x in in {
        total += x;
    }
    return total;
}

i32 plain(i32[4] xs) {
    i32 total = 0;
    for x in xs {
        total += x;
    }
    for i32 y in xs {
        total += y;
    }
    for &z in xs {
        total += *z;
    }
    for &in in xs {
        total += *in;
    }
    return total;
}

