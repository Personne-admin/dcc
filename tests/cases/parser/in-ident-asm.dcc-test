=== FILE: main.dc ===
module m;

void inputs_named(u16 port, u8 val) {
    u8 in = val;
    asm @[inputs(in in al = in, port in dx = port)] { "outb %[in], %[port]" };
}

u8 inputs_expr(u8 in) {
    u8 r = asm @[output(r in al), inputs(in in cl = in)] { "mov %[in], %[r]" };
    return r;
}

u32 output_forms(u32 in) {
    u32 a = asm @[output(u32 in eax), inputs(in in ecx = in)] { "mov %[in], %0" };
    u32 b = asm @[output(in eax), inputs(in in ecx = in)] { "mov %[in], %0" };
    u32 c = 0;
    asm @[output(c = in in eax), inputs(in in ecx = in)] { "mov %[in], %[c]" };
    return a + b + c;
}

u32 inout_forms(u32 in) {
    u32 x = in;
    asm @[inout(in in ecx)] { "incl %[in]" };
    asm @[inout(x in edx)] { "incl %[x]" };
    asm @[inout(a = in in esi)] { "incl %[a]" };
    return x + in;
}

