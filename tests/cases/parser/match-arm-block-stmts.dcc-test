=== FILE: main.dc ===
module m;
i32 f(i32 x, bool c) {
    i32 y = 0;
    match x {
        1 => {
            if c { y = 1; }
            y = y + 2;
        },
        2 => {
            if c { y = 1; } else { y = 3; }
            y = y + 4;
        },
        3 => {
            match y {
                0 => { y = 5; },
                _ => {},
            }
            y = y + 6;
        },
        4 => {
            { y = 7; }
            y = y + 8;
        },
        5 => {
            while y < 10 { y = y + 1; }
            y = y + 9;
        },
        _ => {
            if c { y = 1; };
            y = y + 10;
        },
    };
    return match y {
        0 => { if c { 10 } else { 20 } },
        _ => { match x { 1 => 30, _ => 40 } },
    };
}

