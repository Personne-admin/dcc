module m;
using F = i32(*)(i32);
void consume(F f) {}
void g() {
    consume(|i32 v -> {
        if v > 0 { v = 1; }
        v = v + 2;
        v
    });
    consume(|i32 v -> {
        if v > 0 { v = 1; } else { v = 3; }
        v = v + 4;
        v
    });
    consume(|i32 v -> {
        match v {
            0 => { v = 5; },
            _ => {},
        }
        v = v + 6;
        v
    });
    consume(|i32 v -> {
        { v = 7; }
        v = v + 8;
        v
    });
    consume(|i32 v -> { if v > 0 { 10 } else { 20 } });
}

