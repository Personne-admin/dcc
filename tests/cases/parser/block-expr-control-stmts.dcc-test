module m;
i32 f(i32 x, bool c) {
    i32 y = 0;
    i32 a = {
        if c { y = 1; }
        y = y + 2;
        y
    };
    i32 b = {
        if c { y = 1; } else { y = 3; }
        y = y + 4;
        y
    };
    i32 d = {
        match y {
            0 => { y = 5; },
            _ => {},
        }
        y = y + 6;
        y
    };
    i32 e = {
        { y = 7; }
        y = y + 8;
        y
    };
    i32 g = { if c { 10 } else { 20 } };
    return a + b + d + e + g;
}

