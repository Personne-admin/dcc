module m;

using Width = u8{32, 64};

u8 f(u8 v) {
    if v as (u8{32, 64}) { return 1; }
    while v as (u8{32, 64}) { return 2; }
    match v as (u8{32, 64}) { _ => { return 3; } }
    return 0;
}

