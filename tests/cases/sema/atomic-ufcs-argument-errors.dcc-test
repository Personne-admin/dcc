module test;
import core::atomic;
using core::atomic::MemoryOrder;

void test(volatile i32* p, MemoryOrder o) {
    core::atomic::atomic_load(p);
    core::atomic::atomic_fetch_add(p, 1, o, 2);
    p.atomic_load();
    p.atomic_fetch_add(1);
}

