=== FILE: test.dc ===
module m;

i32 add(i32 a, i32 b) { return a + b; }

i32(*)(i32, i32) get_fn() { return add; }

void test() {
    i32(*)(i32, i32) fp = get_fn();
    fp(3, 4);
}

