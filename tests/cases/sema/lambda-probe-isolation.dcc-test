=== FILE: main.dc ===
module m;

void apply1(i32(*)(i32) f) {}

using HasValue(T) = compiles(T x) {
    x.value;
};

struct WithValue { i32 value; }
struct WithoutValue { }

void constrained_fn(T)(T x) if HasValue(T) {}

void test_probe() {
    static if compiles {
        apply1(|x -> x);
    } {
    }

    bool b = compiles {
        apply1(|bad -> bad + "x");
    };

    WithoutValue nv;
    static if compiles {
        constrained_fn(nv);
    } {
    }

    WithValue wv;
    constrained_fn(wv);

    i32(*)(i32) fp = |q -> q;
    apply1(|z -> z);
}
