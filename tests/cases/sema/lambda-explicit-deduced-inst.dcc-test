module m;

i32 consume(i32 x) {
    return x;
}

T apply(T)(T(*)(T) f, T v) {
    return f(v);
}

void applyd(F, Args...)(F f, Args a) {
    f(a...);
}

i32 test_explicit() {
    return apply!i32(|i32 x -> consume(x), 21);
}

void test_deduced() {
    applyd(|i32 y -> consume(y), 21);
}
