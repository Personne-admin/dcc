module m;

i32 id(T)(T x) {
    return x;
}

T apply(T)(T(*)(T) f, T v) {
    return f(v);
}

T twice(T)(T v) {
    return apply(|T x -> id(x), v);
}

i32 test() {
    return twice!i32(21);
}
