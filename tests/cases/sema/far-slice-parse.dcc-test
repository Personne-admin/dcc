module m;

struct Holder {
    []u8 near;
    [^]u8 far;
    [^GS]u8 based;
    u8[4] array;
    u8[] flexible;
}

void params([]u8 a, [^]u8 b, [^]const u8 c, [^GS]const u8 d, [^CS]u8 e, [^FS]volatile u8 f, [^][^GS]u8 g, [^]u8^ h, [^]u8* i, [][^]u8 j) {
