=== FILE: main.dc ===
module m;

struct Tuple(T...) {
    T... items;
}

void take(i32 v) {
}

void take(f64 v) {
}

void iter(Tuple(i32, i32, i32) s) {
    static for v in s.items {
        take(v);
    }
}

void iter_mixed(Tuple(i32, f64) s) {
    static for v in s.items {
        take(v);
    }
}

void empty_iter(Tuple() e) {
    static for v in e.items {
        take(v);
    }
}

