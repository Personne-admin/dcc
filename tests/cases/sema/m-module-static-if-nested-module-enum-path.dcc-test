module foo::config;

public enum Mode : u8 { A, B }
public using Mode MODE = Mode::A;

=== FILE: main.dc ===
module main;

import foo::config;

static if foo::config::MODE == foo::config::Mode::A {
    public i32 selected() { return 1; }
}

void test() { selected(); }

