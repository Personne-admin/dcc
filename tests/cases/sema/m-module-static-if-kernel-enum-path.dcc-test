module config;

public enum serial_port : u8 {
    COM1 = 10,
    COM2 = 20,
}
public using serial_port SERIAL_PORT = serial_port::COM1;

=== FILE: main.dc ===
module main;

import config;

static if config::SERIAL_PORT == config::serial_port::COM1 {
    public i32 selected() { return 1; }
}

void test() { selected(); }

