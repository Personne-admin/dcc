=== FILE: test.dc ===
module m;

using Named = void(*)(i32 value, bool enabled);
using Unnamed = void(*)(i32, bool);
using Mixed = void(*)(i32, bool enabled);
using NamedI32 = void(*)(i32 value);
using UnnamedI32 = void(*)(i32);
using NamedI32Bool = void(*)(i32 value, bool enabled);

void impl(i32 value, bool enabled) {}
void impl_i32(i32 value) {}
void impl_i32_bool(i32 value, bool enabled) {}

public i32 dispatch(NamedI32 cb) { cb(1); return 0; }
public f64 dispatch(NamedI32Bool cb) { cb(1, true); return 1; }

public void use_named(Named cb) { cb(1, true); }
public void use_unnamed(Unnamed cb) { cb(2, false); }

public void test_assign() {
    Named a = impl;
    Unnamed b = impl;
    a = b;
    b = a;
    Mixed m = a;
    a = m;
}

public void test_overload() {
    NamedI32 n = impl_i32;
    UnnamedI32 u = impl_i32;
    NamedI32Bool nb = impl_i32_bool;
    dispatch(n);
    dispatch(u);
    dispatch(nb);
}

