=== FILE: main.dc ===
module main;
import core::atomic;
using core::atomic::MemoryOrder;

void nonconstant(volatile i32* p, MemoryOrder o) {
    p.atomic_load(o);
    p.atomic_store(1, o);
    p.atomic_exchange(1, o);
    p.atomic_fetch_add(1, o);
    p.atomic_compare_exchange(1, 2, o, MemoryOrder::SeqCst);
    p.atomic_compare_exchange(1, 2, MemoryOrder::SeqCst, o);
    o.atomic_fence();
}

void illegal(volatile i32* p) {
    p.atomic_load(MemoryOrder::Release);
    p.atomic_store(1, MemoryOrder::Acquire);
    MemoryOrder::Relaxed.atomic_fence();
}

