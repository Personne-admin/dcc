module a;

public struct Writer {}
public struct Options {}

public void apply(T)(T x, const Writer* w, const Options* o) {
    static if T == i32 {
    } else static if compiles (T t, const Writer* q, const Options* opts) {
        t.hook(q, opts);
    } {
        x.hook(w, o);
    } else {
        missing_hook();
    }
}

