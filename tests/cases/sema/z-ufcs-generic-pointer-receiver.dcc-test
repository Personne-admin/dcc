=== FILE: main.dc ===
module m;

struct Point {
    i32 x;
    i32 y;
}

struct Arena(T) {
    T* data;
}

struct Vec(T) {
    T* data;
}

T create(T)(Arena(T)* arena, T value) {
    return value;
}

Point create_point(Arena(Point)* arena, i32 x) {
    return {x, 0};
}

void push_back(T)(Vec(T)* vec, T value) {
}

i32 touch(T)(Arena(T)* arena) {
    return 0;
}

Point peel(Point p) {
    return p;
}

i32 depth(T)(T** box) {
    return 0;
}

i32 pick(T)(Arena(T)* arena) {
    return 1;
}

i32 pick(T)(T** box) {
    return 2;
}

i32 t1_identity_explicit(Arena(Point)* arena, Point p) {
    Point r = arena.create(p);
    return r.x;
}

i32 t2_identity_contextual_struct(Arena(Point)* arena) {
    Point r = arena.create({3, 4});
    return r.x;
}

i32 t3_identity_explicit_struct_literal(Arena(Point)* arena) {
    Point r = arena.create(Point{5, 6});
    return r.x;
}

i32 t4_contextual_int_literal(Vec(i32)* vec) {
    vec.push_back(42);
    return 0;
}

i32 t5_value_receiver_addr_of(Arena(Point) arena, Point p) {
    Point r = arena.create(p);
    return r.x;
}

i32 t6_implicit_deref(Point* pt) {
    return pt.peel().x;
}

Point t7_generic_vs_nongeneric(Arena(Point)* arena) {
    return arena.create_point(7);
}

i32 t8_overload_identity_wins(Arena(Point)* arena) {
    return arena.pick();
}

i32 t9_pointer_auto_ref_to_double_ptr(Arena(Point)* arena) {
    return arena.depth();
}

i32 t10_direct_guard(Arena(Point)* arena, Point p) {
    return create(arena, p).x;
}

void t11_invalid_value_to_double_ptr(Arena(Point) arena) {
    i32 r = arena.depth();
}

