module m;

public struct Cell {
    usize v;
}

void write_through_const(const u8* p, const Cell* c, [] const u8 s) {
    (*p)++;
    ++(*p);
    p[0] = 1;
    c.v = 2;
    (*c).v = 3;
    s[0] = 4;
}

void reseat_const_pointer(u8* p) {
    u8* const q = p;
    q = p;
}

