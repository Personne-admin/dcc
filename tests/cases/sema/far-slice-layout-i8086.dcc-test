=== TARGET: i8086-binary ===
=== FILE: main.dc ===
module m;

struct Layout {
    u8 lead;
    []u8 near;
    [^]u8 far;
    [^DS]u8 based;
    u8 tail;
}

void sizes() {
    sizeof([]u8);
    alignof([]u8);
    sizeof([^]u8);
    alignof([^]u8);
    sizeof([^DS]u8);
    alignof([^DS]u8);
    sizeof([^]const u8);
    sizeof([^DS]volatile u8);
    offsetof(Layout, near);
    offsetof(Layout, far);
    offsetof(Layout, based);
    offsetof(Layout, tail);
    sizeof(Layout);
    alignof(Layout);
}

