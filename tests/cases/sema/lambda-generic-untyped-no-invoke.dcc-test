module m;

void consume(i32 x) {}

void keep(F)(F f) { }

void use() {
    keep(|x -> x);
}

void typed_ok() {
    keep(|i32 x -> consume(x));
    keep(|i32 x -> x);
}

void typed_ret() {
    i32(*)(i32) fp = |i32 y -> y * 2;
    keep(fp);
}

