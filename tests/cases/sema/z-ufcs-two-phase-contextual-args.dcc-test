module m;

struct Item {
    i32 id;
    i32 qty;
}

enum Status(T) {
    @implicit_construction Ready(i32),
    @implicit_construction Pending(T)
}

Item lookup(T)(i32 count, T fallback, []T data) {
    return fallback;
}

void print(T, U)(T out, []Status(U) values) {
}

i32 t1_contextual_before_revealing_arg(Item* data) {
    []Item slice = {data[0]};
    Item r = 3.lookup({5, 6}, slice);
    return r.id;
}

i32 t2_tagged_enum_slice_after_receiver_deduction() {
    i32 fd;
    fd.print({42, {7}});
    return 0;
}

