=== FILE: test.dc ===
module m;

using I32BinOp = i32(*)(i32, i32);
using F32BinOp = f32(*)(f32, f32);

i32 process_i32(I32BinOp f, i32 a, i32 b) { return f(a, b); }
f32 process_f32(F32BinOp f, f32 a, f32 b) { return f(a, b); }

i32 op(i32 a, i32 b) { return a + b; }
f32 op(f32 a, f32 b) { return a + b; }

void test() {
    i32 r1 = process_i32(op, 1, 2);
}

