=== FILE: main.dc ===
module main;
import core::atomic;
using core::atomic::MemoryOrder;
using core::atomic::Atomic;

void counts(volatile i32* p, Atomic(i32)* a, MemoryOrder o) {
    p.atomic_load();
    p.atomic_store(1);
    p.atomic_exchange(1);
    p.atomic_fetch_add();
    p.atomic_fetch_sub(1, MemoryOrder::SeqCst, 3);
    p.atomic_fetch_and(1, 2, MemoryOrder::SeqCst);
    p.atomic_fetch_or();
    p.atomic_fetch_xor(1);
    p.atomic_compare_exchange(1, 2, MemoryOrder::SeqCst);
    p.atomic_compare_exchange(1, 2, MemoryOrder::SeqCst, MemoryOrder::SeqCst, MemoryOrder::SeqCst);
    a.atomic_load();
    a.atomic_fetch_add(1);
    MemoryOrder::SeqCst.atomic_fence(MemoryOrder::SeqCst);
    core::atomic::atomic_fence();
    core::atomic::atomic_fetch_add(p, 1);
}

