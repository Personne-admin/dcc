=== FILE: main.dc ===
module m;

void consume(i32 x) {}

using Callable(T) = compiles(T f) {
    f(1);
};

void apply(F)(F callable) if Callable(F) {
    callable(1);
}

struct NotCallable {}

void test_positive() {
    apply(|x -> consume(x * 2));
}

void test_negative() {
    NotCallable nc;
    static if compiles {
        apply(nc);
    } {
    }
}
