=== TARGET: x86-elf ===
=== FILE: main.dc ===
module m;

struct Pair(T, U) {
    T first;
    U second;
}

u8^ g_far;
u8^GS g_based;
const u8^ g_const_far;
u8^ const g_far_const;
u8^* g_ptr_to_far;
i32(^)(i32) g_far_fp;
u8 GS;

public i32 demo(u8^ p, u8^GS q) {
    u8 a = 6;
    u8 b = 3;
    u8 x = a ^ b;
    u8 y = a ^ b ^ a;
    u8 z = (a) ^ b;
    u8^ r = p;
    u8^GS s = q;
    u8^ t = r as u8^;
    u8^GS u = s as u8^GS;
    Pair(u8^, u8^GS) pr;
    GS = 7;
    x = x + y + z + GS;
    if r as u8^ {
        x = x + 1;
    }
    return x as i32;
}
