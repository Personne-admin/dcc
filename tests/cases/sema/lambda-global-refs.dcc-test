module m;

i32 g_add(i32 a, i32 b) { return a + b; }
i32 global_val = 42;

void apply1(i32(*)(i32) f) {}

void test_globals() {
    apply1(|x -> global_val);
    apply1(|x -> g_add(x, x));
    apply1(|x -> g_add(global_val, x));
}
