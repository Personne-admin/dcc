=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module m;

struct Layout {
    u8 lead;
    []u8 near;
    [^GS]u8 based;
    u8 tail;
}

void sizes() {
    sizeof([]u8);
    alignof([]u8);
    sizeof([^GS]u8);
    alignof([^GS]u8);
    sizeof([^FS]const u8);
    offsetof(Layout, near);
    offsetof(Layout, based);
    offsetof(Layout, tail);
    sizeof(Layout);
    alignof(Layout);
}

