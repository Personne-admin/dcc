module ns;

public u16 base = 0xB800;

=== FILE: main.dc ===
module main;

import ns;

u8^ take_far(u8^ p) {
    return p;
}

public i32 demo(u16 a, u16 b, u16 x, u32 o) {
    u8^ p = a + b:x;
    u8^ q = ns::base:o;
    u8^ r = 0xB800:0x100 as u8^;
    u8^ s = take_far(0xB000:o);
    u8^GS t = GS:x;
    u32 mask = 255;
    u32 v = mask ^ 15 ^ 3;
    return 0;
}

