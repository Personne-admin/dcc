module m;

i32 apply1(i32(*)(i32) f) {
    return f(1);
}

i32 apply1(F)(F f) {
    return 0;
}

i32 test_fp_wins() {
    return apply1(|x -> x + 1);
}

i32 test_generic_only(i32(*)(i32) fp) {
    return apply1(fp);
}
