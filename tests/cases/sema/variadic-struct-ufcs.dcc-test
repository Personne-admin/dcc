module m;

struct Tuple(T...) {
    T... items;
}

i32 first(Tuple(i32, f64)* self) {
    return self.items.0;
}

i32 get0(T...)(Tuple(T)* self) {
    return self.items.0;
}

void caller() {
    Tuple(i32, f64) t = {1, 2.0};
    i32 a = t.first();
    i32 b = t.get0();
    Tuple(i32, f64)* p = &t;
    i32 c = p.get0();
    a + b + c;
}

