=== TARGET: i8086-binary ===
=== FILE: main.dc ===
module m;

struct Layout {
    u8 lead;
    u8^ fp;
    u8^DS bp;
    u8 tail;
}

void sizes() {
    sizeof(u8^);
    alignof(u8^);
    sizeof(u8^DS);
    alignof(u8^DS);
    offsetof(Layout, fp);
    offsetof(Layout, bp);
    offsetof(Layout, tail);
    sizeof(Layout);
    alignof(Layout);
}

