=== FILE: main.dc ===
module main;
import core::atomic;
using core::atomic::MemoryOrder;

void based(volatile i32^DS p, volatile i32^ q) {
    core::atomic::atomic_fetch_add(p, 1, MemoryOrder::SeqCst);
    p.atomic_fetch_add(1, MemoryOrder::SeqCst);
    core::atomic::atomic_load(q, MemoryOrder::SeqCst);
    q.atomic_load(MemoryOrder::SeqCst);
}

