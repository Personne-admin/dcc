=== FILE: main.dc ===
module m;

void consume(i32 x) {}

void apply(F, Args...)(F f, Args a) {
    f(a...);
}

void test_repeated() {
    apply(|a -> consume(a), 1);
    apply(|b -> consume(b), 1);
    apply(|c -> consume(c), 2);
}

i32 test_failed_probe() {
    i32 r = 0;
    bool ok = compiles {
        apply(|bad -> consume(bad + "x"), 1);
    };
    apply(|d -> consume(d), 3);
    return r;
}
