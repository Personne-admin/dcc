module m;

enum Mode : u8 { A = 0, B = 1 }
using Mode MODE = RAW as Mode;

static if MODE == Mode::B {
    public i32 value() { return 1; }
} else {
    public i32 value() { return dead_undeclared; }
}

public i32 use_it() { return value(); }

