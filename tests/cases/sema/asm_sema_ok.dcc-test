=== FILE: test.dc ===
module test;

void nop() {
    asm { "nop" };
}

void outb() {
    u16 port = 0x60;
    u8 val = 0x42;
    asm @[inputs(val in al = val, port in dx = port)] { "outb %[val], %[port]" };
}

u64 non_volatile_value() {
    u64 y = asm @[volatile(false), output(u64 in rax)] { "mov $42, %0" };
    return y;
}
