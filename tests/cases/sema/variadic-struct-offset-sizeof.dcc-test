=== FILE: main.dc ===
module m;

struct Tuple(T...) {
    T... items;
}

struct Tagged(K, T...) {
    K key;
    T... rest;
}

struct Wrap(T...) {
    Tuple(T) inner;
}

void g(T...)(Tuple(T) t) {
    sizeof...(T);
}

void f() {
    offsetof(Tuple(i32, f64), items.0);
    offsetof(Tuple(i32, f64), items.1);
    offsetof(Tuple(u8, u64, u8), items.0);
    offsetof(Tuple(u8, u64, u8), items.1);
    offsetof(Tuple(u8, u64, u8), items.2);
    offsetof(Tagged(u32, u8, u64), rest.0);
    offsetof(Tagged(u32, u8, u64), rest.1);
    offsetof(Tagged(u32, u8, u64), key);
    sizeof(Wrap(u8, u16));
    alignof(Wrap(u8, u16));
    sizeof(Tuple(u8, u16));
}

void caller() {
    Tuple(i32, f64) v = {1, 2.0};
    g!(i32, f64)(v);
}

