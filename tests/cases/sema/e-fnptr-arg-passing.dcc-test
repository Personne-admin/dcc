=== FILE: test.dc ===
module test;

using Fn = i32(*)(i32, i32);

i32 add(i32 a, i32 b) { return a + b; }

i32 apply(Fn f, i32 a, i32 b) { return f(a, b); }

i32 test() { return apply(add, 1, 2); }

