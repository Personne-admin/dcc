=== FILE: main.dc ===
module m;

struct Tuple(T...) {
    T... items;
}

struct Tagged(K, T...) {
    K key;
    T... rest;
}

i32 read0(Tuple(i32, f64) s) {
    return s.items.0;
}

f64 read1(Tuple(i32, f64) s) {
    return s.items.1;
}

i32 read_rest(Tagged(i32, i32, i32) t) {
    return t.rest.1 + t.key;
}

void write0(Tuple(i32, f64) s, i32 v) {
    s.items.0 = v;
}

i32 read_ptr(Tuple(i32, f64)* p) {
    return p.items.0 + p.items.1 as i32;
}

void write_ptr(Tuple(i32, f64)* p, i32 v) {
    p.items.0 = v;
}

