=== FILE: main.dc ===
module main;

struct Res {
    bool ok;
    i32 val;
}

bool is_ok(Res self) { return self.ok; }
i32 unwrap(Res self) { return self.val; }
i32 unwrap_err(Res self) { return self.val; }

i32 add1(i32 x) { return x + 1; }

i32 in_if_expr(Res r) {
    return if r? != 0 { 1 } else { 0 };
}

i32 in_arg(Res r) {
    return add1(r?);
}

i32 in_return(Res r) {
    return r?;
}

