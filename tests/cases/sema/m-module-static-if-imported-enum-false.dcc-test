=== FILE: config.dc ===
module config;

public enum Mode : u8 { A, B }
public using Mode MODE = Mode::A;

=== FILE: main.dc ===
module main;

import config;

static if config::MODE == config::Mode::B {
    public i32 selected() { return 1; }
} else {
    public i32 selected() { return 2; }
}

void test() { selected(); }

