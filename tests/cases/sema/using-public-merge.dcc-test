=== FILE: arch/portio.dc ===
module arch::portio;
public u16 last_port;
public u8 last_value;
public void io_out(u16 port, u8 value) { last_port = port; last_value = value; }

=== FILE: dev/uart.dc ===
module dev::uart;
import arch::portio;
@nominal using uart = u16;
using public dev::uart = uart;
using public dev::x = uart;
public uart new_uart(u16 port) { return port as uart; }
using public uart::new = new_uart;
public void write(uart self, u8 value) { arch::portio::io_out(self as u16, value); }

=== FILE: shared/source.dc ===
module shared::source;
public i32 mark() { return 7; }

=== FILE: first.dc ===
module first;
using public shared::left = u8;
