=== FILE: main.dc ===
module main;
import shared::source;
import arch::portio;
import dev::uart;
import first;
import second;
@nomangle public i32 dcc_main() {
    dev::uart com1 = uart::new(0x3f8);
    com1.write('H' as u8);
    if arch::portio::last_port != 0x3f8 || arch::portio::last_value != ('H' as u8) { return 1; }
    dev::x com2 = dev::uart::new(0x2f8);
    if dev::uart::new_uart(0x3f8) != com1 { return 4; }
    dev::uart::write(com2, 'J' as u8);
    if arch::portio::last_port != 0x2f8 || arch::portio::last_value != ('J' as u8) { return 2; }
    shared::left a = 3;
    shared::right b = 4;
    fresh::word c = 9;
    if a != 3 || b != 4 || c != 9 || shared::source::mark() != 7 { return 3; }
    return 0;
}

