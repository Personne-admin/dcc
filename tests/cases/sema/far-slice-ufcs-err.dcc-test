void ufcs([]u8 near, [^]u8 far, [^GS]u8 based, [^FS]u8 other) {
    usize a = far.near_len();
    usize b = based.near_len();
    usize c = based.far_len();
    usize d = near.based_len();
    usize e = far.based_len();
    usize f = other.based_len();
    usize g = far.any_based();
    usize h = near.any_based();
}

void calls([]u8 near, [^]u8 far, [^GS]u8 based) {
    usize a = near_len(far);
    usize b = near_len(based);
    usize c = far_len(based);
    usize d = based_len(far);
    usize e = based_len(near);
}

