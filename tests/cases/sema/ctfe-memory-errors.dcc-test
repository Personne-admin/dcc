module ctfe_memory_errors;

u64 out_of_bounds(usize index) {
    u64[2] data;
    data[0] = 1;
    data[1] = 2;
    return data[index];
}

u64 uninitialized() {
    u64[2] data;
    return data[1];
}

u64 through_null() {
    u64* p = null;
    return *p;
}

usize bad_slice(usize end) {
    u64[2] data;
    return data[0..end].len;
}

[]const char dangling() {
    char[4] local;
    local[0] = 'a';
    return local[0..1];
}

u64* escaping() {
    u64 local = 3;
    return &local;
}

const u64 A = out_of_bounds(4);
const u64 B = uninitialized();
const u64 C = through_null();
const usize D = bad_slice(9);
const []const char E = dangling();
const u64* const F = escaping();

