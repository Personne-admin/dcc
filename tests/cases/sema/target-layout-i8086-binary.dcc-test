=== TARGET: i8086-binary ===
=== FILE: main.dc ===
module m;

struct Layout {
    u8 lead;
    i32* ptr;
    []u8 slice;
    u8 tail;
}

void sizes() {
    sizeof(i32*);
    alignof(i32*);
    sizeof(usize);
    alignof(usize);
    sizeof(isize);
    alignof(isize);
    sizeof([]u8);
    alignof([]u8);
    offsetof(Layout, ptr);
    offsetof(Layout, slice);
    offsetof(Layout, tail);
    sizeof(Layout);
    alignof(Layout);
}

