module lib;

public struct Rec {
    i32 v;
}

public const i32 k = 5;
public enum Mode : u8 { A = 1, B = 2 }

public i32 apply(T)(T x) {
    Rec r = {v = 3};
    Mode m = Mode::B;
    return r.v + (m as i32) + k + (x as i32);
}

