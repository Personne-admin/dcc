module m;

i32 apply3(f64(*)(i32) f) { return 1; }
void apply_void(void(*)() f) {}

void test_ret() {
    apply3(|x -> 3.5);
    apply3(|x -> 3);
    apply_void(| -> {});
    i32(*)(i32) fp = |i32 x -> x * 2;
}
