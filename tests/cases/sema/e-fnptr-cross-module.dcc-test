module lib;

public i32 add(i32 a, i32 b) { return a + b; }

public using BinOp = i32(*)(i32, i32);

public i32 apply(BinOp f, i32 a, i32 b) { return f(a, b); }

=== FILE: main.dc ===
module main;
import lib;

void test() {
    i32 r = lib::apply(lib::add, 1, 2);
}

