=== TARGET: x86_64-elf ===
=== FILE: main.dc ===
module m;

struct Layout {
    u8 lead;
    u8^GS bp;
    u8 tail;
}

void sizes() {
    sizeof(u8^GS);
    alignof(u8^GS);
    offsetof(Layout, bp);
    offsetof(Layout, tail);
    sizeof(Layout);
    alignof(Layout);
}

