=== TARGET: x86-elf ===
=== FILE: main.dc ===
module m;

struct Layout {
    u8 lead;
    []u8 near;
    [^]u8 far;
    [^GS]u8 based;
    u8 tail;
}

void sizes() {
    sizeof([]u8);
    alignof([]u8);
    sizeof([^]u8);
    alignof([^]u8);
    sizeof([^GS]u8);
    alignof([^GS]u8);
    sizeof([^]const u8);
    sizeof([^GS]volatile u8);
    offsetof(Layout, near);
    offsetof(Layout, far);
    offsetof(Layout, based);
    offsetof(Layout, tail);
    sizeof(Layout);
    alignof(Layout);
}

