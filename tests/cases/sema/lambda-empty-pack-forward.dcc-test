module m;

i32 total = 0;

void accumulate(i32 x) { total += x; }

void apply(F, Args...)(F f, Args args) {
    f(args...);
}

void use_empty() {
    apply(| -> accumulate(42));
}

void use_bad() {
    apply(|x -> x);
}
