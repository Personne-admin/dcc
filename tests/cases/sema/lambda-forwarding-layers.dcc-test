module m;

void consume(i32 x) {}

void layer1(F, A)(F f, A a) {
    layer2(f, a);
}

void layer2(F, A)(F f, A a) {
    f(a);
}

void test() {
    layer1(|x -> consume(x * 2), 21);
}
