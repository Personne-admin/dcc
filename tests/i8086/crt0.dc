asm @[intel] {
    \\.section .start, "ax", @progbits
    \\.globl _start
    \\.globl dcc_putc
    \\.globl dcc_exit
    \\_start:
    \\cld
    \\mov edi, offset __bss_start
    \\mov ecx, offset __bss_end
    \\sub ecx, edi
    \\xor eax, eax
    \\a32 rep stosb
    \\call dcc_main
    \\jmp short crt_exit_with_al
    \\dcc_putc:
    \\push bp
    \\mov bp, sp
    \\mov dx, 0x3fd
    \\crt_putc_wait:
    \\in al, dx
    \\test al, 0x20
    \\jz short crt_putc_wait
    \\mov al, byte ptr [bp + 4]
    \\mov dx, 0x3f8
    \\out dx, al
    \\pop bp
    \\ret
    \\dcc_exit:
    \\mov bp, sp
    \\mov al, byte ptr [bp + 2]
    \\crt_exit_with_al:
    \\mov dx, 0xf4
    \\out dx, al
    \\crt_hang:
    \\cli
    \\hlt
    \\jmp short crt_hang
};
