        { name = "s", default_value = "a;b" },
        { name = "s2", default_value = "a b" },
        { name = "i", kind = VariableKind::Identifier, default_value = "1bad" },
        { name = "i2", kind = VariableKind::Identifier, default_value = "enum" },
        { name = "n", kind = VariableKind::Integer, default_value = "01" },
        { name = "n2", kind = VariableKind::Integer, default_value = "+1" },
        { name = "n3", kind = VariableKind::Integer, default_value = "-0" },
        { name = "n4", kind = VariableKind::Integer, default_value = "9999999999999999999" },
        { name = "n5", kind = VariableKind::Integer, default_value = "-5" },
        { name = "b", kind = VariableKind::Bool, default_value = "yes" },
        { name = "c", kind = VariableKind::Choice, choices = { "a", "b" }, default_value = "c" },
    },
}
