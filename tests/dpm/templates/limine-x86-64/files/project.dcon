dpm::v1::Project {
    name = "@@name@@",
    version = "0.1.0",
    description = "x86-64 kernel booted by Limine",
    products = {
        {
            name = "@@name@@",
            entry = "src/main.dc",
            linker_script = "linker-scripts/x86_64.lds",
            run = "run",
            settings = {
                target = Target::X86_64Elf,
                backend = Backend::Llvm,
                model = Model::Kernel,
                libdcext = Libdcext::Freestanding,
                optimize = Optimize::O2,
                debug_info = Tri::On,
                bounds_check = Tri::On,
                restricted_check = Tri::On,
                red_zone = Tri::Off,
                simd = Tri::Off,
                x87 = Tri::Off,
                stack_protector = Tri::Off,
                partial_eval = Tri::On,
                extra_flags = { "-Wl,-static", "-Wl,--no-pie", "-Wl,-zmax-page-size=0x1000", "-Wl,-znoexecstack" },
            },
        },
    },
    assets = {
        { name = "limine", location = "https://github.com/Limine-Bootloader/Limine/releases/download/v12.9.6/limine-binary.tar.gz", version = "v12.9.6" },
        { name = "ovmf", location = "https://github.com/osdev0/edk2-ovmf-stable-bins/releases/download/20261026T212116Z/edk2-ovmf-bins.tar.gz", version = "20261026T212116Z", max_size = 536870912 },
    },
    tasks = {
        {
            name = "limine-tool",
            description = "Build the Limine host utility",
            command = { "cc", "-g", "-O2", "-std=c99", "-D_FILE_OFFSET_BITS=64", "-o", "${task_dir}/limine", "${asset:limine}/limine.c" },
            tools = { "cc" },
            inputs = { "${asset:limine}/limine.c", "${asset:limine}/limine-bios-hdd.h" },
            outputs = { "${task_dir}/limine" },
        },
        {
            name = "iso",
            description = "Build the kernel and a bootable ISO (BIOS and UEFI)",
            command = { "sh", "scripts/make-iso.sh", "${out:@@name@@}", "${asset:limine}", "${task_dir:limine-tool}/limine", "${task_dir}/template.iso", "limine.conf" },
            tools = { "xorriso" },
            build = { "@@name@@" },
            needs = { "limine-tool" },
            inputs = { "scripts/make-iso.sh", "limine.conf", "${out:@@name@@}", "${task_dir:limine-tool}/limine" },
            outputs = { "${task_dir}/template.iso" },
        },
        {
            name = "hdd",
            description = "Build the kernel and a 64 MiB raw disk image",
            command = { "sh", "scripts/make-hdd.sh", "${out:@@name@@}", "${asset:limine}", "${task_dir:limine-tool}/limine", "${task_dir}/template.hdd", "limine.conf", "64" },
            tools = { "sgdisk", "mformat", "mmd", "mcopy", "dd" },
            build = { "@@name@@" },
            needs = { "limine-tool" },
            inputs = { "scripts/make-hdd.sh", "limine.conf", "${out:@@name@@}", "${task_dir:limine-tool}/limine" },
            outputs = { "${task_dir}/template.hdd" },
        },
        {
            name = "run",
            description = "Boot the ISO in QEMU (BIOS); arguments after -- go to QEMU",
            command = { "qemu-system-x86_64", "-M", "q35", "-m", "2G", "-cdrom", "${task_dir:iso}/template.iso", "-boot", "d" },
            tools = { "qemu-system-x86_64" },
            needs = { "iso" },
        },
        {
            name = "run-uefi",
            description = "Boot the ISO in QEMU with OVMF firmware",
            command = { "qemu-system-x86_64", "-M", "q35", "-m", "2G", "-drive", "if=pflash,unit=0,format=raw,file=${asset:ovmf}/ovmf-code-x86_64.fd,readonly=on", "-cdrom", "${task_dir:iso}/template.iso", "-boot", "d" },
            tools = { "qemu-system-x86_64" },
            needs = { "iso" },
        },
        {
            name = "run-hdd",
            description = "Boot the disk image in QEMU (BIOS)",
            command = { "qemu-system-x86_64", "-M", "q35", "-m", "2G", "-hda", "${task_dir:hdd}/template.hdd" },
            tools = { "qemu-system-x86_64" },
            needs = { "hdd" },
        },
        {
            name = "run-hdd-uefi",
            description = "Boot the disk image in QEMU with OVMF firmware",
            command = { "qemu-system-x86_64", "-M", "q35", "-m", "2G", "-drive", "if=pflash,unit=0,format=raw,file=${asset:ovmf}/ovmf-code-x86_64.fd,readonly=on", "-hda", "${task_dir:hdd}/template.hdd" },
            tools = { "qemu-system-x86_64" },
            needs = { "hdd" },
        },
    },
}
