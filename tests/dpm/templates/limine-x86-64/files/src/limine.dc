//!
//! TPM event log
//!

/// request identifier for the TPM event log.
public using u64[4] TPM_EVENT_LOG_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x98e094fc7e76e979,
    0xee8d8775c54e1d1f
};

/// TCG 1.2 event-log format.
public using u64 TPM_EVENT_LOG_FORMAT_TCG_1_2 = 1;

/// TCG 2 event-log format.
public using u64 TPM_EVENT_LOG_FORMAT_TCG_2 = 2;

/// response containing the TPM event log.
public struct TpmEventLogResponse {
    u64 revision;

    /// one of the `TPM_EVENT_LOG_FORMAT_*` values.
    u64 format;

    /// size of the event log in bytes.
    u64 size;

    /// address of the event log.
    void* address;
}

/// requests the TPM event log.
public struct TpmEventLogRequest {
    u64[4] id;
    u64 revision;
    TpmEventLogResponse* response;
}

//!
//! EFI memory map
//!

/// request identifier for the EFI memory map.
public using u64[4] EFI_MEMMAP_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x7df62a431d6872d5,
    0xa4fcdfb3e57306c8
};

/// response containing the firmware's EFI memory map.
public struct EfiMemmapResponse {
    u64 revision;

    /// address of the raw EFI memory map.
    void* memmap;

    /// size of the memory map in bytes.
    u64 memmap_size;

    /// size of each EFI memory descriptor.
    u64 desc_size;

    /// EFI memory descriptor version.
    u64 desc_version;
}

/// requests the EFI memory map.
public struct EfiMemmapRequest {
    u64[4] id;
    u64 revision;
    EfiMemmapResponse* response;
}

//!
//! Date at boot
//!

/// request identifier for the boot timestamp.
public using u64[4] DATE_AT_BOOT_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x502746e184c088aa,
    0xfbc5ec83e6327893
};

/// response containing the wall-clock timestamp at boot.
public struct DateAtBootResponse {
    u64 revision;

    /// boot timestamp represented by the Limine protocol.
    i64 timestamp;
}

/// requests the date and time recorded at boot.
public struct DateAtBootRequest {
    u64[4] id;
    u64 revision;
    DateAtBootResponse* response;
}

//!
//! Executable address
//!

/// request identifier for executable load addresses.
public using u64[4] EXECUTABLE_ADDRESS_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x71ba76863cc55f63,
    0xb2644a48c516a487
};

/// response describing where the executable was loaded.
public struct ExecutableAddressResponse {
    u64 revision;

    /// physical base address of the loaded executable.
    u64 physical_base;

    /// virtual base address of the loaded executable.
    u64 virtual_base;
}

/// requests the executable's physical and virtual load addresses.
public struct ExecutableAddressRequest {
    u64[4] id;
    u64 revision;
    ExecutableAddressResponse* response;
}

//!
//! Device tree blob
//!

/// request identifier for the flattened device tree blob.
public using u64[4] DTB_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0xb40ddb48fb54bac7,
    0x545081493f81ffb7
};

/// response containing the device tree blob.
public struct DtbResponse {
    u64 revision;

    /// address of the flattened device tree.
    void* dtb_ptr;
}

/// requests the flattened device tree blob.
public struct DtbRequest {
    u64[4] id;
    u64 revision;
    DtbResponse* response;
}

//!
//! RISC-V BSP hart ID
//!

/// request identifier for the RISC-V bootstrap hart ID.
public using u64[4] RISCV_BSP_HARTID_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x1369359f025525f9,
    0x2ff2a56178391bb6
};

/// response containing the RISC-V bootstrap hart ID.
public struct RiscvBspHartidResponse {
    u64 revision;

    /// hardware thread ID of the bootstrap processor.
    u64 bsp_hartid;
}

/// requests the RISC-V bootstrap hart ID.
public struct RiscvBspHartidRequest {
    u64[4] id;
    u64 revision;
    RiscvBspHartidResponse* response;
}

//!
//! Bootloader performance
//!

/// request identifier for bootloader performance timings.
public using u64[4] BOOTLOADER_PERFORMANCE_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x6b50ad9bf36d13ad,
    0xdc4c7e88fc759e17
};

/// response containing bootloader performance timing information.
public struct BootloaderPerformanceResponse {
    u64 revision;

    /// time spent before bootloader initialization, in microseconds.
    u64 reset_usec;

    /// time spent during bootloader initialization, in microseconds.
    u64 init_usec;

    /// time spent preparing execution, in microseconds.
    u64 exec_usec;
}

/// requests bootloader performance timing information.
public struct BootloaderPerformanceRequest {
    u64[4] id;
    u64 revision;
    BootloaderPerformanceResponse* response;
}

//!
//! x86_64 IOMMU preservation
//!

/// request identifier for preserving x86_64 IOMMU configuration.
public using u64[4] X86_64_KEEP_IOMMU_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x8ebaabe51f490179,
    0x2aa86a59ffb4ab0f
};

/// response indicating that the x86_64 IOMMU-preservation request was handled.
public struct X86_64KeepIommuResponse {
    u64 revision;
}

/// requests that Limine preserve the x86_64 IOMMU configuration.
public struct X86_64KeepIommuRequest {
    u64[4] id;
    u64 revision;
    X86_64KeepIommuResponse* response;
}

//!
//! TSC frequency
//!

/// request identifier for the timestamp-counter frequency.
public using u64[4] TSC_FREQUENCY_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x10f2ee1d87d195e4,
    0xf747a2b78f6ddb31
};

/// response containing the timestamp-counter frequency.
public struct TscFrequencyResponse {
    u64 revision;

    /// TSC frequency in hertz.
    u64 frequency;
}

/// requests the timestamp-counter frequency.
public struct TscFrequencyRequest {
    u64[4] id;
    u64 revision;
    TscFrequencyResponse* response;
}

//!
//! Entropy
//!

/// request identifier for bootloader-provided entropy.
public using u64[4] ENTROPY_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x65ea80255d5682c5,
    0x9117240723f493eb
};

/// response containing entropy values supplied by the bootloader.
public struct EntropyResponse {
    u64 revision;

    /// number of entries in `values`.
    u64 value_count;

    /// bootloader-provided entropy values.
    u64* values;
}

/// requests entropy values from the bootloader.
public struct EntropyRequest {
    u64[4] id;
    u64 revision;
    EntropyResponse* response;

    /// number of entropy values requested.
    u64 value_count;
}
