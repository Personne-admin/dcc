//!!
//!! DC bindings for the Limine boot protocol.
//!!
//!! These definitions mirror the ABI exposed by the official Limine protocol.
//!! This module provides protocol types and constants only; bootloader setup
//!! and filesystem preparation are handled separately by enclume-limine.
//!!

module limine;

//!
//! Common markers and magic
//!

/// value placed in the `.limine_requests_start_marker` section to mark the
/// beginning of the executable's Limine request list.
public using u64[4] REQUESTS_START_MARKER = {
    0xf6b8f4b39de7d1ae,
    0xfab91a6940fcb9cf,
    0x785c6ed015d3e316,
    0x181e920a7852b9d9
};

/// value placed in the `.limine_requests_end_marker` section to mark the end
/// of the executable's Limine request list.
public using u64[2] REQUESTS_END_MARKER = {
    0xadc0e0531bb10d03,
    0x9572709f31764c62
};

/// first magic word used by a Limine base-revision tag.
public using u64 BASE_REVISION_MAGIC_0 = 0xf9562b2d5c95a6c8;

/// second magic word used by a Limine base-revision tag.
public using u64 BASE_REVISION_MAGIC_1 = 0x6a7b384944536bdc;

/// sonstructs a Limine base-revision tag requesting `revision`.
///
/// the returned value is normally emitted as a global object inside the
/// `.limine_requests` section.
public u64[3] base_revision(u64 revision) {
    return {
        BASE_REVISION_MAGIC_0,
        BASE_REVISION_MAGIC_1,
        revision
    };
}

/// returns whether the requested base revision was accepted by the bootloader.
public bool base_revision_supported(u64[3] tag) {
    return tag[2] == 0;
}

/// returns whether the requested base revision was accepted by the bootloader.
public bool base_revision_supported(const u64[3]* tag) {
    return (*tag)[2] == 0;
}

/// returns whether a loaded-base-revision value was supplied by the bootloader.
public bool loaded_base_revision_valid(u64[3] tag) {
    return tag[1] != BASE_REVISION_MAGIC_1;
}

/// returns whether a loaded-base-revision value was supplied by the bootloader.
public bool loaded_base_revision_valid(const u64[3]* tag) {
    return (*tag)[1] != BASE_REVISION_MAGIC_1;
}

/// returns the base revision selected by the bootloader.
///
/// call `loaded_base_revision_valid` before interpreting this value.
public u64 loaded_base_revision(u64[3] tag) {
    return tag[1];
}

/// returns the base revision selected by the bootloader.
///
/// call `loaded_base_revision_valid` before interpreting this value.
public u64 loaded_base_revision(const u64[3]* tag) {
    return (*tag)[1];
}

/// first common magic word present in every Limine request identifier.
public using u64 COMMON_MAGIC_0 = 0xc7b1dd30df4c8b88;

/// second common magic word present in every Limine request identifier.
public using u64 COMMON_MAGIC_1 = 0x0a82e883a194f07b;

/// common two-word prefix shared by Limine request identifiers.
public using u64[2] COMMON_MAGIC = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1
};

//!
//! UUID
//!

/// UUID representation used in Limine protocol structures.
public struct Uuid {
    u32 a;
    u16 b;
    u16 c;
    u8[8] d;
}

//!
//! Files and media
//!

/// generic block-device or filesystem-backed media.
public using u32 MEDIA_TYPE_GENERIC = 0;

/// optical media.
public using u32 MEDIA_TYPE_OPTICAL = 1;

/// network media obtained through TFTP.
public using u32 MEDIA_TYPE_TFTP = 2;

/// file supplied by the Limine bootloader.
///
/// besides the mapped file contents, this structure carries the resource path,
/// command string, media information, and partition identifiers associated
/// with the file.
public struct File {
    u64 revision;

    /// address of the mapped file contents.
    void* address;

    /// file size in bytes.
    u64 size;

    /// limine resource path for the file.
    char* path;

    /// string associated with the file by the boot configuration.
    char* string;

    /// one of the `MEDIA_TYPE_*` values.
    u32 media_type;

    u32 unused;

    /// TFTP server IPv4 address when the file originates from TFTP media.
    u8[4] tftp_ipv4;

    /// TFTP server port when applicable.
    u32 tftp_port;

    /// partition index associated with the source media.
    u32 partition_index;

    /// MBR disk identifier associated with the source media.
    u32 mbr_disk_id;

    Uuid gpt_disk_uuid;
    Uuid gpt_part_uuid;
    Uuid part_uuid;
}

//!
//! Bootloader information
//!

/// request identifier for bootloader information.
public using u64[4] BOOTLOADER_INFO_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0xf55038d8e2a1202f,
    0x279426fcf5f59740
};

/// response containing the bootloader implementation name and version.
public struct BootloaderInfoResponse {
    u64 revision;

    /// bootloader implementation name.
    char* name;

    /// bootloader version string.
    char* version;
}

/// requests information about the bootloader implementation.
public struct BootloaderInfoRequest {
    u64[4] id;
    u64 revision;
    BootloaderInfoResponse* response;
}

//!
//! Executable command line
//!

/// request identifier for the executable command line.
public using u64[4] EXECUTABLE_CMDLINE_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x4b161536e598651e,
    0xb390ad4a2f1f303a
};

/// response containing the command line associated with the executable.
public struct ExecutableCmdlineResponse {
