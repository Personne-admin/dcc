    COMMON_MAGIC_1,
    0x8c2f75d90bef28a8,
    0x7045a4688eac00c3
};

/// legacy x86 BIOS firmware.
public using u64 FIRMWARE_TYPE_X86BIOS = 0;

/// 32-bit EFI firmware.
public using u64 FIRMWARE_TYPE_EFI32 = 1;

/// 64-bit EFI firmware.
public using u64 FIRMWARE_TYPE_EFI64 = 2;

/// RISC-V SBI firmware environment.
public using u64 FIRMWARE_TYPE_SBI = 3;

/// response identifying the firmware environment used to boot the executable.
public struct FirmwareTypeResponse {
    u64 revision;

    /// one of the `FIRMWARE_TYPE_*` values.
    u64 firmware_type;
}

/// requests the firmware environment used to boot the executable.
public struct FirmwareTypeRequest {
