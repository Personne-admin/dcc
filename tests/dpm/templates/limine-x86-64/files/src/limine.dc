}

//!
//! HHDM
//!
//! Higher Half Direct Map information supplied by the bootloader.
//!

/// request identifier for the higher-half direct-map offset.
public using u64[4] HHDM_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x48dcf1cb8ad2b852,
    0x63984e959a98244b
};

/// response describing the higher-half direct-map offset.
public struct HhdmResponse {
    u64 revision;

    /// offset added to eligible physical addresses to obtain their HHDM
    /// virtual addresses.
    u64 offset;
}

/// requests the bootloader's higher-half direct-map offset.
public struct HhdmRequest {
    u64[4] id;
    u64 revision;
    HhdmResponse* response;
}

//!
//! Framebuffer
//!

/// request identifier for framebuffer information.
public using u64[4] FRAMEBUFFER_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x9d5827dcd881dd75,
    0xa3148604f6fab11b
};

/// RGB framebuffer memory model.
public using u8 FRAMEBUFFER_RGB = 1;

/// video mode supported by a Limine framebuffer.
public struct VideoMode {
    /// number of bytes between adjacent framebuffer scanlines.
    u64 pitch;

    u64 width;
    u64 height;

    /// bits per pixel.
    u16 bpp;

    u8 memory_model;
    u8 red_mask_size;
    u8 red_mask_shift;
    u8 green_mask_size;
    u8 green_mask_shift;
    u8 blue_mask_size;
    u8 blue_mask_shift;
}

/// framebuffer exposed by the bootloader.
public struct Framebuffer {
    /// address of the framebuffer memory.
    void* address;

    u64 width;
    u64 height;

    /// number of bytes between adjacent scanlines.
    u64 pitch;

    /// bits per pixel.
    u16 bpp;

    u8 memory_model;
    u8 red_mask_size;
    u8 red_mask_shift;
    u8 green_mask_size;
    u8 green_mask_shift;
    u8 blue_mask_size;
    u8 blue_mask_shift;
    u8[7] unused;

    /// size in bytes of the EDID data referenced by `edid`.
    u64 edid_size;

    /// pointer to EDID data when available.
    void* edid;

    /// number of entries in `modes`.
    ///
    /// available starting with framebuffer response revision 1.
    u64 mode_count;

    /// available video modes.
    ///
    /// available starting with framebuffer response revision 1.
    VideoMode** modes;
}

/// response containing the framebuffers made available by the bootloader.
public struct FramebufferResponse {
    u64 revision;

    /// number of entries in `framebuffers`.
    u64 framebuffer_count;

    Framebuffer** framebuffers;
}

/// requests framebuffer information from the bootloader.
public struct FramebufferRequest {
    u64[4] id;
    u64 revision;
    FramebufferResponse* response;
}

//!
//! Flanterm framebuffer initialization parameters
//!

/// request identifier for Flanterm framebuffer initialization parameters.
public using u64[4] FLANTERM_FB_INIT_PARAMS_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x3259399fe7c5f126,
    0xe01c1c8c5db9d1a9
};

/// no framebuffer rotation.
public using u64 FLANTERM_FB_ROTATE_0 = 0;

/// rotate the framebuffer by 90 degrees.
public using u64 FLANTERM_FB_ROTATE_90 = 1;

/// rotate the framebuffer by 180 degrees.
public using u64 FLANTERM_FB_ROTATE_180 = 2;

/// rotate the framebuffer by 270 degrees.
public using u64 FLANTERM_FB_ROTATE_270 = 3;

/// flanterm framebuffer initialization parameters supplied by Limine.
public struct FlantermFbInitParams {
    u32* canvas;
    u64 canvas_size;
    u32[8] ansi_colours;
    u32[8] ansi_bright_colours;
    u32 default_bg;
    u32 default_fg;
    u32 default_bg_bright;
    u32 default_fg_bright;
    void* font;
    u64 font_width;
    u64 font_height;
    u64 font_spacing;
    u64 font_scale_x;
    u64 font_scale_y;
    u64 margin;

    /// one of the `FLANTERM_FB_ROTATE_*` values.
    u64 rotation;
}

/// response containing Flanterm initialization parameter sets.
public struct FlantermFbInitParamsResponse {
    u64 revision;
    u64 entry_count;
    FlantermFbInitParams** entries;
}

/// requests Flanterm framebuffer initialization parameters.
public struct FlantermFbInitParamsRequest {
    u64[4] id;
    u64 revision;
    FlantermFbInitParamsResponse* response;
}

//!
//! Paging mode
//!

/// request identifier for selecting and querying the paging mode.
public using u64[4] PAGING_MODE_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x95c1a0edab0944cb,
    0xa4e5cb3842f7488a
};

/// x86_64 four-level paging.
public using u64 PAGING_MODE_X86_64_4LVL = 0;

/// x86_64 five-level paging.
public using u64 PAGING_MODE_X86_64_5LVL = 1;

public using u64 PAGING_MODE_X86_64_MIN = PAGING_MODE_X86_64_4LVL;
public using u64 PAGING_MODE_X86_64_DEFAULT = PAGING_MODE_X86_64_4LVL;

/// AArch64 four-level paging.
public using u64 PAGING_MODE_AARCH64_4LVL = 0;

/// AArch64 five-level paging.
public using u64 PAGING_MODE_AARCH64_5LVL = 1;

public using u64 PAGING_MODE_AARCH64_MIN = PAGING_MODE_AARCH64_4LVL;
public using u64 PAGING_MODE_AARCH64_DEFAULT = PAGING_MODE_AARCH64_4LVL;

/// RISC-V Sv39 paging.
public using u64 PAGING_MODE_RISCV_SV39 = 0;

/// RISC-V Sv48 paging.
public using u64 PAGING_MODE_RISCV_SV48 = 1;

/// RISC-V Sv57 paging.
public using u64 PAGING_MODE_RISCV_SV57 = 2;

public using u64 PAGING_MODE_RISCV_MIN = PAGING_MODE_RISCV_SV39;
public using u64 PAGING_MODE_RISCV_DEFAULT = PAGING_MODE_RISCV_SV48;

/// LoongArch four-level paging.
public using u64 PAGING_MODE_LOONGARCH_4LVL = 0;

public using u64 PAGING_MODE_LOONGARCH_MIN = PAGING_MODE_LOONGARCH_4LVL;
public using u64 PAGING_MODE_LOONGARCH_DEFAULT = PAGING_MODE_LOONGARCH_4LVL;

/// response identifying the paging mode selected by the bootloader.
public struct PagingModeResponse {
    u64 revision;

    /// architecture-specific paging-mode value.
    u64 mode;
}

/// requests a paging mode within the supplied architecture-specific range.
public struct PagingModeRequest {
    u64[4] id;
    u64 revision;
    PagingModeResponse* response;

    /// preferred paging mode.
    u64 mode;

    /// highest paging mode the executable supports.
    u64 max_mode;

    /// lowest paging mode the executable supports.
    u64 min_mode;
}

//!
//! Multiprocessor
//!
//! Architecture-specific structures used by Limine to describe application
//! processors and their startup entry points.
//!

/// request identifier for multiprocessor information.
public using u64[4] MP_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x95a67b819a1b857e,
    0xa0b61b723b6a73e0
};

/// indicates that x86_64 MP information uses x2APIC IDs.
public using u32 MP_RESPONSE_X86_64_X2APIC = 1 << 0;

/// requests x2APIC operation for x86_64 MP startup.
public using u64 MP_REQUEST_X86_64_X2APIC = 1 << 0;

/// x86_64 processor descriptor returned by the MP feature.
public struct MpInfoX86_64 {
    u32 processor_id;
    u32 lapic_id;
    u64 reserved;

    /// entry point assigned by the executable to release this processor.
    GotoAddress goto_address;

    /// value made available to the target processor during startup.
    u64 extra_argument;
}

/// x86_64 multiprocessor response.
public struct MpResponseX86_64 {
    u64 revision;

    /// MP response flags.
    u32 flags;

    /// LAPIC ID of the bootstrap processor.
    u32 bsp_lapic_id;

    u64 cpu_count;
    MpInfoX86_64** cpus;
}

/// AArch64 processor descriptor returned by the MP feature.
public struct MpInfoAarch64 {
    u32 processor_id;
    u32 reserved1;

    /// MPIDR value identifying this processor.
    u64 mpidr;

    u64 reserved;
    GotoAddress goto_address;
    u64 extra_argument;
}

/// AArch64 multiprocessor response.
public struct MpResponseAarch64 {
    u64 revision;
    u32 flags;

    /// MPIDR value of the bootstrap processor.
    u64 bsp_mpidr;

    u64 cpu_count;
    MpInfoAarch64** cpus;
}

/// RISC-V processor descriptor returned by the MP feature.
public struct MpInfoRiscv64 {
    u64 processor_id;

    /// hardware thread identifier.
    u64 hartid;

    u64 reserved;
    GotoAddress goto_address;
    u64 extra_argument;
}

/// RISC-V multiprocessor response.
public struct MpResponseRiscv64 {
    u64 revision;
    u32 flags;

    /// Hart ID of the bootstrap processor.
    u64 bsp_hartid;

    u64 cpu_count;
    MpInfoRiscv64** cpus;
}

/// LoongArch64 processor descriptor returned by the MP feature.
public struct MpInfoLoongArch64 {
    u64 processor_id;

    /// architecture-specific physical processor identifier.
    u64 phys_id;

    u64 reserved;
    GotoAddress goto_address;
    u64 extra_argument;
}

/// LoongArch64 multiprocessor response.
public struct MpResponseLoongArch64 {
    u64 revision;
    u32 flags;

    /// physical identifier of the bootstrap processor.
    u64 bsp_phys_id;

    u64 cpu_count;
    MpInfoLoongArch64** cpus;
}

// TODO arch switches

/// canonical MP processor descriptor used by this binding.
///
/// this alias currently selects the x86_64 representation.
public using MpInfo = MpInfoX86_64;

/// canonical MP response used by this binding.
///
/// this alias currently selects the x86_64 representation.
public using MpResponse = MpResponseX86_64;

/// function pointer written to an MP processor's `goto_address` field.
///
/// assigning a non-null entry point releases the corresponding processor.
public using GotoAddress = void(*)(MpInfo*);

/// requests multiprocessor information.
public struct MpRequest {
    u64[4] id;
    u64 revision;
    MpResponse* response;

    /// architecture-specific MP request flags.
    u64 flags;
}

//!
//! Memory map
//!

/// request identifier for the bootloader memory map.
public using u64[4] MEMMAP_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x67cf3d9d378a806f,
    0xe304acdfc50c3c62
};

/// memory available for general use by the executable.
public using u64 MEMMAP_USABLE = 0;

/// reserved memory.
public using u64 MEMMAP_RESERVED = 1;

/// ACPI reclaimable memory.
public using u64 MEMMAP_ACPI_RECLAIMABLE = 2;

/// ACPI non-volatile storage.
public using u64 MEMMAP_ACPI_NVS = 3;

/// known-bad memory.
public using u64 MEMMAP_BAD_MEMORY = 4;

/// memory temporarily owned by the bootloader and reclaimable according to
/// the Limine protocol's lifetime rules.
public using u64 MEMMAP_BOOTLOADER_RECLAIMABLE = 5;

/// memory occupied by the executable and loaded modules.
public using u64 MEMMAP_EXECUTABLE_AND_MODULES = 6;

/// memory occupied by framebuffer storage.
public using u64 MEMMAP_FRAMEBUFFER = 7;

/// reserved memory that remains mapped.
public using u64 MEMMAP_RESERVED_MAPPED = 8;

/// one physical-memory range in the Limine memory map.
public struct MemmapEntry {
    /// physical base address of the range.
    u64 base;

    /// length of the range in bytes.
    u64 length;

    /// one of the `MEMMAP_*` memory type values.
    u64 type;
}

/// response containing the bootloader-provided physical memory map.
public struct MemmapResponse {
    u64 revision;

    /// number of entries in `entries`.
    u64 entry_count;

    MemmapEntry** entries;
}

/// requests the bootloader's physical memory map.
public struct MemmapRequest {
    u64[4] id;
    u64 revision;
    MemmapResponse* response;
}

//!
//! Entry point
//!

/// request identifier for overriding the executable entry point.
public using u64[4] ENTRY_POINT_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x13d86c035a1cd3e1,
    0x2b0caa89d8f3026a
};

/// executable entry-point function type.
public using EntryPoint = void(*)();

/// response indicating that the requested entry point was accepted.
public struct EntryPointResponse {
    u64 revision;
}

/// requests that Limine transfer control to a specific entry point.
public struct EntryPointRequest {
    u64[4] id;
    u64 revision;
    EntryPointResponse* response;

    /// entry point that Limine should invoke.
    EntryPoint entry;
}

//!
//! Executable file
//!

/// request identifier for the executable-file feature.
public using u64[4] EXECUTABLE_FILE_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0xad97e90e83f1ed67,
    0x31eb5d1c5ff23b69
};

/// response containing the file record for the currently running executable.
public struct ExecutableFileResponse {
    u64 revision;
    File* executable_file;
}

/// requests the file record for the currently running executable.
public struct ExecutableFileRequest {
    u64[4] id;
    u64 revision;
    ExecutableFileResponse* response;
}

//!
//! Modules
//!

/// request identifier for loaded modules.
public using u64[4] MODULE_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x3e7e279702be32af,
    0xca1c4f3bd1280cee
};

/// marks an internal module as required.
public using u64 INTERNAL_MODULE_REQUIRED = 1 << 0;

/// marks an internal module as compressed.
public using u64 INTERNAL_MODULE_COMPRESSED = 1 << 1;

/// module requested directly by the executable.
public struct InternalModule {
    /// limine resource path for the requested module.
    const char* path;

    /// string associated with the requested module.
    const char* string;

    /// combination of `INTERNAL_MODULE_*` flags.
    u64 flags;
}

/// response containing modules loaded for the executable.
public struct ModuleResponse {
    u64 revision;

    /// number of entries in `modules`.
    u64 module_count;

    File** modules;
}

/// requests modules loaded by the bootloader.
public struct ModuleRequest {
    u64[4] id;
    u64 revision;
    ModuleResponse* response;

    /// number of entries in `internal_modules`.
    ///
    /// available starting with module request revision 1.
    u64 internal_module_count;

    /// additional modules requested directly by the executable.
    ///
    /// available starting with module request revision 1.
    InternalModule** internal_modules;
}

