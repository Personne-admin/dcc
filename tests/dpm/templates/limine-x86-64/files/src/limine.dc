//!
//! Stack size
//!

/// request identifier for selecting the executable's initial stack size.
public using u64[4] STACK_SIZE_REQUEST_ID = {
    COMMON_MAGIC_0,
    COMMON_MAGIC_1,
    0x224ef0460a8e8926,
    0xe1cb0fc25f46ea3d
};

/// response indicating that the requested stack-size feature was processed.
public struct StackSizeResponse {
    u64 revision;
}

/// requests a particular initial stack size for the executable.
public struct StackSizeRequest {
    u64[4] id;
    u64 revision;
    StackSizeResponse* response;

    /// requested stack size in bytes.
