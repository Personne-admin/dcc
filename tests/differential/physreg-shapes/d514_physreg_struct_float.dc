module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

struct Mixed {
    u64 count;
    f64 gain;
    u64 code;
    f64 bias;
}

u64 g_a = 19;
f64 g_b = 5.5;
u64 g_c = 41;
f64 g_d = 6.75;

@noinline Mixed make_mixed(u64 count, f64 gain, u64 code, f64 bias) {
    Mixed mixed = {count = count + 1, gain = gain + 2.0, code = code + 3, bias = bias + 4.0};
    return mixed;
}

@noinline Mixed remix_mixed(Mixed mixed, u64 salt, f64 tune) {
    Mixed next = {
        count = mixed.count + salt,
        gain = mixed.gain * tune,
        code = mixed.code ^ salt,
        bias = mixed.bias - tune
    };

    return next;
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    u64 a = g_a;
    f64 b = g_b;
    u64 c = g_c;
    f64 d = g_d;
    Mixed first = make_mixed(a, b, c, d);
    Mixed second = remix_mixed(first, a + c, b + d);
    Mixed third = remix_mixed(second, c + 101, d + 0.5);
    print_u64(&out, a);
    print_u64(&out, f64bits(b));
    print_u64(&out, c);
    print_u64(&out, f64bits(d));
    print_u64(&out, first.count);
    print_u64(&out, f64bits(first.gain));
    print_u64(&out, first.code);
    print_u64(&out, f64bits(first.bias));
    print_u64(&out, second.count);
    print_u64(&out, f64bits(second.gain));
    print_u64(&out, second.code);
    print_u64(&out, f64bits(second.bias));
    print_u64(&out, third.count);
    print_u64(&out, f64bits(third.gain));
    print_u64(&out, third.code);
    print_u64(&out, f64bits(third.bias));
    return 0;
}
