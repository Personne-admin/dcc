module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

u64 g_a = 17;
f64 g_b = 3.25;
u64 g_c = 31;
f64 g_d = 4.75;
u64 g_e = 59;

@noinline f64 scale_one(f64 value) {
    return value * 1.5 + 0.25;
}

@noinline f64 scale_two(f64 value) {
    return value * 2.0 - 1.75;
}

@noinline u64 mix_floats(f64 x, f64 y, u64 z) {
    return (x as u64) + (y as u64) * 3 + z;
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    u64 a = g_a;
    f64 b = g_b;
    u64 c = g_c;
    f64 d = g_d;
    u64 e = g_e;
    f64 first = scale_one(b);
    f64 second = scale_two(d);
    f64 third = scale_one(first + second);
    u64 mixed = mix_floats(first, second, a + c + e);
    print_u64(&out, a);
    print_u64(&out, f64bits(b));
    print_u64(&out, c);
    print_u64(&out, f64bits(d));
    print_u64(&out, e);
    print_u64(&out, f64bits(first));
    print_u64(&out, f64bits(second));
    print_u64(&out, f64bits(third));
    print_u64(&out, mixed);
    return 0;
}
