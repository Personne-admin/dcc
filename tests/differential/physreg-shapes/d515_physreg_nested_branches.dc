module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

struct Pair {
    u64 first;
    u64 second;
}

u64 g_a = 23;
u64 g_b = 47;
u64 g_c = 71;
u64 g_d = 89;
f64 g_e = 7.25;

@noinline u64 select_add(u64 x, u64 y, u64 selector) {
    if selector % 2 == 0 {
        return x + y;
    }
    return x * 2 + y * 3;
}

@noinline Pair select_pair(u64 x, u64 y, u64 selector) {
    if selector % 3 == 0 {
        Pair selected = {first = x + y, second = x * y};
        return selected;
    }

    Pair selected = {first = x * 2, second = y * 3};
    return selected;
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    u64 a = g_a;
    u64 b = g_b;
    u64 c = g_c;
    u64 d = g_d;
    f64 e = g_e;
    u64 first = select_add(a, b, c);
    Pair pair = select_pair(first, d, c + 1);
    u64 second = select_add(pair.first, pair.second, d);
    Pair swapped = select_pair(second, first, a + b + c + d);
    print_u64(&out, a);
    print_u64(&out, b);
    print_u64(&out, c);
    print_u64(&out, d);
    print_u64(&out, f64bits(e));
    print_u64(&out, first);
    print_u64(&out, pair.first);
    print_u64(&out, pair.second);
    print_u64(&out, second);
    print_u64(&out, swapped.first);
    print_u64(&out, swapped.second);
    return 0;
}
