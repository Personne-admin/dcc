module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

struct Accumulator {
    u64 total;
    f64 weight;
    u64 signature;
    f64 audit;
}

u64 g_round = 5;
f64 g_factor = 1.125;

Accumulator leaf_mix(Accumulator state, u64 round) {
    Accumulator result = {
        total = state.total + round * 3,
        weight = state.weight * g_factor + (round as f64),
        signature = state.signature ^ (round * 287),
        audit = state.audit - (round as f64) * 0.25
    };

    return result;
}

Accumulator branch_mix(Accumulator state, u64 round) {
    Accumulator first = leaf_mix(state, round);
    Accumulator second = leaf_mix(first, round + 19);
    Accumulator result = {
        total = first.total + second.total,
        weight = first.weight + second.audit,
        signature = first.signature ^ second.signature,
        audit = first.audit + second.weight
    };

    return result;
}

Accumulator root_mix(Accumulator state, u64 round) {
    Accumulator first = branch_mix(state, round);
    Accumulator second = branch_mix(first, round + 101);
    Accumulator result = {
        total = first.total ^ second.signature,
        weight = first.weight + second.weight,
        signature = first.signature + second.total,
        audit = first.audit + second.audit
    };

    return result;
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    Accumulator acc = {total = g_round, weight = g_factor, signature = g_round ^ 3735928559, audit = g_factor * 8.0};

    u64 i = 0;
    while i < 8 {
        acc = root_mix(acc, g_round + i);
        print_u64(&out, acc.total);
        print_u64(&out, f64bits(acc.weight));
        print_u64(&out, acc.signature);
        print_u64(&out, f64bits(acc.audit));
        i = i + 1;
    }

    return 0;
}
