module main;

import std::os::file;
import std::os::error;
import std::result;

enum Opt(T) {
    Some(T),
    None,
}

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

u64 pick(u64 k, [] u64 arr) {
    Opt(u64) o = Opt::Some(k);
    Opt(u64) r = match o {
        Opt::Some(i) => Opt::Some(arr[i]),
        Opt::None => Opt::None,
    };

    return match r {
        Opt::Some(v) => v,
        Opt::None => 0xFFFFFFFFFFFFFFFF as u64,
    };
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    u64[6] arr = {5, 50, 500, 5000, 50000, 500000};
    print_u64(&out, pick(0, arr[0..6]));
    print_u64(&out, pick(3, arr[0..6]));
    print_u64(&out, pick(5, arr[0..6]));
    Opt(u64) n = Opt::None;
    print_u64(
        &out,
        match n {
            Opt::Some(v) => v,
            Opt::None => 0xDEAD as u64,
        }
    );

    return 0;
}
