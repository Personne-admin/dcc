module main;

import std::map;
import std::mem;
import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

struct Record {
    u64 key;
    f64 weight;
    u64 flags;
    f64 score;
}

Record make_record(u64 key) {
    Record record = {
        key = key,
        weight = (key as f64) * 1.75 + 0.5,
        flags = key ^ 3735928559,
        score = (key as f64) * -0.375 + 4.0
    };

    return record;
}

public i32 main() {
    u8[16384] backing;
    std::mem::FixedBuffer fb = std::mem::new_fixed_buffer(backing[0..16384]);
    std::mem::Allocator alloc = fb.allocator();
    std::os::file::File out = std::os::file::stdout();
    std::map::Map(u64, Record) entries = std::map::new_map(alloc);
    Record probe = make_record(1);
    u64 live_count = 0;
    f64 live_weight = probe.weight;
    usize i = 1;
    while i <= 48 {
        Record record = make_record((i * 7 + 3) as u64);
        if entries.put(record.key, record).is_err() {
            return 4;
        }
        live_count = live_count + record.key;
        live_weight = live_weight + record.score;
        i = i + 1;
    }

    Record seventh = entries.get(52).unwrap_some();
    Record replacement = {key = 52, weight = seventh.weight + 10.0, flags = seventh.flags ^ 65535, score = seventh.score * 2.0};
    if entries.put(52, replacement).is_err() {
        return 5;
    }

    Record* slot = entries.get_ptr(59).unwrap_some();
    slot.weight = slot.weight * 3.0;
    slot.score = slot.score - 1.5;
    if entries.remove(66).is_none() {
        return 6;
    }

    print_u64(&out, live_count);
    print_u64(&out, f64bits(live_weight));
    std::map::Iterator(u64, Record) cursor = entries.iterate();
    u64 iterated = 0;
    u64 key_total = 0;
    f64 weight_total = 0.0;
    u64 flag_total = 0;

    while true {
        std::result::Optional(std::map::Entry(u64, Record)) entry = cursor.next();
        if entry.is_none() {
            break;
        }

        std::map::Entry(u64, Record) current = entry.unwrap_some();
        iterated = iterated + 1;
        key_total = key_total + *current.key;
        weight_total = weight_total + (*current.value).weight;
        flag_total = flag_total ^ (*current.value).flags;
    }

    print_u64(&out, iterated);
    print_u64(&out, key_total);
    print_u64(&out, f64bits(weight_total));
    print_u64(&out, flag_total);
    return 0;
}
