module main;

import std::map;
import std::mem;
import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

struct Record {
    u64 key;
    f64 weight;
    u64 flags;
    f64 score;
}

Record make_record(u64 key) {
    Record record = {
        key = key,
        weight = (key as f64) * 2.25 - 1.5,
        flags = key * 3 + 17,
        score = (key as f64) * 0.75 + 2.0
    };

    return record;
}

public i32 main() {
    u8[16384] backing;
    std::mem::FixedBuffer fb = std::mem::new_fixed_buffer(backing[0..16384]);
    std::mem::Allocator alloc = fb.allocator();
    std::os::file::File out = std::os::file::stdout();
    std::map::Map(u64, Record) entries = std::map::new_map(alloc);

    usize i = 1;
    while i <= 20 {
        if entries.put((i * 3) as u64, make_record((i * 3) as u64)).is_err() {
            return 4;
        }

        i = i + 1;
    }

    Record* ninth = entries.get_ptr(27).unwrap_some();
    print_u64(&out, ninth.key);
    print_u64(&out, f64bits(ninth.weight));
    ninth.score = ninth.score + 100.0;

    usize j = 21;
    while j <= 80 {
        if entries.put((j * 3) as u64, make_record((j * 3) as u64)).is_err() {
            return 5;
        }

        j = j + 1;
    }

    Record refreshed = entries.get(27).unwrap_some();
    print_u64(&out, refreshed.key);
    print_u64(&out, f64bits(refreshed.weight));
    print_u64(&out, f64bits(refreshed.score));
    if entries.remove(33).is_none() {
        return 6;
    }

    if entries.remove(213).is_none() {
        return 7;
    }

    print_u64(&out, entries.get(33).is_none() as u64);
    print_u64(&out, entries.get(213).is_none() as u64);
    return 0;
}
