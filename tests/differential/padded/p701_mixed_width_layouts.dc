module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

union F32Bits {
    f32 f;
    u32 u;
}

u64 f32bits(f32 x) {
    F32Bits b = {f = x};
    return b.u as u64;
}

struct A {
    u8 x;
    u8 y;
    u64 z;
}

struct B {
    u8 x;
    u64 y;
    u8 z;
}

struct C {
    u16 x;
    u32 y;
    u8 z;
}

struct D {
    u32 x;
    u8 y;
    u16 z;
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    A a = {x = 1, y = 2, z = 3};
    print_u64(&out, a.x as u64);
    print_u64(&out, a.y as u64);
    print_u64(&out, a.z);
    B b = {x = 4, y = 5, z = 6};
    print_u64(&out, b.x as u64);
    print_u64(&out, b.y);
    print_u64(&out, b.z as u64);
    C c = {x = 7, y = 8, z = 9};
    print_u64(&out, c.x as u64);
    print_u64(&out, c.y as u64);
    print_u64(&out, c.z as u64);
    D d = {x = 10, y = 11, z = 12};
    print_u64(&out, d.x as u64);
    print_u64(&out, d.y as u64);
    print_u64(&out, d.z as u64);
    return 0;
}
