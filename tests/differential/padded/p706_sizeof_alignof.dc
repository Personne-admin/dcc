module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

union F32Bits {
    f32 f;
    u32 u;
}

u64 f32bits(f32 x) {
    F32Bits b = {f = x};
    return b.u as u64;
}

struct A {
    u8 x;
    u8 y;
    u64 z;
}

struct B {
    u8 x;
    u64 y;
    u8 z;
}

struct C {
    u16 x;
    u32 y;
    u8 z;
}

struct Fa {
    u8 tag;
    f64 value;
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    print_u64(&out, sizeof (A) as u64);
    print_u64(&out, alignof (A) as u64);
    print_u64(&out, sizeof (B) as u64);
    print_u64(&out, alignof (B) as u64);
    print_u64(&out, sizeof (C) as u64);
    print_u64(&out, alignof (C) as u64);
    print_u64(&out, sizeof (Fa) as u64);
    print_u64(&out, alignof (Fa) as u64);
    print_u64(&out, sizeof (u8) as u64);
    print_u64(&out, sizeof (u64) as u64);
    return 0;
}
