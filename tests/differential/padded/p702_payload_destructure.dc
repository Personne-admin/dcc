module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

union F32Bits {
    f32 f;
    u32 u;
}

u64 f32bits(f32 x) {
    F32Bits b = {f = x};
    return b.u as u64;
}

struct Pad {
    u8 a;
    u8 b;
    u64 c;
}

struct Narrow {
    u8 x;
    u64 y;
    u8 z;
}

struct Out {
    u64 x0;
    u64 x1;
    u64 x2;
}

enum Shape {
    Rec(Pad), Thin(Narrow), Point,
}

Out vals_of(Shape s) {
    return match s {
        Shape::Rec(Pad { a, b, c }) => {x0 = a as u64, x1 = b as u64, x2 = c},
        Shape::Thin(Narrow { x, y, z }) => {x0 = x as u64, x1 = y, x2 = z as u64},
        Shape::Point => {x0 = 0, x1 = 0, x2 = 0},
    };
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    Out v = vals_of(Shape::Rec({1, 2, 3}));
    print_u64(&out, v.x0);
    print_u64(&out, v.x1);
    print_u64(&out, v.x2);
    Out w = vals_of(Shape::Thin({4, 5, 6}));
    print_u64(&out, w.x0);
    print_u64(&out, w.x1);
    print_u64(&out, w.x2);
    Out q = vals_of(Shape::Point);
    print_u64(&out, q.x0 + q.x1 + q.x2);
    return 0;
}
