module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

u64 g_seed = 2027;
f64 g_first = 1.125;
f64 g_second = 2.625;
f64 g_third = 4.125;

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    f64 common = (g_first + g_second) * g_third;
    f64 acc = 0.0;

    u64 i = 0;
    while i < 16 {
        f64 first = common + (i as f64) * 0.5;
        f64 second = common * 1.25 - (i as f64);
        f64 third = (g_first + g_second) * g_third + (i as f64) * 1.5;
        acc = acc + first + second + third;
        print_u64(&out, f64bits(first));
        print_u64(&out, f64bits(second));
        print_u64(&out, f64bits(third));
        print_u64(&out, f64bits(acc));
        i = i + 1;
    }

    print_u64(&out, g_seed + i);
    return 0;
}
