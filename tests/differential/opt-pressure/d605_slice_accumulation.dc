module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

u64 g_seed = 3037;

u64 fold_prefix([] u64 values, usize count) {
    u64 folded = 0;
    usize i = 0;
    while i < count {
        folded = folded * 33 + values[i] + (i as u64);
        i = i + 1;
    }

    return folded;
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    u64[16] lanes = {3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 7, 9, 3};
    u64 total = 0;
    usize i = 0;
    while i <= 16 {
        u64 prefix = fold_prefix(lanes[0..16], i);
        total = total + prefix + g_seed;
        print_u64(&out, prefix);
        print_u64(&out, total);
        i = i + 4;
    }
    return 0;
}
