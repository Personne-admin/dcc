module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

import std::map;
import std::mem;

public i32 main() {
    u8[8192] backing;
    std::mem::FixedBuffer fb = std::mem::new_fixed_buffer(backing[0..8192]);
    std::mem::Allocator a = fb.allocator();
    std::os::file::File out = std::os::file::stdout();
    std::map::Map(u64, u64) m = std::map::new_map(a);

    u64 i = 0;
    while i < 20 {
        if m.put(i, i + 1).is_err() {
            return 4;
        }

        if i >= 3 {
            u64 got = m.get(i - 2).unwrap_some();
            print_u64(&out, got);
        }

        if i == 6 {
            u64 missing = m.get(999).unwrap_some();
            print_u64(&out, missing);
        }

        i = i + 1;
    }

    return 0;
}
