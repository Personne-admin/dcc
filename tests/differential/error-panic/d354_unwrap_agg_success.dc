module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

struct Big {
    u64 a;
    f64 f;
    u64 b;
}

Result(Big, u64) ok_big(u64 x) {
    Big b = {a = x * 11 + 3, f = (x as f64) * 1.25, b = x * 13 + 5};
    return Result::Ok(b);
}

Result(u64, Big) err_big(u64 x) {
    Big b = {a = x * 17 + 7, f = (x as f64) * -0.5, b = x * 19 + 9};
    return Result::Err(b);
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();

    u64 i = 0;
    while i < 10 {
        Result(Big, u64) r = ok_big(i);
        Big b = r.unwrap();
        print_u64(&out, b.a);
        print_u64(&out, f64bits(b.f));
        print_u64(&out, b.b);
        Result(u64, Big) r2 = err_big(i);
        Big e = r2.unwrap_err();
        print_u64(&out, e.a);
        print_u64(&out, f64bits(e.f));
        print_u64(&out, e.b);
        i = i + 1;
    }

    return 0;
}
