module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

struct Mixed {
    u64 a;
    f64 f;
    u32 b;
    u32 c;
}

Mixed mk(u64 x, f64 g) {
    Mixed m = {a = x, f = g, b = (x & 0xffffffff) as u32, c = ((x >> 4) & 0xffffffff) as u32};
    return m;
}

Optional(Mixed) pick(u64 i) {
    if i % 5 == 3 {
        return Optional::None;
    }

    return Optional::Some(mk(i * 3 + 1, (i as f64) * 1.5));
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    Mixed acc = {a = 0, f = 0.0, b = 0, c = 0};

    u64 i = 0;
    while i < 20 {
        Optional(Mixed) o = pick(i);
        match o {
            Optional::Some(m) => {
                acc.a += m.a;
                acc.f += m.f;
                acc.b += m.b;
                acc.c += m.c;
            },
            Optional::None => {
                acc.a += 7;
                acc.f += 0.25;
                acc.b += 1;
                acc.c += 2;
            },
        }

        print_u64(&out, acc.a);
        print_u64(&out, f64bits(acc.f));
        print_u64(&out, acc.b as u64);
        print_u64(&out, acc.c as u64);
        i = i + 1;
    }

    return 0;
}
