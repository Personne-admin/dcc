module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

struct Acc {
    u64 sum;
    u64 ok;
    u64 err;
    u64 last;
}

Result(u64, u64) compute(u64 x) {
    if x % 3 == 0 {
        return Result::Err(1000 + x);
    }

    return Result::Ok(x * x + 1);
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    Acc acc = {sum = 0, ok = 0, err = 0, last = 0};

    u64 i = 0;
    while i < 12 {
        Result(u64, u64) r = compute(i);
        match r {
            Result::Ok(v) => {
                acc.sum += v;
                acc.ok += 1;
                acc.last = v;
            },
            Result::Err(e) => {
                acc.sum += e;
                acc.err += 1;
                acc.last = e;
            },
        }

        print_u64(&out, acc.sum);
        print_u64(&out, acc.last);
        i = i + 1;
    }

    print_u64(&out, acc.ok);
    print_u64(&out, acc.err);
    return 0;
}
