module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

u64 g_side = 0;

Result(u64, u64) fail() {
    return Result::Err(0x99);
}

Optional(u64) pick(u64 i) {
    if i % 3 == 2 {
        return Optional::None;
    }

    return Optional::Some(i * 5 + 1);
}

Result(u64, u64) process(u64 n) {
    defer g_side = g_side + 1;
    u64 acc = 0;

    u64 i = 0;
    while i < n {
        Optional(u64) o = pick(i);
        u64 v = match o {
            Optional::Some(x) => x,
            Optional::None => fail() ?,
        };

        acc = acc + v;
        i = i + 1;
    }

    return Result::Ok(acc);
}

void report(std::os::file::File* out, Result(u64, u64) r) {
    match r {
        Result::Ok(v) => print_u64(out, v),
        Result::Err(e) => print_u64(out, 0xF00D0000 + e),
    }
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    g_side = 0;
    report(&out, process(2));
    print_u64(&out, g_side);
    g_side = 0;
    report(&out, process(8));
    print_u64(&out, g_side);
    return 0;
}
