module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

struct Bag {
    u64 total;
    u64 hits;
    u64 misses;
}

Optional(u64) pick(u64 x) {
    if x % 4 == 1 {
        return Optional::None;
    }

    return Optional::Some(x * 7 + 3);
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    Bag b = {total = 0, hits = 0, misses = 0};

    u64 i = 0;
    while i < 16 {
        Optional(u64) o = pick(i);
        match o {
            Optional::Some(v) => {
                b.total += v;
                b.hits += 1;
            },
            Optional::None => {
                b.total += 100000;
                b.misses += 1;
            },
        }
        print_u64(&out, b.total);
        print_u64(&out, b.hits);
        print_u64(&out, b.misses);
        i = i + 1;
    }

    return 0;
}
