module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

struct Big {
    u64 a;
    u64 b;
    f64 f;
    f64 g;
}

Big bmk(u64 x) {
    Big b = {a = x * 2, b = x * 3, f = (x as f64) * 0.5, g = (x as f64) * 0.25};
    return b;
}

Result(Big, u64) lvl3(u64 x) {
    if x == 0 {
        return Result::Err(0x31);
    }

    return Result::Ok(bmk(x));
}

Result(Big, u64) lvl2(u64 x) {
    Big b = lvl3(x) ?;
    Big c = {a = b.a + 1, b = b.b + 2, f = b.f + 0.125, g = b.g + 0.0625};
    return Result::Ok(c);
}

Result(Big, u64) lvl1(u64 x) {
    Big p = lvl2(x) ?;
    Big q = lvl2(x + 10) ?;
    Big d = {a = p.a + q.a, b = p.b + q.b, f = p.f + q.f, g = p.g + q.g};
    return Result::Ok(d);
}

void report(std::os::file::File* out, Result(Big, u64) r) {
    match r {
        Result::Ok(b) => {
            print_u64(out, b.a);
            print_u64(out, b.b);
            print_u64(out, f64bits(b.f));
            print_u64(out, f64bits(b.g));
        },
        Result::Err(e) => print_u64(out, 0xDEAD0000 + e),
    }
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    report(&out, lvl1(2));
    report(&out, lvl1(0));
    report(&out, lvl1(7));
    return 0;
}
