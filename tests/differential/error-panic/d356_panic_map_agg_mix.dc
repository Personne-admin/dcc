module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

import std::map;
import std::mem;
import std::debug;

struct Rec {
    u64 key;
    f64 weight;
    u64 hits;
}

Rec mkrec(u64 k) {
    Rec r = {key = k, weight = (k as f64) * 0.5, hits = k * 2 + 1};
    return r;
}

public i32 main() {
    u8[8192] backing;
    std::mem::FixedBuffer fb = std::mem::new_fixed_buffer(backing[0..8192]);
    std::mem::Allocator a = fb.allocator();
    std::os::file::File out = std::os::file::stdout();
    std::map::Map(u64, Rec) m = std::map::new_map(a);

    u64 i = 0;
    while i < 16 {
        Rec rec = mkrec(i);
        if m.put(i, rec).is_err() {
            return 4;
        }

        Rec got = m.get(i).unwrap_some();
        print_u64(&out, got.key);
        print_u64(&out, f64bits(got.weight));
        print_u64(&out, got.hits);
        if i == 7 {
            std::debug::assert(got.hits == 0x9999, "map agg self-check failed");
        }

        i = i + 1;
    }

    return 0;
}
