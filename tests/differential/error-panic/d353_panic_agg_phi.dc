module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

union F64Bits {
    f64 f;
    u64 u;
}

u64 f64bits(f64 x) {
    F64Bits b = {f = x};
    return b.u;
}

import std::debug;

struct Node {
    u64 id;
    u64 sum;
    f64 weight;
    u64 count;
}

Node step(Node n, u64 i) {
    Node r = {
        id = n.id * 2 + 1,
        sum = n.sum + i * i,
        weight = n.weight + (i as f64) * 0.5,
        count = n.count + 1,
    };

    return r;
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    Node n = {id = 1, sum = 0, weight = 0.0, count = 0};

    u64 i = 0;
    while i < 14 {
        n = step(n, i);
        print_u64(&out, n.id);
        print_u64(&out, n.sum);
        print_u64(&out, f64bits(n.weight));
        print_u64(&out, n.count);
        if i == 10 {
            std::debug::panic("agg phi panic");
        }

        i = i + 1;
    }

    return 0;
}
