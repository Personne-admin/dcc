module main;

import std::os::file;
import std::os::error;
import std::result;

void print_u64(std::os::file::File* out, u64 v) {
    u8[17] buf;
    u64 i = 0;
    while i < 16 {
        u64 sh = (15 - i) * 4;
        u8 nib = ((v >> sh) & 0xF) as u8;
        if nib < 10 {
            buf[i] = 0x30 + nib;
        } else {
            buf[i] = 0x61 + nib - 10;
        }

        i = i + 1;
    }

    buf[16] = 0x0a;
    out.write_all(buf[0..17]);
}

public i32 main() {
    std::os::file::File out = std::os::file::stdout();
    print_u64(&out, 0xCCCC);
    Result(u64, u64) r = Result::Err(0x5678);
    u64 v = r.unwrap();
    print_u64(&out, v);
    return 0;
}
