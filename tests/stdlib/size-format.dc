module main;
import std::mem;
import std::fmt;
import std::sha;
import std::sort;
import std::slice;
import std::result;
using std::{mem, fmt, sha, sort, slice};
@nomangle public i32 dcc_main() {
    usize max = (~(0 as usize));
    fmt::CountingWriter counter = fmt::new_counting_writer();
    counter.count = max;
    fmt::Writer count = counter.writer();
    if count.write_all("a").unwrap_err() != fmt::FmtError::BadFormat || counter.count != max { return 1; }
    char[16] output = {};
    fmt::BufferWriter buffer = fmt::new_buffer_writer(output[0..16]);
    buffer.written = 1;
    fmt::Writer w = buffer.writer();
    []const char fake = slice::from_raw_const(&output[0] as const char*, max);
    if w.write_all(fake).is_ok() || buffer.written != 1 || !buffer.overflowed { return 2; }
    buffer = fmt::new_buffer_writer(output[0..16]);
    w = buffer.writer();
    if fmt::format(&w, "{:18446744073709551616}", 1 as u16).unwrap_err() != fmt::FmtError::BadFormat { return 3; }
    if fmt::format(&w, "{:.18446744073709551616}", 1 as u16).unwrap_err() != fmt::FmtError::BadFormat { return 4; }
    if fmt::default_options().precision != fmt::NO_PRECISION { return 5; }
    if !fmt::format(&w, "{}", 123 as u16).is_ok() || buffer.written != 3 { return 6; }
    usize huge_len = max / 2 + 1;
    u8[1] digest = {0xAB};
    if sha::hex_encode(slice::from_raw_const!u8(&digest[0] as const u8*, huge_len), output[0..16]).is_ok() { return 7; }
    if !sha::hex_encode(digest[0..1] as []const u8, output[0..2]).is_ok() || output[0] != 'a' || output[1] != 'b' { return 8; }
    u16[9] values = {9, 2, 8, 3, 7, 1, 6, 4, 5};
    u16[9] scratch = {};
    sort::sort_stable_by(values[0..9], scratch[0..9], sort::compare_default!u16);
    for usize i = 0; i < 9; i++ { if values[i] != ((i + 1) as u16) { return 9; } }
    sort::heap_sort_by(values[0..9], sort::compare_default!u16);
    for usize i = 0; i < 9; i++ { if values[i] != ((i + 1) as u16) { return 10; } }
    return 0;
}
public i32 main() { return dcc_main(); }
