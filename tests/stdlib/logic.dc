i32 lexical_paths() {
    if !(same(path::basename(""), "")) {
        return 102;
    }
    if !(same(path::dirname(""), "")) {
        return 103;
    }
    if !(same(path::extension(""), "")) {
        return 104;
    }
    if !(same(path::basename("/"), "")) {
        return 105;
    }
    if !(same(path::dirname("/"), "")) {
        return 106;
    }
    if !(same(path::extension("/"), "")) {
        return 107;
    }
    if !(same(path::basename("///"), "")) {
        return 108;
    }
    if !(same(path::dirname("///"), "")) {
        return 109;
    }
    if !(same(path::extension("///"), "")) {
        return 110;
    }
    if !(same(path::basename("a"), "a")) {
        return 111;
    }
    if !(same(path::dirname("a"), "")) {
        return 112;
    }
    if !(same(path::extension("a"), "")) {
        return 113;
    }
    if !(same(path::basename("/a"), "a")) {
        return 114;
    }
    if !(same(path::dirname("/a"), "/")) {
        return 115;
    }
    if !(same(path::extension("/a"), "")) {
        return 116;
    }
    if !(same(path::basename("/a/"), "a")) {
        return 117;
    }
    if !(same(path::dirname("/a/"), "/")) {
        return 118;
    }
    if !(same(path::extension("/a/"), "")) {
        return 119;
    }
    if !(same(path::basename("/a///"), "a")) {
        return 120;
    }
    if !(same(path::dirname("/a///"), "/")) {
        return 121;
    }
    if !(same(path::extension("/a///"), "")) {
        return 122;
    }
    if !(same(path::basename("a/b"), "b")) {
        return 123;
    }
    if !(same(path::dirname("a/b"), "a")) {
        return 124;
    }
    if !(same(path::extension("a/b"), "")) {
        return 125;
    }
    if !(same(path::basename("a//b///"), "b")) {
        return 126;
    }
    if !(same(path::dirname("a//b///"), "a")) {
        return 127;
    }
    if !(same(path::extension("a//b///"), "")) {
        return 128;
    }
    if !(same(path::basename(".bashrc"), ".bashrc")) {
        return 129;
    }
    if !(same(path::dirname(".bashrc"), "")) {
        return 130;
    }
    if !(same(path::extension(".bashrc"), "")) {
        return 131;
    }
    if !(same(path::basename(".."), "..")) {
        return 132;
    }
    if !(same(path::dirname(".."), "")) {
        return 133;
    }
    if !(same(path::extension(".."), ".")) {
        return 134;
    }
    if !(same(path::basename("...foo"), "...foo")) {
        return 135;
    }
    if !(same(path::dirname("...foo"), "")) {
        return 136;
    }
    if !(same(path::extension("...foo"), ".foo")) {
        return 137;
    }
    if !(same(path::basename("a.b.c"), "a.b.c")) {
        return 138;
    }
    if !(same(path::dirname("a.b.c"), "")) {
        return 139;
    }
    if !(same(path::extension("a.b.c"), ".c")) {
        return 140;
    }
    if !(same(path::basename("a."), "a.")) {
        return 141;
    }
    if !(same(path::dirname("a."), "")) {
        return 142;
    }
    if !(same(path::extension("a."), ".")) {
        return 143;
    }
    if !(same(path::basename("a/.hidden"), ".hidden")) {
        return 144;
    }
    if !(same(path::dirname("a/.hidden"), "a")) {
        return 145;
    }
    if !(same(path::extension("a/.hidden"), "")) {
        return 146;
    }
    if error::from_win32(131) != Error::InvalidArgument {
        return 237;
    }
    if error::from_syscall(-13) != Error::AccessDenied || error::from_syscall(
        -4095
    ) != Error::Unexpected {
        return 237;
    }

    bool separators_ok = false;
    static if core::target::OS == core::target::Os::Windows {
        separators_ok = path::separator() == 92 && path::is_separator(92) && same(
            path::basename("C:\\a\\b"),
            "b"
        );
    } else {
        separators_ok = path::separator() == 47 && !path::is_separator(92);
    }

    if !separators_ok {
        return 241;
    }

    if !path::is_separator(47) || path::is_separator(65) {
        return 242;
    }

    return 0;
}

i32 path_encodings() {
    if sizeof (path::PathZ) != path::MAX_BYTES + 8
        || sizeof (path::PathW) != path::MAX_WIDE * 2 + 8
    {
        return 240;
    }

    if !same(error::name(65535 as Error), "Unexpected") {
        return 239;
    }

    path::PathZ z;
    path::PathW w;
    u8[10] utf = {65, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80};
    if !path::to_pathz(utf, &z).is_ok() || z.len != 10 || z.bytes[10] != 0 || !same(
        z.bytes[0..10],
        utf
    ) {
        return 243;
    }

    // U+1F600 - 0x10000 = 0xF600; high=0xD800+0x3D, low=0xDC00+0x200.
    if !path::to_pathw(utf, &w).is_ok()
        || w.len != 5
        || w.units[0] != 65
        || w.units[1] != 233
        || w.units[2] != 8364
        || w.units[3] != 0xD83D
        || w.units[4] != 0xDE00
        || w.units[5] != 0
    {
        return 244;
    }

    if !path::to_pathw("", &w).is_ok() || w.len != 0 || w.units[0] != 0 {
        return 245;
    }

    if !path::to_pathz("", &z).is_ok() || z.len != 0 || z.bytes[0] != 0 {
        return 245;
    }

    u8[4097] boundary;
    std::mem::set(boundary[0..4097], 65 as u8);
    if !path::to_pathz(boundary[0..4095], &z).is_ok()
        || z.len != 4095
        || z.bytes[4095] != 0
    {
        return 246;
    }

    if path::to_pathz(boundary[0..4096], &z).unwrap_err() != Error::NameTooLong || path::to_pathz(
        boundary,
        &z
    ).unwrap_err() != Error::NameTooLong {
        return 247;
    }

    if !path::to_pathw(boundary[0..4095], &w).is_ok()
        || w.len != 4095
        || w.units[4095] != 0
    {
        return 248;
    }

    if path::to_pathw(boundary[0..4096], &w).unwrap_err() != Error::NameTooLong || path::to_pathw(
        boundary,
        &w
    ).unwrap_err() != Error::NameTooLong {
        return 249;
    }

    boundary[4091] = 0xF0;
    boundary[4092] = 0x9F;
    boundary[4093] = 0x98;
    boundary[4094] = 0x80;
    if !path::to_pathw(boundary[0..4097], &w).is_ok()
        || w.len != 4095
        || w.units[4095] != 0
    {
        return 250;
    }

    boundary[4091] = 65;
    boundary[4092] = 0xF0;
    boundary[4093] = 0x9F;
    boundary[4094] = 0x98;
    boundary[4095] = 0x80;
    if !path::to_pathw(boundary[0..4097], &w).is_ok() || w.len != 4095 {
        return 250;
    }

    u8[4098] wider;
    std::mem::set(wider[0..4098], 65 as u8);
    wider[4092] = 0xF0;
    wider[4093] = 0x9F;
    wider[4094] = 0x98;
    wider[4095] = 0x80;
    if path::to_pathw(wider, &w).unwrap_err() != Error::NameTooLong {
        return 250;
    }

    u8[1] continuation = { 0x80 };
    u8[2] overlong = {0xC0, 0xAF};
    u8[2] truncated = {0xE2, 0x82};
    u8[4] too_large = {0xF4, 0x90, 0x80, 0x80};
    if path::to_pathw(continuation, &w).unwrap_err() != Error::InvalidArgument || path::to_pathw(
        overlong,
        &w
    ).unwrap_err() != Error::InvalidArgument || path::to_pathw(
        truncated,
        &w
    ).unwrap_err() != Error::InvalidArgument || path::to_pathw(
        too_large,
        &w
    ).unwrap_err() != Error::InvalidArgument {
        return 251;
    }

    u8[3] bad = {0xED, 0xA0, 0x80};
    if path::to_pathw(bad, &w).unwrap_err() != Error::InvalidArgument {
        return 251;
    }
    return 0;
}

i32 abi_arithmetic() {
    if !linux::abi::is_error(-1) || !linux::abi::is_error(-4095) || linux::abi::is_error(
        -4096
    ) || linux::abi::is_error(
        0
    ) || linux::abi::is_error(
        7
    ) {
        return 252;
    }

    if linux::abi::errno_of(-1) != 1 || linux::abi::errno_of(-4095) != 4095 {
        return 252;
    }

    // errno_of explicitly has no contract for successes or -4096.
    if win::abi::succeeded(0) || !win::abi::succeeded(1) || !win::abi::succeeded(
        -1
    ) {
        return 253;
    }

    if sizeof (linux::abi::Stat) != 144
        || offsetof (linux::abi::Stat, size) != 48
    {
        return 238;
    }

    if sizeof (win::abi::FileTime) != 8
        || sizeof (win::abi::SecurityAttributes) != 24
        || sizeof (win::abi::Overlapped) != 32
        || sizeof (win::abi::SystemInfo) != 48
    {
        return 238;
    }

    if sizeof (win::abi::ByHandleFileInformation) != 52
        || offsetof (win::abi::ByHandleFileInformation, volume_serial_number) != 28
    {
        return 238;
    }

    if sizeof (linux::abi::SockaddrIn) != 16
        || sizeof (linux::abi::SockaddrIn6) != 28
        || sizeof (win::abi::SockaddrIn) != 16
        || sizeof (win::abi::SockaddrIn6) != 28
        || sizeof (win::abi::Wsadata) != 408
        || sizeof (win::abi::AddrInfoW) != 48
        || sizeof (win::abi::Win32FindDataW) != 592
        || sizeof (win::abi::StartupInfoW) != 104
        || sizeof (win::abi::ProcessInformation) != 24
        || sizeof (win::abi::SrwLock) != 8
        || sizeof (win::abi::ConditionVariable) != 8
        || sizeof (win::abi::InitOnce) != 8
        || sizeof (dir::Iterator) != 17016
    {
        return 339;
    }

    win::abi::FileTime ft = {low = 0xD53E8000, high = 0x019DB1DE};
    if win::abi::filetime_ticks(&ft) != win::abi::FILETIME_UNIX_EPOCH {
        return 254;
    }

    ft.low = ft.low + 10000000;
    if (win::abi::filetime_ticks(&ft) - win::abi::FILETIME_UNIX_EPOCH) * 100 != 1000000000 {
        return 254;
    }

    return 0;
}

public i32 main() {
    i32 code = error_mappings();
    if code != 0 {
        return code;
    }
    code = lexical_paths();
    if code != 0 {
        return code;
    }
    code = path_encodings();
    if code != 0 {
        return code;
    }
    return abi_arithmetic();
}
