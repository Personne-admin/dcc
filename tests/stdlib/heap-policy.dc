module main;
import core::slice;
import std::os::heap;
import std::alloc;
import std::array;
import std::error;
import std::sys::linux::abi;
import std::sys::linux::syscall;
using std::os::heap::Heap;
using std::alloc::AllocError;

Status(Error) fail_allocation(Heap* heap) {
    heap.allocate(~(0 as usize), 8)?;
    return Status::Ok;
}

public i32 main() {
    if sizeof(Heap) != 0 { return 2; }
    Heap heap = {};
    [] u8 empty = heap.allocate(0, 1).unwrap();
    if empty.len != 0 || empty.ptr != null { return 3; }
    heap.free(empty, 1);
    if !heap.resize_in_place(empty, 0, 1) || heap.resize_in_place(empty, 1, 1) { return 4; }
    if heap.allocate(1, 3).unwrap_err() != AllocError::InvalidAlignment { return 5; }
    if heap.allocate(1, std::os::heap::page_size()*2).unwrap_err() != AllocError::InvalidAlignment { return 6; }
    for usize alignment = 1; alignment <= std::os::heap::page_size(); alignment *= 2 {
        [] u8 block = heap.allocate(37, alignment).unwrap();
        if block.len != 37 || (block.ptr as usize) % alignment != 0 { return 7; }
        for usize i=0; i<block.len; i++ { block[i]=i as u8; }
        heap.free(block, alignment);
    }
    [] u8 small = heap.allocate(13, 8).unwrap();
    for usize i=0; i<small.len; i++ { small[i]=(i+5) as u8; }
    if !heap.resize_in_place(small, 67, 8) { return 8; }
    small = core::slice::from_raw(small.ptr, 67);
    for usize i=0; i<13; i++ { if small[i] != (i+5) as u8 { return 9; } }
    if heap.resize_in_place(small, 0, 8) { return 10; }
    [] u8 large = heap.reallocate(small, std::os::heap::page_size()*3+17, 8).unwrap();
    for usize i=0; i<13; i++ { if large[i] != (i+5) as u8 { return 11; } }
    if large.len != std::os::heap::page_size()*3+17 { return 12; }
    if !heap.resize_in_place(large, std::os::heap::page_size()+3, 8) { return 20; }
    if !std::sys::linux::abi::is_error(std::sys::linux::syscall::mprotect((large.ptr as usize)+std::os::heap::page_size()*2, std::os::heap::page_size(), std::sys::linux::abi::PROT_READ)) { return 21; }
    large = core::slice::from_raw(large.ptr, std::os::heap::page_size()+3);
    for usize i=0; i<13; i++ { if large[i] != (i+5) as u8 { return 22; } }
    large[large.len-1]=99;
    if heap.reallocate(large, ~(0 as usize), 8).is_ok() || large[large.len-1] != 99 { return 13; }
    heap.free(large, 8);
    Error failure = fail_allocation(&heap).unwrap_err();
    match failure { Error::Allocation(e) => { if e != AllocError::OutOfMemory { return 14; } }, _ => return 15, }
    for usize cycle=0; cycle<100; cycle++ {
        std::array::Array(i32) values={};
        for i32 i=0; i<1000; i++ { if !values.push(i).is_ok() { return 16; } }
        i32 sum=0;
        for value in values.items() { sum+=value; }
        if sum!=499500 { return 17; }
        usize address=values.items().ptr as usize;
        values.deinit();
        if values.len()!=0 || values.capacity()!=0 { return 18; }
        if !std::sys::linux::abi::is_error(std::sys::linux::syscall::mprotect(address, std::os::heap::page_size(), std::sys::linux::abi::PROT_READ)) { return 19; }
    }
    return 0;
}
