module main;

import core::target;
import std::os::process;
import std::os::file;
import std::os::error;
import std::os::path;
import std::mem;
import std::slice;
import std::result;

using std::os::{ process, file, error, path };
using std::{ mem, slice, result };
using error::Error;

bool same([] const char a, [] const char b) {
    return mem::equal(a, b);
}

i32 test_vars_iterate() {
    if process::MAX_ENV_ENTRY != 4096 {
        return 10;
    }
    process::Vars it = process::vars();
    defer process::close(&it);
    usize count = 0;
    bool saw_nonempty_value = false;
    while true {
        result::Optional(process::Var) o = process::next(&it);
        if o.is_none() {
            break;
        }
        process::Var v = o.unwrap_some();
        if v.name.len == 0 {
            return 11;
        }
        // names must not contain '=' or NUL
        for usize i = 0; i < v.name.len; i++ {
            if v.name[i] == '=' as char || v.name[i] == '\0' {
                return 12;
            }
        }
        count++;
        if v.value.len > 1 {
            saw_nonempty_value = true;
        }
        if count > 100000 {
            return 13;
        }
    }
    if count == 0 {
        return 14;
    }
    // every vars() must be closed; double close is safe
    process::close(&it);
    process::close(&it);
    // saw_nonempty_value is informational; PATH is virtually always long
    if !saw_nonempty_value {
        return 15;
    }
    return 0;
}

i32 test_get_var_found() {
    // find first entry, then get_var must match
    process::Vars it = process::vars();
    defer process::close(&it);
    result::Optional(process::Var) first = process::next(&it);
    if first.is_none() {
        return 20;
    }
    process::Var want = first.unwrap_some();
    // copy name since next() borrows an internal buffer on Windows
    char[512] name_store;
    if want.name.len > 512 {
        return 21;
    }
    mem::copy(name_store[0..want.name.len], want.name);
    [] const char name = slice::from_raw_const!char(&name_store[0], want.name.len);
    char[512] val_store;
    if want.value.len > 512 {
        return 22;
    }
    mem::copy(val_store[0..want.value.len], want.value);
    [] const char want_val = slice::from_raw_const!char(&val_store[0], want.value.len);
    char[4096] out_store;
    [] char out = slice::from_raw(&out_store[0], 4096);
    Result([] const char, Error) g = process::get_var(name, out);
    if g.is_err() {
        return 23;
    }
    if !same(g.unwrap(), want_val) {
        return 24;
    }
    return 0;
}

i32 test_get_var_missing() {
    char[64] out_store;
    [] char out = slice::from_raw(&out_store[0], 64);
    Result([] const char, Error) g = process::get_var("__DCC_SPAWN_TEST_ABSENT_9Z9Z__", out);
    if g.is_ok() {
        return 30;
    }
    if g.unwrap_err() != Error::NotFound {
        return 31;
    }
    return 0;
}

i32 test_get_var_small_out() {
    process::Vars it = process::vars();
    defer process::close(&it);
    // find an entry with value longer than 1 byte
    while true {
        result::Optional(process::Var) o = process::next(&it);
        if o.is_none() {
            return 40;
        }
        process::Var v = o.unwrap_some();
        if v.value.len > 2 {
            char[512] name_store;
            if v.name.len > 512 {
                continue;
            }
            mem::copy(name_store[0..v.name.len], v.name);
            [] const char name = slice::from_raw_const!char(&name_store[0], v.name.len);
            char[1] tiny;
            Result([] const char, Error) g = process::get_var(name, tiny[0..1]);
            if g.is_ok() {
                return 41;
            }
            if g.unwrap_err() != Error::NameTooLong {
                return 42;
            }
            return 0;
        }
    }
}

i32 test_has_var() {
    process::Vars it = process::vars();
    defer process::close(&it);
    result::Optional(process::Var) first = process::next(&it);
    if first.is_none() {
        return 50;
    }
    process::Var v = first.unwrap_some();
    char[512] name_store;
    if v.name.len > 512 {
        return 51;
    }
    mem::copy(name_store[0..v.name.len], v.name);
    [] const char name = slice::from_raw_const!char(&name_store[0], v.name.len);
    if !process::has_var(name) {
        return 52;
    }
    if process::has_var("__DCC_SPAWN_TEST_ABSENT_9Z9Z__") {
        return 53;
    }
    // long value still reports true via the one-byte probe
    process::Vars it2 = process::vars();
    defer process::close(&it2);
    while true {
        result::Optional(process::Var) o = process::next(&it2);
        if o.is_none() {
            return 54;
        }
        process::Var e = o.unwrap_some();
        if e.value.len > 1 {
            char[512] n2;
            if e.name.len > 512 {
                continue;
            }
            mem::copy(n2[0..e.name.len], e.name);
            [] const char nm = slice::from_raw_const!char(&n2[0], e.name.len);
            if !process::has_var(nm) {
                return 55;
            }
            return 0;
        }
    }
}

i32 test_arg() {
    static if core::target::OS == core::target::Os::Windows {
        if process::arg_count() != 0 {
            return 60;
        }
        if process::arg(0).is_some() {
            return 61;
        }
    } else {
        usize n = process::arg_count();
        if n == 0 {
            return 62;
        }
        result::Optional([] const char) a0 = process::arg(0);
        if a0.is_none() {
            return 63;
        }
        if a0.unwrap_some().len == 0 {
            return 64;
        }
        if process::arg(n).is_some() {
            return 65;
        }
    }
    return 0;
}

i32 test_current_dir() {
    char[4096] store;
    [] char out = slice::from_raw(&store[0], 4096);
    Result([] const char, Error) r = process::current_dir(out);
    if r.is_err() {
        return 70;
    }
    [] const char cwd = r.unwrap();
    if cwd.len == 0 {
        return 71;
    }
    // absolute with no trailing NUL in the slice
    if !path::is_absolute(cwd) {
        return 72;
    }
    for usize i = 0; i < cwd.len; i++ {
        if cwd[i] == '\0' {
            return 73;
        }
    }
    // buffer too small must fail
    char[1] tiny;
    if process::current_dir(tiny[0..1]).is_ok() {
        return 74;
    }
    return 0;
}

i32 test_set_current_dir() {
    // process-global: save, chdir to scratch, verify, restore via defer
    char[4096] orig_store;
    [] char orig_view = slice::from_raw(&orig_store[0], 4096);
    Result([] const char, Error) o = process::current_dir(orig_view);
    if o.is_err() {
        return 80;
    }
    [] const char orig = o.unwrap();
    char[4096] saved;
    if orig.len > 4096 {
        return 81;
    }
    mem::copy(saved[0..orig.len], orig);
    usize saved_len = orig.len;
    // defer restore
    // NOTE: this case is process-global and cannot run in parallel
    // with anything path-relative.
    if !file::make_directory("fops_cwd_scratch").is_ok() {
        return 82;
    }
    // ensure restore even on early return
    bool restored = false;
    // manual defer pattern: use a flag and explicit restores below
    if !process::set_current_dir("fops_cwd_scratch").is_ok() {
        file::remove_directory("fops_cwd_scratch");
        return 83;
    }
    char[4096] cur_store;
    Result([] const char, Error) c = process::current_dir(slice::from_raw(&cur_store[0], 4096));
    if c.is_err() {
        [] char rview = slice::from_raw(&saved[0], saved_len);
        process::set_current_dir(rview);
        file::remove_directory("fops_cwd_scratch");
        // need absolute remove? we are inside scratch, so use ..?
        return 84;
    }
    // current dir must reflect the scratch directory
    // check tail component
    [] const char cur = c.unwrap();
    if cur.len < 16 {
        [] char rview = slice::from_raw(&saved[0], saved_len);
        process::set_current_dir(rview);
        return 85;
    }
    // last 16 bytes should be fops_cwd_scratch
    if !same(cur[cur.len - 16..cur.len], "fops_cwd_scratch") {
        [] char rview = slice::from_raw(&saved[0], saved_len);
        process::set_current_dir(rview);
        return 86;
    }
    // restore
    [] char rview2 = slice::from_raw(&saved[0], saved_len);
    if !process::set_current_dir(rview2).is_ok() {
        return 87;
    }
    restored = true;
    if !file::remove_directory("fops_cwd_scratch").is_ok() {
        return 88;
    }
    if !restored {
        return 89;
    }
    return 0;
}

public i32 main() {
    i32 code = test_vars_iterate();
    if code != 0 {
        return code;
    }
    code = test_get_var_found();
    if code != 0 {
        return code;
    }
    code = test_get_var_missing();
    if code != 0 {
        return code;
    }
    code = test_get_var_small_out();
    if code != 0 {
        return code;
    }
    code = test_has_var();
    if code != 0 {
        return code;
    }
    code = test_arg();
    if code != 0 {
        return code;
    }
    code = test_current_dir();
    if code != 0 {
        return code;
    }
    return test_set_current_dir();
}
