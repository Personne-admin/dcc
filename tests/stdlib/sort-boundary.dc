module main;
import std::sort;
import std::slice;
u8[32769] values;
@nomangle public i32 dcc_main() {
    []u8 view = std::slice::from_raw!u8(&values[0], 32769);
    for usize i = 0; i < 32769; i++ { view[i] = ((32769 - i) & 255) as u8; }
    std::sort::heap_sort_by(view, std::sort::compare_default!u8);
    for usize i = 1; i < 32769; i++ { if view[i - 1] > view[i] { return 1; } }
    return 0;
}
public i32 main() { return dcc_main(); }
