module main;

import std::os::path;
import std::os::error;
import std::mem;
import std::slice;
import std::result;

using std::os::{ path, error };
using std::{ mem, slice, result };
using error::Error;

bool same([] const u8 a, [] const u8 b) {
    return mem::equal(a, b);
}

i32 check_norm([] const u8 input, [] const u8 want) {
    u8[64] store;
    [] u8 out = slice::from_raw(&store[0], 64);
    Result([] u8, Error) r = path::normalize(input, out);
    if r.is_err() {
        return 1;
    }
    if !same(r.unwrap(), want) {
        return 2;
    }
    return 0;
}

public i32 main() {
    if check_norm("a/b/c/../../d", "a/d") != 0 {
        return 20;
    }
    if check_norm("aa/bb/cc/../../dd", "aa/dd") != 0 {
        return 21;
    }
    if check_norm("a/b/c/d/../../../e", "a/e") != 0 {
        return 22;
    }
    if check_norm("a/b/c/../..", "a") != 0 {
        return 23;
    }
    return 0;
}
