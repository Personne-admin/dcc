module size_json;
import std::json;
import std::mem;
public i32 main() {
    u8[8192] storage = {};
    std::mem::FixedBuffer backing = std::mem::new_fixed_buffer(storage[0..8192]);
    std::mem::FixedHandle alloc = std::mem::borrow(&backing);
    std::json::Document(std::mem::FixedHandle) document = std::json::parse(alloc, "{\"name\":\"dc\",\"items\":[1,2,3],\"ok\":true}").unwrap();
    bool found = document.root.get("items").is_some() && document.root.get("ok").is_some();
    document.deinit();
    return if found { 0 } else { 1 };
}
