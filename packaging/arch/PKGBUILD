pkgname=dcc-git
_pkgname=dcc
pkgver=r1132.g8eaa5005
pkgrel=1
pkgdesc='dc systems programming language compiler and language server'
arch=('x86_64')
url='https://github.com/Personne-admin/dcc'
license=('GPL-3.0-only')

depends=(
    'llvm-libs'
    'libc++'
    'libc++abi'
    'cmark'
)

makedepends=(
    'git'
    'clang'
    'llvm'
    'python'
    'make'
)

provides=('dcc')
conflicts=('dcc')

source=("git+https://github.com/Personne-admin/dcc.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"

    printf "r%s.g%s" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$_pkgname"

    make \
        BUILD_TYPE=release \
        PREFIX=/usr
}

package() {
    cd "$srcdir/$_pkgname"

    make \
        BUILD_TYPE=release \
        PREFIX=/usr \
        DESTDIR="$pkgdir" \
        install
}
