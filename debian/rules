#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_clean:
	rm -rf build

override_dh_auto_build:
	$(MAKE) \
		BUILD_TYPE=release \
		PREFIX=/usr \
		CXX=clang++-21 \
		CC=clang-21 \
		LLVM_CONFIG=llvm-config-21 \
		SCAN_DEPS=clang-scan-deps-21

override_dh_auto_test:
	$(MAKE) \
		BUILD_TYPE=release \
		PREFIX=/usr \
		CXX=clang++-21 \
		CC=clang-21 \
		LLVM_CONFIG=llvm-config-21 \
		SCAN_DEPS=clang-scan-deps-21 \
		test

override_dh_auto_install:
	$(MAKE) \
		BUILD_TYPE=release \
		PREFIX=/usr \
		CXX=clang++-21 \
		CC=clang-21 \
		LLVM_CONFIG=llvm-config-21 \
		SCAN_DEPS=clang-scan-deps-21 \
		DESTDIR=$(CURDIR)/debian/dcc \
		install
